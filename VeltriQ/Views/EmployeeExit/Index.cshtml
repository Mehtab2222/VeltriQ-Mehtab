@model IEnumerable<VeltriQ.Models.HR.EmployeeExit>

@{
    ViewData["Title"] = "Employee Exit";
}

<style>
    .exit-page {
        width: 100%;
    }

    /* HEADER */
    .exit-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .exit-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        letter-spacing: -.4px;
    }

    .exit-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    /* BUTTON */
    .exit-add-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
        box-shadow: 0 8px 22px rgba(124,58,237,.22);
    }

        .exit-add-btn:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    /* CARD */
    .exit-card {
        background: rgba(30,35,44,.94);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        overflow: hidden;
    }

    .exit-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
        gap: 20px;
    }

    .exit-card-title h3 {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 3px;
    }

    .exit-card-title p {
        font-size: 13px;
        color: #94a3b8;
        margin: 0;
    }

    /* SEARCH */
    .exit-search {
        width: 320px;
        position: relative;
    }

        .exit-search input {
            width: 100%;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #2a3441;
            background: #0d1117;
            padding: 0 14px 0 42px;
            color: #fff;
            font-size: 13px;
            outline: none;
        }

            .exit-search input:focus {
                border-color: #7c3aed;
            }

        .exit-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

    /* TABLE */
    .table-wrapper {
        overflow-x: auto;
    }

    .exit-table {
        width: 100%;
        border-collapse: collapse;
    }

        .exit-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .exit-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .exit-table tbody tr:hover {
            background: rgba(255,255,255,.02);
        }

    /* EMPLOYEE INFO */
    .emp-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .emp-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(124,58,237,0.15);
        color: #a78bfa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
    }

    /* STATUS BADGES */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        padding: 0 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34,197,94,.14);
        color: #22c55e;
    }

    .status-pending {
        background: rgba(245,158,11,.14);
        color: #f59e0b;
    }

    /* ACTIONS */
    .action-btn-complete {
        padding: 6px 14px;
        border-radius: 8px;
        background: rgba(239,68,68,.12);
        color: #ef4444;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
        border: 1px solid rgba(239,68,68,0.2);
    }

        .action-btn-complete:hover {
            background: #ef4444;
            color: #fff;
        }
</style>

<div class="exit-page">

    <!-- HEADER -->
    <div class="exit-header">
        <div class="exit-header-left">
            <h2>Employee Exit</h2>
            <p>Manage employee resignations and separation processes.</p>
        </div>

        <a href="/EmployeeExit/Create" class="exit-add-btn">
            <i class="bi bi-plus-lg"></i>
            New Exit Request
        </a>
    </div>

    <!-- CARD -->
    <div class="exit-card">

        <!-- TOP CONTROLS -->
        <div class="exit-card-top">
            <div class="exit-card-title">
                <h3>Exit Records</h3>
                <p>Total Offboarding: @Model.Count()</p>
            </div>

            <div class="exit-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search employee or status..." />
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-wrapper">
            <table class="exit-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Resignation Date</th>
                        <th>Last Working Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="emp-info">
                                    <div class="emp-avatar">
                                        @(item.Employee?.FirstName?.Substring(0, 1))@(item.Employee?.LastName?.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div style="font-weight: 700;">
                                            @item.Employee?.FirstName @item.Employee?.LastName
                                        </div>
                                        <div style="font-size: 11px; color: #6b7280;">ID: @item.EmployeeExitId</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @item.ResignationDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.LastWorkingDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="status-badge status-active">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <a asp-action="Complete" asp-route-id="@item.EmployeeExitId" class="action-btn-complete">
                                        Complete Exit
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #4b5563; font-size: 11px; font-style: italic;">Processed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>