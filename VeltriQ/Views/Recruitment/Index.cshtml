
@model IEnumerable<VeltriQ.Models.Recruitment.ManpowerRequest>

@{
    ViewData["Title"] = "Recruitment Requests";
}

<style>
    .recruitment-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .recruitment-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT BUTTONS ── */
    .btn-export {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 12px;
        font-weight: 600;
        transition: background 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-export:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }

    .recruitment-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .recruitment-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .recruitment-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .recruitment-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .recruitment-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .recruitment-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .recruitment-search-wrapper {
        position: relative;
        width: 320px; /* Increased width layout */
    }

        .recruitment-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .recruitment-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .recruitment-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .recruitment-table {
        width: 100%;
        border-collapse: collapse;
    }

        .recruitment-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .recruitment-table td {
            padding: 6px 16px; /* Reduced row height to match the document directory style */
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .recruitment-table tbody tr {
            transition: background-color .1s ease;
        }

            .recruitment-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── BADGES & CONTROLS ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    /* Type Customizations */
    .badge-new {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
    }

    .badge-warning {
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
    }

    .badge-danger {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    /* Priority Customizations */
    .badge-low {
        background: rgba(148, 163, 184, .12);
        color: #94a3b8;
    }

    .badge-medium {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
    }

    .badge-high {
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
    }

    .badge-urgent {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    /* Workflow Customizations */
    .badge-draft {
        background: rgba(148, 163, 184, .12);
        color: #cbd5e1;
    }

    .badge-pending {
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
    }

    .badge-approved {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    /* ── INLINE ACTIONS (ICONS MATCHING IMAGE) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="recruitment-page">

    <div class="recruitment-header">
        <button class="btn-export">
            <i class="bi bi-download"></i> Export
        </button>
        <a href="@Url.Action("Create")" class="recruitment-add-btn">
            <i class="bi bi-plus-lg"></i> Create Request
        </a>
    </div>

    <div class="recruitment-card">

        <div class="recruitment-card-top">
            <div class="recruitment-card-title">
                <h3>Recruitment Requests</h3>
                <p>Total Requests: @Model.Count()</p>
            </div>

            <!-- Enhanced Right-aligned Search Bar -->
            <div class="recruitment-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="reqSearchInput" placeholder="Search requests..." onkeyup="filterRequestsTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="recruitment-table" id="reqTable">
                <thead>
                    <tr>
                        <th>Request Code</th>
                        <th>Request Date</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Type</th>
                        <th>Positions</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 700;">
                                @item.RequestCode
                            </td>
                            <td>
                                @item.RequestDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                @item.DepartmentId
                            </td>
                            <td>
                                @item.DesignationId
                            </td>
                            <td>
                                @if (item.RecruitmentTypeId == 1)
                                {
                                    <span class="status-badge badge-new">New Block</span>
                                }
                                else if (item.RecruitmentTypeId == 2)
                                {
                                    <span class="status-badge badge-warning">Resignation</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-danger">Termination</span>
                                }
                            </td>
                            <td style="font-weight: 600;">
                                @item.NumberOfPositions
                            </td>
                            <td>
                                @if (item.PriorityId == 1)
                                {
                                    <span class="status-badge badge-low">Low</span>
                                }
                                else if (item.PriorityId == 2)
                                {
                                    <span class="status-badge badge-medium">Medium</span>
                                }
                                else if (item.PriorityId == 3)
                                {
                                    <span class="status-badge badge-high">High</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-urgent">Urgent</span>
                                }
                            </td>
                            <td>
                                @if (item.StatusId == 1)
                                {
                                    <span class="status-badge badge-draft">Draft</span>
                                }
                                else if (item.StatusId == 2)
                                {
                                    <span class="status-badge badge-pending">Pending</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-approved">Approved</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a class="action-btn"
                                       asp-controller="Recruitment"
                                       asp-action="Edit"
                                       asp-route-id="@item.ManpowerRequestId"
                                       title="Edit Record">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="action-btn delete-btn"
                                       href="#"
                                       onclick="return confirm('Are you sure you want to delete this request?')"
                                       title="Delete Request">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterRequestsTable() {
        const input = document.getElementById('reqSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('reqTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>
