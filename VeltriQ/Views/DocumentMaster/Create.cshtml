@model VeltriQ.Models.HR.DocumentMaster

@{
    ViewData["Title"] = "Create Document";
}

<style>

    .document-create-page {
        padding: 4px 0 32px;
    }

    /* TOPBAR */

    .document-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        gap: 20px;
    }

    .document-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
    }

        .document-breadcrumb a {
            color: #8b5cf6;
            text-decoration: none;
            font-weight: 600;
        }

        .document-breadcrumb span {
            color: #94a3b8;
        }

    .document-top-actions {
        display: flex;
        gap: 10px;
    }

    .cancel-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        color: #94a3b8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .save-btn {
        height: 40px;
        padding: 0 20px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 22px rgba(124,58,237,.24);
    }

    /* CARD */

    .document-card {
        max-width: 1000px;
        background: rgba(30,35,44,.92);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 18px;
        overflow: hidden;
    }

    .document-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .document-card-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(124,58,237,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a78bfa;
    }

    .document-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    /* BODY */

    .document-card-body {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .full-width {
        grid-column: span 2;
    }

    /* FIELD */

    .form-field {
        display: flex;
        flex-direction: column;
    }

        .form-field label {
            margin-bottom: 7px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .7px;
            text-transform: uppercase;
        }

    /* INPUT */

    .form-input,
    .form-select {
        width: 100%;
        height: 42px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(15,20,30,.7);
        color: #fff;
        padding: 0 14px;
        font-size: 13px;
        outline: none;
    }

        .form-input:focus,
        .form-select:focus {
            border-color: #7c3aed;
            background: rgba(124,58,237,.06);
            box-shadow: 0 0 0 3px rgba(124,58,237,.12);
        }

</style>

<div class="document-create-page">

    <!-- TOPBAR -->

    <div class="document-topbar">

        <div class="document-breadcrumb">

            <a href="/DocumentMaster/Index">
                Document Master
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Create</span>

        </div>

        <div class="document-top-actions">

            <a href="/DocumentMaster/Index"
               class="cancel-btn">

                <i class="bi bi-x"></i>

                Cancel

            </a>

            <button type="submit"
                    form="documentForm"
                    class="save-btn">

                <i class="bi bi-file-earmark-plus"></i>

                Save Document

            </button>

        </div>

    </div>

    <!-- FORM -->

    <form id="documentForm"
          asp-action="Create"
          method="post">

        <div class="document-card">

            <div class="document-card-header">

                <div class="document-card-icon">

                    <i class="bi bi-file-earmark-text"></i>

                </div>

                <div class="document-card-title">
                    Document Information
                </div>

            </div>

            <div class="document-card-body">

                <!-- NAME -->

                <div class="form-field full-width">

                    <label>
                        Document Name
                    </label>

                    <input asp-for="DocumentName"
                           class="form-input"
                           placeholder="Enter document name" />

                </div>

                <!-- CODE -->

                <div class="form-field">

                    <label>
                        Document Code
                    </label>

                    <input asp-for="DocumentCode"
                           class="form-input"
                           placeholder="DOC-001" />

                </div>

                <!-- MAX SIZE -->

                <div class="form-field">

                    <label>
                        Max File Size (MB)
                    </label>

                    <input asp-for="MaxFileSizeMB"
                           class="form-input"
                           placeholder="5" />

                </div>

                <!-- EXTENSIONS -->

                <div class="form-field full-width">

                    <label>
                        Allowed File Extensions
                    </label>

                    <input asp-for="AllowedFileExtensions"
                           class="form-input"
                           placeholder="pdf,jpg,png,docx" />

                </div>

                <!-- MANDATORY -->

                <div class="form-field">

                    <label>
                        Is Mandatory
                    </label>

                    <select asp-for="IsMandatory"
                            class="form-select">

                        <option value="true">
                            Yes
                        </option>

                        <option value="false">
                            No
                        </option>

                    </select>

                </div>

                <!-- DESCRIPTION -->

                <div class="form-field">

                    <label>
                        Description
                    </label>

                    <input asp-for="Description"
                           class="form-input"
                           placeholder="Enter description" />

                </div>

            </div>

        </div>

    </form>

</div>