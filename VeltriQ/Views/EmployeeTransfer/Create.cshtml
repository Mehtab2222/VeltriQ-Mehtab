@model VeltriQ.Models.HR.EmployeeTransfer

@{
    ViewData["Title"] = "Employee Transfer";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .transfer-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        padding-bottom: 30px;
    }

    /* TOPBAR */
    .transfer-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
    }

    .transfer-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

        .transfer-breadcrumb a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
        }

        .transfer-breadcrumb i {
            color: var(--text-muted);
            font-size: 10px;
        }

        .transfer-breadcrumb span {
            color: var(--text-secondary);
            font-weight: 500;
        }

    .transfer-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cancel-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .cancel-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    .save-btn {
        height: 32px;
        padding: 0 16px;
        border: none;
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .save-btn:hover {
            opacity: 0.9;
        }

    /* SINGLE UNIFIED CARD MODULE */
    .transfer-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-top: 6px;
    }

    .column-header {
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--purple);
        margin-bottom: 14px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 14px;
    }

    .form-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .form-control, .form-select {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--purple);
        }

    textarea.form-control {
        height: auto;
        min-height: 70px;
        padding-top: 8px;
        resize: vertical;
    }

    .readonly-col .form-control,
    .readonly-col .form-select {
        background: rgba(255, 255, 255, 0.02);
        border: 1px dashed var(--border);
        color: var(--text-muted);
        pointer-events: none;
    }

    .full-width-section {
        grid-column: span 2;
        margin-top: 4px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
    }

    /* RESPONSIVE */
    @@media(max-width: 900px) {
        .comparison-grid {
            grid-template-columns: 1fr;
        }

        .full-width-section {
            grid-column: span 1;
        }
    }
</style>

<div class="transfer-page">
    <form id="transferForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- TOPBAR -->
        <div class="transfer-topbar">
            <div class="transfer-breadcrumb">
                <a href="/EmployeeTransfer/Index">Employee Transfers</a>
                <i class="bi bi-chevron-right"></i>
                <span>Create</span>
            </div>

            <div class="transfer-top-actions">
                <a href="/EmployeeTransfer/Index" class="cancel-btn">
                    <i class="bi bi-x"></i> Cancel
                </a>
                <button type="submit" class="save-btn">
                    <i class="bi bi-send"></i> Submit Transfer
                </button>
            </div>
        </div>

        <!-- SINGLE UNIFIED CARD -->
        <div class="transfer-master-card">

            <!-- Employee Search -->
            <div class="form-group" style="max-width: 400px; margin-bottom: 20px;">
                <label class="form-label">Search Employee *</label>
                <select asp-for="EmployeeId" id="employeeDropdown" asp-items="ViewBag.EmployeeList" class="form-select" required>
                    <option value="">-- Select Employee --</option>
                </select>
            </div>

            <div class="comparison-grid">
                <!-- Left: Current Position (Readonly) -->
                <div class="readonly-col">
                    <div class="column-header">
                        <i class="bi bi-person-badge"></i> Current Position
                    </div>

                    <!-- Hidden Inputs for Form Submission -->
                    <input type="hidden" asp-for="CurrentBranchId" id="currentBranchHidden" />
                    <input type="hidden" asp-for="CurrentDepartmentId" id="currentDepartmentHidden" />
                    <input type="hidden" asp-for="CurrentDesignationId" id="currentDesignationHidden" />

                    <div class="form-group">
                        <label class="form-label">Current Branch</label>
                        <select id="currentBranch" asp-items="ViewBag.BranchList" class="form-select" disabled>
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Current Department</label>
                        <select id="currentDepartment" asp-items="ViewBag.DepartmentList" class="form-select" disabled>
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Current Designation</label>
                        <select id="currentDesignation" asp-items="ViewBag.DesignationList" class="form-select" disabled>
                            <option value=""></option>
                        </select>
                    </div>
                </div>

                <!-- Right: New Assignment -->
                <div class="editable-col">
                    <div class="column-header" style="color: #22c55e; border-bottom-color: rgba(34, 197, 94, 0.2);">
                        <i class="bi bi-arrow-right-circle"></i> New Assignment
                    </div>
                    <div class="form-group">
                        <label class="form-label">New Branch *</label>
                        <select asp-for="NewBranchId" asp-items="ViewBag.BranchList" class="form-select" required>
                            <option value="">Select Branch</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">New Department *</label>
                        <select asp-for="NewDepartmentId" asp-items="ViewBag.DepartmentList" class="form-select" required>
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">New Designation *</label>
                        <select asp-for="NewDesignationId" asp-items="ViewBag.DesignationList" class="form-select" required>
                            <option value="">Select Designation</option>
                        </select>
                    </div>
                </div>

                <!-- Footer Details -->
                <div class="full-width-section">
                    <div style="display: grid; grid-template-columns: 1fr; gap: 14px;">
                        <div class="form-group" style="max-width: 400px;">
                            <label class="form-label">Effective Date *</label>
                            <input asp-for="EffectiveDate" type="date" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Transfer Reason</label>
                            <textarea asp-for="TransferReason" rows="3" class="form-control" placeholder="Provide a brief explanation for the change..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const empDrop = document.getElementById("employeeDropdown");
            empDrop.addEventListener("change", function () {
                const id = this.value;
                if (!id) return;
                fetch('/EmployeeTransfer/GetEmployeeDetails?employeeId=' + id)
                    .then(r => r.json())
                    .then(d => {
                        // Set visible disabled selects
                        document.getElementById("currentBranch").value = d.branchId;
                        document.getElementById("currentDepartment").value = d.departmentId;
                        document.getElementById("currentDesignation").value = d.designationId;

                        // Set hidden inputs (so data submits properly)
                        document.getElementById("currentBranchHidden").value = d.branchId;
                        document.getElementById("currentDepartmentHidden").value = d.departmentId;
                        document.getElementById("currentDesignationHidden").value = d.designationId;
                    });
            });
        });
    </script>
}