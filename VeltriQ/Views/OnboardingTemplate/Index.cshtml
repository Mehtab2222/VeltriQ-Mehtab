@model IEnumerable<VeltriQ.ViewModels.OnboardingTemplateListViewModel>

@{
    ViewData["Title"] = "Onboarding Templates";
}

<style>
    .template-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── ALERT SYSTEM ── */
    .alert-container {
        margin-bottom: 12px;
    }

    .custom-alert {
        padding: 8px 12px;
        font-size: 12px;
        border-radius: 4px;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .custom-alert-success {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .custom-alert-danger {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    /* ── HEADER (Compact & Pushed Up) ── */
    .template-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .template-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .template-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH SQUARED CORNERS ── */
    .template-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .template-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .template-card-title h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .template-card-title p {
        margin: 2px 0 0;
        font-size: 11px;
        color: var(--text-secondary);
    }

    /* ── SEARCH BAR ── */
    .template-search {
        width: 280px;
        position: relative;
    }

        .template-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 12px 0 36px;
            outline: none;
            font-size: 12px;
            transition: border-color 0.2s;
        }

            .template-search input:focus {
                border-color: var(--purple);
            }

        .template-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── SCROLLABLE WRAPPER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .template-table {
        width: 100%;
        border-collapse: collapse;
    }

        .template-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
            white-space: nowrap;
        }

        .template-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .template-table tbody tr {
            transition: background-color .1s ease;
        }

            .template-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── IDENTITY CONSOLES ── */
    .template-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .template-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        font-size: 14px;
        flex-shrink: 0;
    }

    .template-name {
        font-weight: 600;
        line-height: 1.2;
    }

    .template-code {
        font-size: 10.5px;
        color: var(--text-muted);
        line-height: 1;
    }

    /* ── COMPACT SYSTEM BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-draft {
        background: rgba(234, 179, 8, .12);
        color: #ca8a04;
    }

    .status-inactive {
        background: rgba(239, 68, 68, .12);
        color: #ef4444;
    }

    /* ── ACTION CONTROLS ── */
    .table-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 4px;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        transition: .15s ease;
        font-size: 12px;
        cursor: pointer;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }

    .action-form {
        display: inline;
        margin: 0;
        padding: 0;
    }
</style>

<div class="template-page">

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="alert-container">
            @if (TempData["Success"] != null)
            {
                <div class="custom-alert custom-alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="custom-alert custom-alert-danger">@TempData["Error"]</div>
            }
        </div>
    }

    <div class="template-header">
        <a asp-action="Create" class="template-add-btn">
            <i class="bi bi-plus-lg"></i>
            Create Template
        </a>
    </div>

    <div class="template-card">

        <div class="template-card-top">
            <div class="template-card-title">
                <h3>Onboarding Templates</h3>
                <p>Total Templates: @Model.Count()</p>
            </div>

            <div class="template-search">
                <i class="bi bi-search"></i>
                <input type="text" id="templateSearchInput" placeholder="Search templates..." onkeyup="filterTemplateTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="template-table" id="templateTable">
                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Employment Type</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Version</th>
                        <th>Published</th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="template-info">
                                        <div class="template-icon">
                                            <i class="bi bi-file-earmark-text"></i>
                                        </div>
                                        <div>
                                            <div class="template-name">@item.TemplateName</div>
                                            <div class="template-code">@item.TemplateCode</div>
                                        </div>
                                    </div>
                                </td>

                                <td>@item.EmploymentType</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Department) ? "-" : item.Department)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Designation) ? "-" : item.Designation)</td>
                                <td>@item.Version</td>

                                <td>
                                    @if (item.IsPublished)
                                    {
                                        <span class="status-badge status-active">Published</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-draft">Draft</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Edit" asp-route-id="@item.OnboardingTemplateId" class="action-btn" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Configure" asp-route-id="@item.OnboardingTemplateId" class="action-btn" title="Configure Template">
                                            <i class="bi bi-sliders"></i>
                                        </a>

                                        @if (item.IsPublished)
                                        {
                                            <form asp-action="UnPublish" asp-route-id="@item.OnboardingTemplateId" method="post" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn" title="Unpublish">
                                                    <i class="bi bi-arrow-down-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Publish" asp-route-id="@item.OnboardingTemplateId" method="post" class="action-form">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="action-btn" title="Publish">
                                                    <i class="bi bi-arrow-up-circle"></i>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete" asp-route-id="@item.OnboardingTemplateId" method="post" class="action-form" onsubmit="return confirm('Are you sure you want to delete this template?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn delete-btn" title="Delete Template">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 20px;">
                                No onboarding templates found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterTemplateTable() {
        const input = document.getElementById('templateSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('templateTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>