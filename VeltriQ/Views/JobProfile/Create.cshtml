@model VeltriQ.ViewModels.JobProfileViewModel

@{
    ViewData["Title"] = "Create Job Profile";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .jobprofile-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
    }

    /* ── CORE PANEL CARD MODULE ── */
    .jobprofile-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        height: calc(100vh - var(--topbar-h) - 100px);
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .jobprofile-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
        flex-shrink: 0;
        background: var(--card-bg);
    }

    .jobprofile-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .jobprofile-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .add-skills-btn {
        height: 26px;
        padding: 0 12px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .add-skills-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    /* FORM BODY SCROLL AREA */
    .jobprofile-form-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .form-section-title {
        color: var(--text-primary);
        font-size: 12.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .form-group label {
            color: var(--text-secondary);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .form-control {
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s;
    }

    textarea.form-control {
        min-height: 90px;
        padding-top: 8px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: var(--purple);
    }

    /* FOOTER BAR */
    .jobprofile-card-footer {
        padding: 12px 16px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

    .submit-btn {
        height: 30px;
        padding: 0 16px;
        border: 1px solid var(--purple);
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

        .submit-btn:hover {
            opacity: 0.9;
        }
</style>

<div class="jobprofile-page">
    <div class="jobprofile-master-card">

        <!-- CARD TOP HEADER -->
        <div class="jobprofile-card-top">
            <div class="jobprofile-card-title">
                <h3>Create Job Profile</h3>
                <p>Fill in the job profile details for recruitment structures.</p>
            </div>

            <a href="/Skill/Index" target="_blank" class="add-skills-btn">
                <i class="bi bi-plus-lg"></i> Add Skills
            </a>
        </div>

        <!-- FORM CONTAINER -->
        <form asp-action="Create" asp-controller="JobProfile" method="post" style="display: flex; flex-direction: column; flex: 1; overflow: hidden;">

            <div class="jobprofile-form-scroll">

                <div class="form-section-title">Job Information Matrix</div>

                <div class="form-grid">

                    <div class="form-group">
                        <label>Job Profile Name *</label>
                        <input asp-for="JobTitle" class="form-control" placeholder="Enter job profile name" autocomplete="off" />
                    </div>

                    <div class="form-group">
                        <label>Skill Category *</label>
                        <select asp-for="JobCategoryId" asp-items="Model.JobCategoryList" class="form-control" id="jobCategoryDropdown">
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Reviewer</label>
                        <select asp-for="SelectedReviewerIds" asp-items="Model.EmployeeList" class="form-control">
                            <option value="">Select Reviewer</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Reporting To</label>
                        <select asp-for="ReportingToId" asp-items="Model.EmployeeList" class="form-control">
                            <option value="">Select Employee</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Hiring Manager</label>
                        <select asp-for="HiringManagerId" asp-items="Model.EmployeeList" class="form-control">
                            <option value="">Select Employee</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Skill</label>
                        <select asp-for="SelectedSkillIds" class="form-control" id="skillsDropdown">
                            <option value="">Select Skill</option>
                        </select>
                    </div>

                </div>

                <div class="form-group" style="margin-top: 18px;">
                    <label>Job Description</label>
                    <textarea asp-for="JobDescription" class="form-control" placeholder="Enter detailed job description..."></textarea>
                </div>

            </div>

            <!-- FOOTER BAR WITH SUBMIT -->
            <div class="jobprofile-card-footer">
                <button type="submit" class="submit-btn">
                    <i class="bi bi-check2-circle"></i> Create Job Profile
                </button>
            </div>

        </form>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#jobCategoryDropdown').change(function () {
            var categoryId = $(this).val();
            var $skillsDropdown = $('#skillsDropdown');

            $skillsDropdown.empty();
            $skillsDropdown.append('<option value="">Select Skill</option>');

            if (categoryId) {
                $.get('/JobProfile/GetSkillsByCategory', { categoryId: categoryId }, function (data) {
                    if (data && data.length > 0) {
                        $.each(data, function (i, item) {
                            var skillId = item.id !== undefined ? item.id : (item.value !== undefined ? item.value : item.Value);
                            var skillName = item.text !== undefined ? item.text : (item.name !== undefined ? item.name : item.Name);

                            $skillsDropdown.append($('<option></option>').val(skillId).text(skillName));
                        });
                    }
                }).fail(function () {
                    console.error("Failed to fetch skills for the selected category.");
                });
            }
        });
    });
</script>