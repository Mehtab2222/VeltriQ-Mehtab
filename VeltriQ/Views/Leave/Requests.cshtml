@model IEnumerable<VeltriQ.Models.HR.LeaveApplication>

@{
    ViewData["Title"] = "Leave Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .leave-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .leave-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    .leave-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .leave-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .leave-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .leave-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .leave-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .leave-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .leave-table {
        width: 100%;
        border-collapse: collapse;
    }

        .leave-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .leave-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .leave-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .status-approved {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    .custom-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

        .custom-modal.active {
            display: flex;
        }

    .custom-modal-box {
        width: 100%;
        max-width: 500px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
    }

    .modal-header-custom {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .modal-header-custom h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

    .close-modal-btn {
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 4px;
        background: var(--hover-bg);
        color: var(--text-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-body-custom {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
        }

    .custom-input, .custom-select {
        width: 100%;
        height: 36px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
    }

        .custom-input:focus, .custom-select:focus {
            border-color: var(--purple);
        }

    textarea.custom-input {
        height: auto;
        min-height: 70px;
        padding-top: 6px;
    }

    .modal-footer-custom {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .cancel-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        cursor: pointer;
        font-weight: 600;
        font-size: 12px;
    }

    .save-btn {
        height: 34px;
        padding: 0 16px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
</style>

@Html.AntiForgeryToken()

<div class="leave-page">
    <div class="leave-header">
        <button class="leave-add-btn" onclick="openApplyModal()">
            <i class="bi bi-plus-lg"></i> Apply Leave Request
        </button>
    </div>

    <div class="leave-card">
        <div class="leave-card-top">
            <div class="leave-card-title">
                <h3>Leave Requests Workspace</h3>
                <p>Manage pending and processed time-off submissions.</p>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="leave-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>From — To</th>
                        <th style="text-align: center;">Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            var statusClass = x.Status == "Approved" ? "status-approved" : (x.Status == "Rejected" || x.Status == "Cancelled" ? "status-rejected" : "status-pending");
                            <tr>
                                <td style="font-weight: 700;">@(x.Employee != null ? $"{x.Employee.FirstName} {x.Employee.LastName}" : "—")</td>
                                <td>@(x.LeaveType?.LeaveTypeName ?? "—")</td>
                                <td>@x.StartDate.ToString("dd MMM yyyy") — @x.EndDate.ToString("dd MMM yyyy")</td>
                                <td style="text-align: center; font-weight: 700;">@x.TotalDays</td>
                                <td>@(x.Reason ?? "—")</td>
                                <td><span class="badge-status @statusClass">@x.Status</span></td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                        @if (x.Status == "Pending")
                                        {
                                            <button class="action-btn" onclick="updateStatus(@x.LeaveApplicationId, 'Approved')" style="color: #22c55e;" title="Approve">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="action-btn" onclick="updateStatus(@x.LeaveApplicationId, 'Rejected')" style="color: #ef4444;" title="Reject">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                            <button class="action-btn" onclick="cancelApplication(@x.LeaveApplicationId)" style="color: #f59e0b;" title="Withdraw Request">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        }
                                        else if (x.Status == "Approved")
                                        {
                                            <button class="action-btn" onclick="cancelApplication(@x.LeaveApplicationId)" style="color: #f59e0b;" title="Cancel Leave">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span style="font-size: 11px; color: var(--text-muted); font-style: italic;">@x.Status</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No leave requests found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="custom-modal" id="applyModal">
    <div class="custom-modal-box">
        <div class="modal-header-custom">
            <div>
                <h3>Apply For Leave</h3>
                <p>Submit a new employee time-off request.</p>
            </div>
            <button class="close-modal-btn" onclick="closeApplyModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body-custom">
            <div class="form-group">
                <label>Employee *</label>
                <select class="custom-select" id="applyEmployeeId" asp-items="ViewBag.EmployeeList">
                    <option value="">Select Employee</option>
                </select>
            </div>
            <div class="form-group">
                <label>Leave Type *</label>
                <select class="custom-select" id="applyLeaveTypeId" asp-items="ViewBag.LeaveTypeList">
                    <option value="">Select Leave Type</option>
                </select>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label>Start Date *</label>
                    <input type="date" class="custom-input" id="applyStartDate" />
                </div>
                <div class="form-group">
                    <label>End Date *</label>
                    <input type="date" class="custom-input" id="applyEndDate" />
                </div>
            </div>
            <div class="form-group">
                <label>Reason *</label>
                <textarea class="custom-input" id="applyReason" placeholder="Provide explanation..."></textarea>
            </div>
        </div>
        <div class="modal-footer-custom">
            <button class="cancel-btn" onclick="closeApplyModal()">Cancel</button>
            <button class="save-btn" onclick="submitLeaveRequest()"><i class="bi bi-check2-circle"></i> Submit Request</button>
        </div>
    </div>
</div>

<script>
    function openApplyModal() {
        document.getElementById('applyEmployeeId').value = '';
        document.getElementById('applyLeaveTypeId').value = '';
        document.getElementById('applyStartDate').value = '';
        document.getElementById('applyEndDate').value = '';
        document.getElementById('applyReason').value = '';
        document.getElementById('applyModal').classList.add('active');
    }

    function closeApplyModal() {
        document.getElementById('applyModal').classList.remove('active');
    }

    async function submitLeaveRequest() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const payload = {
            employeeId: parseInt(document.getElementById('applyEmployeeId').value) || 0,
            leaveTypeId: parseInt(document.getElementById('applyLeaveTypeId').value) || 0,
            startDate: document.getElementById('applyStartDate').value,
            endDate: document.getElementById('applyEndDate').value,
            reason: document.getElementById('applyReason').value.trim()
        };

        if (!payload.employeeId || !payload.leaveTypeId || !payload.startDate || !payload.endDate || !payload.reason) {
            alert('Please fill out all fields.');
            return;
        }

        try {
            const res = await fetch('/Leave/SubmitApplication', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
                closeApplyModal();
                location.reload();
            } else {
                alert(result.message || 'Submission failed.');
            }
        } catch (err) {
            console.error('Error:', err);
        }
    }

    async function updateStatus(id, status) {
        if (!confirm(`Mark request as ${status}?`)) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const res = await fetch(`/Leave/UpdateRequestStatus?id=${id}&status=${status}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) location.reload();
        } catch (err) {
            console.error('Error:', err);
        }
    }

    async function cancelApplication(id) {
        if (!confirm('Are you sure you want to cancel/withdraw this leave request?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const res = await fetch(`/Leave/CancelApplication?id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert(result.message || 'Cancellation failed.');
            }
        } catch (err) {
            console.error('Cancel error:', err);
        }
    }
</script>