<html lang="en" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - VeltriQ</title>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg: #0d1117;
            --sidebar-bg: #0d1117;
            --sidebar-border: rgba(255,255,255,0.05);
            --sidebar-text: #6b7280;
            --card-bg: #161b22;
            --card-shadow: 0 1px 12px rgba(0,0,0,.28);
            --topbar-bg: #161b22;
            --text-primary: #f1f5f9;
            --text-secondary: #9ca3af;
            --text-muted: #6b7280;
            --border: #21262d;
            --input-bg: #0d1117;
            --hover-bg: rgba(124,58,237,.1);
            --purple: #7c3aed;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            overflow-x: hidden;
        }

        .main-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 220px;
            min-width: 220px;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            overflow-y: auto;
            z-index: 200;
            display: flex;
            flex-direction: column;
            padding: 16px 10px;
            border-right: 1px solid var(--sidebar-border);
            scrollbar-width: none;
        }

            .sidebar::-webkit-scrollbar {
                display: none;
            }

        .logo-section {
            padding: 0 8px 14px;
            border-bottom: 1px solid var(--sidebar-border);
            margin-bottom: 6px;
        }

        .logo-wrap {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .logo-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            flex-shrink: 0;
            background: linear-gradient(135deg,#6d28d9,#7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 800;
            color: #fff;
        }

        .logo-text {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -.3px;
        }

        .logo-sub {
            font-size: 10px;
            color: var(--sidebar-text);
            margin-top: 2px;
            opacity: .7;
            line-height: 1.3;
            padding-left: 1px;
        }

        .nav-section {
            flex: 1;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
        }

            .sidebar-menu li {
                margin-bottom: 1px;
            }

            .sidebar-menu a {
                text-decoration: none;
                color: var(--sidebar-text);
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 9px 10px;
                border-radius: 10px;
                font-size: 13px;
                font-weight: 500;
                transition: .2s ease;
            }

                .sidebar-menu a:hover {
                    background: var(--hover-bg);
                    color: #fff;
                }

                .sidebar-menu a.active {
                    background: linear-gradient(90deg,#6d28d9,#7c3aed);
                    color: #fff;
                    box-shadow: 0 4px 14px rgba(109,40,217,.3);
                }

            .sidebar-menu i {
                font-size: 14px;
                width: 16px;
                min-width: 16px;
            }

        .chevron {
            margin-left: auto;
            font-size: 10px;
            opacity: .4;
        }

        .nav-badge {
            margin-left: auto;
            background: #7c3aed;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 20px;
            min-width: 20px;
            text-align: center;
        }

        .quick-section {
            padding-top: 10px;
            border-top: 1px solid var(--sidebar-border);
            margin-top: 8px;
        }

        .quick-title {
            font-size: 9.5px;
            text-transform: uppercase;
            letter-spacing: 1.1px;
            color: var(--sidebar-text);
            opacity: .5;
            margin-bottom: 4px;
            padding: 0 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .q-plus {
            background: rgba(255,255,255,.07);
            border: none;
            color: #fff;
            width: 18px;
            height: 18px;
            border-radius: 5px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
        }

        .quick-link {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--sidebar-text);
            text-decoration: none;
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 12.5px;
            transition: background .15s,color .15s;
        }

            .quick-link:hover {
                background: var(--hover-bg);
                color: #fff;
            }

            .quick-link i {
                font-size: 13px;
            }

        /* CONTENT */

        .content-area {
            margin-left: 220px;
            width: calc(100% - 220px);
            padding: 16px 20px;
            min-height: 100vh;
        }

        /* TOPBAR */

        .topbar {
            background: var(--topbar-bg);
            border-radius: 13px;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--card-shadow);
            margin-bottom: 16px;
            border: 1px solid var(--border);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 18px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .search-box {
            width: 330px;
            position: relative;
        }

            .search-box input {
                width: 100%;
                border: 1.5px solid var(--border);
                background: var(--input-bg);
                border-radius: 10px;
                padding: 8px 14px 8px 36px;
                font-size: 13px;
                color: var(--text-primary);
                outline: none;
            }

            .search-box i {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                left: 12px;
                color: var(--text-muted);
                font-size: 13px;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .tb-icon {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-secondary);
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            position: relative;
        }

        .notif-dot {
            position: absolute;
            top: 4px;
            right: 4px;
            background: #7c3aed;
            color: #fff;
            font-size: 8px;
            font-weight: 800;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .tb-sep {
            width: 1px;
            height: 24px;
            background: var(--border);
            margin: 0 4px;
        }

        .profile-pill {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px;
            border-radius: 9px;
            cursor: pointer;
        }

            .profile-pill img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #7c3aed;
            }

        .p-name {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .p-role {
            font-size: 10.5px;
            color: var(--text-muted);
        }

        .float-settings {
            position: fixed;
            bottom: 22px;
            right: 22px;
            z-index: 999;
        }

        .float-btn {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg,#6d28d9,#7c3aed);
            border: none;
            border-radius: 13px;
            color: #fff;
            font-size: 19px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(109,40,217,.4);
        }
        /* DROPDOWN MENU */

        .menu-dropdown {
            margin-bottom: 4px;
        }

        .dropdown-toggle {
            width: 100%;
            display: flex !important;
            align-items: center;
            gap: 8px;
        }

            .dropdown-toggle .dropdown-icon {
                margin-left: auto;
            }

        .menu-left {
            display: contents;
        }

        .dropdown-icon {
            font-size: 11px;
            transition: .25s ease;
        }

        .menu-dropdown.active .dropdown-icon {
            transform: rotate(180deg);
        }

        /* SUBMENU */

        .submenu {
            list-style: none;
            padding-left: 18px;
            margin-top: 4px;
            display: none;
        }

        .menu-dropdown.active .submenu {
            display: block;
        }

        .submenu li {
            margin-bottom: 2px;
        }

        .submenu a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 8px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 12px;
            transition: .2s ease;
        }

            .submenu a:hover {
                background: rgba(124,58,237,.12);
                color: #fff;
            }

        .submenu i {
            font-size: 12px;
        }
    </style>
</head>

