
@model VeltriQ.ViewModels.ManpowerRequestViewModel

@{
    ViewData["Title"] = "Create Recruitment Request";
}

<style>
    .recruitment-page {
        width: 100%;
        padding: 10px;
    }

    /* Header with Top-Right Buttons */
    .recruitment-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .recruitment-header-text h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .recruitment-header-text p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    /* Container Card Styling matching standard token layouts */
    .recruitment-card {
        background: rgba(30, 35, 44, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 24px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        width: 100% !important;
        height: 44px;
        background-color: #0d1117 !important;
        border: 1px solid #2a3441 !important;
        color: #fff !important;
        border-radius: 10px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #7c3aed !important;
            box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.1);
        }

    textarea.form-control {
        height: auto;
        padding-top: 12px;
    }

    /* Standardized Card/Grid Sections */
    .section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #7c3aed;
        margin-bottom: 20px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(124, 58, 237, 0.2);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Button Tokens */
    .btn-cancel {
        height: 42px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        border-radius: 10px;
        background: rgba(255,255,255,0.05);
        color: #fff;
        border: 1px solid rgba(255,255,255,0.1);
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.2s;
    }

        .btn-cancel:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
        }

    .btn-submit {
        height: 42px;
        padding: 0 25px;
        border-radius: 10px;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        border: none;
        font-weight: 700;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);
        transition: transform 0.2s;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
            color: #fff;
        }
</style>

<div class="recruitment-page">
    <form id="recruitmentForm" asp-action="Create" method="post">

        <div class="recruitment-header">
            <div class="recruitment-header-text">
                <h2>Recruitment Request</h2>
                <p>Create manpower recruitment request</p>
            </div>

            <div class="header-actions">
                <a href="@Url.Action("Index")" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">
                    <i class="bi bi-check2-circle"></i> Submit Request
                </button>
            </div>
        </div>

        <div class="recruitment-card">
            <div class="row">

                <div class="col-12">
                    <div class="section-title">
                        <i class="bi bi-file-earmark-person"></i> Request Information
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Request Date</label>
                        <input asp-for="RequestDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Recruitment Type</label>
                        <select asp-for="RecruitmentTypeId" asp-items="Model.RecruitmentTypes" class="form-select" id="recruitmentType">
                            <option value="">Select Type</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Number Of Positions</label>
                        <input asp-for="NumberOfPositions" class="form-control" type="number" min="1" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Department</label>
                        <select asp-for="DepartmentId" asp-items="Model.DepartmentList" class="form-select">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Designation</label>
                        <select asp-for="DesignationId" asp-items="Model.DesignationList" class="form-select">
                            <option value="">Select Designation</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Required Joining Date</label>
                        <input asp-for="RequiredJoiningDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="col-12" id="replacementSection" style="display:none; margin-top: 10px;">
                    <div class="section-title" style="color: #f59e0b; border-bottom-color: rgba(245, 158, 11, 0.2);">
                        <i class="bi bi-arrow-counterclockwise"></i> Replacement Information
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Employee No</label>
                                <select asp-for="ReplacementEmployeeId" asp-items="Model.EmployeeList" class="form-select" id="employeeDropdown">
                                    <option value="">Select Employee</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Remarks</label>
                                <input asp-for="Remarks" class="form-control" placeholder="Enter context or justification details..." />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-3">
                    <div class="section-title">
                        <i class="bi bi-sliders"></i> Candidate Requirements
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Min Experience (Yrs)</label>
                        <input asp-for="MinExperience" class="form-control" type="number" step="0.5" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Max Experience (Yrs)</label>
                        <input asp-for="MaxExperience" class="form-control" type="number" step="0.5" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Min Age</label>
                        <input asp-for="MinAge" class="form-control" type="number" />
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Max Age</label>
                        <input asp-for="MaxAge" class="form-control" type="number" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Education</label>
                        <select asp-for="EducationId" asp-items="Model.EducationList" class="form-select">
                            <option value="">Select Education</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Nationality</label>
                        <select asp-for="NationalityId" asp-items="Model.NationalityList" class="form-select">
                            <option value="">Select Nationality</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label class="form-label">Priority</label>
                        <select asp-for="PriorityId" asp-items="Model.PriorityList" class="form-select">
                            <option value="">Select Priority</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Min Salary</label>
                        <input asp-for="MinSalary" class="form-control" type="number" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">Max Salary</label>
                        <input asp-for="MaxSalary" class="form-control" type="number" />
                    </div>
                </div>

                <div class="col-12 mt-3">
                    <div class="section-title">
                        <i class="bi bi-briefcase"></i> Job Details Description
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Required Skills</label>
                        <textarea asp-for="RequiredSkills" class="form-control" rows="2" placeholder="List core technical competencies..."></textarea>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <label class="form-label">Job Description</label>
                        <textarea asp-for="JobDescription" class="form-control" rows="4" placeholder="Detail standard daily operations, key target expectations, and workflow responsibilities..."></textarea>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        toggleReplacementSection();

        $("#recruitmentType").change(function () {
            toggleReplacementSection();
        });
    });

    function toggleReplacementSection() {
        let type = $("#recruitmentType").val();

        // Checks dynamic conditions matching target database primary keys
        if (type == "2" || type == "3") {
            $("#replacementSection").slideDown();
            $("#employeeDropdown").prop("disabled", false);
        }
        else {
            $("#replacementSection").slideUp();
            $("#employeeDropdown").prop("disabled", true);
            $("#employeeDropdown").val("");
        }
    }
</script>

