@model VeltriQ.ViewModels.ManpowerRequestViewModel

@{
    ViewData["Title"] = "Create Recruitment Request";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .template-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-bottom: 30px;
    }

    .validation-summary-box {
        font-size: 11.5px;
        color: #ef4444;
        margin-bottom: 12px;
        font-weight: 600;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 8px 12px;
        border-radius: 4px;
    }

    /* ── HEADER BACK TO LIST NAVIGATION ACTION ── */
    .form-action-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT SYSTEM BUTTON CONTROLS ── */
    .form-action-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: none;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

    .btn-submit-theme {
        background: var(--purple);
        color: #fff;
    }

        .btn-submit-theme:hover {
            opacity: 0.9;
            color: #fff;
        }

    .btn-cancel-theme {
        background: var(--hover-bg);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

        .btn-cancel-theme:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    .form-footer-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--border);
    }

    /* ── SQUARED SINGLE-PANEL CONTAINER CARD DECK ── */
    .custom-form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px; /* Branded strict crisp layout corners */
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
    }

    .custom-form-header {
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
    }

        .custom-form-header h5 {
            margin: 0;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

    .custom-form-body {
        padding: 16px;
        background: var(--card-bg);
    }

    .form-grid-row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -8px;
        margin-left: -8px;
    }

    .form-grid-col-3 {
        flex: 0 0 25%;
        max-width: 25%;
        padding: 0 8px;
    }

    .form-grid-col-4 {
        flex: 0 0 33.3333%;
        max-width: 33.3333%;
        padding: 0 8px;
    }

    .form-grid-col-6 {
        flex: 0 0 50%;
        max-width: 50%;
        padding: 0 8px;
    }

    .form-grid-col-12 {
        flex: 0 0 100%;
        max-width: 100%;
        padding: 0 8px;
    }

    .form-field-group {
        margin-bottom: 12px;
        position: relative;
    }

    .custom-form-label {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 10px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .custom-form-label span {
            color: #ef4444;
            margin-left: 2px;
        }

    .custom-form-control {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--purple);
        }

    textarea.custom-form-control {
        height: auto;
        padding: 8px 10px;
        resize: vertical;
    }

    select.custom-form-control {
        padding-right: 24px;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%239ca3af' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 12px 12px;
    }

    .validation-err-text {
        font-size: 10.5px;
        color: #ef4444;
        font-weight: 500;
        margin-top: 2px;
        display: block;
    }

    @@media (max-width: 768px) {
        .form-grid-col-3, .form-grid-col-4, .form-grid-col-6, .form-grid-col-12 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="template-create-page">
    @if (TempData["Error"] != null)
    {
        <div class="validation-summary-box" style="font-size:13px; margin-bottom:16px;">
            @TempData["Error"]
        </div>
    }
    <div class="form-action-header">
        <a href="@Url.Action("Index")" class="form-action-btn btn-cancel-theme">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <form id="recruitmentForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-box"></div>

        <div class="custom-form-card">
            <div class="custom-form-header">
                <h5>Request Information</h5>
            </div>
            <div class="custom-form-body">
                <div class="form-grid-row">
                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="RequestDate" class="custom-form-label">Request Date<span>*</span></label>
                        <input asp-for="RequestDate" type="date" class="custom-form-control" />
                        <span asp-validation-for="RequestDate" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="JobProfileId" class="custom-form-label">Job Profile <span>*</span></label>
                        <select asp-for="JobProfileId" asp-items="Model.JobProfileList" class="custom-form-control">
                            <option value="">-- Select Job Profile --</option>
                        </select>
                        <span asp-validation-for="JobProfileId" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="RecruitmentTypeId" class="custom-form-label">Recruitment Type<span>*</span></label>
                        <select asp-for="RecruitmentTypeId" asp-items="Model.RecruitmentTypes" class="custom-form-control" id="recruitmentType">
                            <option value="">Select Type</option>
                        </select>
                        <span asp-validation-for="RecruitmentTypeId" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="BranchId" class="custom-form-label">Branch<span>*</span></label>
                        <select asp-for="BranchId" asp-items="Model.BranchList" class="custom-form-control" id="BranchId">
                            <option value="">Select Branch</option>
                        </select>
                        <span asp-validation-for="BranchId" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="DepartmentId" class="custom-form-label">Department<span>*</span></label>
                        <select asp-for="DepartmentId" asp-items="Model.DepartmentList" class="custom-form-control" id="DepartmentId">
                            <option value="">Select Department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="DesignationId" class="custom-form-label">Designation<span>*</span></label>
                        <select asp-for="DesignationId" asp-items="Model.DesignationList" class="custom-form-control" id="DesignationId">
                            <option value="">Select Designation</option>
                        </select>
                        <span asp-validation-for="DesignationId" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="NumberOfPositions" class="custom-form-label">Number Of Positions<span>*</span></label>
                        <input asp-for="NumberOfPositions" class="custom-form-control" type="number" min="1" />
                        <span asp-validation-for="NumberOfPositions" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="RequiredJoiningDate" class="custom-form-label">Required Joining Date<span>*</span></label>
                        <input asp-for="RequiredJoiningDate" type="date" class="custom-form-control" />
                        <span asp-validation-for="RequiredJoiningDate" class="validation-err-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="custom-form-card" id="replacementSection" style="display:none;">
            <div class="custom-form-header" style="border-bottom-color: rgba(245, 158, 11, 0.15);">
                <h5 style="color: #fbbf24;">Replacement Information</h5>
            </div>
            <div class="custom-form-body">
                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="ReplacementEmployeeId" class="custom-form-label">Employee No</label>
                        <select asp-for="ReplacementEmployeeId" asp-items="Model.EmployeeList" class="custom-form-control" id="employeeDropdown">
                            <option value="">Select Employee</option>
                        </select>
                        <span asp-validation-for="ReplacementEmployeeId" class="validation-err-text"></span>
                    </div>
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="Remarks" class="custom-form-label">Remarks</label>
                        <input asp-for="Remarks" class="custom-form-control" placeholder="Enter context or justification details..." autocomplete="off" />
                        <span asp-validation-for="Remarks" class="validation-err-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="custom-form-card">
            <div class="custom-form-header">
                <h5>Candidate Requirements</h5>
            </div>
            <div class="custom-form-body">
                <div class="form-grid-row">
                    <div class="form-grid-col-3 form-field-group">
                        <label asp-for="MinExperience" class="custom-form-label">Min Experience (Yrs)</label>
                        <input asp-for="MinExperience" class="custom-form-control" type="number" step="0.5" />
                        <span asp-validation-for="MinExperience" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-3 form-field-group">
                        <label asp-for="MaxExperience" class="custom-form-label">Max Experience (Yrs)</label>
                        <input asp-for="MaxExperience" class="custom-form-control" type="number" step="0.5" />
                        <span asp-validation-for="MaxExperience" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-3 form-field-group">
                        <label asp-for="MinAge" class="custom-form-label">Min Age</label>
                        <input asp-for="MinAge" class="custom-form-control" type="number" />
                        <span asp-validation-for="MinAge" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-3 form-field-group">
                        <label asp-for="MaxAge" class="custom-form-label">Max Age</label>
                        <input asp-for="MaxAge" class="custom-form-control" type="number" />
                        <span asp-validation-for="MaxAge" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="EducationId" class="custom-form-label">Education</label>
                        <select asp-for="EducationId" asp-items="Model.EducationList" class="custom-form-control">
                            <option value="">Select Education</option>
                        </select>
                        <span asp-validation-for="EducationId" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="NationalityId" class="custom-form-label">Nationality</label>
                        <select asp-for="NationalityId" asp-items="Model.NationalityList" class="custom-form-control">
                            <option value="">Select Nationality</option>
                        </select>
                        <span asp-validation-for="NationalityId" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="PriorityId" class="custom-form-label">Priority</label>
                        <select asp-for="PriorityId" asp-items="Model.PriorityList" class="custom-form-control">
                            <option value="">Select Priority</option>
                        </select>
                        <span asp-validation-for="PriorityId" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="MinSalary" class="custom-form-label">Min Salary</label>
                        <input asp-for="MinSalary" class="custom-form-control" type="number" />
                        <span asp-validation-for="MinSalary" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="MaxSalary" class="custom-form-label">Max Salary</label>
                        <input asp-for="MaxSalary" class="custom-form-control" type="number" />
                        <span asp-validation-for="MaxSalary" class="validation-err-text"></span>
                    </div>
                </div>
            </div>
        </div>

  

        <div class="form-footer-actions">
            <button type="submit" class="form-action-btn btn-submit-theme">
                <i class="bi bi-check-circle"></i> Submit Request
            </button>

            <a href="@Url.Action("Index")" class="form-action-btn btn-cancel-theme">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
        </div>
    </form>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

                    $("#recruitmentForm").on("submit", function (e) {
            console.log("SUBMIT EVENT FIRED. defaultPrevented =", e.isDefaultPrevented());
            console.log("jQuery Validate says form is valid:", $(this).valid());
        });
            toggleReplacementSection();

            $("#recruitmentType").change(function () {
                toggleReplacementSection();
            });

            // Branch Changed -> Load Departments
            $("#BranchId").change(function () {
                var branchId = $(this).val();
                $("#DepartmentId").html('<option value="">Select Department</option>');
                $("#DesignationId").html('<option value="">Select Designation</option>');

                if (branchId == "") return;

                $.get("/Recruitment/GetDepartments", { branchId: branchId }, function (data) {
                    $.each(data, function (i, item) {
                        $("#DepartmentId").append(
                            $("<option></option>").val(item.id).text(item.text)
                        );
                    });
                });
            });

            // Department Changed -> Load Designations
            $("#DepartmentId").change(function () {
                var departmentId = $(this).val();
                $("#DesignationId").html('<option value="">Select Designation</option>');

                if (departmentId == "") return;

                $.get('/Recruitment/GetDesignations', { departmentId: departmentId }, function (data) {
                    $.each(data, function (i, item) {
                        $("#DesignationId").append(
                            $('<option></option>').val(item.id).text(item.text)
                        );
                    });
                });
            });
        });

        function toggleReplacementSection() {
            let type = $("#recruitmentType").val();
            if (type == "2" || type == "3") {
                $("#replacementSection").slideDown();
                $("#employeeDropdown").prop("disabled", false);
            } else {
                $("#replacementSection").slideUp();
                $("#employeeDropdown").prop("disabled", true);
                $("#employeeDropdown").val("");
            }
        }
    </script>
}