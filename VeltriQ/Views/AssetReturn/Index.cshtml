@model IEnumerable<VeltriQ.ViewModels.AssetReturn.AssetReturnIndexViewModel>

@{
    ViewData["Title"] = "Active Allocations (Returns Workspace)";
}

<style>
    .return-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── MAX HEIGHT PANEL CARD WITH SQUARED EDGES ── */
    .return-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 60px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .return-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .return-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .return-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── SYSTEM SEARCH BAR ── */
    .return-search {
        width: 280px;
        position: relative;
    }

        .return-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .return-search input:focus {
                border-color: var(--purple);
            }

        .return-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── HIGH DENSITY SCROLLABLE MATRIX GRID ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .return-table {
        width: 100%;
        border-collapse: collapse;
    }

        .return-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .return-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .return-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── HIGH-DENSITY PROFILE IDENTITIES ── */
    .entity-profile-block {
        display: flex;
        flex-direction: column;
    }

    .entity-master-name {
        font-weight: 600;
        line-height: 1.2;
    }

    .entity-sub-code {
        font-size: 10.5px;
        color: var(--text-muted);
        font-weight: 700;
        margin-top: 1px;
    }

    /* ── ACCORDANT FRAMEWORK STATUS PILLS ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-allocated {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .badge-condition {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    /* ── ACTIONS WORKSPACE WORKFLOWS ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.btn-return-action {
            color: #eab308;
        }

            .action-btn.btn-return-action:hover {
                background: #eab308;
                color: #fff;
            }
</style>

<div class="return-page">

    <div class="return-card">
        <div class="return-card-top">
            <div class="return-card-title">
                <h3>Active Custody Logs</h3>
                <p>Select an active employee allocation row below to initiate the warehouse return process.</p>
            </div>

            <div class="return-search">
                <i class="bi bi-search"></i>
                <input type="text" id="returnSearchInput" placeholder="Search parameters..." onkeyup="filterReturnTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="return-table" id="returnTable">
                <thead>
                    <tr>
                        <th>Custodian Employee</th>
                        <th>Inventory Reference</th>
                        <th>Asset Blueprint</th>
                        <th>Serial No</th>
                        <th>Issue Handover Date</th>
                        <th>Current Condition</th>
                        <th style="text-align: center; width: 90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="entity-profile-block">
                                        <span class="entity-master-name">@item.EmployeeName</span>
                                        <span class="entity-sub-code">@item.EmployeeCode</span>
                                    </div>
                                </td>

                                <td style="font-weight: 700; color: var(--text-primary);">
                                    @item.InventoryCode
                                </td>

                                <td>
                                    <div class="entity-profile-block">
                                        <span class="entity-master-name">@item.AssetName</span>
                                        <span class="entity-sub-code">@item.AssetCode</span>
                                    </div>
                                </td>

                                <td style="font-family: monospace; font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(item.SerialNumber) ? "N/A" : item.SerialNumber)
                                </td>

                                <td style="color: var(--text-secondary);">
                                    @(item.IssueDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>

                                <td>
                                    <span class="status-badge badge-condition">@item.AssetCondition</span>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a href="/AssetInventory/Details/@item.AssetInventoryId" class="action-btn" title="Inspect Asset specifications"><i class="bi bi-eye"></i></a>
                                        <a href="/AssetReturn/Return/@item.EmployeeAssetId" class="action-btn btn-return-action" title="Process Handover Return"><i class="bi bi-arrow-counterclockwise"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No active employee custody allocations require returns processing inside system channels.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterReturnTable() {
        const input = document.getElementById('returnSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('returnTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>