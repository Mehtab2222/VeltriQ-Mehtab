@model IEnumerable<VeltriQ.Models.HR.Employee>

@{
    ViewData["Title"] = "Employees";
}

<style>
    .employee-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .employee-header {
        display: flex;
        justify-content: flex-end; /* Aligns button to right cleanly without big text */
        align-items: center;
        margin-bottom: 12px; /* Reduced to push card up */
    }

    /* ── COMPACT ADD BUTTON ── */
    .employee-add-btn {
        height: 34px; /* Scaled down height */
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px; /* Slightly smaller typography */
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .employee-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .employee-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        /* Strict max-height constraint calculated based on remaining viewport space */
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .employee-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px; /* Compressed padding */
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .employee-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .employee-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── SEARCH BAR ── */
    .employee-search {
        width: 280px;
        position: relative;
    }

        .employee-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .employee-search input:focus {
                border-color: var(--purple);
            }

        .employee-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        /* Invisible scrollbars for modern browsers */
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }

        .table-wrapper::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
    }

        .employee-table th {
            text-align: left;
            padding: 10px 16px; /* Compact padding */
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .employee-table td {
            padding: 8px 16px; /* Significantly reduced row height */
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .employee-table tbody tr {
            transition: background-color .1s ease;
        }

            .employee-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── COMPACT IDENTITY PLATFORMS ── */
    .employee-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .employee-avatar {
        width: 32px; /* Smaller avatars */
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 11px;
        flex-shrink: 0;
    }

    .employee-name {
        font-weight: 600;
        margin-bottom: 1px;
        line-height: 1.2;
    }

    .employee-profile-link {
        color: var(--text-primary);
        text-decoration: none;
    }

        .employee-profile-link:hover {
            color: var(--purple);
        }

    .employee-code {
        font-size: 10.5px;
        color: var(--text-muted);
        line-height: 1;
    }

    /* ── BADGES & CONTROLS ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .table-actions {
        display: flex;
        gap: 4px;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="employee-page">

    <div class="employee-header">
        <a href="/Employee/Create" class="employee-add-btn">
            <i class="bi bi-plus-lg"></i>
            Add Employee
        </a>
    </div>

    <div class="employee-card">

        <div class="employee-card-top">
            <div class="employee-card-title">
                <h3>Employee Directory</h3>
                <p>Total Records: @Model.Count()</p>
            </div>

            <div class="employee-search">
                <i class="bi bi-search"></i>
                <input type="text" id="empSearchInput" placeholder="Search employees..." onkeyup="filterEmployeesTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="employee-table" id="empTable">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Branch</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="employee-info">
                                    <div class="employee-avatar">
                                        @(item.FirstName?.Substring(0, 1).ToUpper())@(item.LastName?.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="employee-name">
                                            <a href="/Employee/Profile/@item.EmployeeId" class="employee-profile-link">
                                                @item.FirstName @item.LastName
                                            </a>
                                        </div>
                                        <div class="employee-code">@item.EmployeeCode</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Branch?.BranchName</td>
                            <td>@item.Department?.DepartmentName</td>
                            <td>@item.Designation?.DesignationName</td>
                            <td>@(item.JoiningDate?.ToString("dd MMM yyyy"))</td>
                            <td><span class="status-badge status-active">@item.EmployeeStatus</span></td>
                            <td>
                                <div class="table-actions">
                                    <a href="/Employee/Profile/@item.EmployeeId" class="action-btn" title="View Profile"><i class="bi bi-eye"></i></a>
                                    <a href="/Employee/Edit/@item.EmployeeId" class="action-btn" title="Edit Entry"><i class="bi bi-pencil"></i></a>
                                    <a href="/Employee/Delete/@item.EmployeeId" class="action-btn delete-btn" title="Deactivate" onclick="return confirm('Are you sure?')"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterEmployeesTable() {
        const input = document.getElementById('empSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('empTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            // Evaluates Identity Strings, Branches, and Departments for match validation
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>