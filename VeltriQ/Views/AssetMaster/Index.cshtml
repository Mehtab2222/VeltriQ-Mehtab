@model IEnumerable<VeltriQ.Models.HR.AssetMaster>

@{
    ViewData["Title"] = "Asset Master";
}

<style>
    .asset-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .asset-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .asset-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .asset-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .asset-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .asset-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .asset-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .asset-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .asset-search-wrapper {
        position: relative;
        width: 320px;
    }

        .asset-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .asset-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .asset-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .asset-table {
        width: 100%;
        border-collapse: collapse;
    }

        .asset-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .asset-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .asset-table tbody tr {
            transition: background-color .1s ease;
        }

            .asset-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .badge-required {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
    }

    .badge-returnable {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .badge-nonreturnable {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
    }

    /* ── INLINE ACTIONS (EDIT & TOGGLE WORKFLOWS) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.toggle-deactivate-btn {
            color: #22c55e;
        }

            .action-btn.toggle-deactivate-btn:hover {
                background: #ef4444;
                color: #fff;
            }

        .action-btn.toggle-activate-btn {
            color: #ef4444;
        }

            .action-btn.toggle-activate-btn:hover {
                background: #22c55e;
                color: #fff;
            }
</style>

<div class="asset-page">

    <div class="asset-header">
        <a href="/AssetMaster/Create" class="asset-add-btn">
            <i class="bi bi-plus-lg"></i> Add Asset
        </a>
    </div>

    <div class="asset-master-card">

        <div class="asset-card-top">
            <div class="asset-card-title">
                <h3>Asset Inventory</h3>
                <p>Total Records: <span id="assetCounter">@Model.Count()</span></p>
            </div>

            <div class="asset-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="assetSearchInput" placeholder="Search assets..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="asset-table" id="assetGridMatrix">
                <thead>
                    <tr>
                        <th>Asset Name</th>
                        <th>Asset Code</th>
                        <th>Asset Category</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Serial No</th>
                        <th>Returnable</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name" style="font-weight: 600;">
                                    @item.AssetName
                                </td>
                                <td data-search="code">
                                    <code>@item.AssetCode</code>
                                </td>
                                <td data-search="category">
                                    <span class="status-badge badge-category">
                                        @item.AssetCategory
                                    </span>
                                </td>
                                <td data-search="brand">
                                    @(string.IsNullOrWhiteSpace(item.BrandName) ? "-" : item.BrandName)
                                </td>
                                <td data-search="model">
                                    @(string.IsNullOrWhiteSpace(item.ModelName) ? "-" : item.ModelName)
                                </td>
                                <td>
                                    @if (item.SerialNumberRequired)
                                    {
                                        <span class="status-badge badge-required">Required</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-size: 12px; font-weight: 500; padding-left: 6px;">No</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsReturnable)
                                    {
                                        <span class="status-badge badge-returnable">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-nonreturnable">No</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/AssetMaster/Edit/@item.AssetMasterId" class="action-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (item.IsActive == true)
                                        {
                                            <a href="/AssetMaster/ToggleStatus/@item.AssetMasterId"
                                               class="action-btn toggle-deactivate-btn"
                                               title="Deactivate Asset"
                                               onclick="return confirm('Are you sure you want to deactivate this asset?')">
                                                <i class="bi bi-toggle-on" style="font-size: 14px;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/AssetMaster/ToggleStatus/@item.AssetMasterId"
                                               class="action-btn toggle-activate-btn"
                                               title="Activate Asset"
                                               onclick="return confirm('Are you sure you want to activate this asset?')">
                                                <i class="bi bi-toggle-off" style="font-size: 14px;"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("assetSearchInput");
        const matrixGrid = document.getElementById("assetGridMatrix");
        const counterTracker = document.getElementById("assetCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const categoryText = row.querySelector('[data-search="category"]')?.textContent.toLowerCase() || "";
                const brandText = row.querySelector('[data-search="brand"]')?.textContent.toLowerCase() || "";
                const modelText = row.querySelector('[data-search="model"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameText} ${codeText} ${categoryText} ${brandText} ${modelText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>