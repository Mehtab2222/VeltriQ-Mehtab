@model List<VeltriQ.ViewModels.SkillCategoryGroupViewModel>

@{
    ViewData["Title"] = "Skills & Categories";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .skill-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
    }

    /* ── UNIFIED MASTER SQUARE CARD MODULE ── */
    .skill-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        height: calc(100vh - var(--topbar-h) - 100px);
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .skill-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
        flex-shrink: 0;
        background: var(--card-bg);
    }

    .skill-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .skill-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* SPLIT TOP CREATION BAR WITH VERTICAL DIVIDER */
    .skill-creation-strip {
        background: var(--hover-bg);
        border-bottom: 1px solid var(--border);
        display: grid;
        grid-template-columns: 1fr 1px 1.5fr;
        align-items: center;
        flex-shrink: 0;
    }

    .creation-section-pane {
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .creation-section-pane label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

    .vertical-white-divider {
        width: 1px;
        height: 32px;
        background: var(--border);
    }

    .skill-input, .skill-select {
        height: 30px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s;
    }

        .skill-input:focus, .skill-select:focus {
            border-color: var(--purple);
        }

    .skill-btn {
        height: 30px;
        padding: 0 14px;
        border: none;
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: opacity 0.2s;
        white-space: nowrap;
    }

        .skill-btn:hover {
            opacity: 0.9;
        }

    /* TABLE CONTAINER & EXPANSIVE SPACING */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
    }

    .skills-table {
        width: 100%;
        border-collapse: collapse;
    }

        .skills-table th {
            text-align: left;
            padding: 12px 20px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .skills-table td {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .skills-table tbody tr {
            transition: background-color .1s ease;
        }

            .skills-table tbody tr:hover {
                background: var(--hover-bg);
            }

    .badge-category {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    /* RELAXED, UNCONGESTED SKILL CHIPS */
    .skill-chips-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .skill-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 12px;
        color: var(--text-primary);
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    .action-btns {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .btn-icon {
        height: 28px;
        width: 28px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 11.5px;
        transition: all 0.2s;
        text-decoration: none;
    }

        .btn-icon:hover {
            border-color: var(--purple);
            color: #fff;
            background: var(--purple);
        }

    .btn-icon-danger:hover {
        border-color: #ef4444;
        background: #ef4444;
        color: #fff;
    }

    /* Inline Edit Inputs */
    .edit-input-field {
        height: 28px;
        border-radius: 4px;
        border: 1px solid var(--purple);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 8px;
        font-size: 12px;
        width: 100%;
        display: none;
        outline: none;
    }
</style>

<div class="skill-page">
    <div class="skill-master-card">

        <div class="skill-card-top">
            <div class="skill-card-title">
                <h3>Manage Skills & Categories</h3>
                <p>Create categories and assign individual skills or bulk create them efficiently.</p>
            </div>
        </div>

        <div class="skill-creation-strip">
            <div class="creation-section-pane">
                <label>Add Category</label>
                <form asp-action="AddCategory" asp-controller="Skill" method="post" style="display: flex; gap: 8px; align-items: center; flex: 1;">
                    <input type="text" name="categoryName" class="skill-input" placeholder="Category Name..." style="flex: 1;" required />
                    <button type="submit" class="skill-btn"><i class="bi bi-folder-plus"></i> Create</button>
                </form>
            </div>

            <div class="vertical-white-divider"></div>

            <div class="creation-section-pane">
                <label>Add Skill(s)</label>
                <form asp-action="AddSkill" asp-controller="Skill" method="post" style="display: flex; gap: 8px; align-items: center; flex: 1;">
                    <select name="jobCategoryId" class="skill-select" style="width: 160px;" required>
                        <option value="">Select Category</option>
                        @if (Model != null)
                        {
                            foreach (var cat in Model)
                            {
                                <option value="@cat.JobCategoryId">@cat.CategoryName</option>
                            }
                        }
                    </select>
                    <input type="text" name="skillName" class="skill-input" placeholder="Skill Name (comma-separated for bulk)" style="flex: 1;" required />
                    <button type="submit" class="skill-btn"><i class="bi bi-code-square"></i> Add Skill(s)</button>
                </form>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="skills-table">
                <thead>
                    <tr>
                        <th style="width: 25%;">Category Name</th>
                        <th style="width: 60%;">Skills Available</th>
                        <th style="width: 15%; text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cat in Model)
                        {
                            <tr>
                                <td>
                                    <span class="category-display-text-@cat.JobCategoryId">
                                        <span class="badge-category">@cat.CategoryName</span>
                                    </span>
                                    <form asp-action="EditCategory" asp-controller="Skill" method="post" style="display:inline;">
                                        <input type="hidden" name="jobCategoryId" value="@cat.JobCategoryId" />
                                        <input type="text" name="categoryName" value="@cat.CategoryName" class="edit-input-field category-edit-input-@cat.JobCategoryId" required />
                                    </form>
                                </td>

                                <td>
                                    @if (cat.Skills != null && cat.Skills.Any())
                                    {
                                        <div class="skill-chips-container">
                                            @foreach (var skill in cat.Skills)
                                            {
                                                <span class="skill-chip" id="skill-badge-@skill.SkillId">
                                                    <span class="skill-text-@skill.SkillId">@skill.SkillName</span>

                                                    <form asp-action="EditSkill" asp-controller="Skill" method="post" style="display:none;" id="skill-edit-form-@skill.SkillId">
                                                        <input type="hidden" name="skillId" value="@skill.SkillId" />
                                                        <input type="text" name="skillName" value="@skill.SkillName" class="edit-input-field" style="display:inline-block; width:100px; height:24px; font-size:11px;" required />
                                                        <button type="submit" style="background:none; border:none; color:#22c55e; cursor:pointer; padding:0 4px;"><i class="bi bi-check" style="font-size:14px;"></i></button>
                                                    </form>

                                                    <span style="display:inline-flex; gap:3px; margin-left:4px;">
                                                        <button type="button" class="btn-icon" style="height:22px; width:22px; font-size:10px;" onclick="toggleEditSkill(@skill.SkillId)" title="Edit Skill"><i class="bi bi-pencil"></i></button>
                                                        <a href="@Url.Action("DeleteSkill", "Skill", new { id = skill.SkillId })" class="btn-icon btn-icon-danger" style="height:22px; width:22px; font-size:10px;" onclick="return confirm('Are you sure you want to delete this skill?');" title="Delete Skill"><i class="bi bi-x"></i></a>
                                                    </span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-style: italic; font-size: 12px;">No skills added under this category.</span>
                                    }
                                </td>

                                <td style="text-align: right; padding-right: 24px;">
                                    <div class="action-btns" style="justify-content: flex-end;">
                                        <button type="button" class="btn-icon" onclick="toggleEditCategory(@cat.JobCategoryId)" title="Edit Category Name">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <a href="@Url.Action("DeleteCategory", "Skill", new { id = cat.JobCategoryId })" class="btn-icon btn-icon-danger" onclick="return confirm('Are you sure you want to delete this category and all its associated skills?');" title="Delete Category">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-muted); padding: 40px 0; font-style: italic;">
                                No skill categories found. Use the creation strip above to add new categories and skills.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<script>
    function toggleEditCategory(categoryId) {
        var $displaySpan = $('.category-display-text-' + categoryId);
        var $inputField = $('.category-edit-input-' + categoryId);

        if ($inputField.is(':hidden')) {
            $displaySpan.hide();
            $inputField.show().focus();
        } else {
            $inputField.parent('form').submit();
        }
    }

    function toggleEditSkill(skillId) {
        var $textSpan = $('.skill-text-' + skillId);
        var $editForm = $('#skill-edit-form-' + skillId);

        if ($editForm.is(':hidden')) {
            $textSpan.hide();
            $editForm.show();
            $editForm.find('input').focus();
        } else {
            $editForm.submit();
        }
    }
</script>