
@model IEnumerable<VeltriQ.Models.HR.HRContact>

@{
    ViewData["Title"] = "HR Contacts";
}

<style>
    .hrcontact-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .hrcontact-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .hrcontact-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .hrcontact-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .hrcontact-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .hrcontact-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .hrcontact-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .hrcontact-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .hrcontact-search-wrapper {
        position: relative;
        width: 320px;
    }

        .hrcontact-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .hrcontact-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .hrcontact-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .hrcontact-table {
        width: 100%;
        border-collapse: collapse;
    }

        .hrcontact-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .hrcontact-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .hrcontact-table tbody tr {
            transition: background-color .1s ease;
        }

            .hrcontact-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES & MODULES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-type {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
    }

    .badge-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .email-box {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #c4b5fd;
        background: rgba(124, 58, 237, .10);
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
    }

    /* ── INLINE ACTIONS (RIGHT ALIGNED) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="hrcontact-page">

    <div class="hrcontact-header">
        <a href="/HRContact/Create" class="hrcontact-add-btn">
            <i class="bi bi-plus-lg"></i> Add Contact
        </a>
    </div>

    <div class="hrcontact-card">

        <div class="hrcontact-card-top">
            <div class="hrcontact-card-title">
                <h3>Contact Directory</h3>
                <p>Total Records: <span id="contactCounter">@Model.Count()</span></p>
            </div>

            <div class="hrcontact-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="contactSearchInput" placeholder="Search contacts..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="hrcontact-table" id="contactTableMatrix">
                <thead>
                    <tr>
                        <th>Contact</th>
                        <th>Contact Code</th>
                        <th>Contact Type</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name" style="font-weight: 600;">
                                    @item.ContactName
                                </td>
                                <td data-search="code">
                                    <span style="color: var(--text-secondary); font-size: 11.5px; font-weight: 500;">
                                        @item.ContactCode
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge badge-type">
                                        @item.ContactType
                                    </span>
                                </td>
                                <td data-search="email">
                                    <span class="email-box">
                                        <i class="bi bi-envelope"></i> @item.EmailAddress
                                    </span>
                                </td>
                                <td data-search="phone">
                                    @(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "-" : item.PhoneNumber)
                                </td>
                                <td>
                                    <span class="status-badge badge-active">Active</span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/HRContact/Details/@item.HRContactId" class="action-btn" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/HRContact/Edit/@item.HRContactId" class="action-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/HRContact/Delete/@item.HRContactId" class="action-btn delete-btn" title="Delete Entry" onclick="return confirm('Are you sure?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("contactSearchInput");
        const matrixGrid = document.getElementById("contactTableMatrix");
        const counterTracker = document.getElementById("contactCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const emailText = row.querySelector('[data-search="email"]')?.textContent.toLowerCase() || "";
                const phoneText = row.querySelector('[data-search="phone"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameText} ${codeText} ${emailText} ${phoneText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>
