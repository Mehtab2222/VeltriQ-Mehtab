@model VeltriQ.Models.HR.Designation

@{
    ViewData["Title"] = "Create Designation";
}

<style>

    .designation-create-page {
        padding: 4px 0 32px;
    }

    /* TOPBAR */

    .designation-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        gap: 20px;
    }

    .designation-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
    }

        .designation-breadcrumb a {
            color: #8b5cf6;
            text-decoration: none;
            font-weight: 600;
        }

        .designation-breadcrumb span {
            color: #94a3b8;
        }

    .designation-top-actions {
        display: flex;
        gap: 10px;
    }

    .cancel-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        color: #94a3b8;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
    }

    .save-btn {
        height: 40px;
        padding: 0 20px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 22px rgba(124,58,237,.24);
    }

    /* CARD */

    .designation-card {
        background: rgba(30,35,44,.92);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 18px;
        overflow: hidden;
    }

    .designation-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .designation-card-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(124,58,237,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a78bfa;
    }

    .designation-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    /* BODY */

    .designation-card-body {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .full-width {
        grid-column: span 2;
    }

    /* FIELD */

    .form-field {
        display: flex;
        flex-direction: column;
    }

        .form-field label {
            margin-bottom: 7px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .7px;
            text-transform: uppercase;
        }

    /* INPUT */

    .form-input,
    .form-select {
        width: 100%;
        height: 42px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(15,20,30,.7);
        color: #e2e8f0;
        padding: 0 14px;
        font-size: 13px;
        outline: none;
    }

        .form-input:focus,
        .form-select:focus {
            border-color: #7c3aed;
            background: rgba(124,58,237,.06);
            box-shadow: 0 0 0 3px rgba(124,58,237,.12);
        }

</style>

<div class="designation-create-page">

    <!-- TOPBAR -->

    <div class="designation-topbar">

        <div class="designation-breadcrumb">

            <a href="/Designation/Index">
                Designations
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Create</span>

        </div>

        <div class="designation-top-actions">

            <a href="/Designation/Index"
               class="cancel-btn">

                <i class="bi bi-x"></i>

                Cancel

            </a>

            <button type="submit"
                    form="designationForm"
                    class="save-btn">

                <i class="bi bi-building-add"></i>

                Save Designation

            </button>

        </div>

    </div>

    <!-- FORM -->

    <form id="designationForm"
          asp-action="Create"
          method="post">

        <div class="designation-card">

            <div class="designation-card-header">

                <div class="designation-card-icon">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div class="designation-card-title">
                    Designation Information
                </div>

            </div>

            <div class="designation-card-body">

                <!-- DEPARTMENT -->

                <div class="form-field full-width">

                    <label>
                        Department
                    </label>

                    <select asp-for="DepartmentId"
                            asp-items="ViewBag.DepartmentList"
                            class="form-select">

                        <option value="">
                            Select Department
                        </option>

                    </select>

                </div>

                <!-- NAME -->

                <div class="form-field full-width">

                    <label>
                        Designation Name
                    </label>

                    <input asp-for="DesignationName"
                           class="form-input"
                           placeholder="Enter designation name" />

                </div>

                <!-- CODE -->

                <div class="form-field">

                    <label>
                        Designation Code
                    </label>

                    <input asp-for="DesignationCode"
                           class="form-input"
                           placeholder="DES-001" />

                </div>

                <!-- DESCRIPTION -->

                <div class="form-field">

                    <label>
                        Description
                    </label>

                    <input asp-for="Description"
                           class="form-input"
                           placeholder="Enter description" />

                </div>

            </div>

        </div>

    </form>

</div>