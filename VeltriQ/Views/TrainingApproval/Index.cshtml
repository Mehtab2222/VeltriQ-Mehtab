@{
    ViewData["Title"] = "Training Approval Review";
}

<style>
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .tra-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        gap: 12px;
    }

    .tra-back-btn {
        height: 30px;
        width: fit-content;
        padding: 0 12px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .15s ease;
        flex-shrink: 0;
    }

        .tra-back-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    /* SINGLE MASTER CARD */
    .tra-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        height: calc(100vh - var(--topbar-h) - 90px);
        max-height: calc(100vh - var(--topbar-h) - 90px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* UNIFIED INFO BAR — title + meta + seats + status, all in one strip */
    .tra-info-bar {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-shrink: 0;
    }

    .tra-info-left {
        min-width: 0;
        flex: 1;
    }

        .tra-info-left h2 {
            font-size: 16.5px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 6px 0;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

    .tra-req-no {
        font-family: monospace;
        font-size: 11px;
        font-weight: 700;
        color: var(--purple);
        background: rgba(124, 58, 237, 0.08);
        padding: 1px 7px;
        border-radius: 4px;
    }

    .tra-meta-line {
        font-size: 12px;
        color: var(--text-secondary);
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
    }

        .tra-meta-line b {
            color: var(--text-primary);
            font-weight: 600;
        }

        .tra-meta-line .sep {
            color: var(--border);
        }

    .tra-info-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        flex-shrink: 0;
    }

    .tra-status-pill {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
    }

    .pill-pending {
        background: rgba(245,158,11,.12);
        color: #f59e0b;
    }

    .pill-approved {
        background: rgba(34,197,94,.12);
        color: #22c55e;
    }

    .pill-rejected {
        background: rgba(239,68,68,.12);
        color: #ef4444;
    }

    .tra-seats-text {
        font-size: 11px;
        color: var(--text-secondary);
        white-space: nowrap;
    }

        .tra-seats-text b {
            color: var(--purple);
        }

    /* SPLIT BODY: ROSTER | ACTIONS */
    .tra-card-body {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 320px;
        overflow: hidden;
    }

    .tra-roster-section {
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border);
        overflow: hidden;
    }

    .tra-roster-toolbar {
        padding: 10px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

        .tra-roster-toolbar h5 {
            margin: 0;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            color: var(--text-secondary);
        }

            .tra-roster-toolbar h5 span {
                color: var(--purple);
            }

    .tra-add-emp-btn {
        height: 26px;
        padding: 0 10px;
        border-radius: 4px;
        border: 1px dashed var(--purple);
        background: transparent;
        color: var(--purple);
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all .15s ease;
    }

        .tra-add-emp-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    .tra-roster-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 10px 20px;
    }

    /* ADD SEARCH */
    .tra-add-search-wrap {
        position: relative;
        margin-bottom: 10px;
        display: none;
    }

        .tra-add-search-wrap input {
            width: 100%;
            height: 32px;
            border-radius: 5px;
            border: 1px solid var(--purple);
            background: var(--input-bg);
            padding: 0 10px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
        }

    .tra-add-dropdown {
        position: absolute;
        top: 36px;
        left: 0;
        right: 0;
        max-height: 200px;
        overflow-y: auto;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 5px;
        box-shadow: 0 6px 16px rgba(0,0,0,.2);
        z-index: 50;
        display: none;
    }

    .tra-add-option {
        padding: 8px 10px;
        font-size: 11.5px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        color: var(--text-primary);
    }

        .tra-add-option:hover {
            background: var(--hover-bg);
        }

        .tra-add-option span {
            color: var(--text-muted);
            font-size: 10px;
        }

    /* EMPLOYEE ROW — plain list, not individually carded */
    .tra-emp-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 4px;
        border-bottom: 1px solid var(--border);
    }

        .tra-emp-row:last-child {
            border-bottom: none;
        }

    .tra-emp-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .tra-emp-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: rgba(124,58,237,.12);
        color: var(--purple);
        font-size: 10.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tra-emp-text h5 {
        margin: 0;
        font-size: 12px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .tra-emp-text p {
        margin: 1px 0 0 0;
        font-size: 10.5px;
        color: var(--text-secondary);
    }

    .tra-emp-code {
        font-family: monospace;
        color: var(--purple);
        font-weight: 700;
    }

    .tra-emp-remove {
        width: 22px;
        height: 22px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .15s ease;
        flex-shrink: 0;
    }

        .tra-emp-remove:hover {
            background: #ef4444;
            color: #fff;
            border-color: #ef4444;
        }

    .tra-empty-note {
        text-align: center;
        color: var(--text-muted);
        font-style: italic;
        font-size: 12px;
        padding: 24px 10px;
    }

    /* RIGHT ACTION SECTION — no inner card wrappers, just spaced blocks */
    .tra-action-section {
        display: flex;
        flex-direction: column;
        padding: 18px 20px;
        gap: 16px;
        overflow-y: auto;
    }

    .tra-action-block label {
        display: block;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        color: var(--text-muted);
        margin-bottom: 6px;
    }

    .tra-reason-text {
        font-size: 12.5px;
        color: var(--text-primary);
        line-height: 1.5;
    }

    .tra-remarks-textarea {
        width: 100%;
        min-height: 90px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        padding: 10px;
        color: var(--text-primary);
        font-size: 12px;
        outline: none;
        resize: vertical;
    }

        .tra-remarks-textarea:focus {
            border-color: var(--purple);
        }

    .tra-action-footer {
        margin-top: auto;
        display: flex;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid var(--border);
    }

    .tra-btn {
        flex: 1;
        height: 38px;
        border-radius: 6px;
        border: none;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: opacity .15s ease;
    }

        .tra-btn:hover {
            opacity: .88;
        }

        .tra-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

    .tra-btn-approve {
        background: #22c55e;
        color: #fff;
    }

    .tra-btn-reject {
        background: transparent;
        color: #ef4444;
        border: 1px solid rgba(239,68,68,.4) !important;
    }

    .tra-processed-note {
        text-align: center;
        font-size: 12px;
        color: var(--text-muted);
        padding: 14px;
        border: 1px dashed var(--border);
        border-radius: 6px;
    }

    /* CONFIRM DIALOG */
    .tra-confirm-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 3000;
        display: none;
        align-items: center;
        justify-content: center;
    }

    .tra-confirm-box {
        width: 360px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 12px 30px rgba(0,0,0,.3);
    }

        .tra-confirm-box h4 {
            margin: 0 0 6px 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .tra-confirm-box p {
            margin: 0 0 16px 0;
            font-size: 12px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

    .tra-confirm-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .tra-confirm-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 5px;
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        border: 1px solid var(--border);
    }

    .tra-confirm-cancel {
        background: var(--hover-bg);
        color: var(--text-primary);
    }

    .tra-confirm-ok-approve {
        background: #22c55e;
        color: #fff;
        border-color: #22c55e;
    }

    .tra-confirm-ok-reject {
        background: #ef4444;
        color: #fff;
        border-color: #ef4444;
    }
</style>

@Html.AntiForgeryToken()

<div class="tra-page">

    <button type="button" class="tra-back-btn" onclick="window.location.href='/TransactionApproval/Index'">
        <i class="bi bi-arrow-left"></i> Back to Approvals
    </button>

    <div class="tra-master-card">

        <!-- UNIFIED INFO BAR -->
        <div class="tra-info-bar">
            <div class="tra-info-left">
                <h2>
                    <span id="traTrainingName">Loading...</span>
                    <span class="tra-req-no" id="traRequestNo"></span>
                </h2>
                <div class="tra-meta-line">
                    <span>Requested by <b id="traRequestedBy">—</b></span>
                    <span class="sep">|</span>
                    <span>Date: <b id="traRequestDate">—</b></span>
                    <span class="sep">|</span>
                    <span>Code: <b id="traScheduleCode">—</b></span>
                    <span class="sep">|</span>
                    <span>Trainer: <b id="traTrainer">—</b></span>
                    <span class="sep">|</span>
                    <span>Venue: <b id="traVenue">—</b></span>
                    <span class="sep">|</span>
                    <span>Schedule: <b id="traSchedule">—</b></span>
                </div>
            </div>
            <div class="tra-info-right">
                <span class="tra-status-pill pill-pending" id="traStatusPill">Pending</span>
                <span class="tra-seats-text" id="traSeatsLabel">— seats</span>
            </div>
        </div>

        <!-- SPLIT BODY -->
        <div class="tra-card-body">

            <!-- ROSTER -->
            <div class="tra-roster-section">
                <div class="tra-roster-toolbar">
                    <h5>Requested Employees (<span id="traEmpCount">0</span>)</h5>
                    <button type="button" class="tra-add-emp-btn" onclick="toggleAddEmployeeSearch()">
                        <i class="bi bi-plus-lg"></i> Add Employee
                    </button>
                </div>
                <div class="tra-roster-scroll">
                    <div class="tra-add-search-wrap" id="traAddSearchWrap">
                        <input type="text" id="traAddSearchInput" placeholder="Search employees to add..." oninput="filterAddableEmployees()" autocomplete="off" />
                        <div class="tra-add-dropdown" id="traAddDropdown"></div>
                    </div>
                    <div id="traEmployeeList"></div>
                </div>
            </div>

            <!-- ACTIONS -->
            <div class="tra-action-section">
                <div class="tra-action-block">
                    <label>Reason / Notes from Requester</label>
                    <p class="tra-reason-text" id="traReasonText">—</p>
                </div>

                <div class="tra-action-block" id="traDecisionArea" style="flex:1;">
                    <label>Approval Remarks (optional)</label>
                    <textarea id="traRemarksInput" class="tra-remarks-textarea" placeholder="Add a note for this decision..."></textarea>
                </div>

                <div class="tra-action-footer" id="traActionButtons">
                    <button type="button" class="tra-btn tra-btn-reject" onclick="requestDecision('reject')">
                        <i class="bi bi-x-lg"></i> Reject
                    </button>
                    <button type="button" class="tra-btn tra-btn-approve" onclick="requestDecision('approve')">
                        <i class="bi bi-check-lg"></i> Approve & Enroll
                    </button>
                </div>

                <div id="traAlreadyProcessedNote" class="tra-processed-note" style="display:none;"></div>
            </div>

        </div>
    </div>
</div>

<!-- CONFIRM DIALOG -->
<div class="tra-confirm-backdrop" id="traConfirmBackdrop">
    <div class="tra-confirm-box">
        <h4 id="traConfirmTitle">Confirm Action</h4>
        <p id="traConfirmMessage"></p>
        <div class="tra-confirm-actions">
            <button type="button" class="tra-confirm-btn tra-confirm-cancel" onclick="closeConfirmDialog()">Cancel</button>
            <button type="button" class="tra-confirm-btn" id="traConfirmOkBtn">Confirm</button>
        </div>
    </div>
</div>

<script>
    const transactionApprovalId = @ViewBag.TransactionApprovalId;

    let currentModel = null;
    let currentEmployeeIds = [];
    let addableEmployeesCache = [];
    let pendingDecisionType = null;

    document.addEventListener("DOMContentLoaded", loadReviewData);

    async function loadReviewData() {
        try {
            const res = await fetch(`/TrainingApproval/GetTrainingRequestForApproval?transactionApprovalId=${transactionApprovalId}`);
            const result = await res.json();

            if (!result.success) {
                alert(result.message || "Failed to load request.");
                return;
            }

            currentModel = result.data;
            currentEmployeeIds = currentModel.employees.map(e => e.employeeId);

            renderSummary(result);
            renderEmployeeList();

            if (currentModel.status !== "Pending") {
                document.getElementById("traDecisionArea").style.display = "none";
                document.getElementById("traActionButtons").style.display = "none";
                const note = document.getElementById("traAlreadyProcessedNote");
                note.style.display = "block";
                note.innerText = `This request has already been ${currentModel.status.toLowerCase()}.`;
            }
        } catch (err) {
            console.error("Load review data fault:", err);
            alert("Failed to load training request for review.");
        }
    }

    function renderSummary(result) {
        const m = currentModel;
        document.getElementById("traTrainingName").innerText = m.trainingName || "Untitled Training";
        document.getElementById("traRequestNo").innerText = m.requestNo || "";
        document.getElementById("traRequestedBy").innerText = m.requestedByName || "—";
        document.getElementById("traRequestDate").innerText = m.requestDate ? new Date(m.requestDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : "—";
        document.getElementById("traScheduleCode").innerText = m.trainingCode || "—";
        document.getElementById("traTrainer").innerText = m.trainerName || "—";
        document.getElementById("traVenue").innerText = m.venueName || "—";
        document.getElementById("traReasonText").innerText = m.reason && m.reason.trim() ? m.reason : "No notes provided.";

        const startD = result.startDate ? new Date(result.startDate) : null;
        const endD = result.endDate ? new Date(result.endDate) : null;
        const fmt = d => d ? d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : "";
        document.getElementById("traSchedule").innerText = startD
            ? `${fmt(startD)} - ${fmt(endD)}, ${result.startTime?.substring(0,5) || ''}-${result.endTime?.substring(0,5) || ''}`
            : "—";

        const capacity = result.capacity || 0;
        const enrolled = result.totalEnrolled || 0;
        document.getElementById("traSeatsLabel").innerHTML = `<b>${enrolled}</b> / ${capacity} seats used (${result.availableSeats} available)`;

        const pill = document.getElementById("traStatusPill");
        pill.innerText = m.status;
        pill.className = "tra-status-pill " + (m.status === "Approved" ? "pill-approved" : m.status === "Rejected" ? "pill-rejected" : "pill-pending");
    }

    function initials(name) {
        if (!name) return "?";
        const parts = name.trim().split(" ");
        return ((parts[0]?.[0] || "") + (parts[1]?.[0] || "")).toUpperCase();
    }

    function renderEmployeeList() {
        const container = document.getElementById("traEmployeeList");
        document.getElementById("traEmpCount").innerText = currentEmployeeIds.length;

        const empMap = {};
        currentModel.employees.forEach(e => empMap[e.employeeId] = e);

        if (currentEmployeeIds.length === 0) {
            container.innerHTML = `<div class="tra-empty-note">No employees on this request.</div>`;
            return;
        }

        const canEdit = currentModel.status === "Pending";

        container.innerHTML = currentEmployeeIds.map(id => {
            const e = empMap[id];
            const name = e ? e.employeeName : `Employee #${id}`;
            const code = e ? e.employeeNo : "";
            const dept = e ? e.departmentName : "";
            const desig = e ? e.designationName : "";

            return `
                <div class="tra-emp-row" data-emp-id="${id}">
                    <div class="tra-emp-info">
                        <div class="tra-emp-avatar">${initials(name)}</div>
                        <div class="tra-emp-text">
                            <h5><span class="tra-emp-code">${code}</span> — ${name}</h5>
                            <p>${dept || "General"}${desig ? " · " + desig : ""}</p>
                        </div>
                    </div>
                    ${canEdit ? `<button type="button" class="tra-emp-remove" onclick="removeEmployee(${id})" title="Remove from request"><i class="bi bi-x"></i></button>` : ''}
                </div>`;
        }).join('');
    }

    function removeEmployee(employeeId) {
        currentEmployeeIds = currentEmployeeIds.filter(id => id !== employeeId);
        renderEmployeeList();
    }

    function toggleAddEmployeeSearch() {
        const wrap = document.getElementById("traAddSearchWrap");
        const willShow = wrap.style.display !== "block";
        wrap.style.display = willShow ? "block" : "none";
        if (willShow) {
            document.getElementById("traAddSearchInput").value = "";
            document.getElementById("traAddSearchInput").focus();
            loadAddableEmployees();
        } else {
            document.getElementById("traAddDropdown").style.display = "none";
        }
    }

    async function loadAddableEmployees() {
        try {
            const res = await fetch(`/TrainingApproval/GetAddableEmployees?trainingScheduleId=${currentModel.trainingScheduleId}&currentEmployeeIds=${currentEmployeeIds.join(',')}`);
            const result = await res.json();
            addableEmployeesCache = result.data || [];
            filterAddableEmployees();
        } catch (err) {
            console.error("Addable employees load fault:", err);
        }
    }

    function filterAddableEmployees() {
        const query = document.getElementById("traAddSearchInput").value.trim().toLowerCase();
        const dropdown = document.getElementById("traAddDropdown");

        const matched = addableEmployeesCache.filter(e =>
            !currentEmployeeIds.includes(e.employeeId) && (
                (e.employeeName && e.employeeName.toLowerCase().includes(query)) ||
                (e.employeeCode && e.employeeCode.toLowerCase().includes(query))
            )
        ).slice(0, 30);

        if (matched.length === 0) {
            dropdown.innerHTML = `<div class="tra-add-option" style="cursor:default; color:var(--text-muted); font-style:italic;">No matching employees found.</div>`;
        } else {
            dropdown.innerHTML = matched.map(e => `
                <div class="tra-add-option" onclick="addEmployee(${e.employeeId}, '${(e.employeeName || '').replace(/'/g,"\\'")}', '${(e.employeeCode || '')}', '${(e.departmentName || '').replace(/'/g,"\\'")}')">
                    <span><b>${e.employeeCode}</b> — ${e.employeeName}</span>
                    <span>${e.departmentName || 'General'}</span>
                </div>`).join('');
        }
        dropdown.style.display = "block";
    }

    function addEmployee(employeeId, employeeName, employeeCode, departmentName) {
        if (currentEmployeeIds.includes(employeeId)) return;

        currentEmployeeIds.push(employeeId);
        currentModel.employees.push({
            employeeId, employeeName, employeeNo: employeeCode, departmentName, designationName: ""
        });

        renderEmployeeList();
        document.getElementById("traAddDropdown").style.display = "none";
        document.getElementById("traAddSearchInput").value = "";
    }

    document.addEventListener("click", function (e) {
        const wrap = document.getElementById("traAddSearchWrap");
        if (wrap && !wrap.contains(e.target) && !e.target.closest(".tra-add-emp-btn")) {
            document.getElementById("traAddDropdown").style.display = "none";
        }
    });

    function requestDecision(type) {
        if (type === 'approve' && currentEmployeeIds.length === 0) {
            alert("At least one employee must remain on the request to approve.");
            return;
        }

        pendingDecisionType = type;
        const box = document.getElementById("traConfirmBackdrop");
        const title = document.getElementById("traConfirmTitle");
        const msg = document.getElementById("traConfirmMessage");
        const okBtn = document.getElementById("traConfirmOkBtn");

        if (type === 'approve') {
            title.innerText = "Approve Training Request?";
            msg.innerText = `${currentEmployeeIds.length} employee(s) will be enrolled in "${currentModel.trainingName}". This cannot be undone.`;
            okBtn.className = "tra-confirm-btn tra-confirm-ok-approve";
            okBtn.innerText = "Approve & Enroll";
        } else {
            title.innerText = "Reject Training Request?";
            msg.innerText = `This request from ${currentModel.requestedByName} will be marked as rejected.`;
            okBtn.className = "tra-confirm-btn tra-confirm-ok-reject";
            okBtn.innerText = "Reject Request";
        }

        okBtn.onclick = executeDecision;
        box.style.display = "flex";
    }

    function closeConfirmDialog() {
        document.getElementById("traConfirmBackdrop").style.display = "none";
        pendingDecisionType = null;
    }

    async function executeDecision() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const remarks = document.getElementById("traRemarksInput").value;
        const okBtn = document.getElementById("traConfirmOkBtn");
        okBtn.disabled = true;

        try {
            let url, body;
            if (pendingDecisionType === 'approve') {
                url = '/TrainingApproval/ApproveTrainingRequest';
                body = { transactionApprovalId, finalEmployeeIds: currentEmployeeIds, remarks };
            } else {
                url = '/TrainingApproval/RejectTrainingRequest';
                body = { transactionApprovalId, remarks };
            }

            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                body: JSON.stringify(body)
            });
            const result = await res.json();

            if (result.success) {
                closeConfirmDialog();
                window.location.href = '/TransactionApproval/Index';
            } else {
                alert(result.message || "Action failed.");
                okBtn.disabled = false;
            }
        } catch (err) {
            console.error("Decision submission fault:", err);
            alert("Network error while submitting decision.");
            okBtn.disabled = false;
        }
    }
</script>