@using VeltriQ.Services.Interfaces
@inject IMenuService MenuService
<!DOCTYPE html>
<html lang="en" data-theme="dark" id="vqRoot">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]VeltriQ | HRMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>

        /* ═══════════════════════════════════════
                   CSS VARIABLES
                   Dark theme (default)
                ═══════════════════════════════════════ */
        :root {
            --bg: #0d1117;
            --sidebar-bg: #0d1117;
            --sidebar-border: rgba(255,255,255,0.05);
            --sidebar-text: #6b7280;
            --sidebar-text-hover: #ffffff;
            --sidebar-active-bg: linear-gradient(90deg, #6d28d9, #7c3aed);
            --sidebar-active-color: #ffffff;
            --card-bg: #161b22;
            --topbar-bg: #0d1117;
            --text-primary: #f1f5f9;
            --text-secondary: #9ca3af;
            --text-muted: #6b7280;
            --border: #21262d;
            --input-bg: #0d1117;
            --hover-bg: rgba(124,58,237,.1);
            --purple: #7c3aed;
            --accent: #7c3aed;
            --accent-hover: rgba(124,58,237,0.18);
            --accent-border: rgba(124,58,237,0.25);
            --accent-text: #c4b5fd;
            --company-btn-bg: rgba(124,58,237,0.1);
            --company-drop-bg: #161b22;
            --company-drop-border: #21262d;
            --logo-text-color: #ffffff;
            --notif-border: var(--topbar-bg);
            --scrollbar-thumb: rgba(124,58,237,.3);
            --topbar-h: 52px;
            --sidebar-w: 220px;
        }

        /* ═══════════════════════════════════════
                   LIGHT THEME
                   Sidebar/topbar: #2C0023 (deep burgundy)
                   Content: clean white
                ═══════════════════════════════════════ */
        [data-theme="light"] {
            --bg: #f5f3f7;
            --sidebar-bg: #2C0023;
            --sidebar-border: rgba(255,255,255,0.10);
            --sidebar-text: rgba(255,255,255,0.55);
            --sidebar-text-hover: #ffffff;
            --sidebar-active-bg: rgba(255,255,255,0.15);
            --sidebar-active-color: #ffffff;
            --card-bg: #ffffff;
            --topbar-bg: #2C0023;
            --text-primary: #1a0f18;
            --text-secondary: #6b546a;
            --text-muted: #9e809c;
            --border: #e4d8e2;
            --input-bg: #ffffff;
            --hover-bg: rgba(255,255,255,0.10);
            --purple: #2C0023;
            --accent: #2C0023;
            --accent-hover: rgba(44,0,35,0.12);
            --accent-border: rgba(44,0,35,0.2);
            --accent-text: #ffffff;
            --company-btn-bg: rgba(255,255,255,0.12);
            --company-drop-bg: #ffffff;
            --company-drop-border: #e4d8e2;
            --logo-text-color: #ffffff;
            --notif-border: #2C0023;
            --scrollbar-thumb: rgba(44,0,35,0.25);
        }

        /* ═══════════════════════════════════════
                   RESET
                ═══════════════════════════════════════ */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            overflow: hidden; /* prevent body scroll — each zone scrolls independently */
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text-primary);
        }

        /* ═══════════════════════════════════════
                   ROOT SHELL — full viewport grid
                     [sidebar] | [topbar + content stacked]
                ═══════════════════════════════════════ */
        .shell {
            display: grid;
            grid-template-columns: var(--sidebar-w) 1fr;
            grid-template-rows: var(--topbar-h) 1fr;
            grid-template-areas:
                "sidebar topbar"
                "sidebar content";
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        /* ═══════════════════════════════════════
                   SIDEBAR
                   — fixed to its grid cell, scrolls internally
                ═══════════════════════════════════════ */
        .sidebar {
            grid-area: sidebar;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--sidebar-border);
            display: flex;
            flex-direction: column;
            overflow: hidden; /* clip; children handle scroll */
            position: sticky;
            top: 0;
            height: 100vh;
        }

        /* Logo block — compact, fixed height */
        .logo-section {
            flex-shrink: 0;
            height: var(--topbar-h); /* exactly matches topbar height */
            display: flex;
            align-items: center;
            padding: 0 14px;
            border-bottom: 1px solid var(--sidebar-border);
            border-right: none;
        }

        .logo-wrap {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .logo-icon {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            flex-shrink: 0;
            background: linear-gradient(135deg, #6d28d9, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 800;
            color: #fff;
        }

        .logo-text {
            font-size: 14px;
            font-weight: 800;
            color: var(--logo-text-color);
            letter-spacing: -.3px;
            line-height: 1.2;
        }

        .logo-sub {
            font-size: 9px;
            color: var(--sidebar-text);
            opacity: .65;
            line-height: 1.3;
        }

        /* Scrollable nav zone */
        .nav-section {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 8px 10px 10px;
            /* invisible scrollbar */
            scrollbar-width: none;
        }

            .nav-section::-webkit-scrollbar {
                display: none;
            }

        /* ── Sidebar Menu ── */
        .sidebar-menu {
            list-style: none;
            padding: 0;
        }

            .sidebar-menu li {
                margin-bottom: 1px;
            }

            .sidebar-menu a {
                text-decoration: none;
                color: var(--sidebar-text);
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 10px;
                border-radius: 9px;
                font-size: 12.5px;
                font-weight: 500;
                transition: background .15s, color .15s;
                white-space: nowrap;
            }

                .sidebar-menu a:hover {
                    background: var(--hover-bg);
                    color: var(--sidebar-text-hover);
                }

                .sidebar-menu a.active {
                    background: var(--sidebar-active-bg);
                    color: var(--sidebar-active-color);
                    box-shadow: none;
                }

            .sidebar-menu i {
                font-size: 14px;
                width: 16px;
                min-width: 16px;
            }

        .chevron {
            margin-left: auto;
            font-size: 10px;
            opacity: .4;
        }

        .nav-badge {
            margin-left: auto;
            background: #7c3aed;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 20px;
            min-width: 20px;
            text-align: center;
        }

        /* ── Dropdown menus ── */
        .menu-dropdown {
            margin-bottom: 1px;
        }

        .dropdown-toggle {
            width: 100%;
            display: flex !important;
        }

        .dropdown-icon {
            margin-left: auto;
            font-size: 10px;
            opacity: .4;
            transition: transform .2s;
        }

        .menu-dropdown.active .dropdown-icon {
            transform: rotate(180deg);
        }

        .submenu {
            list-style: none;
            padding-left: 16px;
            margin-top: 2px;
            display: none;
        }

        .menu-dropdown.active .submenu {
            display: block;
        }

        .submenu li {
            margin-bottom: 1px;
        }

        .submenu a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border-radius: 8px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 12px;
            transition: background .15s, color .15s;
        }

            .submenu a:hover {
                background: var(--hover-bg);
                color: var(--sidebar-text-hover);
            }

        .submenu i {
            font-size: 12px;
            width: 14px;
            min-width: 14px;
        }

        /* ═══════════════════════════════════════
                   TOPBAR
                   — flush to top, zero radius, sticky
                ═══════════════════════════════════════ */
        .topbar {
            grid-area: topbar;
            background: var(--topbar-bg);
            border-bottom: 1px solid var(--border);
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            /* NO border-radius, NO margin, NO box-shadow top */
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .menu-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 18px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

            .menu-btn:hover {
                background: var(--hover-bg);
            }

        .search-box {
            width: 320px;
            position: relative;
        }

            .search-box input {
                width: 100%;
                border: 1.5px solid transparent;
                background: transparent;
                border-radius: 9px;
                padding: 7px 14px 7px 34px;
                font-size: 13px;
                font-family: inherit;
                color: var(--text-primary);
                outline: none;
                transition: border .2s, background .2s;
            }

                .search-box input:hover,
                .search-box input:focus {
                    border-color: rgba(124,58,237,0.4);
                    background: var(--input-bg);
                }

            .search-box i {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                left: 11px;
                color: var(--text-muted);
                font-size: 13px;
            }

        .tb-icon {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-secondary);
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            position: relative;
            transition: background .15s;
        }

            .tb-icon:hover {
                background: var(--hover-bg);
                color: var(--purple);
            }

        .notif-dot {
            position: absolute;
            top: 4px;
            right: 4px;
            background: #7c3aed;
            color: #fff;
            font-size: 8px;
            font-weight: 800;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--notif-border);
        }

        .tb-sep {
            width: 1px;
            height: 22px;
            background: var(--border);
            margin: 0 5px;
        }

        .profile-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 10px;
            border-radius: 9px;
            cursor: pointer;
            transition: background .15s;
        }

            .profile-pill:hover {
                background: var(--hover-bg);
            }

            .profile-pill img {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid #7c3aed;
            }

        .p-name {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1.2;
        }

        .p-role {
            font-size: 10px;
            color: var(--text-muted);
        }

        .profile-pill .bi-chevron-down {
            font-size: 10px;
            color: var(--text-muted);
        }

        /* ═══════════════════════════════════════
                   CONTENT AREA — scrolls independently
                ═══════════════════════════════════════ */
        .content-area {
            grid-area: content;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 20px 22px 32px;
            background: var(--bg);
            /* invisible scrollbar */
            scrollbar-width: thin;
            scrollbar-color: var(--scrollbar-thumb) transparent;
        }

            .content-area::-webkit-scrollbar {
                width: 4px;
            }

            .content-area::-webkit-scrollbar-track {
                background: transparent;
            }

            .content-area::-webkit-scrollbar-thumb {
                background: var(--scrollbar-thumb);
                border-radius: 4px;
            }

        /* ═══════════════════════════════════════
                   FLOATING THEME BUTTON
                ═══════════════════════════════════════ */
        .float-settings {
            position: fixed;
            bottom: 22px;
            right: 22px;
            z-index: 999;
        }

        .float-btn {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #6d28d9, #7c3aed);
            border: none;
            border-radius: 13px;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 20px rgba(109,40,217,.4);
            transition: transform .2s, box-shadow .2s;
        }

        [data-theme="light"] .float-btn {
            background: linear-gradient(135deg, #3d0032, #2C0023);
            box-shadow: 0 6px 20px rgba(44,0,35,.35);
        }

            .float-btn:hover {
                transform: scale(1.08);
            }

        .company-switcher {
            position: relative;
        }

        .company-switch-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            background: var(--company-btn-bg);
            border: 1px solid var(--accent-border);
            border-radius: 9px;
            padding: 5px 12px;
            color: var(--accent-text);
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: all .2s;
            white-space: nowrap;
        }

            .company-switch-btn:hover {
                background: var(--accent-hover);
                border-color: var(--accent-border);
            }

            .company-switch-btn i {
                font-size: 14px;
            }

        .company-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            background: var(--company-drop-bg);
            border: 1px solid var(--company-drop-border);
            border-radius: 12px;
            padding: 8px;
            min-width: 220px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.18);
            display: none;
            z-index: 500;
        }

            .company-dropdown.open {
                display: block;
            }

        .company-drop-title {
            font-size: 9.5px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4b5563;
            padding: 2px 8px 8px;
            font-weight: 700;
        }

        .company-drop-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 9px;
            cursor: pointer;
            transition: background .15s;
        }

            .company-drop-item:hover {
                background: var(--accent-hover);
            }

            .company-drop-item.active {
                background: var(--accent-hover);
            }

        .co-initial {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: linear-gradient(135deg,#6d28d9,#7c3aed);
            color: #fff;
            font-size: 13px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .co-dname {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .co-dcode {
            font-size: 11px;
            color: var(--text-muted);
        }

        .co-check {
            margin-left: auto;
            color: var(--accent);
            font-size: 14px;
            font-weight: 700;
        }
    </style>
</head>

<body>

    <div class="shell">

        <!-- ═══════════ SIDEBAR ═══════════ -->
        <aside class="sidebar">

            <!-- Logo — same height as topbar -->
            <div class="logo-section">
                <div class="logo-wrap">
                    <div class="logo-icon">V</div>
                    <div>
                        <div class="logo-text">VeltriQ HRMS</div>
                        <div class="logo-sub">Powering the Modern Workplace.</div>
                    </div>
                </div>
            </div>

            <!-- Scrollable nav -->
            <div class="nav-section">
                <ul class="sidebar-menu">

                    <!-- Dashboard -->
                    <li>
                        <a href="/" class="active">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <!-- Organization -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-building"></i>
                            <span>Organization</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="/Company/Index"><i class="bi bi-buildings"></i>Company</a></li>
                            <li><a href="/Branch/Index"><i class="bi bi-diagram-3"></i>Branch</a></li>
                            <li><a href="/Department/Index"><i class="bi bi-grid"></i>Department</a></li>
                            <li><a href="/Designation/Index"><i class="bi bi-person-badge"></i>Designation</a></li>
                            <li><a href="/Division/Index"><i class="bi bi-layers"></i>Division</a></li>
                            <li><a href="/Nationality/Index"><i class="bi bi-globe"></i>Nationality</a></li>
                            <li><a href="/City/Index"><i class="bi bi-geo-alt"></i>Country City</a></li>
                            <li><a href="/DocumentMaster/Index"><i class="bi bi-file-earmark-text"></i>Document Master</a></li>
                            <li><a href="/AssetMaster/Index"><i class="bi bi-box-seam"></i>Asset Master</a></li>
                            <li><a href="/HRContact/Index"><i class="bi bi-person-lines-fill"></i>HR Contact</a></li>
                        </ul>
                    </li>

                    <!-- Assets -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-box-seam"></i>
                            <span>Assets</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li>
                                <a asp-controller="AssetMaster" asp-action="Index">
                                    <i class="bi bi-sliders"></i>Master
                                </a>
                            </li>
                            <li>
                                <a asp-controller="AssetInventory" asp-action="Index">
                                    <i class="bi bi-boxes"></i>Inventory
                                </a>
                            </li>
                            <li>
                                <a asp-controller="EmployeeAssets" asp-action="Index">
                                    <i class="bi bi-people"></i>Employee Asset
                                </a>
                            </li>
                            <li>
                                <a asp-controller="AssetReturn" asp-action="Index">
                                    <i class="bi bi-arrow-counterclockwise"></i>Return
                                </a>
                            </li>
                        </ul>
                    </li>
                    <!-- Employees -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-people"></i>
                            <span>Employees</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="/Employee/Index"><i class="bi bi-person"></i>Employee List</a></li>
                            <li><a href="#"><i class="bi bi-person-x"></i>Inactive Employees</a></li>
                            <li><a href="#"><i class="bi bi-cash-stack"></i>Salary Revision</a></li>
                            <li><a href="/EmployeeTransfer/Index"><i class="bi bi-arrow-left-right"></i>Employee Transfer</a></li>
                            <li><a href="#"><i class="bi bi-diagram-3"></i>Organization Chart</a></li>
                            <li><a href="/EmployeeExit/Index"><i class="bi bi-box-arrow-right"></i>Employee Exit</a></li>
                            <li><a href="/EmployeeSuspension/Index"> <i class="bi bi-slash-circle"></i> Employee Suspension</a></li>
                            <li><a href="/EndOfService/Index"><i class="bi bi-wallet2"></i>End Of Service</a></li>
                            <li><a href="/ReportingLevel/Index"><i class="bi bi-diagram-2"></i>Reporting Level</a></li>
                            <li><a href="/LoanManagement/Index"><i class="bi bi-cash-coin"></i>Loan Management</a></li>
                        </ul>
                    </li>

                    <!-- Attendance -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-calendar-check"></i>
                            <span>Attendance</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="#"><i class="bi bi-calendar-event"></i>Holiday Entry</a></li>
                            <li><a href="#"><i class="bi bi-clock-history"></i>Shift Management</a></li>
                            <li><a href="#"><i class="bi bi-calendar3"></i>Shift Schedule</a></li>
                            <li><a href="#"><i class="bi bi-clock"></i>TimeSheet</a></li>
                            <li><a href="#"><i class="bi bi-upload"></i>Import Attendance</a></li>
                        </ul>
                    </li>

                    <!-- Leave -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-airplane"></i>
                            <span>Leave</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="/Leave/LeaveTypes"><i class="bi bi-list-check"></i>Leave Type</a></li>
                            <li><a href="#"><i class="bi bi-calendar2-check"></i>Leave Request</a></li>
                            <li><a href="#"><i class="bi bi-x-circle"></i>Leave Cancellation</a></li>
                            <li><a href="#"><i class="bi bi-pie-chart"></i>Leave Balance</a></li>
                        </ul>
                    </li>

                    <!-- Payroll -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-cash-stack"></i>
                            <span>Payroll</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="#"><i class="bi bi-wallet2"></i>Allowance</a></li>
                            <li><a href="#"><i class="bi bi-bank2"></i>Financial Posting</a></li>
                            <li><a href="#"><i class="bi bi-dash-circle"></i>Deduction</a></li>
                            <li><a href="#"><i class="bi bi-calculator"></i>Payroll Generation</a></li>
                        </ul>
                    </li>

                    <!-- Insurance -->
                    <li class="menu-dropdown">
                        <a href="javascript:void(0);" class="dropdown-toggle">
                            <i class="bi bi-heart-pulse"></i>
                            <span>Insurance</span>
                            <i class="bi bi-chevron-down dropdown-icon"></i>
