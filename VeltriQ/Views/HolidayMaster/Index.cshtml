@model IEnumerable<VeltriQ.Models.HR.Attendance.HolidayMaster>

@{
    ViewData["Title"] = "Holiday Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .holiday-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .holiday-header-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    .holiday-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .holiday-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .holiday-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .holiday-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .holiday-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .holiday-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box input {
            width: 100%;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 12px 0 32px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .search-box input:focus {
                border-color: var(--purple);
            }

        .search-box i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .holiday-table {
        width: 100%;
        border-collapse: collapse;
    }

        .holiday-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .holiday-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .holiday-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    /* MODAL WINDOW SYSTEM */
    .custom-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

        .custom-modal.active {
            display: flex;
        }

    .custom-modal-box {
        width: 100%;
        max-width: 800px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        max-height: 92vh;
        display: flex;
        flex-direction: column;
    }

    .modal-header-custom {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

        .modal-header-custom h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

    .close-modal-btn {
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 4px;
        background: var(--card-bg);
        color: var(--text-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-body-custom {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scrollbar-width: thin;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group.wide {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--text-secondary);
        }

    .custom-input, .custom-select, .custom-textarea {
        width: 100%;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
    }

    .custom-input, .custom-select {
        height: 36px;
    }

    .custom-textarea {
        resize: vertical;
        min-height: 60px;
        padding: 8px 12px;
    }

        .custom-input:focus, .custom-select:focus, .custom-textarea:focus {
            border-color: var(--purple);
        }

    .custom-input[readonly] {
        background: var(--hover-bg);
        opacity: 0.8;
        cursor: not-allowed;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }

        .checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--purple);
            cursor: pointer;
        }

        .checkbox-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            text-transform: none;
            cursor: pointer;
        }

    .modal-footer-custom {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

    .cancel-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 12px;
        cursor: pointer;
    }

    .save-btn {
        height: 34px;
        padding: 0 16px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@Html.AntiForgeryToken()

<div class="holiday-page">
    <div class="holiday-header-bar">
        <button class="holiday-add-btn" onclick="openHolidayModal('create', 0)">
            <i class="bi bi-plus-lg"></i> Create Holiday
        </button>
    </div>

    <div class="holiday-card">
        <div class="holiday-card-top">
            <div class="holiday-card-title">
                <h3>Holiday Master Workspace</h3>
                <p>Manage national, festival, company, regional, and optional holidays across company branches.</p>
            </div>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="tableSearchKeyword" placeholder="Search holidays..." onkeyup="filterHolidays()" autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="holiday-table" id="holidayTable">
                <thead>
                    <tr>
                        <th>Holiday Code</th>
                        <th>Holiday Name</th>
                        <th>Date</th>
                        <th>Holiday Type</th>
                        <th>Company / Branch</th>
                        <th style="text-align: center;">Attributes</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            var statusClass = x.IsActive ? "status-active" : "status-inactive";
                            var statusText = x.IsActive ? "Active" : "Inactive";
                            <tr class="holiday-row" id="holiday-row-@x.HolidayMasterId">
                                <td style="font-weight: 700; font-family: monospace;">@x.HolidayCode</td>
                                <td style="font-weight: 600;" class="searchable-text">@x.HolidayName</td>
                                <td>@x.HolidayDate.ToString("dd MMM yyyy")</td>
                                <td><span style="font-size: 11px; padding: 2px 6px; background: var(--hover-bg); border: 1px solid var(--border); border-radius: 4px;">@x.HolidayType</span></td>
                                <td class="searchable-text">
                                    <div style="font-weight: 600;">@(x.Company?.CompanyName ?? "—")</div>
                                    <div style="font-size: 11px; color: var(--text-secondary);">@(x.Branch?.BranchName ?? "All Branches")</div>
                                </td>
                                <td style="text-align: center; font-size: 11px;">
                                    @if (x.IsOptional)
                                    {
                                        <span style="color: #3b82f6; font-weight: 600;">[Optional]</span>
                                    }
                                    @if (x.IsRecurring)
                                    {
                                        <span style="color: #10b981; font-weight: 600;">[Recurring]</span>
                                    }
                                    @if (x.IsHalfDay)
                                    {
                                        <span style="color: #f59e0b; font-weight: 600;">[Half-Day: @x.HalfDaySession]</span>
                                    }
                                    @if (!x.IsOptional && !x.IsRecurring && !x.IsHalfDay)
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge-status @statusClass" id="badge-@x.HolidayMasterId">@statusText</span>
                                </td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                        <button class="action-btn" onclick="openHolidayModal('edit', @x.HolidayMasterId)" title="Edit Holiday">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="action-btn" onclick="toggleHolidayStatus(@x.HolidayMasterId)" title="Toggle Status" style="color: #f59e0b;">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No holiday records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="custom-modal" id="holidayModal">
    <div class="custom-modal-box">
        <div class="modal-header-custom">
            <div>
                <h3 id="modalTitle">Create Holiday Configuration</h3>
                <p style="font-size: 11px; color: var(--text-secondary); margin: 2px 0 0 0;">Define holiday parameters, dates, and organizational targets.</p>
            </div>
            <button type="button" class="close-modal-btn" onclick="closeHolidayModal()"><i class="bi bi-x-lg"></i></button>
        </div>

        <form id="holidayForm" method="post" onsubmit="submitHolidayForm(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="HolidayMasterId" name="HolidayMaster.HolidayMasterId" value="0" />

            <div class="modal-body-custom">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Company *</label>
                        <select name="HolidayMaster.CompanyId" class="custom-select" id="modalCompanyId" onchange="onCompanyChange(this.value)" required>
                            <option value="">Select Company</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Branch (Optional)</label>
                        <select name="HolidayMaster.BranchId" class="custom-select" id="modalBranchId">
                            <option value="">All Branches</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Holiday Code * (Auto)</label>
                        <input type="text" name="HolidayMaster.HolidayCode" id="modalHolidayCode" class="custom-input" readonly required />
                    </div>

                    <div class="form-group">
                        <label>Holiday Type *</label>
                        <select name="HolidayMaster.HolidayType" class="custom-select" id="modalHolidayType" required>
                            <option value="">Select Type</option>
                            <option value="National Holiday">National Holiday</option>
                            <option value="Festival Holiday">Festival Holiday</option>
                            <option value="Company Holiday">Company Holiday</option>
                            <option value="Regional Holiday">Regional Holiday</option>
                            <option value="Optional Holiday">Optional Holiday</option>
                        </select>
                    </div>

                    <div class="form-group wide">
                        <label>Holiday Name *</label>
                        <input type="text" name="HolidayMaster.HolidayName" id="modalHolidayName" class="custom-input" placeholder="e.g. Independence Day" required />
                    </div>

                    <div class="form-group">
                        <label>Holiday Date *</label>
                        <input type="date" name="HolidayMaster.HolidayDate" id="modalHolidayDate" class="custom-input" required />
                    </div>

                    <div class="form-group wide">
                        <label>Description</label>
                        <textarea name="HolidayMaster.Description" id="modalDescription" class="custom-textarea" placeholder="Optional details about this holiday..."></textarea>
                    </div>

                    <div class="form-group wide" style="display: flex; flex-direction: row; gap: 20px; align-items: center; margin-top: 4px; flex-wrap: wrap;">
                        <div class="checkbox-group">
                            <input type="checkbox" name="HolidayMaster.IsOptional" id="modalIsOptional" value="true" />
                            <label for="modalIsOptional">Optional Holiday</label>
                        </div>
                        <div class="checkbox-group">
                            <input type="checkbox" name="HolidayMaster.IsRecurring" id="modalIsRecurring" value="true" />
                            <label for="modalIsRecurring">Recurring Yearly</label>
                        </div>
                        <div class="checkbox-group">
                            <input type="checkbox" name="HolidayMaster.IsHalfDay" id="modalIsHalfDay" value="true" onchange="toggleHalfDaySession(this.checked)" />
                            <label for="modalIsHalfDay">Half Day Holiday</label>
                        </div>
                    </div>

                    <div class="form-group wide" id="halfDaySessionGroup" style="display: none;">
                        <label>Half Day Session *</label>
                        <select name="HolidayMaster.HalfDaySession" class="custom-select" id="modalHalfDaySession">
                            <option value="">Select Session</option>
                            <option value="Morning">Morning</option>
                            <option value="Afternoon">Afternoon</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="cancel-btn" onclick="closeHolidayModal()">Cancel</button>
                <button type="submit" class="save-btn"><i class="bi bi-check2-circle"></i> Save Holiday</button>
            </div>
        </form>
    </div>
</div>

<script>
    function filterHolidays() {
        const input = document.getElementById('tableSearchKeyword');
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#holidayTable tbody tr.holiday-row');

        rows.forEach(row => {
            const textContent = row.textContent.toLowerCase();
            if (textContent.includes(filter)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function toggleHalfDaySession(isHalfDay) {
        const group = document.getElementById('halfDaySessionGroup');
        const select = document.getElementById('modalHalfDaySession');
        if (isHalfDay) {
            group.style.display = 'flex';
            select.required = true;
        } else {
            group.style.display = 'none';
            select.required = false;
            select.value = '';
        }
    }

    async function loadCompaniesDropdown(selectedCompanyId = null) {
        const companySelect = document.getElementById('modalCompanyId');
        companySelect.innerHTML = '<option value="">Select Company</option>';

        try {
            const res = await fetch('/ShiftMaster/GetCompanies');
            const companies = await res.json();
            companies.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.companyId || c.value;
                opt.textContent = c.companyName || c.text;
                if (selectedCompanyId && opt.value == selectedCompanyId) {
                    opt.selected = true;
                }
                companySelect.appendChild(opt);
            });
        } catch (err) {
            console.error('Error loading companies:', err);
        }
    }

    async function onCompanyChange(companyId, selectedBranchId = null) {
        const branchSelect = document.getElementById('modalBranchId');
        branchSelect.innerHTML = '<option value="">All Branches</option>';

        if (!companyId) return;

        try {
            const res = await fetch(`/HolidayMaster/GetBranchesByCompany?companyId=${companyId}`);
            const branches = await res.json();
            branches.forEach(b => {
                const opt = document.createElement('option');
                opt.value = b.branchId;
                opt.textContent = b.branchName;
                if (selectedBranchId && b.branchId == selectedBranchId) {
                    opt.selected = true;
                }
                branchSelect.appendChild(opt);
            });
        } catch (err) {
            console.error('Error loading branches:', err);
        }
    }

    async function openHolidayModal(mode, id = 0) {
        const modal = document.getElementById('holidayModal');
        const form = document.getElementById('holidayForm');
        const title = document.getElementById('modalTitle');

        modal.classList.add('active');
        form.reset();
        toggleHalfDaySession(false);

        if (mode === 'create') {
            title.textContent = 'Create Holiday Configuration';
            form.action = '/HolidayMaster/Create';
            document.getElementById('HolidayMasterId').value = 0;

            await loadCompaniesDropdown();
            document.getElementById('modalBranchId').innerHTML = '<option value="">All Branches</option>';

            const randomCode = 'HOL-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('modalHolidayCode').value = randomCode;
        } else {
            title.textContent = 'Edit Holiday Configuration';
            form.action = '/HolidayMaster/Edit';
            document.getElementById('HolidayMasterId').value = id;

            try {
                const res = await fetch(`/HolidayMaster/GetHolidayById?id=${id}`);
                const data = await res.json();

                if (data.success) {
                    await loadCompaniesDropdown(data.companyId);
                    await onCompanyChange(data.companyId, data.branchId);

                    document.getElementById('modalHolidayCode').value = data.holidayCode;
                    document.getElementById('modalHolidayType').value = data.holidayType;
                    document.getElementById('modalHolidayName').value = data.holidayName;

                    if (data.holidayDate) {
                        const formattedDate = data.holidayDate.split('T')[0];
                        document.getElementById('modalHolidayDate').value = formattedDate;
                    }

                    document.getElementById('modalDescription').value = data.description || '';
                    document.getElementById('modalIsOptional').checked = data.isOptional;
                    document.getElementById('modalIsRecurring').checked = data.isRecurring;

                    if (data.isHalfDay) {
                        document.getElementById('modalIsHalfDay').checked = true;
                        toggleHalfDaySession(true);
                        document.getElementById('modalHalfDaySession').value = data.halfDaySession || '';
                    }
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#7c3aed' });
                    closeHolidayModal();
                }
            } catch (err) {
                console.error('Failed to load holiday details for editing:', err);
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not fetch holiday details.', confirmButtonColor: '#7c3aed' });
                closeHolidayModal();
            }
        }
    }

    function closeHolidayModal() {
        document.getElementById('holidayModal').classList.remove('active');
    }

    async function submitHolidayForm(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                closeHolidayModal();
                Swal.fire({ icon: 'success', title: 'Success!', text: 'Holiday saved successfully.', timer: 1200, showConfirmButton: false });
                setTimeout(() => location.reload(), 1200);
            } else {
                Swal.fire({ icon: 'error', title: 'Validation Error', text: 'Please check your inputs and try again.', confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Submission error:', err);
            Swal.fire({ icon: 'error', title: 'Submission Failed', text: 'An unexpected network error occurred.', confirmButtonColor: '#7c3aed' });
        }
    }

    async function toggleHolidayStatus(id) {
        const confirmResult = await Swal.fire({
            title: 'Toggle Holiday Status?',
            text: 'Are you sure you want to toggle the status of this holiday?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#ef4444',
            confirmButtonText: 'Yes, toggle it!'
        });

        if (!confirmResult.isConfirmed) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(`/HolidayMaster/ToggleStatus/${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Action Denied', text: result.message, confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Toggle status error:', err);
        }
    }
</script>