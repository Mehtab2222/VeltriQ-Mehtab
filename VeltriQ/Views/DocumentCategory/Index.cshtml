@using VeltriQ.ViewModels.OnboardingDocumentCategory
@model DocumentCategoryIndexViewModel

@{
    ViewData["Title"] = "Document Categories";
}

<style>
    .categories-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR (CRISP & FULLY SQUARED) ── */
    .categories-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px; /* Fully squared corporate grid matching employee page */
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* ── DECK CONTROL ACTIONS TOP HEADER PANEL ── */
    .categories-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
        gap: 20px;
    }

    .categories-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .categories-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── HEADER NAVIGATION ACTION BAR BUTTONS ── */
    .categories-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 4px;
    }

    .categories-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
        cursor: pointer;
    }

        .categories-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── SYSTEM BRANDED SEARCH BAR ── */
    .categories-search {
        width: 280px;
        position: relative;
    }

        .categories-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .categories-search input:focus {
                border-color: var(--purple);
            }

        .categories-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── SCROLLABLE GRID MATRIX DESIGN ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }

        .table-wrapper::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }

    .categories-table {
        width: 100%;
        border-collapse: collapse;
    }

        .categories-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .categories-table td {
            padding: 8px 16px; /* Compressed padding for high density view */
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .categories-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── FORM LABELS AND UTILITIES ── */
    .custom-form-label {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

        .custom-form-label span {
            color: #ef4444;
            margin-left: 2px;
        }

    .custom-form-control {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12.5px;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--purple);
        }

    textarea.custom-form-control {
        height: 64px;
        padding: 6px 12px;
        resize: none;
    }

    /* ── THEME STATUS BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
    }

    /* ── CONTROL ACTIONS BUTTON MATRIX PANEL ── */
    .table-actions {
        display: flex;
        gap: 4px;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        transition: all 0.1s ease;
        cursor: pointer;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    .action-toggle-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.1s ease;
    }

        .action-toggle-btn.btn-activate {
            color: #22c55e;
        }

            .action-toggle-btn.btn-activate:hover {
                background: #22c55e;
                color: #fff;
            }

        .action-toggle-btn.btn-deactivate {
            color: #ef4444;
        }

            .action-toggle-btn.btn-deactivate:hover {
                background: #ef4444;
                color: #fff;
            }

    /* ── SQUARED BRANDED POPUP INTERACTIVE MODALS ── */
    .vq-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .vq-modal-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        width: 440px;
        padding: 18px;
        border-radius: 0px; /* Sharp corners */
        box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .vq-modal-header h4 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        text-transform: uppercase;
    }

    .vq-modal-body p {
        font-size: 13px;
        color: var(--text-secondary);
        margin: 4px 0;
        line-height: 1.4;
    }

    .vq-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 4px;
    }

    .form-action-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

    .btn-submit-theme {
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
    }

        .btn-submit-theme:hover {
            opacity: 0.9;
        }

    .btn-cancel-theme {
        background: var(--hover-bg);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.12);
        }

    .validation-err-text {
        font-size: 11px;
        color: #ef4444;
        font-weight: 500;
        margin-top: 2px;
        display: none;
    }
</style>

@Html.AntiForgeryToken()

<input type="hidden" id="hfDefaultNextDisplayOrder" value="@Model.CreateCategory.DisplayOrder" />

<div class="categories-page">

    <div class="categories-header">
        <button type="button" class="categories-add-btn" onclick="openAddCategoryModal()">
            <i class="bi bi-plus-lg"></i>
            Add Category
        </button>
    </div>

    <div class="categories-card">

        <div class="categories-card-top">
            <div class="categories-card-title">
                <h3>Document Categories</h3>
                <p>Total Configuration Blocks: @(Model.Categories?.Count ?? 0)</p>
            </div>

            <div class="categories-search">
                <i class="bi bi-search"></i>
                <input type="text" id="catSearchInput" placeholder="Search categories..." onkeyup="filterCategoriesTable()" value="@Model.SearchText" autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="categories-table" id="categoriesTable">
                <thead>
                    <tr>
                        <th style="width: 70px; text-align: center;">Order</th>
                        <th style="width: 240px;">Category Name</th>
                        <th>Description</th>
                        <th style="width: 130px; text-align: center;">Assigned Docs</th>
                        <th style="width: 110px;">Status</th>
                        <th style="width: 100px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        foreach (var item in Model.Categories)
                        {
                            <tr class="category-row-item" id="cat_row_@item.OnboardingDocumentCategoryMasterId">
                                <td style="text-align: center; font-weight: 700; color: var(--text-secondary);" class="target-order">
                                    @item.DisplayOrder
                                </td>
                                <td style="font-weight: 600;" class="target-name">
                                    @item.CategoryName
                                </td>
                                <td style="color: var(--text-secondary); font-size: 12px;" class="target-desc">
                                    @item.Description
                                </td>
                                <td style="text-align: center; font-weight: 700; color: var(--text-secondary);" class="target-count">
                                    @item.DocumentCount
                                </td>
                                <td class="status-cell">
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions" style="justify-content: center;">
                                        <button type="button" class="action-btn" title="Edit Properties"
                                                onclick="openEditCategoryModal(@item.OnboardingDocumentCategoryMasterId)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button"
                                                class="action-toggle-btn @(item.IsActive ? "btn-deactivate" : "btn-activate")"
                                                title="@(item.IsActive ? "Deactivate Category" : "Activate Category")"
                                                onclick="openToggleModal(@item.OnboardingDocumentCategoryMasterId, '@item.CategoryName', @(item.IsActive ? "true" : "false"))">
                                            <i class="bi @(item.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyStatePlaceholderRow">
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No system categories found inside active deployment records.
                            </td>
                        </tr>
                    }

                    <tr id="searchFallbackRow" style="display: none;">
                        <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                            No matching category configurations located.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="categoryFormModal" class="vq-modal-backdrop" style="display: none;">
    <div class="vq-modal-card">
        <div class="custom-form-header" style="border-bottom: 1px solid var(--border); padding-bottom:6px; margin-bottom:4px;">
            <h4 id="formModalTitle">Add Category</h4>
        </div>
        <div class="vq-modal-body" style="display:flex; flex-direction:column; gap:10px;">
            <input type="hidden" id="txtFormCategoryId" value="0" />

            <div class="form-field-group">
                <label class="custom-form-label">Category Name<span>*</span></label>
                <input type="text" id="txtFormCategoryName" class="custom-form-control" placeholder="e.g., Legal Certificates" maxlength="100" autocomplete="off" />
                <span class="validation-err-text" id="lblFormCategoryNameErr"></span>
            </div>

            <div class="form-field-group">
                <label class="custom-form-label">Description</label>
                <textarea id="txtFormCategoryDesc" class="custom-form-control" placeholder="Brief summary notes regarding database scope assignment..."></textarea>
                <span class="validation-err-text" id="lblFormCategoryDescErr"></span>
            </div>

            <div class="form-field-group" style="width: 140px;">
                <label class="custom-form-label">Display Order<span>*</span></label>
                <input type="number" id="txtFormCategoryOrder" class="custom-form-control" min="1" oninput="this.value = Math.abs(this.value) || ''" />
                <span class="validation-err-text" id="lblFormCategoryOrderErr"></span>
            </div>
        </div>
        <div class="vq-modal-footer">
            <button type="button" class="form-action-btn btn-cancel-theme" onclick="closeFormModal()">Cancel</button>
            <button type="button" class="form-action-btn btn-submit-theme" id="btnSubmitFormAction" onclick="submitCategoryFormPipeline()">Save Category</button>
        </div>
    </div>
</div>

<div id="statusToggleModal" class="vq-modal-backdrop" style="display: none;">
    <div class="vq-modal-card">
        <div class="vq-modal-header">
            <h4 id="modalActionTitle">Change Component State</h4>
        </div>
        <div class="vq-modal-body">
            <input type="hidden" id="targetCategoryId" value="0" />
            <input type="hidden" id="targetCurrentState" value="false" />
            <p id="modalActionMessage">Are you sure you want to alter this operational category's layout parameters?</p>
        </div>
        <div class="vq-modal-footer">
            <button type="button" class="form-action-btn btn-cancel-theme" onclick="closeToggleModal()">Cancel</button>
            <button type="button" id="btnConfirmAction" class="form-action-btn" style="color: #fff;" onclick="submitStateTransition()">Confirm</button>
        </div>
    </div>
</div>

<script>
    function filterCategoriesTable() {
        const input = document.getElementById('catSearchInput');
        const filter = input.value.toLowerCase().trim();
        const table = document.getElementById('categoriesTable');
        const rows = table.getElementsByTagName('tbody')[0].getElementsByClassName('category-row-item');
        const fallbackRow = document.getElementById('searchFallbackRow');

        let visualMatches = 0;

        for (let i = 0; i < rows.length; i++) {
            const contextString = rows[i].textContent || rows[i].innerText;
            if (contextString.toLowerCase().indexOf(filter) > -1) {
                rows[i].style.display = "";
                visualMatches++;
            } else {
                rows[i].style.display = "none";
            }
        }

        if (rows.length > 0) {
            fallbackRow.style.display = (visualMatches === 0) ? "" : "none";
        }
    }

    /* ── FORM STATE OPEN SELECTIONS ── */
    function openAddCategoryModal() {
        clearFormValidationStates();
        document.getElementById("txtFormCategoryId").value = "0";
        document.getElementById("formModalTitle").innerText = "Add Category";
        document.getElementById("btnSubmitFormAction").innerText = "Save Category";

        // Populate default next display order from view parameters
        document.getElementById("txtFormCategoryOrder").value = document.getElementById("hfDefaultNextDisplayOrder").value;
        document.getElementById("categoryFormModal").style.display = "flex";
    }

    function openEditCategoryModal(id) {
        clearFormValidationStates();
        const row = document.getElementById(`cat_row_${id}`);
        if(!row) return;

        const currentName = row.querySelector(".target-name").innerText.trim();
        const currentDesc = row.querySelector(".target-desc").innerText.trim();
        const currentOrder = row.querySelector(".target-order").innerText.trim();

        document.getElementById("txtFormCategoryId").value = id;
        document.getElementById("txtFormCategoryName").value = currentName;
        document.getElementById("txtFormCategoryDesc").value = currentDesc === "No description provided." ? "" : currentDesc;
        document.getElementById("txtFormCategoryOrder").value = currentOrder;

        document.getElementById("formModalTitle").innerText = "Edit Category";
        document.getElementById("btnSubmitFormAction").innerText = "Save Changes";
        document.getElementById("categoryFormModal").style.display = "flex";
    }

    function closeFormModal() {
        document.getElementById("categoryFormModal").style.display = "none";
    }

    function clearFormValidationStates() {
        document.getElementById("txtFormCategoryName").value = "";
        document.getElementById("txtFormCategoryDesc").value = "";
        document.getElementById("txtFormCategoryOrder").value = "";

        const errors = document.querySelectorAll(".validation-err-text");
        errors.forEach(lbl => { lbl.innerText = ""; lbl.style.display = "none"; });
    }

    /* ── SUBMIT FORM SAVE / EDIT HANDLERS ── */
    function submitCategoryFormPipeline() {
        const id = parseInt(document.getElementById("txtFormCategoryId").value);
        const nameField = document.getElementById("txtFormCategoryName");
        const descField = document.getElementById("txtFormCategoryDesc");
        const orderField = document.getElementById("txtFormCategoryOrder");

        let hasError = false;

        // Reset errors
        const errors = document.querySelectorAll(".validation-err-text");
        errors.forEach(lbl => { lbl.innerText = ""; lbl.style.display = "none"; });

        if(!nameField.value.trim()) {
            const err = document.getElementById("lblFormCategoryNameErr");
            err.innerText = "Category Name is required.";
            err.style.display = "block";
            hasError = true;
        }

        if(!orderField.value.trim() || parseInt(orderField.value) <= 0) {
            const err = document.getElementById("lblFormCategoryOrderErr");
            err.innerText = "Display Order must be greater than 0.";
            err.style.display = "block";
            hasError = true;
        }

        if(hasError) return;

        // Routing endpoints maps natively against controller standard methods
        const endpoint = id === 0 ? '/DocumentCategory/Create' : '/DocumentCategory/Edit';

        const payload = {
            CategoryName: nameField.value.trim(),
            Description: descField.value.trim(),
            DisplayOrder: parseInt(orderField.value)
        };
        if(id > 0) {
            payload.OnboardingDocumentCategoryMasterId = id;
        }

        fetch(endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                // Instantly sync variations and reload view configuration matrices smoothly without page reloads
                location.reload();
            } else {
                const err = document.getElementById("lblFormCategoryNameErr");
                err.innerText = data.message || "Failed to submit form data configuration rules.";
                err.style.display = "block";
            }
        })
        .catch(() => alert("Network exception transmitting category configurations data parameters."));
    }

    /* ── TOGGLE LIFECYCLE OPERATIONAL MODALS ── */
    function openToggleModal(id, catName, isActive) {
        document.getElementById("targetCategoryId").value = id;
        document.getElementById("targetCurrentState").value = isActive;

        const titleContainer = document.getElementById("modalActionTitle");
        const msgContainer = document.getElementById("modalActionMessage");
        const actionBtn = document.getElementById("btnConfirmAction");

        if (isActive) {
            titleContainer.innerText = "Deactivate Category";
            msgContainer.innerHTML = `Are you sure you want to <strong>deactivate</strong> the category <strong>"${catName}"</strong>? This will restrict active document attachments setups.`;
            actionBtn.style.background = "#ef4444";
        } else {
            titleContainer.innerText = "Activate Category";
            msgContainer.innerHTML = `Are you sure you want to <strong>activate</strong> the category <strong>"${catName}"</strong>? It will rejoin core document form drop menus instantly.`;
            actionBtn.style.background = "#22c55e";
        }

        document.getElementById("statusToggleModal").style.display = "flex";
    }

    function closeToggleModal() {
        document.getElementById("statusToggleModal").style.display = "none";
        document.getElementById("targetCategoryId").value = "0";
    }

    function submitStateTransition() {
        const catId = document.getElementById("targetCategoryId").value;
        const isCurrentlyActive = document.getElementById("targetCurrentState").value === "true";

        const targetEndpoint = isCurrentlyActive ? '/DocumentCategory/Deactivate' : '/DocumentCategory/Activate';

        fetch(targetEndpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(parseInt(catId))
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const row = document.getElementById(`cat_row_${catId}`);
                if (row) {
                    const statusCell = row.querySelector('.status-cell');
                    const actionButton = row.querySelector('.action-toggle-btn');
                    const catNameText = row.querySelector('.target-name').innerText;

                    if (isCurrentlyActive) {
                        statusCell.innerHTML = '<span class="status-badge status-inactive">Inactive</span>';
                        actionButton.className = 'action-toggle-btn btn-activate';
                        actionButton.title = 'Activate Category';
                        actionButton.setAttribute('onclick', `openToggleModal(${catId}, '${catNameText}', false)`);
                        actionButton.innerHTML = '<i class="bi bi-check-circle"></i>';
                    } else {
                        statusCell.innerHTML = '<span class="status-badge status-active">Active</span>';
                        actionButton.className = 'action-toggle-btn btn-deactivate';
                        actionButton.title = 'Deactivate Category';
                        actionButton.setAttribute('onclick', `openToggleModal(${catId}, '${catNameText}', true)`);
                        actionButton.innerHTML = '<i class="bi bi-slash-circle"></i>';
                    }
                }
                closeToggleModal();
            } else {
                // Renders backend custom string block (e.g. "This category is currently assigned to 6 document(s)...")
                alert(data.message || "Action blocked by data constraint configuration maps.");
            }
        })
        .catch(() => alert("Network exceptions processing master state variations loops."));
    }

    // Trigger local sorting filters if value terms persist on load boundaries
    if(document.getElementById("catSearchInput").value.trim() !== "") {
        filterCategoriesTable();
    }
</script>