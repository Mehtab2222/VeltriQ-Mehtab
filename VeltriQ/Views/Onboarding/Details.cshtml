
@model VeltriQ.ViewModels.EmployeeOnboarding.EmployeeOnboardingDetailsViewModel

@{
    ViewData["Title"] = "Onboarding Profile Details";
}

<style>
    .profile-details-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── TOP HERO PROFILE BANNER ── */
    .profile-hero-banner {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
    }

    .hero-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .hero-identity-block {
        display: flex;
        flex-direction: column;
    }

    .hero-name-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
    }

        .hero-name-row i {
            font-size: 18px;
            color: var(--purple);
        }

        .hero-name-row h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

    .hero-meta-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 2px 0 6px 0;
        font-weight: 600;
    }

    /* ── METADATA STRIP ── */
    .hero-metadata-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .hero-metadata-strip span strong {
            color: var(--text-primary);
        }

    .hero-status-block {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    .status-label-caption {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-secondary);
        letter-spacing: 0.5px;
    }

    /* ── NAVIGATION TAB BAR ── */
    .details-nav-tabs {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 4px 0 0 0;
        border-bottom: 1px solid var(--border);
        gap: 2px;
    }

    .details-tab-item {
        margin-bottom: -1px;
    }

    .details-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-secondary);
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .details-tab-btn:hover {
            color: var(--purple);
        }

        .details-tab-btn.active {
            color: var(--purple);
            background: var(--card-bg);
            border-color: var(--border) var(--border) transparent var(--border);
        }

    /* ── WORKSPACE TAB VIEWPORT ── */
    .workspace-tab-viewport {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 16px;
        min-height: 350px;
    }

    /* ── CONCISE DATA GRID TABLES ── */
    .viewport-grid-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
        margin-bottom: 16px;
    }

        .viewport-grid-table th {
            text-align: left;
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            background: var(--hover-bg);
            border: 1px solid var(--border);
        }

        .viewport-grid-table td {
            padding: 8px 12px;
            border: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .viewport-grid-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── TYPOGRAPHY & SEPARATORS ── */
    .info-section-heading {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--purple);
        margin: 0 0 10px 0;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .info-address-block {
        padding: 10px 12px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        margin-bottom: 16px;
    }

        .info-address-block p {
            margin: 0 0 4px 0;
            font-size: 12.5px;
            color: var(--text-primary);
        }

            .info-address-block p:last-child {
                margin-bottom: 0;
            }

    .info-divider {
        border: none;
        border-top: 1px dashed var(--border);
        margin: 16px 0;
    }

    /* ── OVERVIEW SUMMARY ROWS ── */
    .overview-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
    }

        .overview-summary-row:last-child {
            border-bottom: none;
        }

    .overview-summary-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .overview-summary-value {
        font-size: 12px;
        font-weight: 700;
        color: var(--purple);
    }

    .indicator-check {
        color: #22c55e;
    }

    .indicator-cross {
        color: #ef4444;
    }

    /* ── TIMELINE WORKSPACE ── */
    .timeline-empty-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
        text-align: center;
        color: var(--text-secondary);
    }

        .timeline-empty-placeholder i {
            font-size: 28px;
            opacity: 0.4;
            margin-bottom: 8px;
        }

    /* ── BADGES & ACTION LINKS ── */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-invited {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-progress {
        background: rgba(234, 179, 8, 0.12);
        color: #eab308;
    }

    .status-submitted {
        background: rgba(147, 51, 234, 0.12);
        color: #a855f7;
    }

    .status-approved {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-rejected {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
    }

    .status-default {
        background: var(--hover-bg);
        color: var(--text-secondary);
    }

    .progress-percent-large {
        font-size: 22px;
        font-weight: 800;
        color: var(--purple);
        line-height: 1;
    }

    .form-action-btn {
        height: 32px;
        padding: 0 16px;
        border-radius: 6px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
        cursor: pointer;
    }

        .form-action-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed !important;
        }

    .btn-cancel-theme {
        background: var(--hover-bg);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

        .btn-cancel-theme:hover:not(:disabled) {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }

    .action-link-btn {
        background: transparent;
        border: none;
        color: var(--purple);
        font-weight: 600;
        cursor: pointer;
        font-size: 12px;
        padding: 2px 6px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
    }

        .action-link-btn:hover {
            background: var(--hover-bg);
        }

        .action-link-btn.btn-danger-text {
            color: #ef4444;
        }

    /* ── CUSTOM MICRO MODAL ── */
    .vq-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    .vq-modal-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        width: 420px;
        padding: 16px;
        border-radius: 6px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .vq-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .vq-modal-header h4 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
        }

    .vq-modal-body textarea {
        width: 100%;
        height: 80px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        color: var(--text-primary);
        padding: 8px;
        font-family: inherit;
        font-size: 12.5px;
        resize: none;
        outline: none;
    }

    .vq-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 12px;
    }
</style>

@Html.AntiForgeryToken()

<div class="profile-details-page">

    <div class="profile-hero-banner">
        <div class="hero-top-row">
            <div>
                <a asp-action="Index" class="form-action-btn btn-cancel-theme">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
            <div class="hero-status-block">
                <span class="status-label-caption">Current Lifecycle Status</span>
                @{
                    string statusLower = (Model.Status ?? "").ToLower();
                    string statusClass = statusLower switch
                    {
                        "invited" => "status-invited",
                        "in progress" or "progress" => "status-progress",
                        "submitted" => "status-submitted",
                        "approved" => "status-approved",
                        _ => "status-default"
                    };
                }
                <span class="status-pill @statusClass">
                    <i class="bi bi-circle-fill" style="font-size: 5px;"></i> @Model.Status
                </span>
            </div>
        </div>

        <div class="hero-top-row" style="margin-bottom: 8px;">
            <div class="hero-identity-block">
                <div class="hero-name-row">
                    <i class="bi bi-person-badge"></i>
                    <h2>@Model.CandidateName</h2>
                </div>
                <div class="hero-meta-subtitle">
                    @Model.Designation <span style="color: var(--border); margin: 0 4px;">•</span> @Model.Department
                </div>
            </div>
            <div style="text-align: right; align-self: flex-end;">
                <div class="progress-percent-large">@Model.CompletionPercentage%</div>
                <span class="status-label-caption">Overall Progress</span>
            </div>
        </div>

        <div class="hero-metadata-strip">
            <span>Candidate Code: <strong>@Model.CandidateCode</strong></span>
            <span>Email: <strong>@Model.Email</strong></span>
            <span>Mobile: <strong>@Model.MobileNumber</strong></span>
            <span>Template: <strong>@Model.TemplateName</strong></span>
            <span>Expected Joining: <strong style="color: var(--purple);">@(Model.ExpectedJoiningDate?.ToString("dd MMM yyyy") ?? "-")</strong></span>
        </div>
    </div>

    <ul class="details-nav-tabs">
        <li class="details-tab-item">
            <button class="details-tab-btn active" onclick="toggleDetailsTab('overview', this)">
                <i class="bi bi-pie-chart"></i> Overview
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('information', this)">
                <i class="bi bi-layers"></i> Information
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('documents', this)">
                <i class="bi bi-file-earmark-text"></i> Documents
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('policies', this)">
                <i class="bi bi-shield-check"></i> Policies
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('activities', this)">
                <i class="bi bi-calendar-check"></i> Activities
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('timeline', this)">
                <i class="bi bi-clock-history"></i> Timeline
            </button>
        </li>
    </ul>

    <div class="workspace-tab-viewport">

        <div id="view_overview">
            <div class="overview-summary-row">
                <span class="overview-summary-label">
                    @if (Model.CompletedSections == Model.TotalSections)
                    {
                        <i class="bi bi-check-circle-fill indicator-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill indicator-cross"></i>
                    }
                    Information Sections Completed
                </span>
                <span class="overview-summary-value">@Model.CompletedSections / @Model.TotalSections</span>
            </div>
            <div class="overview-summary-row">
                <span class="overview-summary-label">
                    @if (Model.UploadedDocuments == Model.TotalDocuments)
                    {
                        <i class="bi bi-check-circle-fill indicator-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill indicator-cross"></i>
                    }
                    Documents Uploaded
                </span>
                <span class="overview-summary-value" id="overview_uploaded_docs">@Model.UploadedDocuments / @Model.TotalDocuments</span>
            </div>
            <div class="overview-summary-row">
                <span class="overview-summary-label">
                    @if (Model.VerifiedDocuments == Model.TotalDocuments)
                    {
                        <i class="bi bi-check-circle-fill indicator-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill indicator-cross"></i>
                    }
                    Mandatory Documents Verified
                </span>
                <span class="overview-summary-value">@Model.VerifiedDocuments / @Model.TotalDocuments</span>
            </div>
            <div class="overview-summary-row">
                <span class="overview-summary-label">
                    @if (Model.AcceptedPolicies == Model.TotalPolicies)
                    {
                        <i class="bi bi-check-circle-fill indicator-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill indicator-cross"></i>
                    }
                    Policies Accepted
                </span>
                <span class="overview-summary-value">@Model.AcceptedPolicies / @Model.TotalPolicies</span>
            </div>
            <div class="overview-summary-row">
                <span class="overview-summary-label">
                    @if (Model.CompletedActivities == Model.TotalActivities)
                    {
                        <i class="bi bi-check-circle-fill indicator-check"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill indicator-cross"></i>
                    }
                    Activities Completed
                </span>
                <span class="overview-summary-value">@Model.CompletedActivities / @Model.TotalActivities</span>
            </div>
            @if (Model.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
            {
                <div class="text-end"
                     style="margin-top:32px;
                    border-top:1px dashed var(--border);
                    padding-top:16px;
                    font-size:14px;">

                    <div style="margin-bottom:6px;">
                        <strong>Approved On:</strong>
                        @(Model.ApprovedOn?.ToString("dd MMM yyyy hh:mm tt") ?? "-")
                    </div>

                    <div>
                        <strong>Approved By:</strong>
                        @Model.ApprovedBy
                    </div>

                </div>
            }
            else
            {
                <div class="text-end"
                     style="margin-top:32px;
                    border-top:1px dashed var(--border);
                    padding-top:16px;">

                    <button type="button"
                            class="form-action-btn"
                            style="background:var(--purple);color:white;"
                            onclick="openApproveOnboardingModal()"
                            @(Model.CanApproveOnboarding ? "" : "disabled")>

                        <i class="bi bi-check-circle"></i>
                        Approve Onboarding

                    </button>

                </div>
            }
        </div>

        <div id="view_information" style="display: none;">
            <h5 class="info-section-heading">Personal Information</h5>
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th style="width:220px;">First Name</th>
                        <td>@(Model.PersonalInformation?.FirstName ?? "-")</td>
                        <th style="width:220px;">Middle Name</th>
                        <td>@(Model.PersonalInformation?.MiddleName ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Last Name</th>
                        <td>@(Model.PersonalInformation?.LastName ?? "-")</td>
                        <th>Date of Birth</th>
                        <td>@(Model.PersonalInformation?.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Gender</th>
                        <td>@(Model.PersonalInformation?.Gender ?? "-")</td>
                        <th>Marital Status</th>
                        <td>@(Model.PersonalInformation?.MaritalStatus ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Blood Group</th>
                        <td>@(Model.PersonalInformation?.BloodGroup ?? "-")</td>
                        <th>Nationality</th>
                        <td>@(Model.PersonalInformation?.Nationality ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Religion</th>
                        <td>@(Model.PersonalInformation?.Religion ?? "-")</td>
                        <th></th>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Contact Details</h5>
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th style="width:220px;">Email</th>
                        <td>@(Model.PersonalInformation?.Email ?? "-")</td>
                        <th style="width:220px;">Mobile</th>
                        <td>@(Model.PersonalInformation?.MobileNumber ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Alternate Mobile</th>
                        <td>@(Model.PersonalInformation?.AlternateMobileNumber ?? "-")</td>
                        <th></th>
                        <td></td>
                    </tr>
                </tbody>
            </table>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Family Details</h5>
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th style="width:220px;">Father Name</th>
                        <td>@(Model.PersonalInformation?.FatherName ?? "-")</td>
                        <th style="width:220px;">Mother Name</th>
                        <td>@(Model.PersonalInformation?.MotherName ?? "-")</td>
                    </tr>
                </tbody>
            </table>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Current Address</h5>
            <div class="info-address-block">
                @if (Model.Address != null && !string.IsNullOrWhiteSpace(Model.Address.CurrentAddressLine1))
                {
                    <p>@Model.Address.CurrentAddressLine1</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Address.CurrentAddressLine2))
                    {
                        <p>@Model.Address.CurrentAddressLine2</p>
                    }
                    <p>
                        @Model.Address.CurrentCity, @Model.Address.CurrentState, @Model.Address.CurrentCountry - @Model.Address.CurrentPostalCode
                    </p>
                }
                else
                {
                    <p style="color: var(--text-muted); font-style: italic;">No current address information recorded.</p>
                }
            </div>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Permanent Address</h5>
            <div class="info-address-block">
                @if (Model.Address != null && !string.IsNullOrWhiteSpace(Model.Address.PermanentAddressLine1))
                {
                    <p>@Model.Address.PermanentAddressLine1</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Address.PermanentAddressLine2))
                    {
                        <p>@Model.Address.PermanentAddressLine2</p>
                    }
                    <p>
                        @Model.Address.PermanentCity, @Model.Address.PermanentState, @Model.Address.PermanentCountry - @Model.Address.PermanentPostalCode
                    </p>
                }
                else
                {
                    <p style="color: var(--text-muted); font-style: italic;">No permanent address information recorded.</p>
                }
            </div>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Dependents</h5>
            <table class="viewport-grid-table">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Relationship</th>
                        <th>Date of Birth</th>
                        <th>Nominee</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Dependents?.Dependents != null && Model.Dependents.Dependents.Any())
                    {
                        foreach (var item in Model.Dependents.Dependents)
                        {
                            <tr>
                                <td>@item.FullName</td>
                                <td>@item.Relationship</td>
                                <td>@(item.DateOfBirth?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    @if (item.IsNominee)
                                    {
                                        <span class="status-pill status-approved">Yes</span>
                                    }
                                    else
                                    {
                                        <span>No</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 12px;">
                                No dependents available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <hr class="info-divider" />

            <h5 class="info-section-heading">Qualifications</h5>
            <table class="viewport-grid-table">
                <thead>
                    <tr>
                        <th>Qualification</th>
                        <th>Institute</th>
                        <th>Passing Year</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Qualifications?.Qualifications != null && Model.Qualifications.Qualifications.Any())
                    {
                        foreach (var item in Model.Qualifications.Qualifications)
                        {
                            <tr>
                                <td>@item.QualificationName</td>
                                <td>@item.Institute</td>
                                <td>@item.PassingYear</td>
                                <td>@item.Percentage %</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 12px;">
                                No qualifications available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="view_documents" style="display: none;">
            <table class="viewport-grid-table">
                <thead>
                    <tr>
                        <th>Document Name</th>
                        <th style="width: 90px;">Mandatory</th>
                        <th style="width: 90px;">Uploaded</th>
                        <th style="width: 110px;">Status</th>
                        <th>Uploaded On</th>
                        <th style="width: 240px; text-align: center;">HR Action Workspace</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DocumentsList != null && Model.DocumentsList.Any())
                    {
                        foreach (var doc in Model.DocumentsList)
                        {
                            <tr id="doc_row_@doc.EmployeeOnboardingDocumentId">
                                <td style="font-weight: 600;">@doc.DocumentName</td>
                                <td style="color: var(--text-secondary);">@(doc.IsMandatory ? "Yes" : "No")</td>
                                <td>
                                    <i class="bi @(doc.IsUploaded ? "bi-check2 text-success" : "bi-dash var(--text-muted)")"></i>
                                </td>
                                <td class="status-cell">
                                    @if (doc.IsUploaded)
                                    {
                                        string docStatusClass = doc.IsVerified ? "status-approved" : (!string.IsNullOrWhiteSpace(doc.Remarks) ? "status-rejected" : "status-progress");
                                        string docStatusLabel = doc.IsVerified ? "Verified" : (!string.IsNullOrWhiteSpace(doc.Remarks) ? "Rejected" : "Pending");

                                        <span class="status-pill @docStatusClass">@docStatusLabel</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">-</span>
                                    }
                                </td>
                                <td style="color: var(--text-secondary);">@(doc.UploadedOn?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td class="action-cell" style="text-align: center;">
                                    @if (doc.IsUploaded)
                                    {
                                        @if (!string.IsNullOrWhiteSpace(doc.FilePath))
                                        {
                                            <a href="@doc.FilePath" target="_blank" class="action-link-btn view-link">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-secondary); font-size: 11px; margin-right: 4px;" class="file-name-txt">@doc.FileName</span>
                                        }

                                        @if (!doc.IsVerified)
                                        {
                                            <span class="action-divider" style="color: var(--border); margin: 0 2px;">|</span>
                                            <button type="button" class="action-link-btn btn-approve-action" onclick="approveDocument(@doc.EmployeeOnboardingDocumentId)">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </button>
                                            <span class="action-divider" style="color: var(--border); margin: 0 2px;">|</span>
                                            <button type="button" class="action-link-btn btn-danger-text btn-reject-action" onclick="openRejectModal(@doc.EmployeeOnboardingDocumentId, '@doc.DocumentName')">
                                                <i class="bi bi-x-circle"></i> Reject
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-success verified-badge" style="font-size: 11px; font-weight: 700; margin-left: 6px;">
                                                <i class="bi bi-shield-check"></i> Verified
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-size: 11px; font-style: italic;">No candidate payload</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No templates documents mapped to this workflow.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="view_policies" style="display: none;">
            <table class="viewport-grid-table">
                <thead>
                    <tr>
                        <th>Policy Name</th>
                        <th style="width: 120px;">Mandatory</th>
                        <th style="width: 120px;">Accepted</th>
                        <th>Accepted On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PoliciesList != null && Model.PoliciesList.Any())
                    {
                        foreach (var policy in Model.PoliciesList)
                        {
                            <tr>
                                <td style="font-weight: 600;">@policy.PolicyName</td>
                                <td style="color: var(--text-secondary);">@(policy.IsMandatory ? "Yes" : "No")</td>
                                <td>
                                    <i class="bi @(policy.IsAccepted ? "bi-check2 text-success" : "bi-hourglass-split text-warning")"></i>
                                </td>
                                <td style="color: var(--text-secondary);">@(policy.AcceptedOn?.ToString("dd MMM yyyy") ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No system regulatory policies assigned.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="view_activities" style="display: none;">
            <table class="viewport-grid-table">
                <thead>
                    <tr>
                        <th>Activity Name</th>
                        <th style="width: 120px;">Completed</th>
                        <th>Completed On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActivitiesList != null && Model.ActivitiesList.Any())
                    {
                        foreach (var act in Model.ActivitiesList)
                        {
                            <tr>
                                <td style="font-weight: 600;">@act.ActivityName</td>
                                <td>
                                    <i class="bi @(act.IsCompleted ? "bi-check2 text-success" : "bi-dash var(--text-muted)")"></i>
                                </td>
                                <td style="color: var(--text-secondary);">@(act.CompletedOn?.ToString("dd MMM yyyy") ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No operational task activities linked.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="view_timeline" style="display: none;">
            <div class="timeline-empty-placeholder">
                <i class="bi bi-clock-history"></i>
                <div>No onboarding activity available.</div>
            </div>
        </div>

    </div>
</div>

<!-- ── CUSTOM MODAL: REJECT DOCUMENT ── -->
<div id="hrRejectDocModal" class="vq-modal-backdrop" style="display: none;">
    <div class="vq-modal-card">
        <div class="vq-modal-header">
            <h4 id="rejectModalTitle">Reject Document</h4>
            <button type="button" style="background:transparent; border:none; color:var(--text-secondary); cursor:pointer;" onclick="closeRejectModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="vq-modal-body">
            <input type="hidden" id="rejectTargetDocId" value="0" />
            <textarea id="txtRejectRemarks" placeholder="Provide reason or correction remarks for the candidate..."></textarea>
        </div>
        <div class="vq-modal-footer">
            <button type="button" class="form-action-btn btn-cancel-theme" onclick="closeRejectModal()">Cancel</button>
            <button type="button" class="form-action-btn" style="background:#ef4444; color:#fff;" onclick="submitDocumentRejection()">Confirm Rejection</button>
        </div>
    </div>
</div>

<!-- ── CUSTOM MODAL: APPROVE ONBOARDING ── -->
<div id="approveOnboardingModal" class="vq-modal-backdrop" style="display: none;">
    <div class="vq-modal-card">
        <div class="vq-modal-header">
            <h4>Approve Onboarding Workflow</h4>
            <button type="button" style="background: transparent; border: none; color: var(--text-secondary); cursor: pointer;" onclick="closeApproveOnboardingModal()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="vq-modal-body">
            <p style="margin: 0; font-size: 13px; color: var(--text-primary); line-height: 1.5;">
                Are you sure you want to finalize and approve this onboarding profile setup?
                <br /><br />
                Once confirmed, the workflow milestones will be locked down, transitioning the records to active state.
            </p>
        </div>
        <div class="vq-modal-footer">
            <button type="button" class="form-action-btn btn-cancel-theme" onclick="closeApproveOnboardingModal()">Cancel</button>
            <button type="button" class="form-action-btn" style="background: #22c55e; color: #fff;" onclick="submitApproveOnboarding()">Confirm Approval</button>
        </div>
    </div>
</div>

<script>
    function toggleDetailsTab(targetViewId, buttonElement) {
        const tabs = buttonElement.closest('.details-nav-tabs').getElementsByClassName('details-tab-btn');
        for (let i = 0; i < tabs.length; i++) {
            tabs[i].classList.remove('active');
        }

        buttonElement.classList.add('active');

        const targets = ['overview', 'information', 'documents', 'policies', 'activities', 'timeline'];
        targets.forEach(view => {
            const el = document.getElementById('view_' + view);
            if (el) el.style.display = 'none';
        });

        const targetView = document.getElementById('view_' + targetViewId);
        if (targetView) targetView.style.display = 'block';
    }

    /* ── DOCUMENT APPROVAL PIPELINE ── */
    function approveDocument(documentId) {
        if (!confirm("Are you sure you want to verify and approve this document?")) return;

        fetch('/Onboarding/ApproveDocument', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ id: documentId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const row = document.getElementById(`doc_row_${documentId}`);
                if (row) {
                    const statusCell = row.querySelector('.status-cell');
                    statusCell.innerHTML = '<span class="status-pill status-approved">Verified</span>';

                    const actionCell = row.querySelector('.action-cell');
                    const viewLink = actionCell.querySelector('.view-link');
                    const fileNameTxt = actionCell.querySelector('.file-name-txt');

                    let viewHtml = '';
                    if (viewLink) {
                        viewHtml = viewLink.outerHTML;
                    } else if (fileNameTxt) {
                        viewHtml = fileNameTxt.outerHTML;
                    }

                    actionCell.innerHTML = viewHtml + ' <span class="text-success verified-badge" style="font-size: 11px; font-weight: 700; margin-left: 6px;"><i class="bi bi-shield-check"></i> Verified</span>';
                }
            } else {
                alert(data.message || "Failed to approve the document configuration target.");
            }
        })
        .catch(() => alert("Error communicating with verification action pipeline."));
    }

    /* ── DOCUMENT REJECTION INTERACTION MODAL ── */
    function openRejectModal(documentId, docName) {
        document.getElementById("rejectTargetDocId").value = documentId;
        document.getElementById("rejectModalTitle").innerText = "Reject - " + docName;
        document.getElementById("txtRejectRemarks").value = "";
        document.getElementById("hrRejectDocModal").style.display = "flex";
    }

    function closeRejectModal() {
        document.getElementById("hrRejectDocModal").style.display = "none";
        document.getElementById("rejectTargetDocId").value = "0";
    }

    function submitDocumentRejection() {
        const docId = document.getElementById("rejectTargetDocId").value;
        const remarksValue = document.getElementById("txtRejectRemarks").value.trim();

        if (!remarksValue) {
            alert("Please enter a rejection remark for context instruction.");
            return;
        }

        fetch('/Onboarding/RejectDocument', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ id: docId, remarks: remarksValue })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const row = document.getElementById(`doc_row_${docId}`);
                if (row) {
                    const statusCell = row.querySelector('.status-cell');
                    statusCell.innerHTML = '<span class="status-pill status-rejected">Rejected</span>';
                }
                closeRejectModal();
            } else {
                alert(data.message || "Failed to process target rejection payload workflow state.");
            }
        })
        .catch(() => alert("Fatal connectivity breakdown handling data write."));
    }

    /* ── APPLICATION OVERVIEW ONBOARDING WORKFLOW APPROVAL PIPELINE ── */
    function openApproveOnboardingModal() {
        document.getElementById("approveOnboardingModal").style.display = "flex";
    }

    function closeApproveOnboardingModal() {
        document.getElementById("approveOnboardingModal").style.display = "none";
    }

    function submitApproveOnboarding() {
        const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');

        fetch('/Onboarding/ApproveOnboarding', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': tokenElement ? tokenElement.value : ''
            },
            body: JSON.stringify({ employeeOnboardingId: @Model.EmployeeOnboardingId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                closeApproveOnboardingModal();
                if(data.message) {
                    alert(data.message);
                }
                location.reload();
            } else {
                alert(data.message || "Failed to finalize target validation state mapping pipeline workflow.");
            }
        })
        .catch(() => alert("Fatal connectivity breakdown handling data write validation processing actions."));
    }
</script>
