@model VeltriQ.Models.HR.EmployeeSuspension

@{
    ViewData["Title"] = "Create Employee Suspension";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .suspension-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        padding-bottom: 30px;
    }

    /* TOPBAR */
    .suspension-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
    }

    .suspension-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

        .suspension-breadcrumb a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
        }

        .suspension-breadcrumb i {
            color: var(--text-muted);
            font-size: 10px;
        }

        .suspension-breadcrumb span {
            color: var(--text-secondary);
            font-weight: 500;
        }

    .suspension-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cancel-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .cancel-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    .save-btn-danger {
        height: 32px;
        padding: 0 16px;
        border: none;
        border-radius: 4px;
        background: #ef4444;
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .save-btn-danger:hover {
            opacity: 0.9;
        }

    /* SINGLE COMPACT CARD MODULE (3 Columns per row) */
    .suspension-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
    }

    .suspension-card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .col-span-2 {
        grid-column: span 2;
    }

    .col-span-3 {
        grid-column: span 3;
    }

    /* FIELD */
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .form-field label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

    /* INPUT */
    .form-input, .form-select {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .form-input:focus, .form-select:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.1);
        }

        .form-input::placeholder {
            color: var(--text-muted);
        }

    textarea.form-input {
        height: auto;
        min-height: 70px;
        padding-top: 8px;
        resize: vertical;
    }

    /* RESPONSIVE */
    @@media(max-width: 1024px) {
        .suspension-card-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .col-span-2, .col-span-3 {
            grid-column: span 2;
        }
    }

    @@media(max-width: 640px) {
        .suspension-card-grid {
            grid-template-columns: 1fr;
        }

        .col-span-2, .col-span-3 {
            grid-column: span 1;
        }

        .suspension-topbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .suspension-top-actions {
            width: 100%;
        }

        .cancel-btn,
        .save-btn-danger {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="suspension-create-page">

    <!-- TOPBAR -->
    <div class="suspension-topbar">
        <div class="suspension-breadcrumb">
            <a href="/EmployeeSuspension/Index">Employee Suspensions</a>
            <i class="bi bi-chevron-right"></i>
            <span>Create</span>
        </div>

        <div class="suspension-top-actions">
            <a href="/EmployeeSuspension/Index" class="cancel-btn">
                <i class="bi bi-x"></i> Cancel
            </a>
            <button type="submit" form="suspensionForm" class="save-btn-danger">
                <i class="bi bi-slash-circle"></i> Suspend Employee
            </button>
        </div>
    </div>

    <!-- FORM -->
    <form id="suspensionForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- SINGLE COMPACT CARD (3 Fields per row) -->
        <div class="suspension-master-card">
            <div class="suspension-card-grid">

                <!-- EMPLOYEE -->
                <div class="form-field">
                    <label>Employee *</label>
                    <select asp-for="EmployeeId" asp-items="ViewBag.EmployeeList" class="form-select" required>
                        <option value="">-- Select Employee --</option>
                    </select>
                </div>

                <!-- SUSPENSION TYPE -->
                <div class="form-field">
                    <label>Suspension Type *</label>
                    <select asp-for="SuspensionType" class="form-select" required>
                        <option value="">Select Suspension Type</option>
                        <option value="Disciplinary">Disciplinary</option>
                        <option value="Investigation">Investigation</option>
                        <option value="Policy Violation">Policy Violation</option>
                        <option value="Misconduct">Misconduct</option>
                    </select>
                </div>

                <!-- SUSPENSION DATE -->
                <div class="form-field">
                    <label>Suspension Date *</label>
                    <input asp-for="SuspensionDate" type="date" class="form-input" required />
                </div>

                <!-- EXPECTED END DATE -->
                <div class="form-field">
                    <label>Expected End Date</label>
                    <input asp-for="EndDate" type="date" class="form-input" />
                </div>

                <!-- SUSPENSION REASON -->
                <div class="form-field col-span-2">
                    <label>Suspension Reason</label>
                    <textarea asp-for="SuspensionReason" rows="3" class="form-input" placeholder="Provide detailed documentation for the suspension..."></textarea>
                </div>

            </div>
        </div>
    </form>
</div>