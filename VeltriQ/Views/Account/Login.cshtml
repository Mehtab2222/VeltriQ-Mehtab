@model VeltriQ.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VeltriQ HRMS | Secure Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #7c3aed;
            --primary-light: #a78bfa;
            --accent: #2563eb;
            --bg-dark: #090e1a; /* Deeper dark for contrast */
            --text-muted: #94a3b8;
            /* Subtler glass transparency */
            --glass: rgba(15, 23, 42, 0.55);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }

        body {
            min-height: 100vh;
            overflow: hidden;
            background: var(--bg-dark);
            color: #fff;
            position: relative;
        }

        /* --- GLOBAL BACKGROUND DRIFT --- */
        .bg-blur {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.3;
            z-index: 0;
            animation: globalDrift 20s infinite alternate ease-in-out;
        }

        .blur-1 {
            width: 400px;
            height: 400px;
            background: var(--primary);
            top: -10%;
            left: -5%;
        }

        .blur-2 {
            width: 350px;
            height: 350px;
            background: var(--accent);
            bottom: -5%;
            right: -5%;
            animation-delay: -7s;
        }

        @@keyframes globalDrift {
            from

        {
            transform: translate(0, 0);
        }

        to {
            transform: translate(60px, 40px);
        }

        }

        /* --- MAIN LAYOUT --- */
        .login-container {
            position: relative;
            z-index: 2;
            width: 100%;
            height: 100vh;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
        }

        /* LEFT PANEL (BRANDING) */
        .login-left {
            padding: 100px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .brand-badge {
            width: fit-content;
            padding: 6px 14px;
            border-radius: 100px;
            background: rgba(124, 58, 237, 0.1);
            border: 1px solid rgba(124, 58, 237, 0.2);
            color: var(--primary-light);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 20px;
        }

        .login-left h1 {
            font-size: 56px;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 20px;
            letter-spacing: -1.5px;
        }

        /* --- RIGHT PANEL (THE COMPACT, ANIMATED CARD) --- */
        .login-right {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 380px;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.2);
            transition: border-color 0.4s, box-shadow 0.4s;
            position: relative;
            overflow: hidden; /* Necessary for background animation */
            border: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 1;
        }

            /* NEW: Hover Effect on the Card itself */
            .login-card:hover {
                border-color: rgba(124, 58, 237, 0.3);
                box-shadow: 0 0 40px rgba(124, 58, 237, 0.15);
            }

            /* NEW: The subtle background "motion" gradient */
            .login-card::before,
            .login-card::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                z-index: -1; /* Place behind card content */
                opacity: 0.2; /* Subtlety is key */
                filter: blur(40px); /* Blend the gradients */
                animation-duration: 25s;
                animation-iteration-count: infinite;
                animation-timing-function: linear;
            }

            /* Gradient One: Deep Primary and Blue */
            .login-card::before {
                background: conic-gradient(from 180deg at 50% 50%, var(--primary) 0deg, var(--accent) 90deg, transparent 180deg, var(--primary) 360deg);
                animation-name: meshFlow;
                mix-blend-mode: color-dodge; /* Blend perfectly with dark card */
            }

            /* Gradient Two: Opposite Rotation */
            .login-card::after {
                background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, var(--accent) 90deg, var(--primary) 180deg, transparent 360deg);
                animation-name: meshFlowOpposite;
                animation-delay: -10s;
            }

        @@keyframes meshFlow {
            0%

        {
            transform: rotate(0deg) scale(1);
        }

        50% {
            transform: rotate(180deg) scale(1.1);
        }

        100% {
            transform: rotate(360deg) scale(1);
        }

        }

        @@keyframes meshFlowOpposite {
            0%

        {
            transform: rotate(360deg) scale(1.1);
        }

        50% {
            transform: rotate(180deg) scale(1);
        }

        100% {
            transform: rotate(0deg) scale(1.1);
        }

        }

        /* Glass layer (Ensures content contrast against the moving mesh) */
        .card-content-wrapper {
            position: relative;
            z-index: 2; /* Content sits above moving background */
            background: var(--glass);
            margin: -32px; /* Offset the parent padding */
            padding: 32px; /* Add the padding back in */
            border-radius: 24px;
            backdrop-filter: blur(16px);
        }

        .login-logo {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
            box-shadow: 0 8px 20px rgba(124, 58, 237, 0.3);
        }

        .login-card h2 {
            font-size: 24px;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .login-card .subtitle {
            color: var(--text-muted);
            font-size: 13px;
            margin-bottom: 24px;
        }

        /* FORM ELEMENTS */
        .form-group {
            margin-bottom: 18px;
            text-align: left;
        }

            .form-group label {
                display: block;
                font-size: 11px;
                font-weight: 700;
                color: #94a3b8;
                margin-bottom: 6px;
                letter-spacing: 0.5px;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: #475569;
                font-size: 14px;
                transition: 0.3s;
            }

        .form-control {
            width: 100%;
            height: 48px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.05);
            background: rgba(0,0,0,0.3);
            padding: 0 16px 0 44px;
            color: #fff;
            font-size: 14px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--primary);
                background: rgba(0,0,0,0.5);
                box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
            }

                .form-control:focus + i {
                    color: var(--primary-light);
                }

        .validation-msg {
            color: #ef4444;
            font-size: 11px;
            margin-top: 4px;
            display: block;
        }

        .login-btn {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 12px;
            background: var(--primary);
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 8px;
            box-shadow: 0 10px 20px rgba(124, 58, 237, 0.2);
        }

            .login-btn:hover {
                background: var(--primary-light);
                transform: translateY(-1px);
                box-shadow: 0 15px 30px rgba(124, 58, 237, 0.3);
            }

        /* FOOTER - ENSURE MAX VISIBILITY */
        .login-footer {
            margin-top: 24px;
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
            letter-spacing: 0.3px;
            line-height: 1.5;
            position: relative;
            z-index: 3; /* Keep it above everything */
        }

            .login-footer b {
                color: #fff;
            }

        /* MOBILE FIX */
        @@media (max-width: 900px) {
            .login-container {
                grid-template-columns: 1fr;
            }

            .login-left {
                display: none;
            }

            .login-card {
                max-width: 360px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-blur blur-1"></div>
    <div class="bg-blur blur-2"></div>

    <main class="login-container">
        <section class="login-left">
            <div class="brand-badge">HRMS CLOUD</div>
            <h1>The Future of <br>Workforce Management.</h1>
            <p style="color:var(--text-muted); font-size:16px;">Automate payroll, track attendance, and manage employees in one subtle, powerful interface.</p>
        </section>

        <section class="login-right">
            <div class="login-card">
                <div class="card-content-wrapper">
                    <div class="login-logo">
                        <i class="bi bi-intersect"></i>
                    </div>
                    <h2>Welcome Back</h2>
                    <p class="subtitle">Securely log in to your HR portal</p>

                    <form asp-action="Login" asp-controller="Account" method="post">
                        <div class="form-group">
                            <label asp-for="Email">OFFICIAL EMAIL</label>
                            <div class="input-wrapper">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Email" class="form-control" placeholder="name@company.com" />
                            </div>
                            <span asp-validation-for="Email" class="validation-msg"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">PASSWORD</label>
                            <div class="input-wrapper">
                                <i class="bi bi-shield-lock"></i>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="validation-msg"></span>
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <label style="display: flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 12px; cursor: pointer;">
                                <input asp-for="RememberMe" type="checkbox" style="accent-color: var(--primary);" /> Remember Me
                            </label>
                            <a href="#" style="color:var(--primary-light); text-decoration:none; font-size:12px;">Forgot?</a>
                        </div>

                        <button type="submit" class="login-btn">Access Dashboard</button>
                    </form>
                </div>
            </div>

            <div class="login-footer">
                © 2026 <b>VeltriQ</b> HRMS Enterprise Solution. <br>
                Unauthorized access is strictly prohibited.
            </div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>