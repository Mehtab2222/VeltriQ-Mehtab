@model VeltriQ.Models.HR.AssetMaster

@{
    ViewData["Title"] = "Create Asset";
}

<style>

    .asset-create-page {
        padding: 4px 0 32px;
    }

    /* TOPBAR */

    .asset-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        gap: 20px;
    }

    .asset-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
    }

        .asset-breadcrumb a {
            color: #8b5cf6;
            text-decoration: none;
            font-weight: 600;
        }

        .asset-breadcrumb span {
            color: #94a3b8;
        }

    .asset-top-actions {
        display: flex;
        gap: 10px;
    }

    .cancel-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        color: #94a3b8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .save-btn {
        height: 40px;
        padding: 0 20px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 22px rgba(124,58,237,.24);
    }

    /* CARD */

    .asset-card {
        max-width: 1000px;
        background: rgba(30,35,44,.92);
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.06);
        overflow: hidden;
    }

    .asset-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .asset-card-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(124,58,237,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a78bfa;
    }

    .asset-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    /* BODY */

    .asset-card-body {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .full-width {
        grid-column: span 2;
    }

    /* FIELD */

    .form-field {
        display: flex;
        flex-direction: column;
    }

        .form-field label {
            margin-bottom: 7px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .7px;
            text-transform: uppercase;
        }

    /* INPUT */

    .form-input,
    .form-select {
        width: 100%;
        height: 42px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(15,20,30,.7);
        color: #fff;
        padding: 0 14px;
        font-size: 13px;
        outline: none;
    }

        .form-input:focus,
        .form-select:focus {
            border-color: #7c3aed;
            background: rgba(124,58,237,.06);
            box-shadow: 0 0 0 3px rgba(124,58,237,.12);
        }

</style>

<div class="asset-create-page">

    <!-- TOPBAR -->

    <div class="asset-topbar">

        <div class="asset-breadcrumb">

            <a href="/AssetMaster/Index">
                Asset Master
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Create</span>

        </div>

        <div class="asset-top-actions">

            <a href="/AssetMaster/Index"
               class="cancel-btn">

                <i class="bi bi-x"></i>

                Cancel

            </a>

            <button type="submit"
                    form="assetForm"
                    class="save-btn">

                <i class="bi bi-box-seam"></i>

                Save Asset

            </button>

        </div>

    </div>

    <!-- FORM -->

    <form id="assetForm"
          asp-action="Create"
          method="post">

        <div class="asset-card">

            <div class="asset-card-header">

                <div class="asset-card-icon">

                    <i class="bi bi-laptop"></i>

                </div>

                <div class="asset-card-title">
                    Asset Information
                </div>

            </div>

            <div class="asset-card-body">

                <!-- NAME -->

                <div class="form-field full-width">

                    <label>
                        Asset Name
                    </label>

                    <input asp-for="AssetName"
                           class="form-input"
                           placeholder="Enter asset name" />

                </div>

                <!-- CODE -->

                <div class="form-field">

                    <label>
                        Asset Code
                    </label>

                    <input asp-for="AssetCode"
                           class="form-input"
                           placeholder="AST-001" />

                </div>

                <!-- CATEGORY -->

                <div class="form-field">

                    <label>
                        Asset Category
                    </label>

                    <select asp-for="AssetCategory"
                            class="form-select">

                        <option value="">
                            Select Category
                        </option>

                        <option>IT Asset</option>
                        <option>Office Asset</option>
                        <option>Security Asset</option>
                        <option>Furniture</option>

                    </select>

                </div>

                <!-- BRAND -->

                <div class="form-field">

                    <label>
                        Brand Name
                    </label>

                    <input asp-for="BrandName"
                           class="form-input"
                           placeholder="Dell / HP / Lenovo" />

                </div>

                <!-- MODEL -->

                <div class="form-field">

                    <label>
                        Model Name
                    </label>

                    <input asp-for="ModelName"
                           class="form-input"
                           placeholder="Latitude 5440" />

                </div>

                <!-- SERIAL -->

                <div class="form-field">

                    <label>
                        Serial Number Required
                    </label>

                    <select asp-for="SerialNumberRequired"
                            class="form-select">

                        <option value="true">
                            Yes
                        </option>

                        <option value="false">
                            No
                        </option>

                    </select>

                </div>

                <!-- RETURNABLE -->

                <div class="form-field">

                    <label>
                        Is Returnable
                    </label>

                    <select asp-for="IsReturnable"
                            class="form-select">

                        <option value="true">
                            Yes
                        </option>

                        <option value="false">
                            No
                        </option>

                    </select>

                </div>

                <!-- DESCRIPTION -->

                <div class="form-field full-width">

                    <label>
                        Description
                    </label>

                    <input asp-for="Description"
                           class="form-input"
                           placeholder="Enter asset description" />

                </div>

            </div>

        </div>

    </form>

</div>