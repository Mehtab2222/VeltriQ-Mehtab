@model VeltriQ.ViewModels.AssetInventory.AssetInventoryDetailsViewModel

@{
    ViewData["Title"] = "Asset Stock Details";
}

<style>
    .inventory-details-frame {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── PROFILE HERO WORKSPACE BANNER ── */
    .inventory-hero-banner {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
    }

    .hero-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .hero-identity-deck {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hero-avatar-box {
        width: 42px;
        height: 42px;
        border-radius: 0px; /* Strict Squared Layout Code */
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .hero-title-block {
        display: flex;
        flex-direction: column;
    }

        .hero-title-block h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

    .hero-meta-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
        font-weight: 600;
    }

    /* ── METADATA INFO STRIP ── */
    .hero-metadata-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .hero-metadata-strip span strong {
            color: var(--text-primary);
        }

    /* ── HIGH DENSITY INFORMATION BLOCKS GRID ── */
    .grid-layout-deck {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .workspace-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    .workspace-card-header {
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        background: var(--hover-bg);
    }

        .workspace-card-header h3 {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    /* ── CONCISE DATA GRIDS ── */
    .viewport-grid-table {
        width: 100%;
        border-collapse: collapse;
    }

        .viewport-grid-table th {
            text-align: left;
            padding: 8px 14px;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            background: rgba(255, 255, 255, 0.01);
            border-bottom: 1px solid var(--border);
            border-right: 1px solid var(--border);
            width: 160px;
        }

        .viewport-grid-table td {
            padding: 8px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .viewport-grid-table tr:last-child th,
        .viewport-grid-table tr:last-child td {
            border-bottom: none;
        }

    /* ── SYSTEM STATUS STATE BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-available {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-allocated {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .btn-cancel-theme {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }
</style>

<div class="inventory-details-frame">

    <div class="hero-top-row">
        <div>
            <a asp-action="Index" class="btn-cancel-theme">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>
    </div>

    <div class="inventory-hero-banner">
        <div class="hero-top-row">
            <div class="hero-identity-deck">
                <div class="hero-avatar-box">
                    <i class="bi bi-box-seam" style="font-size: 16px;"></i>
                </div>
                <div class="hero-title-block">
                    <h2>@Model.AssetName</h2>
                    <div class="hero-meta-subtitle">
                        @Model.BrandName <span style="color: var(--border); margin: 0 4px;">•</span> @Model.ModelName
                    </div>
                </div>
            </div>
            <div>
                @{
                    string statusLower = (Model.InventoryStatus ?? "").ToLower();
                    string statusClass = statusLower switch
                    {
                        "available" or "instock" or "in stock" => "status-available",
                        "allocated" or "assigned" or "issued" => "status-allocated",
                        _ => "status-category"
                    };
                }
                <span class="status-badge @statusClass">@Model.InventoryStatus</span>
            </div>
        </div>

        <div class="hero-metadata-strip">
            <span>Inventory Code: <strong style="color: var(--purple);">@Model.InventoryCode</strong></span>
            <span>Asset Catalog ID: <strong>@Model.AssetCode</strong></span>
            <span>Category Group: <span class="status-badge status-category" style="height: 16px; font-size: 9.5px; padding: 0 6px;">@Model.AssetCategory</span></span>
            <span>Registered On: <strong>@Model.CreatedOn.ToString("dd MMM yyyy")</strong></span>
        </div>
    </div>

    <div class="grid-layout-deck">

        <div class="workspace-card">
            <div class="workspace-card-header">
                <h3>Item Specifications</h3>
            </div>
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th>Serial Number</th>
                        <td style="font-family: monospace; font-weight: 600;">
                            @(string.IsNullOrWhiteSpace(Model.SerialNumber) ? "N/A (Tracking Key Exempt)" : Model.SerialNumber)
                        </td>
                    </tr>
                    <tr>
                        <th>Asset Condition</th>
                        <td style="font-weight: 600;">@(Model.AssetCondition ?? "-")</td>
                    </tr>
                    <tr>
                        <th>System Activity State</th>
                        <td>
                            @if (Model.IsActive)
                            {
                                <span class="text-success" style="font-weight: 600;"><i class="bi bi-circle-fill" style="font-size: 6px; margin-right: 4px;"></i> Active Registry</span>
                            }
                            else
                            {
                                <span class="text-danger" style="font-weight: 600;"><i class="bi bi-circle-fill" style="font-size: 6px; margin-right: 4px;"></i> Archived / Inactive</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Internal Logs / Notes</th>
                        <td style="color: var(--text-secondary); font-style: italic; font-size: 12px; line-height: 1.4;">
                            @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No storage remarks or extra technical log updates recorded." : Model.Remarks)
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="workspace-card">
            <div class="workspace-card-header">
                <h3>Acquisition & Vendor Audit</h3>
            </div>
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th>Acquisition Date</th>
                        <td>@(Model.PurchaseDate?.ToString("dd MMM yyyy") ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Acquisition Cost</th>
                        <td style="font-weight: 700; color: var(--purple);">
                            @(Model.PurchaseCost.HasValue? Model.PurchaseCost.Value.ToString("C2") : "-")
                        </td>
                    </tr>
                    <tr>
                        <th>Vendor Supplier Entity</th>
                        <td style="font-weight: 600;">@(Model.VendorName ?? "-")</td>
                    </tr>
                    <tr>
                        <th>Last Ledger Modification</th>
                        <td style="color: var(--text-secondary);">
                            @(Model.ModifiedOn.HasValue? Model.ModifiedOn.Value.ToString("dd MMM yyyy HH:mm") : "Never Modified")
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <div class="workspace-card">
        <div class="workspace-card-header">
            <h3>Live Assignment & Custody Log</h3>
        </div>
        @if (Model.IsAllocated)
        {
            <table class="viewport-grid-table">
                <tbody>
                    <tr>
                        <th style="width: 200px;">Current Custodian Account</th>
                        <td style="font-weight: 700;">
                            <i class="bi bi-person-badge" style="color: var(--purple); margin-right: 6px;"></i> @Model.EmployeeName
                        </td>
                    </tr>
                    <tr>
                        <th>Custodian Tracking Code</th>
                        <td style="font-weight: 600; color: var(--text-secondary);">@Model.EmployeeCode</td>
                    </tr>
                    <tr>
                        <th>Custody Handover Date</th>
                        <td>
                            <span class="status-badge status-allocated">
                                <i class="bi bi-calendar-check" style="font-size: 10px; margin-right: 4px;"></i> @(Model.IssueDate?.ToString("dd MMM yyyy HH:mm") ?? "-")
                            </span>
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px; font-size: 13px; background: rgba(255,255,255,0.005);">
                <i class="bi bi-shield-check" style="font-size: 20px; color: #22c55e; display: block; margin-bottom: 6px; opacity: 0.8;"></i>
                This asset unit is currently sitting securely in stock reserves and is completely unassigned.
            </div>
        }
    </div>

</div>