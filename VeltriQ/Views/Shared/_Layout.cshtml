                        @if (ViewBag.Companies != null)
                        {
                            @foreach (var c in ViewBag.Companies)
                            {
                                // Defensive check to prevent "Cannot perform runtime binding on a null reference"
                                var companyName = c.CompanyName ?? "Unknown";
                                var isSelected = ViewBag.CurrentCompanyId == c.CompanyId;

                                <div class="company-drop-item @(isSelected ? "active" : "")"
                                     data-id="@c.CompanyId"
                                     onclick="switchCompany(@c.CompanyId, '@companyName')">

                                    <span class="co-initial">
                                        @companyName.Substring(0, 1).ToUpper()
                                    </span>

                                    <div>
                                        <div class="co-dname">@companyName</div>
                                        <div class="co-dcode">@(c.CompanyCode ?? "N/A")</div>
                                    </div>

                                    @if (isSelected)
                                    {
                                        <i class="bi bi-check2 co-check"></i>
                                    }
                                </div>
                            }
                        }
