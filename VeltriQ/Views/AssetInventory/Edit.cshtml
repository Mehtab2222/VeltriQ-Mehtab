@model VeltriQ.Models.HR.AssetMaster

@{
    ViewData["Title"] = "Edit Asset";
}

<style>
    .template-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .validation-summary-box {
        font-size: 12px;
        color: #ef4444;
        margin-bottom: 12px;
        font-weight: 500;
    }

    /* ── HEADER BACK TO LIST NAVIGATION ACTION ── */
    .form-action-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT SYSTEM BUTTON CONTROLS ── */
    .form-action-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
        cursor: pointer;
    }

    .btn-submit-theme {
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
    }

        .btn-submit-theme:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-cancel-theme {
        background: var(--hover-bg);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }

    .form-footer-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
    }

    /* ── SQUARED SINGLE-PANEL CONTAINER CARD DECK ── */
    .custom-form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px; /* Branded strict crisp layout corners */
        display: flex;
        flex-direction: column;
    }

    .custom-form-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
    }

        .custom-form-header h5 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

    .custom-form-body {
        padding: 16px;
        background: var(--card-bg);
    }

    .form-grid-row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -8px;
        margin-left: -8px;
    }

    .form-grid-col-6 {
        flex: 0 0 50%;
        max-width: 50%;
        padding: 0 8px;
    }

    .form-grid-col-12 {
        flex: 0 0 100%;
        max-width: 100%;
        padding: 0 8px;
    }

    .form-field-group {
        margin-bottom: 12px;
        position: relative;
    }

    .custom-form-label {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

        .custom-form-label span {
            color: #ef4444;
            margin-left: 2px;
        }

    .custom-form-control {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12.5px;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--purple);
        }

    textarea.custom-form-control {
        height: 56px;
        padding: 6px 12px;
        resize: none;
    }

    select.custom-form-control {
        padding-right: 24px;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%239ca3af' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 12px 12px;
    }

    .validation-err-text {
        font-size: 11px;
        color: #ef4444;
        font-weight: 500;
        margin-top: 2px;
        display: block;
    }

    @@media (max-width: 768px) {
        .form-grid-col-6, .form-grid-col-12 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="template-create-page">

    <div class="form-action-header">
        <a href="/AssetMaster/Index" class="form-action-btn btn-cancel-theme">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <form id="assetForm" asp-action="Edit" method="post">
        <input asp-for="AssetMasterId" type="hidden" />
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-box"></div>

        <div class="custom-form-card">
            <div class="custom-form-header">
                <h5>Asset Configuration setup</h5>
            </div>

            <div class="custom-form-body">
                <div class="form-grid-row">
                    <div class="form-grid-col-12 form-field-group">
                        <label asp-for="AssetName" class="custom-form-label">Asset Name<span>*</span></label>
                        <input asp-for="AssetName" class="custom-form-control" placeholder="Enter asset name" autocomplete="off" />
                        <span asp-validation-for="AssetName" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="AssetCode" class="custom-form-label">
                            Asset Code
                        </label>

                        <input asp-for="AssetCode"
                               class="custom-form-control"
                               readonly />

                        <span asp-validation-for="AssetCode"
                              class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="AssetCategory" class="custom-form-label">Asset Category<span>*</span></label>
                        <select asp-for="AssetCategory" class="custom-form-control">
                            <option value="">Select Category</option>
                            <option>IT Asset</option>
                            <option>Office Asset</option>
                            <option>Security Asset</option>
                            <option>Furniture</option>
                        </select>
                        <span asp-validation-for="AssetCategory" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="BrandName" class="custom-form-label">Brand Name</label>
                        <input asp-for="BrandName" class="custom-form-control" placeholder="Dell / HP / Lenovo" autocomplete="off" />
                        <span asp-validation-for="BrandName" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="ModelName" class="custom-form-label">Model Name</label>
                        <input asp-for="ModelName" class="custom-form-control" placeholder="Latitude 5440" autocomplete="off" />
                        <span asp-validation-for="ModelName" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="SerialNumberRequired" class="custom-form-label">Serial Number Required</label>
                        <select asp-for="SerialNumberRequired" class="custom-form-control">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="SerialNumberRequired" class="validation-err-text"></span>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="IsReturnable" class="custom-form-label">Is Returnable</label>
                        <select asp-for="IsReturnable" class="custom-form-control">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="IsReturnable" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-12 form-field-group">
                        <label asp-for="Description" class="custom-form-label">Description</label>
                        <textarea asp-for="Description" class="custom-form-control" placeholder="Provide additional configuration rules or asset inventory notes..."></textarea>
                        <span asp-validation-for="Description" class="validation-err-text"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-footer-actions">
            <button type="submit" class="form-action-btn btn-submit-theme">
                <i class="bi bi-check-circle"></i>
               Update Asset
            </button>

            <a href="/AssetMaster/Index" class="form-action-btn btn-cancel-theme">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}