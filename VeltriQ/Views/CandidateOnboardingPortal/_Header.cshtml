@model VeltriQ.ViewModels.CandidateOnboardingPortal.CandidateOnboardingIndexViewModel

<style>
    .profile-hero-banner {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .hero-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .hero-profile-core {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* ── HIGH DENSITY SQUARED AVATAR CONSOLE ── */
    .hero-avatar-wrapper {
        width: 48px;
        height: 48px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        color: var(--purple);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .hero-identity-block {
        display: flex;
        flex-direction: column;
    }

    .hero-name-row h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .hero-meta-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 4px 0 0 0;
        font-weight: 600;
    }

    /* ── COMPACT METADATA STRIP ── */
    .hero-metadata-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .hero-metadata-strip span strong {
            color: var(--text-primary);
        }

    .hero-status-block {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        flex-shrink: 0;
    }

    .status-label-caption {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-secondary);
        letter-spacing: 0.5px;
    }

    .progress-percent-large {
        font-size: 22px;
        font-weight: 800;
        color: var(--purple);
        line-height: 1;
    }

    /* ── ADAPTIVE LIFESTYLE STATUS PILLS ── */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
        text-transform: uppercase;
    }

    .status-invited {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-progress {
        background: rgba(234, 179, 8, 0.12);
        color: #eab308;
    }

    .status-submitted {
        background: rgba(147, 51, 234, 0.12);
        color: #a855f7;
    }

    .status-approved {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-default {
        background: var(--hover-bg);
        color: var(--text-secondary);
    }

    /* Read Only Indicator Badge */
    .badge-read-only {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
        font-size: 9.5px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        letter-spacing: 0.5px;
    }

    .vq-txt-primary {
        color: var(--text-primary) !important;
    }

    /* ── SYSTEM WORKFLOW ACTIONS ── */
    .form-action-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
        cursor: pointer;
    }

    .btn-submit-theme {
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
    }

        .btn-submit-theme:hover:not(:disabled) {
            transform: translateY(-1px);
            color: #fff;
        }

    @@media (max-width: 768px) {
        .hero-top-row

    {
        flex-direction: column-reverse;
        align-items: stretch;
        gap: 12px;
    }

    .hero-status-block {
        align-items: flex-start;
    }

    .form-action-btn {
        width: 100%;
        justify-content: center;
    }

    .hero-metadata-strip {
        flex-direction: column;
        gap: 6px;
    }

    }
</style>

<div class="profile-hero-banner">
    <div class="hero-top-row">
        <div>
            @if (Model.StatusCode == "SUBMITTED" || Model.StatusCode == "REVIEW" || Model.StatusCode == "APPROVED")
            {
                <div style="background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34, 197, 94, 0.2); padding: 8px 14px; border-radius: 6px; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="bi bi-shield-check text-success" style="font-size: 16px;"></i>
                    <span class="vq-txt-primary" style="font-size: 12.5px; font-weight: 600;">Your onboarding has been submitted successfully. The portal is now locked while HR reviews your information. If any corrections are required, HR will unlock the portal and notify you.</span>
                </div>
            }
            else if (Model.CanSubmit == true)
            {
                <form asp-action="SubmitOnboarding" asp-controller="CandidateOnboardingPortal" method="post" id="finalSubmitForm" onsubmit="return confirm('Are you sure you want to submit your onboarding? After submission, the portal will become read-only until HR requests corrections.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="form-action-btn btn-submit-theme" id="btnFinalSubmit">
                        <i class="bi bi-cloud-arrow-up"></i> Final Submit Onboarding
                    </button>
                </form>
            }
        </div>

        <div class="hero-status-block">
            <span class="status-label-caption">Onboarding Status</span>
            <div class="d-flex align-items-center gap-2">
                @{
                    string cStatusLower = (Model.Status ?? "").ToLower();
                    string cStatusClass = cStatusLower switch
                    {
                        "invited" => "status-invited",
                        "in progress" or "progress" => "status-progress",
                        "submitted" or "under review" or "review" => "status-submitted",
                        "approved" => "status-approved",
                        _ => "status-default"
                    };
                }

                @if (Model.StatusCode == "SUBMITTED" || Model.StatusCode == "REVIEW" || Model.StatusCode == "APPROVED")
                {
                    <span class="badge-read-only"><i class="bi bi-lock-fill"></i> READ ONLY</span>
                }

                <span class="status-pill @cStatusClass">
                    <i class="bi bi-circle-fill" style="font-size: 5px;"></i> @Model.Status
                </span>
            </div>
        </div>
    </div>

    <div class="hero-top-row" style="align-items: flex-end; margin-bottom: 4px;">
        <div class="hero-profile-core">
            <div class="hero-avatar-wrapper">
                @(!string.IsNullOrWhiteSpace(Model.CandidateName) ? Model.CandidateName.Substring(0, 1).ToUpper() : "C")
            </div>
            <div class="hero-identity-block">
                <div class="hero-name-row">
                    <h2>@Model.CandidateName</h2>
                </div>
                <div class="hero-meta-subtitle">
                    @Model.Designation <span style="color: var(--border); margin: 0 4px;">•</span> @Model.Department
                </div>
            </div>
        </div>

        <div style="text-align: right; flex-shrink: 0;">
            <div class="progress-percent-large">@Model.CompletionPercentage%</div>
            <span class="status-label-caption">Overall Progress</span>
        </div>
    </div>

    <div class="hero-metadata-strip">
        <span>Candidate Code: <strong>@Model.CandidateCode</strong></span>
        <span>Employment Type: <strong>@Model.EmploymentType</strong></span>
        <span>Email: <strong>@Model.Email</strong></span>
        <span>Mobile: <strong>@Model.MobileNumber</strong></span>
        <span>Expected Joining: <strong style="color: var(--purple);">@(Model.ExpectedJoiningDate?.ToString("dd MMM yyyy") ?? "-")</strong></span>
    </div>
</div>