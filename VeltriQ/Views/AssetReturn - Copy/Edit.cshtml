@model VeltriQ.ViewModels.AssetInventory.AssetInventoryEditViewModel

@{
    ViewData["Title"] = "Modify Inventory Item";
}

<style>
    .inventory-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── TOP ACTION BAR DECK ── */
    .inventory-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 4px;
    }

    .btn-cancel-theme {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }

    /* ── RIGID CORE CONTEXT CARD ── */
    .inventory-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    .inventory-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
    }

    .inventory-card-title h3 {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .inventory-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── DATA WORKSPACE FORM CONTENT ── */
    .workspace-form-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .form-grid-deck {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
    }

        .form-group-block label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    /* ── DROPDOWN & INPUT STYLING ── */
    .form-deck-input, .select-deck-input {
        width: 100%;
        height: 36px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 13px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.2s ease;
    }

    select.select-deck-input {
        cursor: pointer;
        padding-right: 24px;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%2394a3b8' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 12px;
        -webkit-appearance: none;
        appearance: none;
    }

    .form-deck-input:focus, .select-deck-input:focus {
        border-color: var(--purple);
    }

    .form-deck-textarea {
        width: 100%;
        height: 64px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 8px 12px;
        font-size: 13px;
        font-family: inherit;
        outline: none;
        resize: none;
        transition: border-color 0.2s ease;
    }

        .form-deck-textarea:focus {
            border-color: var(--purple);
        }

    /* ── HIGH-DENSITY SYSTEM STATE BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 22px;
        padding: 0 10px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-available {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-allocated {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-maintenance {
        background: rgba(234, 179, 8, 0.12);
        color: #eab308;
    }

    .status-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    /* ── HIGH-DENSITY READ-ONLY INFO CARDS PANEL ── */
    .metadata-panel-deck {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        padding: 12px 14px;
        background: var(--hover-bg);
        border: 1px dashed var(--border);
        margin: 4px 0;
    }

    .metadata-info-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .metadata-card-label {
        font-size: 9.5px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metadata-card-value {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
    }

    /* ── PANEL FOOTER WORKSPACE ── */
    .panel-footer-deck {
        padding: 16px;
        border-top: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.01);
        display: flex;
        justify-content: flex-end;
    }

    .btn-submit-stock {
        height: 36px;
        padding: 0 20px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: transform 0.2s ease;
    }

        .btn-submit-stock:hover {
            transform: translateY(-1px);
        }

    .field-validation-error {
        color: #ef4444;
        font-size: 11px;
        margin-top: 2px;
        font-weight: 600;
    }
</style>

<div class="inventory-container">

    <div class="inventory-header">
        <a asp-action="Index" class="btn-cancel-theme">
            <i class="bi bi-arrow-left"></i> Back to Directory
        </a>
    </div>

    <form asp-action="Edit" method="post" id="inventoryEditForm">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="AssetInventoryId" />
        <input type="hidden" asp-for="InventoryCode" />
        <input type="hidden" asp-for="AssetMasterId" />
        <input type="hidden" asp-for="AssetCode" />
        <input type="hidden" asp-for="AssetName" />
        <input type="hidden" asp-for="AssetCategory" />
        <input type="hidden" asp-for="BrandName" />
        <input type="hidden" asp-for="ModelName" />
        <input type="hidden" asp-for="InventoryStatus" />
        <input type="hidden" asp-for="IsActive" />

        <div class="inventory-card">

            <div class="inventory-card-top">
                <div class="inventory-card-title">
                    <h3>Modify Stock Item: <span style="color: var(--purple);">@Model.InventoryCode</span></h3>
                    <p>Update audit logs, serial configurations, and purchase specifications.</p>
                </div>
                <div>
                    @{
                        string statusLower = (Model.InventoryStatus ?? "").ToLower();
                        string statusClass = statusLower switch
                        {
                            "available" or "instock" or "in stock" => "status-available",
                            "allocated" or "assigned" or "issued" => "status-allocated",
                            "maintenance" or "repair" => "status-maintenance",
                            _ => "status-category"
                        };
                    }
                    <span class="status-badge @statusClass">
                        <i class="bi bi-activity" style="font-size: 10px; margin-right: 4px;"></i> Lifecycle: @Model.InventoryStatus
                    </span>
                </div>
            </div>

            <div class="workspace-form-body">

                <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 12.5px; font-weight: 600; list-style: none; padding: 0; margin: 0 0 4px 0;"></div>

                <div class="metadata-panel-deck">
                    <div class="metadata-info-card">
                        <span class="metadata-card-label">Selected Base Asset</span>
                        <span class="metadata-card-value" style="color: var(--purple);">@Model.AssetCode - @Model.AssetName</span>
                    </div>
                    <div class="metadata-info-card">
                        <span class="metadata-card-label">Asset Category Group</span>
                        <span class="metadata-card-value">@Model.AssetCategory</span>
                    </div>
                    <div class="metadata-info-card">
                        <span class="metadata-card-label">Manufacturer Blueprint</span>
                        <span class="metadata-card-value">@Model.BrandName / @Model.ModelName</span>
                    </div>
                </div>

                <div class="form-grid-deck">
                    <div class="form-group-block">
                        <label>Serial Number / Asset Tag <span class="text-danger">*</span></label>
                        <input asp-for="SerialNumber" class="form-deck-input" placeholder="Type hardware identity string..." autocomplete="off" />
                        <span asp-validation-for="SerialNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group-block">
                        <label>Asset Structural Condition <span class="text-danger">*</span></label>
                        <select asp-for="AssetCondition" class="select-deck-input">
                            <option value="New / In Box">New / In Box</option>
                            <option value="Excellent">Excellent Condition</option>
                            <option value="Good">Good / Refurbished</option>
                            <option value="Damaged">Damaged / Needs Review</option>
                            <option value="Scrapped">Scrapped / Out of Service</option>
                        </select>
                        <span asp-validation-for="AssetCondition" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-grid-deck">
                    <div class="form-group-block">
                        <label>Purchase Acquisition Date</label>
                        <input asp-for="PurchaseDate" type="date" class="form-deck-input" />
                        <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                    </div>

                    <div class="form-group-block">
                        <label>Unit Acquisition Cost</label>
                        <input asp-for="PurchaseCost" type="number" step="0.01" class="form-deck-input" placeholder="0.00" autocomplete="off" />
                        <span asp-validation-for="PurchaseCost" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group-block">
                    <label>Vendor Supplier Entity</label>
                    <input asp-for="VendorName" class="form-deck-input" placeholder="Supplier corporate trade title..." autocomplete="off" />
                    <span asp-validation-for="VendorName" class="text-danger"></span>
                </div>

                <div class="form-group-block">
                    <label>Internal Technical Remarks</label>
                    <textarea asp-for="Remarks" class="form-deck-textarea" placeholder="Update technical specifications notes or storage room parameters..."></textarea>
                    <span asp-validation-for="Remarks" class="text-danger"></span>
                </div>

            </div>

            <div class="panel-footer-deck">
                <button type="submit" class="btn-submit-stock">
                    <i class="bi bi-check-circle"></i> Save Stock Configuration
                </button>
            </div>

        </div>
    </form>
</div>