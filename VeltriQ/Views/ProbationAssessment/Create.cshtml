@model VeltriQ.ViewModels.HR.ProbationAssessmentViewModel

@{
    ViewData["Title"] = "Create Probation Assessment";

    var employeeName = Model.Master.EmployeeName;

    var checkpoint1 = Model.Checkpoints.ElementAtOrDefault(0);
    var checkpoint2 = Model.Checkpoints.ElementAtOrDefault(1);
    var checkpoint3 = Model.Checkpoints.ElementAtOrDefault(2);
}

<div class="page-container">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div>
            <h2>
                Create Probation Assessment
            </h2>

            <p>
                Evaluate employee performance during the probation period.
            </p>
        </div>

    </div>


    <!-- =========================================================
         EMPLOYEE INFORMATION
    ========================================================== -->

    <div class="card">

        <div class="card-header">

            <h3>
                Employee Information
            </h3>

        </div>


        <div class="employee-summary">

            <div class="employee-avatar">
                @employeeName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.FirstOrDefault())
                .Take(2)
                .Aggregate("", (a, b) => a + b)
            </div>


            <div class="employee-info">

                <div class="employee-name">
                    @employeeName
                </div>

                <div class="employee-code">
                    @Model.Master.EmployeeNo
                </div>

            </div>

        </div>


        <div class="employee-details">

            <div>
                <span>Department</span>
                <strong>
                    @Model.Master.Department
                </strong>
            </div>

            <div>
                <span>Designation</span>
                <strong>
                    @Model.Master.Designation
                </strong>
            </div>

            <div>
                <span>Probation Start</span>
                <strong>
                    @Model.Master.ProbationStartDate?.ToString("dd MMM yyyy")
                </strong>
            </div>

            <div>
                <span>Probation End</span>
                <strong>
                    @Model.Master.ProbationEndDate?.ToString("dd MMM yyyy")
                </strong>
            </div>

        </div>

    </div>


    <!-- =========================================================
         CHECKPOINT TABS
    ========================================================== -->

    <div class="checkpoint-tabs">

        <button type="button"
                class="checkpoint-tab active"
                data-checkpoint="0">

            <span>CP1</span>

            <strong>
                6-Week Evaluation
            </strong>

            <small>
                @checkpoint1?.ScheduledDate?.ToString("dd MMM yyyy")
            </small>

        </button>


        <button type="button"
                class="checkpoint-tab locked"
                data-checkpoint="1"
                disabled>

            <span>CP2</span>

            <strong>
                10-Week Evaluation
            </strong>

            <small>
                @checkpoint2?.ScheduledDate?.ToString("dd MMM yyyy")
            </small>

        </button>


        <button type="button"
                class="checkpoint-tab locked"
                data-checkpoint="2"
                disabled>

            <span>CP3</span>

            <strong>
                Final Evaluation
            </strong>

            <small>
                @checkpoint3?.ScheduledDate?.ToString("dd MMM yyyy")
            </small>

        </button>

    </div>


    <!-- =========================================================
         CHECKPOINT 1
    ========================================================== -->

    <div class="card checkpoint-panel active"
         id="checkpoint-0">

        <div class="checkpoint-header">

            <div>

                <h3>
                    6-Week Evaluation
                </h3>

                <p>
                    Scheduled date:
                    <strong>
                        @checkpoint1?.ScheduledDate?.ToString("dd MMM yyyy")
                    </strong>
                </p>

            </div>


            <span class="status-badge pending">
                Pending
            </span>

        </div>


        <!-- =====================================================
             CRITERIA
        ====================================================== -->

        <div class="criteria-section">

            <h4>
                Evaluation Criteria
            </h4>


            @foreach (var category in Model.AllCriteria
                        .GroupBy(x => x.Category)
                        .OrderBy(x => x.Min(y => y.DisplayOrder)))
            {

                <div class="criteria-category">

                    <div class="category-title">
                        @category.Key
                    </div>


                    @foreach (var criterion in category
                                    .OrderBy(x => x.DisplayOrder))
                    {

                        <div class="criteria-row">

                            <div class="criteria-information">

                                <div class="criteria-name">
                                    @criterion.CriteriaName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                                        criterion.CriteriaDescription))
                                {
                                    <div class="criteria-description">
                                        @criterion.CriteriaDescription
                                    </div>
                                }

                            </div>


                            <div class="rating-options">

                                <label>
                                    <input type="radio"
                                           name="Ratings[@criterion.CriteriaId]"
                                           value="A+"
                                           data-score="5" />

                                    <span>A+</span>
                                </label>


                                <label>
                                    <input type="radio"
                                           name="Ratings[@criterion.CriteriaId]"
                                           value="A"
                                           data-score="4" />

                                    <span>A</span>
                                </label>


                                <label>
                                    <input type="radio"
                                           name="Ratings[@criterion.CriteriaId]"
                                           value="B+"
                                           data-score="3" />

                                    <span>B+</span>
                                </label>


                                <label>
                                    <input type="radio"
                                           name="Ratings[@criterion.CriteriaId]"
                                           value="B"
                                           data-score="2" />

                                    <span>B</span>
                                </label>


                                <label>
                                    <input type="radio"
                                           name="Ratings[@criterion.CriteriaId]"
                                           value="C"
                                           data-score="1" />

                                    <span>C</span>
                                </label>

                            </div>

                        </div>

                    }

                </div>

            }

        </div>


        <!-- =====================================================
             COMMENTS
        ====================================================== -->

        <div class="checkpoint-comments">

            <div class="form-group">

                <label>
                    Strengths
                </label>

                <textarea name="Strengths"
                          class="form-control"
                          rows="3"
                          placeholder="Enter employee strengths..."></textarea>

            </div>


            <div class="form-group">

                <label>
                    Development Areas
                </label>

                <textarea name="DevelopmentAreas"
                          class="form-control"
                          rows="3"
                          placeholder="Enter development areas..."></textarea>

            </div>


            <div class="form-group">

                <label>
                    Progress
                </label>

                <textarea name="Progress"
                          class="form-control"
                          rows="3"
                          placeholder="Enter progress comments..."></textarea>

            </div>

        </div>


        <!-- =====================================================
             SUBMIT
        ====================================================== -->

        <div class="checkpoint-actions">

            <button type="button"
                    class="btn btn-primary"
                    id="submitCheckpoint">

                <i class="bi bi-check-circle"></i>

                Submit Checkpoint 1

            </button>

        </div>

    </div>

</div>