@model IEnumerable<VeltriQ.Models.HR.LeaveType>

@{
    ViewData["Title"] = "Leave Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .leave-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .leave-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    .leave-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .leave-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .leave-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .leave-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .leave-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .leave-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .leave-search-wrapper {
        position: relative;
        width: 320px;
    }

        .leave-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .leave-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .leave-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .leave-table {
        width: 100%;
        border-collapse: collapse;
    }

        .leave-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .leave-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .leave-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
        text-decoration: none;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.toggle-btn {
            color: #f59e0b;
        }

            .action-btn.toggle-btn:hover {
                background: #f59e0b;
                color: #fff;
            }

    .custom-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

        .custom-modal.active {
            display: flex;
        }

    .custom-modal-box {
        width: 100%;
        max-width: 500px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
    }

    .modal-header-custom {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .modal-header-custom h3 {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

    .close-modal-btn {
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 4px;
        background: var(--hover-bg);
        color: var(--text-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-body-custom {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
        }

    .custom-input {
        width: 100%;
        height: 36px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
    }

        .custom-input:focus {
            border-color: var(--purple);
        }

    .modal-footer-custom {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .cancel-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        cursor: pointer;
        font-weight: 600;
        font-size: 12px;
    }

    .save-btn {
        height: 34px;
        padding: 0 16px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
</style>

@Html.AntiForgeryToken()

<div class="leave-page">
    <div class="leave-header">
        <button class="leave-add-btn" onclick="openLeaveModal(0)">
            <i class="bi bi-plus-lg"></i> Add New Leave Type
        </button>
    </div>

    <div class="leave-card">
        <div class="leave-card-top">
            <div class="leave-card-title">
                <h3>Leave Type Directory</h3>
                <p>Total Leave Types: <span id="leaveCounter">@(Model != null ? Model.Count() : 0)</span></p>
            </div>
            <div class="leave-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="leaveSearchInput" placeholder="Search leave type..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="leave-table" id="leaveTableMatrix">
                <thead>
                    <tr>
                        <th>Leave Name</th>
                        <th>Leave Code</th>
                        <th style="text-align: center;">Default Quota</th>
                        <th>Created On</th>
                        <th>Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.IsActive ? "status-active" : "status-inactive";
                            var toggleIcon = item.IsActive ? "bi-toggle-on" : "bi-toggle-off";
                            var toggleTitle = item.IsActive ? "Deactivate Leave Type" : "Activate Leave Type";
                            <tr>
                                <td data-search="name" style="font-weight: 600;">@item.LeaveTypeName</td>
                                <td data-search="code"><span style="color: var(--purple); font-family: monospace; font-weight: 700;">@item.Code</span></td>
                                <td style="text-align: center; font-weight: 700;">@item.DefaultQuota days</td>
                                <td>@item.CreatedOn.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge @badgeClass">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div class="table-actions">
                                        <button class="action-btn" onclick="openLeaveModal(@item.LeaveTypeId)" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="action-btn toggle-btn" onclick="toggleLeaveStatus(@item.LeaveTypeId)" title="@toggleTitle">
                                            <i class="bi @toggleIcon" style="font-size: 14px;"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No leave types configured.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="custom-modal" id="leaveModal">
    <div class="custom-modal-box">
        <div class="modal-header-custom">
            <div>
                <h3 id="modalTitle">Add Leave Type</h3>
                <p>Configure corporate leave rules.</p>
            </div>
            <button class="close-modal-btn" onclick="closeLeaveModal()"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body-custom">
            <input type="hidden" id="editLeaveTypeId" value="0" />
            <div class="form-group">
                <label>Leave Name *</label>
                <input type="text" class="custom-input" id="modalLeaveTypeName" placeholder="e.g., Casual Leave" autocomplete="off" oninput="autoGenerateCode(this.value)" />
            </div>
            <div class="form-group">
                <label>Leave Code * (Auto-generated)</label>
                <input type="text" class="custom-input" id="modalCode" placeholder="e.g., LV-001" autocomplete="off" style="font-family: monospace;" />
            </div>
            <div class="form-group">
                <label>Default Quota (Days) *</label>
                <input type="number" class="custom-input" id="modalDefaultQuota" value="12" min="0" />
            </div>
        </div>
        <div class="modal-footer-custom">
            <button class="cancel-btn" onclick="closeLeaveModal()">Cancel</button>
            <button class="save-btn" onclick="saveLeaveTypeData()"><i class="bi bi-check2-circle"></i> Save Leave Type</button>
        </div>
    </div>
</div>

<script>
    function autoGenerateCode(nameVal) {
        const codeInput = document.getElementById('modalCode');
        const editId = document.getElementById('editLeaveTypeId').value;
        if (editId === "0" && nameVal.trim().length > 0) {
            const cleaned = nameVal.trim().toUpperCase().replace(/[^A-Z]/g, '');
            const prefix = cleaned.length >= 2 ? cleaned.substring(0, 2) : "LV";
            const randomNum = Math.floor(100 + Math.random() * 900);
            codeInput.value = `${prefix}-${randomNum}`;
        }
    }

    function openLeaveModal(id) {
        document.getElementById('editLeaveTypeId').value = id;
        document.getElementById('modalLeaveTypeName').value = '';
        document.getElementById('modalCode').value = '';
        document.getElementById('modalDefaultQuota').value = '12';

        if (id > 0) {
            document.getElementById('modalTitle').innerText = 'Edit Leave Type';
            fetch(`/Leave/GetLeaveTypeById?id=${id}`)
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        document.getElementById('modalLeaveTypeName').value = res.data.leaveTypeName;
                        document.getElementById('modalCode').value = res.data.code;
                        document.getElementById('modalDefaultQuota').value = res.data.defaultQuota;
                    }
                });
        } else {
            document.getElementById('modalTitle').innerText = 'Add Leave Type';
            autoGenerateCode("Leave");
        }
        document.getElementById('leaveModal').classList.add('active');
    }

    function closeLeaveModal() {
        document.getElementById('leaveModal').classList.remove('active');
    }

    async function saveLeaveTypeData() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const payload = {
            leaveTypeId: parseInt(document.getElementById('editLeaveTypeId').value) || 0,
            leaveTypeName: document.getElementById('modalLeaveTypeName').value.trim(),
            code: document.getElementById('modalCode').value.trim(),
            defaultQuota: parseInt(document.getElementById('modalDefaultQuota').value) || 0
        };

        if (!payload.leaveTypeName || !payload.code) {
            alert('Please fill out all required fields.');
            return;
        }

        try {
            const res = await fetch('/Leave/SaveLeaveType', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
                closeLeaveModal();
                location.reload();
            } else {
                alert(result.message || 'Operation failed.');
            }
        } catch (err) {
            console.error('Save error:', err);
        }
    }

    async function toggleLeaveStatus(id) {
        if (!confirm('Are you sure you want to change the status of this leave type?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        try {
            const res = await fetch(`/Leave/ToggleLeaveTypeStatus?id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert(result.message || 'Action failed.');
            }
        } catch (err) {
            console.error('Toggle status error:', err);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("leaveSearchInput");
        const matrixGrid = document.getElementById("leaveTableMatrix");
        const counterTracker = document.getElementById("leaveCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");
        const inlineFallbackRow = document.getElementById("emptyMatrixFallback");

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const compoundSourceText = `${nameText} ${codeText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (inlineFallbackRow) {
                if (matchedCount === 0 && dataRows.length > 0) {
                    inlineFallbackRow.style.display = "";
                } else {
                    inlineFallbackRow.style.display = "none";
                }
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>