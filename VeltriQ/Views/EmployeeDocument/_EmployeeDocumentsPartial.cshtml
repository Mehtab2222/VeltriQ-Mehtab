@model IEnumerable<VeltriQ.Models.HR.EmployeeDocument>

@{
    ViewData["Title"] = "Employee Documents";

    var employeeId = ViewBag.EmployeeId;
}

<style>

    .document-page {
        padding: 8px 0 30px;
    }

    /* HEADER */

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .document-header-left h2 {
        color: #fff;
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .document-header-left p {
        color: #94a3b8;
        font-size: 14px;
        margin: 0;
    }

    /* BUTTON */

    .add-document-btn {
        height: 42px;
        padding: 0 18px;
        border-radius: 12px;
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 10px 25px rgba(124,58,237,.24);
    }

        .add-document-btn:hover {
            color: #fff;
        }

    /* CARD */

    .document-card {
        background: rgba(30,35,44,.95);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 22px;
        overflow: hidden;
    }

    .document-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .document-card-title h3 {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .document-card-title p {
        color: #94a3b8;
        font-size: 13px;
        margin: 0;
    }

    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
    }

    .document-table {
        width: 100%;
        border-collapse: collapse;
    }

        .document-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .document-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .document-table tbody tr:hover {
            background: rgba(255,255,255,.02);
        }

    /* DOCUMENT */

    .document-name {
        font-weight: 700;
        margin-bottom: 3px;
    }

    .document-number {
        color: #64748b;
        font-size: 11px;
    }

    /* BADGES */

    .status-badge {
        height: 28px;
        padding: 0 12px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
    }

    .status-verified {
        background: rgba(34,197,94,.14);
        color: #22c55e;
    }

    .status-pending {
        background: rgba(245,158,11,.14);
        color: #f59e0b;
    }

    .status-expired {
        background: rgba(239,68,68,.14);
        color: #ef4444;
    }

    /* ACTIONS */

    .table-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(124,58,237,.10);
        color: #a78bfa;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s ease;
    }

        .action-btn:hover {
            background: #7c3aed;
            color: #fff;
        }

</style>

<div class="document-page">

    <!-- HEADER -->

    <div class="document-header">

        <div class="document-header-left">

            <h2>Employee Documents</h2>

            <p>
                Manage employee uploaded documents and verification records.
            </p>

        </div>

        <a href="/EmployeeDocument/Create?employeeId=@employeeId"
           class="add-document-btn">

            <i class="bi bi-upload"></i>

            Upload Document

        </a>

    </div>

    <!-- CARD -->

    <div class="document-card">

        <div class="document-card-header">

            <div class="document-card-title">

                <h3>Uploaded Documents</h3>

                <p>
                    Total Documents:
                    @Model.Count()
                </p>

            </div>

        </div>

        <!-- TABLE -->

        <div class="table-wrapper">

            <table class="document-table">

                <thead>

                    <tr>

                        <th>Document</th>
                        <th>Issue Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>File</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- DOCUMENT -->

                            <td>

                                <div class="document-name">
                                    @item.DocumentMaster?.DocumentName
                                </div>

                                <div class="document-number">
                                    @item.DocumentNumber
                                </div>

                            </td>

                            <!-- ISSUE -->

                            <td>

                                @(item.IssueDate?.ToString("dd MMM yyyy"))

                            </td>

                            <!-- EXPIRY -->

                            <td>

                                @(item.ExpiryDate?.ToString("dd MMM yyyy"))

                            </td>

                            <!-- STATUS -->

                            <td>

                                @if (item.VerificationStatus == "Verified")
                                {
                                    <span class="status-badge status-verified">
                                        Verified
                                    </span>
                                }
                                else if (item.VerificationStatus == "Expired")
                                {
                                    <span class="status-badge status-expired">
                                        Expired
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        Pending
                                    </span>
                                }

                            </td>

                            <!-- FILE -->

                            <td>

                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a href="@item.FilePath"
                                       target="_blank"
                                       class="action-btn">

                                        <i class="bi bi-file-earmark-arrow-down"></i>

                                    </a>
                                }

                            </td>

                            <!-- ACTIONS -->

                            <td>

                                <div class="table-actions">

                                    <a href="#"
                                       class="action-btn">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a href="#"
                                       class="action-btn">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>