@model IEnumerable<VeltriQ.Models.HR.Country>

@{
    ViewData["Title"] = "Countries";
}

<style>

    .country-page {
        width: 100%;
    }

    .country-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .country-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .country-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    .country-add-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 8px 22px rgba(124,58,237,.22);
    }

    .country-card {
        background: rgba(30,35,44,.94);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        overflow: hidden;
    }

    .country-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .country-search {
        width: 300px;
        position: relative;
    }

        .country-search input {
            width: 100%;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #2a3441;
            background: #0d1117;
            padding: 0 14px 0 42px;
            color: #fff;
            outline: none;
        }

        .country-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    .country-table {
        width: 100%;
        border-collapse: collapse;
    }

        .country-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
        }

        .country-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
        }

    .country-name {
        font-weight: 700;
    }

    .country-code {
        font-size: 11px;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 30px;
        background: rgba(34,197,94,.14);
        color: #22c55e;
        font-size: 11px;
        font-weight: 700;
    }

</style>

<div class="country-page">

    <div class="country-header">

        <div class="country-header-left">

            <h2>Countries</h2>

            <p>
                Manage countries and global regions.
            </p>

        </div>

        <a href="/Country/Create"
           class="country-add-btn">

            <i class="bi bi-plus-lg"></i>

            Add Country

        </a>

    </div>

    <div class="country-card">

        <div class="country-card-top">

            <div>

                <h3 style="color:#fff;font-size:18px;font-weight:700;">
                    Country Directory
                </h3>

                <p style="color:#94a3b8;font-size:13px;margin:0;">
                    Total Countries: @Model.Count()
                </p>

            </div>

            <div class="country-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search countries..." />

            </div>

        </div>

        <div class="table-wrapper">

            <table class="country-table">

                <thead>

                    <tr>

                        <th>Country</th>
                        <th>Currency</th>
                        <th>Phone Code</th>
                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <div class="country-name">
                                    @item.CountryName
                                </div>

                                <div class="country-code">
                                    @item.CountryCode
                                </div>

                            </td>

                            <td>
                                @item.CurrencyCode
                            </td>

                            <td>
                                @item.PhoneCode
                            </td>

                            <td>

                                <span class="status-badge">
                                    Active
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>