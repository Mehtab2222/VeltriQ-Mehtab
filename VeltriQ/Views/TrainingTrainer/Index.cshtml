@model VeltriQ.ViewModels.Training.TrainingTrainerViewModel

@{
    ViewData["Title"] = "Training Trainers";
}

<style>
    .trainer-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .trainer-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .trainer-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
        cursor: pointer;
    }

        .trainer-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .trainer-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .trainer-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .trainer-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .trainer-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .trainer-search-wrapper {
        position: relative;
        width: 320px;
    }

        .trainer-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .trainer-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .trainer-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .trainer-table {
        width: 100%;
        border-collapse: collapse;
    }

        .trainer-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .trainer-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .trainer-table tbody tr {
            transition: background-color .1s ease;
        }

            .trainer-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .badge-internal {
        background: rgba(59, 130, 246, 0.12);
        color: #60a5fa;
    }

    .badge-external {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    /* ── INLINE ACTIONS ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
        cursor: pointer;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.toggle-deactivate-btn {
            color: #22c55e;
        }

            .action-btn.toggle-deactivate-btn:hover {
                background: #ef4444;
                color: #fff;
            }

        .action-btn.toggle-activate-btn {
            color: #ef4444;
        }

            .action-btn.toggle-activate-btn:hover {
                background: #22c55e;
                color: #fff;
            }

    /* ── ✅ FIXED ELEMENT POPUP CONTAINER RESTORED TO MIDDLE OF THE PAGE ── */
    .modal-backdrop-layer {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center; /* Centered layout placement rules */
    }

    .modal-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        width: 460px; /* Standard horizontal width metric profile for centered popups */
        max-width: 92vw;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-card-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hover-bg);
    }

        .modal-card-header h4 {
            margin: 0;
            font-size: 13.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .modal-body-form-fields {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group-block label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

    .form-deck-input {
        width: 100%;
        height: 36px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 13px;
        outline: none;
    }

        .form-deck-input:focus {
            border-color: var(--purple);
        }

        .form-deck-input:disabled {
            background: var(--hover-bg);
            opacity: 0.7;
            cursor: not-allowed;
        }

    .modal-card-footer {
        padding: 12px 16px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-modal-cancel {
        height: 34px;
        padding: 0 14px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-action-trigger {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

@Html.AntiForgeryToken()

<div class="trainer-page">

    <div class="trainer-header">
        <button type="button" class="trainer-add-btn" onclick="openCreateWorkspaceModal()">
            <i class="bi bi-plus-lg"></i> Add Trainer
        </button>
    </div>

    <div class="trainer-master-card">

        <div class="trainer-card-top">
            <div class="trainer-card-title">
                <h3>Trainer Registry Master</h3>
                <p>Total Records: <span id="trainerCounter">0</span></p>
            </div>

            <div class="trainer-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="trainerSearchInput" placeholder="Search trainers..." autocomplete="off" oninput="executeClientSideSearchFilter()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="trainer-table" id="trainerGridMatrix">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Trainer Name</th>
                        <th>Trainer Type</th>
                        <th>Mobile Number</th>
                        <th>Email Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="trainerMasterGridBody">
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                            Streaming trainer database registers...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal-backdrop-layer" id="trainerWorkspaceModalLayer">
    <div class="modal-card">
        <div class="modal-card-header">
            <h4 id="modalHeadingTitle">Add Trainer</h4>
            <button type="button" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size: 16px;" onclick="closeWorkspaceModal()">✕</button>
        </div>
        <form id="trainerWorkspaceForm" onsubmit="submitTrainerForm(event)">
            <input type="hidden" id="txtTrainingTrainerId" name="TrainingTrainerId" value="0" />

            <div class="modal-body-form-fields">
                <div class="form-group-block" id="blockTrainerCodeDisplay" style="display: none;">
                    <label>Trainer Assignment Code</label>
                    <input type="text" id="txtTrainerCode" class="form-deck-input" disabled style="opacity: 0.75; font-weight: 700; color: var(--purple);" />
                </div>

                <div class="form-group-block">
                    <label>Trainer Scope Type *</label>
                    <select id="ddlTrainerType" name="TrainerType" class="form-deck-input" asp-items="Model.TrainerTypes" onchange="handleTrainerTypeToggle()" required>
                        <option value="">-- Select Type --</option>
                    </select>
                </div>

                <div class="form-group-block" id="blockInternalEmployee" style="display: none;">
                    <label>Select Corporate Employee *</label>
                    <select id="ddlEmployeeId" name="EmployeeId" class="form-deck-input" asp-items="Model.Employees">
                        <option value="">-- Select Employee Context --</option>
                    </select>
                </div>

                <div id="blockExternalFields" style="display: none; flex-direction: column; gap: 14px;">
                    <div class="form-group-block">
                        <label>External Trainer Name *</label>
                        <input type="text" id="txtTrainerName" name="TrainerName" class="form-deck-input" placeholder="e.g. Dr. Arthur Pendragon" maxlength="200" />
                    </div>

                    <div class="form-group-block">
                        <label>Mobile Number *</label>
                        <input type="text" id="txtMobileNo" name="MobileNo" class="form-deck-input" placeholder="e.g. +91 9876543210" maxlength="20" />
                    </div>

                    <div class="form-group-block">
                        <label>Email Address *</label>
                        <input type="email" id="txtEmail" name="Email" class="form-deck-input" placeholder="e.g. arthur.p@external.com" maxlength="150" />
                    </div>
                </div>
            </div>

            <div class="modal-card-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeWorkspaceModal()">Cancel</button>
                <button type="submit" class="btn-action-trigger" id="btnSubmitForm">Save Trainer</button>
            </div>
        </form>
    </div>
</div>

<script>
    let localTrainerCache = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadTrainerGridMatrix();
    });

    function openCreateWorkspaceModal() {
        document.getElementById("trainerWorkspaceForm").reset();
        document.getElementById("txtTrainingTrainerId").value = "0";
        document.getElementById("blockTrainerCodeDisplay").style.display = "none";

        document.getElementById("ddlTrainerType").disabled = false;
        toggleFormInputStates(false);
        handleTrainerTypeToggle();

        document.getElementById("modalHeadingTitle").innerText = "Add Trainer";
        document.getElementById("btnSubmitForm").innerText = "Save Trainer";
        document.getElementById("btnSubmitForm").style.display = "inline-flex";

        document.getElementById("trainerWorkspaceModalLayer").style.display = "flex";
    }

    function closeWorkspaceModal() {
        document.getElementById("trainerWorkspaceModalLayer").style.display = "none";
    }

    function handleTrainerTypeToggle() {
        const selectedType = document.getElementById("ddlTrainerType").value;
        const blockInternal = document.getElementById("blockInternalEmployee");
        const blockExternal = document.getElementById("blockExternalFields");

        const empSelect = document.getElementById("ddlEmployeeId");
        const nameInput = document.getElementById("txtTrainerName");
        const mobInput = document.getElementById("txtMobileNo");
        const emailInput = document.getElementById("txtEmail");

        if (selectedType === "1") {
            blockInternal.style.display = "flex";
            blockExternal.style.display = "none";
            empSelect.required = true;
            nameInput.required = mobInput.required = emailInput.required = false;
        } else if (selectedType === "2") {
            blockInternal.style.display = "none";
            blockExternal.style.display = "flex";
            empSelect.required = false;
            nameInput.required = mobInput.required = emailInput.required = true;
        } else {
            blockInternal.style.display = "none";
            blockExternal.style.display = "none";
            empSelect.required = nameInput.required = mobInput.required = emailInput.required = false;
        }
    }

    function toggleFormInputStates(isDisable) {
        document.getElementById("ddlEmployeeId").disabled = isDisable;
        document.getElementById("txtTrainerName").disabled = isDisable;
        document.getElementById("txtMobileNo").disabled = isDisable;
        document.getElementById("txtEmail").disabled = isDisable;
    }

    async function loadTrainerGridMatrix() {
        try {
            const res = await fetch('/TrainingTrainer/GetTrainerList', { method: 'GET' });
            const result = await res.json();

            localTrainerCache = result.data || [];
            renderTrainerRows(localTrainerCache);
        } catch {
            document.getElementById("trainerMasterGridBody").innerHTML = `<tr><td colspan="6" style="text-align: center; color: red; padding: 24px;">Failed to refresh trainer records.</td></tr>`;
        }
    }

    function renderTrainerRows(dataset) {
        const tbody = document.getElementById("trainerMasterGridBody");
        document.getElementById("trainerCounter").innerText = dataset.length;

        if (dataset.length === 0) {
            tbody.innerHTML = `<tr id="emptyMatrixFallback"><td colspan="6" style="text-align: center; color: var(--text-secondary); font-style: italic; padding: 24px;">No records found.</td></tr>`;
            return;
        }

        tbody.innerHTML = dataset.map(x => `
            <tr>
                <td class="col-code"><code>${x.trainerCode}</code></td>
                <td style="font-weight: 600;">${x.trainerName || "-"}</td>
                <td>
                    <span class="status-badge ${x.trainerType === 1 ? "badge-internal" : "badge-external"}">
                        ${x.trainerTypeText}
                    </span>
                </td>
                <td style="font-weight: 500;">${x.mobileNo || "-"}</td>
                <td style="font-weight: 500;">${x.email || "-"}</td>
                <td>
                    <div class="table-actions">
                        <button type="button" class="action-btn" title="View Details" onclick="fireViewDetails(${x.trainingTrainerId})"><i class="bi bi-eye"></i></button>
                        <button type="button" class="action-btn" title="Edit Parameters" onclick="fireEditWorkflow(${x.trainingTrainerId})"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="action-btn toggle-status ${x.isActive ? "toggle-deactivate-btn" : "toggle-activate-btn"}"
                                title="${x.isActive ? "Deactivate Trainer" : "Activate Trainer"}"
                                onclick="executeToggleStatus(${x.trainingTrainerId}, ${x.isActive})">
                            <i class="bi ${x.isActive ? "bi-toggle-on" : "bi-toggle-off"}" style="font-size:14px;"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `).join('');
    }

    async function fireViewDetails(id) {
        document.getElementById("trainerWorkspaceForm").reset();
        try {
            const res = await fetch(`/TrainingTrainer/GetTrainer/${id}`);
            const result = await res.json();

            if (result.success && result.data) {
                populateFormFields(result.data);
                document.getElementById("ddlTrainerType").disabled = true;
                toggleFormInputStates(true);

                document.getElementById("blockTrainerCodeDisplay").style.display = "flex";
                document.getElementById("modalHeadingTitle").innerText = "View Trainer Details";
                document.getElementById("btnSubmitForm").style.display = "none";

                document.getElementById("trainerWorkspaceModalLayer").style.display = "flex";
            }
        } catch { alert("Failed to establish detailed channel fields."); }
    }

    async function fireEditWorkflow(id) {
        document.getElementById("trainerWorkspaceForm").reset();
        try {
            const res = await fetch(`/TrainingTrainer/GetTrainer/${id}`);
            const result = await res.json();

            if (result.success && result.data) {
                populateFormFields(result.data);
                document.getElementById("ddlTrainerType").disabled = true;
                toggleFormInputStates(false);

                document.getElementById("blockTrainerCodeDisplay").style.display = "flex";
                document.getElementById("modalHeadingTitle").innerText = "Modify Trainer Parameters";
                document.getElementById("btnSubmitForm").innerText = "Save Changes";
                document.getElementById("btnSubmitForm").style.display = "inline-flex";

                document.getElementById("trainerWorkspaceModalLayer").style.display = "flex";
            }
        } catch { alert("Failed to establish update channel fields."); }
    }

    function populateFormFields(d) {
        document.getElementById("txtTrainingTrainerId").value = d.trainingTrainerId;
        document.getElementById("txtTrainerCode").value = d.trainerCode;
        document.getElementById("ddlTrainerType").value = d.trainerType;
        handleTrainerTypeToggle();

        if (d.trainerType === 1) {
            document.getElementById("ddlEmployeeId").value = d.employeeId;
        } else {
            document.getElementById("txtTrainerName").value = d.trainerName;
            document.getElementById("txtMobileNo").value = d.mobileNo;
            document.getElementById("txtEmail").value = d.email;
        }
    }

    async function submitTrainerForm(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById("txtTrainingTrainerId").value);
        const url = id === 0 ? "/TrainingTrainer/Create" : "/TrainingTrainer/Update";

        const formData = new URLSearchParams();
        formData.append("TrainingTrainerId", id);
        formData.append("TrainerType", document.getElementById("ddlTrainerType").value);
        formData.append("EmployeeId", document.getElementById("ddlEmployeeId").value);
        formData.append("TrainerName", document.getElementById("txtTrainerName").value);
        formData.append("MobileNo", document.getElementById("txtMobileNo").value);
        formData.append("Email", document.getElementById("txtEmail").value);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token },
                body: formData.toString()
            });
            const result = await res.json();

            if (result.success) {
                closeWorkspaceModal();
                if (window.showVqSuccess) window.showVqSuccess(result.message);

                setTimeout(() => { loadTrainerGridMatrix(); }, 500);
            } else {
                if (window.showVqError) window.showVqError(result.message);
                else alert(result.message);
            }
        } catch { alert("Transmission synchronization fault."); }
    }

    function executeToggleStatus(id, currentStatus) {
        const titleText = currentStatus ? "Deactivate" : "Activate";
        const msg = `Are you sure you want to ${titleText.toLowerCase()} this training trainer registry record?`;

        showVqConfirm(
            titleText + " Trainer",
            msg,
            async function() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                try {
                    const res = await fetch(`/TrainingTrainer/ToggleStatus/${id}`, {
                        method: "POST", headers: { "RequestVerificationToken": token }
                    });
                    const result = await res.json();

                    if (result.success) {
                        if (window.showVqAlert) {
                            showVqAlert("Success", "Trainer status updated successfully.", true);
                        }
                        loadTrainerGridMatrix();
                    }
                } catch { alert("Status toggling failure."); }
            }
        );
    }

    function executeClientSideSearchFilter() {
        const query = document.getElementById("trainerSearchInput").value.trim().toLowerCase();

        const matched = localTrainerCache.filter(x =>
            (x.trainerName && x.trainerName.toLowerCase().includes(query)) ||
            x.trainerCode.toLowerCase().includes(query) ||
            (x.email && x.email.toLowerCase().includes(query)) ||
            (x.mobileNo && x.mobileNo.toLowerCase().includes(query))
        );

        renderTrainerRows(matched);
    }
</script>