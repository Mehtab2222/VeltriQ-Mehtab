@model IEnumerable<VeltriQ.Models.HR.EmployeeSuspension>

@{
    ViewData["Title"] = "Employee Suspension";
}

<style>
    .suspension-page {
        width: 100%;
    }

    /* HEADER */
    .suspension-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .suspension-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        letter-spacing: -.4px;
    }

    .suspension-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    /* BUTTON */
    .suspension-add-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
        box-shadow: 0 8px 22px rgba(124,58,237,.22);
    }

        .suspension-add-btn:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    /* CARD */
    .suspension-card {
        background: rgba(30,35,44,.94);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        overflow: hidden;
    }

    .suspension-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
        gap: 20px;
    }

    .suspension-card-title h3 {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 3px;
    }

    .suspension-card-title p {
        font-size: 13px;
        color: #94a3b8;
        margin: 0;
    }

    /* SEARCH */
    .suspension-search {
        width: 320px;
        position: relative;
    }

        .suspension-search input {
            width: 100%;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #2a3441;
            background: #0d1117;
            padding: 0 14px 0 42px;
            color: #fff;
            font-size: 13px;
            outline: none;
        }

            .suspension-search input:focus {
                border-color: #7c3aed;
            }

        .suspension-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

    /* TABLE */
    .table-wrapper {
        overflow-x: auto;
    }

    .suspension-table {
        width: 100%;
        border-collapse: collapse;
    }

        .suspension-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .suspension-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .suspension-table tbody tr:hover {
            background: rgba(255,255,255,.02);
        }

    /* INFO */
    .emp-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .emp-avatar {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(124, 58, 237, 0.1);
        color: #7c3aed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

    /* STATUS */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        padding: 0 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-reinstated {
        background: rgba(34, 197, 94, 0.14);
        color: #22c55e;
    }

    .status-suspended {
        background: rgba(239, 68, 68, 0.14);
        color: #ef4444;
    }

    /* ACTIONS */
    .btn-reinstate {
        padding: 6px 14px;
        border-radius: 8px;
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

        .btn-reinstate:hover {
            background: #22c55e;
            color: #fff;
        }
</style>

<div class="suspension-page">

    <!-- HEADER -->
    <div class="suspension-header">
        <div class="suspension-header-left">
            <h2>Employee Suspension</h2>
            <p>Track disciplinary suspensions and process employee reinstatements.</p>
        </div>

        <a href="/EmployeeSuspension/Create" class="suspension-add-btn">
            <i class="bi bi-plus-lg"></i>
            New Suspension
        </a>
    </div>

    <!-- CARD -->
    <div class="suspension-card">

        <!-- TOP CONTROLS -->
        <div class="suspension-card-top">
            <div class="suspension-card-title">
                <h3>Suspension Records</h3>
                <p>Active & Past disciplinary cases</p>
            </div>

            <div class="suspension-search">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Search employee..." />
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-wrapper">
            <table class="suspension-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="emp-info">
                                    <div class="emp-avatar">
                                        @(item.Employee?.FirstName?.Substring(0, 1))@(item.Employee?.LastName?.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div style="font-weight: 700;">
                                            @item.Employee?.FirstName @item.Employee?.LastName
                                        </div>
                                        <div style="font-size: 11px; color: #6b7280;">Case ID: #@item.EmployeeSuspensionId</div>
                                    </div>
                                </div>
                            </td>

                            <td>@item.SuspensionDate.ToString("dd MMM yyyy")</td>

                            <td>
                                @(item.EndDate != null ? item.EndDate.Value.ToString("dd MMM yyyy") : "-")
                            </td>

                            <td>
                                <span style="font-weight: 600; color: #94a3b8;">@item.SuspensionType</span>
                            </td>

                            <td>
                                @if (item.Status == "Reinstated")
                                {
                                    <span class="status-badge status-reinstated">Reinstated</span>
                                }
                                else
                                {
                                    <span class="status-badge status-suspended">Suspended</span>
                                }
                            </td>

                            <td>
                                @if (!item.IsReinstated)
                                {
                                    <a asp-action="Reinstate" asp-route-id="@item.EmployeeSuspensionId" class="btn-reinstate">
                                        Reinstate
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #4b5563; font-size: 11px; font-style: italic;">Processed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>