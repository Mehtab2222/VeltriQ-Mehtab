@model IEnumerable<VeltriQ.Models.HR.Employee>

@{
    ViewData["Title"] = "Employees";
}

<style>

    .employee-page {
        width: 100%;
    }

    /* HEADER */

    .employee-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .employee-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        letter-spacing: -.4px;
    }

    .employee-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    /* BUTTON */

    .employee-add-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
        box-shadow: 0 8px 22px rgba(124,58,237,.22);
    }

        .employee-add-btn:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    /* CARD */

    .employee-card {
        background: rgba(30,35,44,.94);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        overflow: hidden;
    }

    .employee-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
        gap: 20px;
    }

    .employee-card-title h3 {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 3px;
    }

    .employee-card-title p {
        font-size: 13px;
        color: #94a3b8;
        margin: 0;
    }

    /* SEARCH */

    .employee-search {
        width: 320px;
        position: relative;
    }

        .employee-search input {
            width: 100%;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #2a3441;
            background: #0d1117;
            padding: 0 14px 0 42px;
            color: #fff;
            font-size: 13px;
            outline: none;
        }

            .employee-search input:focus {
                border-color: #7c3aed;
            }

        .employee-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
    }

        .employee-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .employee-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .employee-table tbody tr {
            transition: .2s ease;
        }

            .employee-table tbody tr:hover {
                background: rgba(255,255,255,.02);
            }

    /* EMPLOYEE INFO */

    .employee-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .employee-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .employee-name {
        font-weight: 700;
        color: #fff;
        margin-bottom: 2px;
    }

    .employee-code {
        font-size: 11px;
        color: #6b7280;
    }

    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34,197,94,.14);
        color: #22c55e;
    }

    /* ACTIONS */

    .table-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        border: none;
        background: rgba(124,58,237,.12);
        color: #7c3aed;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s ease;
        text-decoration: none;
    }

        .action-btn:hover {
            background: #7c3aed;
            color: #fff;
        }

    .delete-btn {
        background: rgba(239,68,68,.12);
        color: #ef4444;
    }

        .delete-btn:hover {
            background: #ef4444;
            color: #fff;
        }

    .employee-profile-link {
        color: #fff;
        text-decoration: none;
        font-weight: 700;
        transition: .2s ease;
    }

        .employee-profile-link:hover {
            color: #a78bfa;
        }
</style>

<div class="employee-page">

    <!-- HEADER -->

    <div class="employee-header">

        <div class="employee-header-left">

            <h2>Employees</h2>

            <p>
                Manage employee directory and workforce records.
            </p>

        </div>

        <a href="/Employee/Create"
           class="employee-add-btn">

            <i class="bi bi-plus-lg"></i>

            Add Employee

        </a>

    </div>

    <!-- CARD -->

    <div class="employee-card">

        <!-- TOP -->

        <div class="employee-card-top">

            <div class="employee-card-title">

                <h3>Employee Directory</h3>

                <p>
                    Total Employees:
                    @Model.Count()
                </p>

            </div>

            <div class="employee-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search employees..." />

            </div>

        </div>

        <!-- TABLE -->

        <div class="table-wrapper">

            <table class="employee-table">

                <thead>

                    <tr>

                        <th>Employee</th>
                        <th>Branch</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- EMPLOYEE -->

                            <td>

                                <div class="employee-info">

                                    <div class="employee-avatar">

                                        @(item.FirstName?.Substring(0, 1))
                                        @(item.LastName?.Substring(0, 1))

                                    </div>

                                    <div>

                                        <div class="employee-name">

                                            <a href="/Employee/Profile/@item.EmployeeId"
                                               class="employee-profile-link">

                                                @item.FirstName
                                                @item.LastName

                                            </a>

                                        </div>

                                        <div class="employee-code">
                                            @item.EmployeeCode
                                        </div>

                                    </div>

                                </div>

                            </td>

                            <!-- BRANCH -->

                            <td>
                                @item.Branch?.BranchName
                            </td>

                            <!-- DEPARTMENT -->

                            <td>
                                @item.Department?.DepartmentName
                            </td>

                            <!-- DESIGNATION -->

                            <td>
                                @item.Designation?.DesignationName
                            </td>

                            <!-- JOINING -->

                            <td>
                                @(item.JoiningDate?.ToString("dd MMM yyyy"))
                            </td>

                            <!-- STATUS -->

                            <td>

                                <span class="status-badge status-active">
                                    @item.EmployeeStatus
                                </span>

                            </td>

                            <!-- ACTIONS -->

                            <td>

                                <div class="table-actions">

                                    <a href="#"
                                       class="action-btn">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a href="/Employee/Edit/@item.EmployeeId"
                                       class="action-btn">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <a href="/Employee/Delete/@item.EmployeeId"
                                       class="action-btn delete-btn"
                                       onclick="return confirm('Are you sure you want to deactivate this employee?')">

                                        <i class="bi bi-trash"></i>

                                    </a>
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>