@model IEnumerable<VeltriQ.Models.HR.AssetMaster>

@{
    ViewData["Title"] = "Asset Master";
}

<style>
    .asset-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── UNIFIED CORE MATRIX PANEL ── */
    .asset-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* ── TOP CONTROL DECK HEADER ── */
    .asset-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
        gap: 16px;
    }

    .asset-card-title {
        display: flex;
        flex-direction: column;
    }

        .asset-card-title h3 {
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 700;
            margin: 0 0 2px 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .asset-card-title p {
            color: var(--text-secondary);
            font-size: 11.5px;
            font-weight: 600;
            margin: 0;
        }

    /* ── ALIGNED SEARCH INTERFACE ── */
    .asset-search-deck {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .asset-search {
        width: 280px;
        position: relative;
    }

        .asset-search input {
            width: 100%;
            height: 30px;
            border-radius: 0px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 10px 0 32px;
            color: var(--text-primary);
            font-size: 12px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.15s ease-in-out;
        }

            .asset-search input:focus {
                border-color: rgba(124, 58, 237, 0.6);
            }

        .asset-search i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── THEMED ACTION WORKSPACE BUTTONS ── */
    .asset-add-btn {
        height: 30px;
        padding: 0 12px;
        border-radius: 0px;
        border: none;
        background: var(--purple);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: opacity 0.15s ease-in-out;
    }

        .asset-add-btn:hover {
            opacity: 0.9;
            color: #fff;
        }

    /* ── HIGH-DENSITY HIGH-PERFORMANCE DATA MATRIX ── */
    .table-wrapper {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) transparent;
    }

        .table-wrapper::-webkit-scrollbar {
            height: 4px;
        }

        .table-wrapper::-webkit-scrollbar-thumb {
            background: var(--scrollbar-thumb);
            border-radius: 0px;
        }

    .asset-table {
        width: 100%;
        border-collapse: collapse;
    }

        .asset-table th {
            text-align: left;
            padding: 8px 12px;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            background: var(--hover-bg);
            border-bottom: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .asset-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .asset-table tbody tr:last-child td {
            border-bottom: none;
        }

        .asset-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── CONDENSED TRACKING LABELS ── */
    .asset-identity-block {
        display: flex;
        flex-direction: column;
    }

    .asset-name {
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.3;
    }

    .asset-code {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 600;
        margin-top: 1px;
    }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 20px;
        padding: 0 8px;
        border-radius: 0px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
        border: 1px solid rgba(124, 58, 237, 0.2);
    }

    .badge-required {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .badge-returnable {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .badge-nonreturnable {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
    }

    /* ── CONTROL ACTIONS DECK ── */
    .table-actions {
        display: flex;
        gap: 4px;
    }

    .action-link-btn {
        background: transparent;
        border: none;
        color: var(--purple);
        font-weight: 600;
        cursor: pointer;
        font-size: 12px;
        padding: 2px 6px;
        border-radius: 0px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
    }

        .action-link-btn:hover {
            background: var(--hover-bg);
        }

    .action-divider {
        color: var(--border);
        align-self: center;
        font-size: 11px;
    }
</style>

<div class="asset-page">

    <div class="asset-master-card">

        <div class="asset-card-top">
            <div class="asset-card-title">
                <h3>Asset Inventory Configuration</h3>
                <p>Total Registered Framework Assets: <span style="color: var(--purple);" id="assetCounter">@Model.Count()</span></p>
            </div>

            <div class="asset-search-deck">
                <div class="asset-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="assetSearchInput" placeholder="Search parameters..." autocomplete="off" />
                </div>

                <a href="/AssetMaster/Create" class="asset-add-btn">
                    <i class="bi bi-plus-lg"></i> Add Asset
                </a>
            </div>
        </div>

        <div class="table-wrapper">
            <table class="asset-table" id="assetGridMatrix">
                <thead>
                    <tr>
                        <th style="width: 25%;">Asset / Identity Code</th>
                        <th style="width: 20%;">Category Group</th>
                        <th style="width: 20%;">Brand / Model Blueprint</th>
                        <th style="width: 15%;">Serial Required</th>
                        <th style="width: 12%;">Returnable Lifecycle</th>
                        <th style="width: 8%; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name-code">
                                    <div class="asset-identity-block">
                                        <span class="asset-name">@item.AssetName</span>
                                        <span class="asset-code">@item.AssetCode</span>
                                    </div>
                                </td>

                                <td data-search="category" style="font-weight: 600;">
                                    <span class="status-badge badge-category">
                                        <i class="bi bi-layers-half" style="font-size: 10px;"></i> @item.AssetCategory
                                    </span>
                                </td>

                                <td data-search="brand-model" style="color: var(--text-secondary); font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(item.BrandName) ? "-" : item.BrandName)
                                    <span style="color: var(--border); margin: 0 2px;">/</span>
                                    @(string.IsNullOrWhiteSpace(item.ModelName) ? "-" : item.ModelName)
                                </td>

                                <td>
                                    @if (item.SerialNumberRequired)
                                    {
                                        <span class="status-badge badge-required">
                                            <i class="bi bi-shield-lock" style="font-size: 10px;"></i> Required
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted); font-size: 12px; font-weight: 500; margin-left: 6px;">No</span>
                                    }
                                </td>

                                <td>
                                    @if (item.IsReturnable)
                                    {
                                        <span class="status-badge badge-returnable">
                                            <i class="bi bi-arrow-counterclockwise" style="font-size: 10px;"></i> Returnable
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-nonreturnable">
                                            <i class="bi bi-dash-circle" style="font-size: 10px;"></i> Non-Returnable
                                        </span>
                                    }
                                </td>

                                <td style="text-align: center;">
                                    <div class="table-actions" style="justify-content: center;">
                                        <a href="/AssetMaster/Details/@(item.GetType().GetProperty("AssetMasterId")?.GetValue(item) ?? item.GetType().GetProperty("Id")?.GetValue(item) ?? "0")" class="action-link-btn" title="View Specifications">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <span class="action-divider">|</span>
                                        <a href="/AssetMaster/Edit/@(item.GetType().GetProperty("AssetMasterId")?.GetValue(item) ?? item.GetType().GetProperty("Id")?.GetValue(item) ?? "0")" class="action-link-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No organization inventory configurations mapped to database registries.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("assetSearchInput");
        const matrixGrid = document.getElementById("assetGridMatrix");
        const counterTracker = document.getElementById("assetCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        // Dynamic Fallback Element Construction
        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found inside local matrices.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameCodeText = row.querySelector('[data-search="name-code"]')?.textContent.toLowerCase() || "";
                const categoryText = row.querySelector('[data-search="category"]')?.textContent.toLowerCase() || "";
                const brandModelText = row.querySelector('[data-search="brand-model"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameCodeText} ${categoryText} ${brandModelText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            // Toggle Empty State Visibility
            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            // Synchronize counter text
            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>