@model IEnumerable<VeltriQ.Models.HR.Nationality>

@{
    ViewData["Title"] = "Nationalities";
}

<style>
    .nationality-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .nationality-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .nationality-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .nationality-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .nationality-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .nationality-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .nationality-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .nationality-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .nationality-search-wrapper {
        position: relative;
        width: 320px;
    }

        .nationality-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .nationality-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .nationality-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .nationality-table {
        width: 100%;
        border-collapse: collapse;
    }

        .nationality-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .nationality-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .nationality-table tbody tr {
            transition: background-color .1s ease;
        }

            .nationality-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    /* ── INLINE ACTIONS (RIGHT ALIGNED) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="nationality-page">

    <div class="nationality-header">
        <a href="/Nationality/Create" class="nationality-add-btn">
            <i class="bi bi-plus-lg"></i> Add Nationality
        </a>
    </div>

    <div class="nationality-card">

        <div class="nationality-card-top">
            <div class="nationality-card-title">
                <h3>Nationality Directory</h3>
                <p>Total Records: <span id="nationCounter">@Model.Count()</span></p>
            </div>

            <div class="nationality-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="nationSearchInput" placeholder="Search nationalities..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="nationality-table" id="nationTableMatrix">
                <thead>
                    <tr>
                        <th>Nationality</th>
                        <th>Nationality Code</th>
                        <th>Country Code</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name" style="font-weight: 600;">
                                    @item.NationalityName
                                </td>
                                <td data-search="code">
                                    <span style="color: var(--text-secondary); font-size: 11.5px; font-weight: 500;">
                                        @item.NationalityCode
                                    </span>
                                </td>
                                <td data-search="country">
                                    @(string.IsNullOrWhiteSpace(item.CountryCode) ? "-" : item.CountryCode)
                                </td>
                                <td>
                                    <span class="status-badge status-active">Active</span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/Nationality/Details/@item.NationalityId" class="action-btn" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Nationality/Edit/@item.NationalityId" class="action-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/Nationality/Delete/@item.NationalityId" class="action-btn delete-btn" title="Delete Entry" onclick="return confirm('Are you sure?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="5" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("nationSearchInput");
        const matrixGrid = document.getElementById("nationTableMatrix");
        const counterTracker = document.getElementById("nationCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="5" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const countryText = row.querySelector('[data-search="country"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameText} ${codeText} ${countryText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>