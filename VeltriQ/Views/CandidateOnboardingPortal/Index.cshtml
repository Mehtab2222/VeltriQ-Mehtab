@model VeltriQ.ViewModels.CandidateOnboardingPortal.CandidateOnboardingIndexViewModel

@{
    ViewData["Title"] = "Onboarding Workspace";
    Layout = "_CandidateOnboardingLayout"; // Explicitly linked to your isolated candidate portal layout shell
}

<style>
    .profile-details-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── COMPACT NAVIGATION SUB-TAB STRIP ── */
    .details-nav-tabs {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 4px 0 0 0;
        border-bottom: 1px solid var(--border);
        gap: 2px;
        overflow-x: auto; /* Fluid horizontal scroll swipe touch support for mobile screens */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .details-nav-tabs::-webkit-scrollbar {
            display: none;
        }

    .details-tab-item {
        margin-bottom: -1px;
        flex-shrink: 0;
    }

    .details-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--text-secondary);
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
    }

        .details-tab-btn:hover {
            color: var(--purple);
        }

        .details-tab-btn.active {
            color: var(--purple);
            background: var(--card-bg);
            border-color: var(--border) var(--border) transparent var(--border);
        }

    /* ── WORKSPACE VIEWPORT LAYOUT PANEL ── */
    .workspace-tab-viewport {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 16px;
        min-height: 350px;
    }

    /* ── COMPACT MICRO OVERFLOW HOVER SCROLL PANELS ── */
    .responsive-table-holder {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
    }

        .responsive-table-holder::-webkit-scrollbar {
            height: 4px;
        }

        .responsive-table-holder::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 2px;
        }

    .viewport-grid-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
    }

        .viewport-grid-table th {
            text-align: left;
            padding: 8px 12px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
            background: var(--hover-bg);
            white-space: nowrap;
        }

        .viewport-grid-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
            white-space: nowrap;
        }

        .viewport-grid-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── METRIC ALIGNMENT PARAMS ── */
    .overview-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
    }

        .overview-summary-row:last-child {
            border-bottom: none;
        }

    .overview-summary-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .overview-summary-value {
        font-size: 12px;
        font-weight: 700;
        color: var(--purple);
    }

    .timeline-empty-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 16px;
        text-align: center;
        color: var(--text-secondary);
    }

        .timeline-empty-placeholder i {
            font-size: 28px;
            opacity: 0.4;
            margin-bottom: 8px;
        }
</style>

<div class="profile-details-page">

    @await Html.PartialAsync("_Header", Model)

    <ul class="details-nav-tabs">
        <li class="details-tab-item">
            <button class="details-tab-btn active" onclick="toggleDetailsTab('overview', this)">
                <i class="bi bi-pie-chart"></i> Overview
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('information', this)">
                <i class="bi bi-layers"></i> Information
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('documents', this)">
                <i class="bi bi-file-earmark-text"></i> Documents
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('policies', this)">
                <i class="bi bi-shield-check"></i> Policies
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('activities', this)">
                <i class="bi bi-calendar-check"></i> Activities
            </button>
        </li>
        <li class="details-tab-item">
            <button class="details-tab-btn" onclick="toggleDetailsTab('timeline', this)">
                <i class="bi bi-clock-history"></i> Timeline
            </button>
        </li>
    </ul>

    <div class="workspace-tab-viewport">

        <div id="view_overview">
            @await Html.PartialAsync("_Overview", Model)
        </div>

        <div id="view_information" style="display: none;">
            @await Html.PartialAsync("_Information", Model)
        </div>

        <div id="view_documents" style="display: none;">
            @await Html.PartialAsync("_Documents", Model)
        </div>

        <div id="view_policies" style="display: none;">
            @await Html.PartialAsync("_Policies", Model)
        </div>

        <div id="view_activities" style="display: none;">
            @await Html.PartialAsync("_Activities", Model)
        </div>

        <div id="view_timeline" style="display: none;">
            @await Html.PartialAsync("_Timeline", Model)
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function toggleDetailsTab(targetViewId, buttonElement) {
            // Unset current focus attributes cleanly
            const tabs = buttonElement.closest('.details-nav-tabs').getElementsByClassName('details-tab-btn');
            for (let i = 0; i < tabs.length; i++) {
                tabs[i].classList.remove('active');
            }

            // Register focal destination target active
            buttonElement.classList.add('active');

            // Collapse view instances instantly
            const targets = ['overview', 'information', 'documents', 'policies', 'activities', 'timeline'];
            targets.forEach(view => {
                const el = document.getElementById('view_' + view);
                if (el) el.style.display = 'none';
            });

            // Deploy focal layer panel screen
            const targetView = document.getElementById('view_' + targetViewId);
            if (targetView) targetView.style.display = 'block';
        }
    </script>
}