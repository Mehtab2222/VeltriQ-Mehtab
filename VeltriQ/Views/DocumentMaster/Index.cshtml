@model IEnumerable<VeltriQ.Models.HR.DocumentMaster>

@{
    ViewData["Title"] = "Document Master";
}

<style>

    .document-page {
        width: 100%;
    }

    /* HEADER */

    .document-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .document-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
    }

    .document-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    /* BUTTON */

    .document-add-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 8px 22px rgba(124,58,237,.22);
        transition: .2s ease;
    }

        .document-add-btn:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    /* CARD */

    .document-card {
        background: rgba(30,35,44,.94);
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.06);
        overflow: hidden;
    }

    .document-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
        gap: 20px;
    }

    .document-card-title h3 {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .document-card-title p {
        color: #94a3b8;
        font-size: 13px;
        margin: 0;
    }

    /* SEARCH */

    .document-search {
        width: 320px;
        position: relative;
    }

        .document-search input {
            width: 100%;
            height: 42px;
            border-radius: 12px;
            border: 1px solid #2a3441;
            background: #0d1117;
            padding: 0 14px 0 42px;
            color: #fff;
            outline: none;
            font-size: 13px;
        }

            .document-search input:focus {
                border-color: #7c3aed;
            }

        .document-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
        }

    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
    }

    .document-table {
        width: 100%;
        border-collapse: collapse;
    }

        .document-table th {
            text-align: left;
            padding: 0 20px 14px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
        }

        .document-table td {
            padding: 18px 20px;
            border-top: 1px solid rgba(255,255,255,.04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .document-table tbody tr:hover {
            background: rgba(255,255,255,.02);
        }

    /* DOC */

    .document-name {
        font-weight: 700;
        color: #fff;
        margin-bottom: 2px;
    }

    .document-code {
        font-size: 11px;
        color: #6b7280;
    }

    /* BADGES */

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 28px;
        padding: 0 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-mandatory {
        background: rgba(239,68,68,.14);
        color: #ef4444;
    }

    .badge-optional {
        background: rgba(59,130,246,.14);
        color: #60a5fa;
    }

    .badge-active {
        background: rgba(34,197,94,.14);
        color: #22c55e;
    }

    .extension-box {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 8px;
        background: rgba(124,58,237,.10);
        color: #c4b5fd;
        font-size: 11px;
        font-weight: 600;
    }

    /* ACTIONS */

    .table-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 30px;
        height: 30px;
        border-radius: 10px;
        border: none;
        background: rgba(124,58,237,.12);
        color: #7c3aed;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s ease;
    }

        .action-btn:hover {
            background: #7c3aed;
            color: #fff;
        }

</style>

<div class="document-page">

    <!-- HEADER -->

    <div class="document-header">

        <div class="document-header-left">

            <h2>Document Master</h2>

            <p>
                Manage onboarding and employee document configurations.
            </p>

        </div>

        <a href="/DocumentMaster/Create"
           class="document-add-btn">

            <i class="bi bi-plus-lg"></i>

            Add Document

        </a>

    </div>

    <!-- CARD -->

    <div class="document-card">

        <div class="document-card-top">

            <div class="document-card-title">

                <h3>Document Directory</h3>

                <p>
                    Total Documents:
                    @Model.Count()
                </p>

            </div>

            <div class="document-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       placeholder="Search documents..." />

            </div>

        </div>

        <!-- TABLE -->

        <div class="table-wrapper">

            <table class="document-table">

                <thead>

                    <tr>

                        <th>Document</th>
                        <th>Mandatory</th>
                        <th>Extensions</th>
                        <th>Max Size</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- DOC -->

                            <td>

                                <div class="document-name">
                                    @item.DocumentName
                                </div>

                                <div class="document-code">
                                    @item.DocumentCode
                                </div>

                            </td>

                            <!-- MANDATORY -->

                            <td>

                                @if (item.IsMandatory)
                                {
                                    <span class="badge badge-mandatory">
                                        Mandatory
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-optional">
                                        Optional
                                    </span>
                                }

                            </td>

                            <!-- EXTENSIONS -->

                            <td>

                                <span class="extension-box">
                                    @item.AllowedFileExtensions
                                </span>

                            </td>

                            <!-- SIZE -->

                            <td>
                                @(item.MaxFileSizeMB) MB
                            </td>

                            <!-- STATUS -->

                            <td>

                                <span class="badge badge-active">
                                    Active
                                </span>

                            </td>

                            <!-- ACTIONS -->

                            <td>

                                <div class="table-actions">

                                    <a href="#"
                                       class="action-btn">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a href="#"
                                       class="action-btn">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>