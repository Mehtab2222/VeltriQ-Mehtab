@model VeltriQ.ViewModels.JobProfileViewModel

@{
    ViewData["Title"] = "Edit Job Profile";
}

<style>
    .jobprofile-container {
        width: 100%;
    }

    .jobprofile-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .jobprofile-header h2 {
            font-size: 26px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }

        .jobprofile-header p {
            color: #94a3b8;
            font-size: 14px;
            margin: 0;
        }

    .add-skills-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: 1px solid #2d3748;
        background: rgba(124,58,237,.12);
        color: #c4b5fd;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
    }

        .add-skills-btn:hover {
            background: rgba(124,58,237,.22);
            color: #fff;
        }

    .jobprofile-card {
        background: rgba(30,35,44,.94);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        padding: 28px;
    }

    .form-section-title {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 22px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .form-control {
        height: 46px;
        border-radius: 12px;
        border: 1px solid #2d3748;
        background: #0f172a;
        color: #fff;
        padding: 0 14px;
        font-size: 13px;
        outline: none;
        transition: .2s ease;
    }

    select.form-control[multiple] {
        height: 160px;
        padding-top: 10px;
    }

    textarea.form-control {
        min-height: 120px;
        padding-top: 12px;
        resize: none;
    }

    .form-control:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124,58,237,.15);
    }

    .submit-btn {
        height: 48px;
        padding: 0 24px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg,#7c3aed,#6d28d9);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        margin-top: 30px;
        transition: .2s ease;
        box-shadow: 0 10px 24px rgba(124,58,237,.25);
    }

        .submit-btn:hover {
            transform: translateY(-2px);
        }
</style>

<div class="jobprofile-container">

    <div class="jobprofile-header">
        <div>
            <h2>Edit Job Profile</h2>
            <p>Update the job profile details.</p>
        </div>

        <a href="/Skill/Index" target="_blank" class="add-skills-btn">
            <i class="bi bi-plus-lg"></i> Add Skills
        </a>
    </div>

    <div class="jobprofile-card">

        <form asp-action="Edit" asp-controller="JobProfile" method="post">
            <input type="hidden" asp-for="JobProfileId" />

            <div class="form-section-title">Job Information</div>

            <div class="form-grid">

                <div class="form-group">
                    <label>Job Profile Name</label>
                    <input asp-for="JobTitle" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Skill Category</label>
                    <select asp-for="JobCategoryId" asp-items="Model.JobCategoryList" class="form-control" id="jobCategoryDropdown">
                        <option value="">Select Category</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Reviewers</label>
                    <select asp-for="SelectedReviewerIds" asp-items="Model.EmployeeList" multiple class="form-control"></select>
                </div>

                <div class="form-group">
                    <label>Reporting To</label>
                    <select asp-for="ReportingToId" asp-items="Model.EmployeeList" class="form-control">
                        <option value="">Select Employee</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Hiring Manager</label>
                    <select asp-for="HiringManagerId" asp-items="Model.EmployeeList" class="form-control">
                        <option value="">Select Employee</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Skills</label>
                    <select asp-for="SelectedSkillIds" multiple class="form-control" id="skillsDropdown"></select>
                </div>

            </div>

            <div class="form-group mt-4">
                <label>Job Description</label>
                <textarea asp-for="JobDescription" class="form-control"></textarea>
            </div>

            <button type="submit" class="submit-btn">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>

        </form>

    </div>

</div>

<script>
    var existingSkillIds = @Html.Raw(Json.Serialize(Model.SelectedSkillIds ?? new List<int>()));

    function loadSkills(categoryId, preselect) {
        $("#skillsDropdown").empty();
        if (!categoryId) return;

        $.get('/JobProfile/GetSkillsByCategory', { categoryId: categoryId }, function (data) {
            $.each(data, function (i, item) {
                var selected = preselect.indexOf(item.id) !== -1 ? "selected" : "";
                $("#skillsDropdown").append(`<option value="${item.id}" ${selected}>${item.text}</option>`);
            });
        });
    }

    $(document).ready(function () {
        var initialCategoryId = $("#jobCategoryDropdown").val();
        loadSkills(initialCategoryId, existingSkillIds);
    });

    $("#jobCategoryDropdown").change(function () {
        loadSkills($(this).val(), []);
    });
</script>