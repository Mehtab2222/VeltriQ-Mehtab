@model IEnumerable<VeltriQ.Models.HR.Attendance.WeeklyOffPolicy>

@{
    ViewData["Title"] = "Weekly Off Policies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .weekly-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .weekly-header-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    .weekly-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .weekly-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .weekly-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .weekly-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .weekly-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .weekly-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box input {
            width: 100%;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 12px 0 32px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .search-box input:focus {
                border-color: var(--purple);
            }

        .search-box i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .weekly-table {
        width: 100%;
        border-collapse: collapse;
    }

        .weekly-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .weekly-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .weekly-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    /* MODAL WINDOW SYSTEM */
    .custom-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

        .custom-modal.active {
            display: flex;
        }

    .custom-modal-box {
        width: 100%;
        max-width: 650px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
    }

    .modal-header-custom {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

        .modal-header-custom h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

    .close-modal-btn {
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 4px;
        background: var(--card-bg);
        color: var(--text-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-body-custom {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 16px;
        scrollbar-width: thin;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group.wide {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--text-secondary);
        }

    .custom-input, .custom-select, .custom-textarea {
        width: 100%;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
    }

    .custom-input, .custom-select {
        height: 36px;
    }

    .custom-textarea {
        resize: vertical;
        min-height: 70px;
        padding: 8px 12px;
    }

        .custom-input:focus, .custom-select:focus, .custom-textarea:focus {
            border-color: var(--purple);
        }

    .custom-input[readonly] {
        background: var(--hover-bg);
        opacity: 0.8;
        cursor: not-allowed;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }

        .checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--purple);
            cursor: pointer;
        }

        .checkbox-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            text-transform: none;
            cursor: pointer;
        }

    .modal-footer-custom {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

    .cancel-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        font-weight: 600;
        font-size: 12px;
        cursor: pointer;
    }

    .save-btn {
        height: 34px;
        padding: 0 16px;
        border: none;
        border-radius: 6px;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-weight: 600;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@Html.AntiForgeryToken()

<div class="weekly-page">
    <div class="weekly-header-bar">
        <button class="weekly-add-btn" onclick="openPolicyModal('create')">
            <i class="bi bi-plus-lg"></i> Create Weekly Off Policy
        </button>
    </div>

    <div class="weekly-card">
        <div class="weekly-card-top">
            <div class="weekly-card-title">
                <h3>Weekly Off Policy Master</h3>
                <p>Manage standard weekend patterns, company-specific day offs, and recurring schedules.</p>
            </div>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="policySearchInput" placeholder="Search policies..." onkeyup="filterPolicies()" autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="weekly-table" id="policyTable">
                <thead>
                    <tr>
                        <th>Policy Code</th>
                        <th>Policy Name</th>
                        <th>Company</th>
                        <th style="text-align: center;">Default Status</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            var statusClass = x.IsActive ? "status-active" : "status-inactive";
                            var statusText = x.IsActive ? "Active" : "Inactive";
                            <tr class="policy-row" id="policy-row-@x.WeeklyOffPolicyId">
                                <td style="font-weight: 700; font-family: monospace;">@x.PolicyCode</td>
                                <td style="font-weight: 600;" class="searchable-text">@x.PolicyName</td>
                                <td class="searchable-text">@(x.Company?.CompanyName ?? "—")</td>
                                <td style="text-align: center;">
                                    @if (x.IsDefaultPolicy)
                                    {
                                        <span class="badge-status" style="background: rgba(124, 58, 237, 0.15); color: var(--purple);">Default</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge-status @statusClass" id="badge-@x.WeeklyOffPolicyId">@statusText</span>
                                </td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                        <button class="action-btn" onclick="openPolicyModal('edit', @x.WeeklyOffPolicyId)" title="Edit Policy">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="action-btn" onclick="togglePolicyStatus(@x.WeeklyOffPolicyId)" title="Toggle Status" style="color: #f59e0b;">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No weekly off policies configured yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="custom-modal" id="policyModal">
    <div class="custom-modal-box">
        <div class="modal-header-custom">
            <div>
                <h3 id="modalTitle">Create Weekly Off Policy</h3>
                <p style="font-size: 11px; color: var(--text-secondary); margin: 2px 0 0 0;">Define policy details and company mappings.</p>
            </div>
            <button type="button" class="close-modal-btn" onclick="closePolicyModal()"><i class="bi bi-x-lg"></i></button>
        </div>

        <form id="policyForm" method="post" onsubmit="submitPolicyForm(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" id="WeeklyOffPolicyId" name="WeeklyOffPolicy.WeeklyOffPolicyId" value="0" />

            <div class="modal-body-custom">
                <div class="form-grid">
                    <div class="form-group wide">
                        <label>Company *</label>
                        <select name="WeeklyOffPolicy.CompanyId" class="custom-select" id="modalCompanyId" required>
                            <option value="">Select Company</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Policy Code * (Auto)</label>
                        <input type="text" name="WeeklyOffPolicy.PolicyCode" id="modalPolicyCode" class="custom-input" readonly required />
                    </div>

                    <div class="form-group">
                        <label>Policy Name *</label>
                        <input type="text" name="WeeklyOffPolicy.PolicyName" id="modalPolicyName" class="custom-input" placeholder="e.g. Saturday & Sunday Off" required />
                    </div>

                    <div class="form-group wide">
                        <label>Description</label>
                        <textarea name="WeeklyOffPolicy.Description" id="modalDescription" class="custom-textarea" placeholder="Optional details..."></textarea>
                    </div>

                    <div class="form-group wide" style="display: flex; flex-direction: row; gap: 24px; margin-top: 4px;">
                        <div class="checkbox-group">
                            <input type="checkbox" name="WeeklyOffPolicy.IsDefaultPolicy" id="modalIsDefaultPolicy" value="true" />
                            <label for="modalIsDefaultPolicy">Set as Default Policy</label>
                        </div>
                        <div class="checkbox-group">
                            <input type="checkbox" name="WeeklyOffPolicy.IsActive" id="modalIsActive" value="true" checked />
                            <label for="modalIsActive">Is Active</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="cancel-btn" onclick="closePolicyModal()">Cancel</button>
                <button type="submit" class="save-btn"><i class="bi bi-check2-circle"></i> Save Policy</button>
            </div>
        </form>
    </div>
</div>

<script>
    function filterPolicies() {
        const input = document.getElementById('policySearchInput');
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#policyTable tbody tr.policy-row');

        rows.forEach(row => {
            const textContent = row.textContent.toLowerCase();
            if (textContent.includes(filter)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    async function loadCompanies(selectedCompanyId = null) {
        const companySelect = document.getElementById('modalCompanyId');
        companySelect.innerHTML = '<option value="">Select Company</option>';

        try {
            const res = await fetch('/ShiftMaster/GetCompanies');
            const companies = await res.json();
            companies.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.companyId || c.value;
                opt.textContent = c.companyName || c.text;
                if (selectedCompanyId && opt.value == selectedCompanyId) {
                    opt.selected = true;
                }
                companySelect.appendChild(opt);
            });
        } catch (err) {
            console.error('Error loading companies:', err);
        }
    }

    async function openPolicyModal(mode, id = 0) {
        const modal = document.getElementById('policyModal');
        const form = document.getElementById('policyForm');
        const title = document.getElementById('modalTitle');

        modal.classList.add('active');
        form.reset();

        if (mode === 'create') {
            title.textContent = 'Create Weekly Off Policy';
            form.action = '/WeeklyOffPolicy/Create';
            document.getElementById('WeeklyOffPolicyId').value = 0;
            document.getElementById('modalIsActive').checked = true;
            document.getElementById('modalIsDefaultPolicy').checked = false;

            await loadCompanies();

            const randomCode = 'WOP-' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('modalPolicyCode').value = randomCode;
        } else {
            title.textContent = 'Edit Weekly Off Policy';
            form.action = '/WeeklyOffPolicy/Edit';
            document.getElementById('WeeklyOffPolicyId').value = id;

            try {
                const res = await fetch(`/WeeklyOffPolicy/GetPolicyById?id=${id}`);
                const data = await res.json();

                if (data.success) {
                    await loadCompanies(data.companyId);
                    document.getElementById('modalPolicyCode').value = data.policyCode;
                    document.getElementById('modalPolicyName').value = data.policyName;
                    document.getElementById('modalDescription').value = data.description || '';
                    document.getElementById('modalIsDefaultPolicy').checked = data.isDefaultPolicy;
                    document.getElementById('modalIsActive').checked = data.isActive;
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message, confirmButtonColor: '#7c3aed' });
                    closePolicyModal();
                }
            } catch (err) {
                console.error('Failed to load policy for editing:', err);
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not fetch policy details.', confirmButtonColor: '#7c3aed' });
                closePolicyModal();
            }
        }
    }

    function closePolicyModal() {
        document.getElementById('policyModal').classList.remove('active');
    }

    async function submitPolicyForm(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                closePolicyModal();
                Swal.fire({ icon: 'success', title: 'Success!', text: 'Weekly Off Policy saved successfully.', timer: 1200, showConfirmButton: false });
                setTimeout(() => location.reload(), 1200);
            } else {
                Swal.fire({ icon: 'error', title: 'Validation Error', text: 'Please check your inputs and try again.', confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Submission error:', err);
            Swal.fire({ icon: 'error', title: 'Submission Failed', text: 'An unexpected network error occurred.', confirmButtonColor: '#7c3aed' });
        }
    }

    async function togglePolicyStatus(id) {
        const confirmResult = await Swal.fire({
            title: 'Toggle Policy Status?',
            text: 'Are you sure you want to toggle the status of this weekly off policy?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#ef4444',
            confirmButtonText: 'Yes, toggle it!'
        });

        if (!confirmResult.isConfirmed) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(`/WeeklyOffPolicy/ToggleStatus/${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Action Denied', text: result.message, confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Toggle status error:', err);
        }
    }
</script>