@model VeltriQ.ViewModels.AssetAllocation.AssetAllocationIndexViewModel

@{
    ViewData["Title"] = "Asset Allocation";
}

<style>
    .asset-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Pushed Up & Unified) ── */
    .asset-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT ADD/ALLOCATE BUTTON ── */
    .asset-allocate-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .asset-allocate-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH SYSTEM VARIABLES ── */
    .asset-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .asset-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .asset-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .asset-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── SEARCH INTERFACE DECK ── */
    .asset-search {
        width: 280px;
        position: relative;
    }

        .asset-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .asset-search input:focus {
                border-color: var(--purple);
            }

        .asset-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── HIGH-DENSITY TABLE GRID MATRIX ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .asset-table {
        width: 100%;
        border-collapse: collapse;
    }

        .asset-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .asset-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .asset-table tbody tr {
            transition: background-color .1s ease;
        }

            .asset-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH DENSITY IDENTITY ELEMENTS ── */
    .employee-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .employee-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 11px;
        flex-shrink: 0;
    }

    .employee-name {
        font-weight: 600;
        margin-bottom: 1px;
        line-height: 1.2;
    }

    .employee-profile-link {
        color: var(--text-primary);
        text-decoration: none;
    }

        .employee-profile-link:hover {
            color: var(--purple);
        }

    /* ── CUSTOM STATUS BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        background: rgba(234, 179, 8, 0.12);
        color: #eab308;
    }

    .status-allocated {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-partial {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }
</style>

<div class="asset-page">

    <div class="asset-header">
        <a href="/AssetAllocation/Create" class="asset-allocate-btn">
            <i class="bi bi-plus-lg"></i>
            Allocate Assets
        </a>
    </div>

    <div class="asset-card">

        <div class="asset-card-top">
            <div class="asset-card-title">
                <h3>Asset Allocation</h3>
                <p>Total Records: @Model.Items.Count</p>
            </div>

            <div class="asset-search">
                <i class="bi bi-search"></i>
                <input type="text" id="allocationSearchInput" placeholder="Search parameters..." onkeyup="filterAllocationsTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="asset-table" id="allocationTable">
                <thead>
                    <tr>
                        <th>Employee Code</th>
                        <th>Employee Name</th>
                        <th>Department</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="font-weight: 700; color: var(--text-primary);">
                                    @item.EmployeeCode
                                </td>
                                <td>
                                    <div class="employee-info">
                                        <div class="employee-avatar">
                                            @if (!string.IsNullOrWhiteSpace(item.EmployeeName) && item.EmployeeName.Contains(" "))
                                            {
                                                var parts = item.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                                if (parts.Length >= 2)
                                                {
                                                    @($"{parts[0][0]}{parts[1][0]}".ToUpper())
                                                }
                                                else
                                                {
                                                    @($"{parts[0][0]}".ToUpper())
                                                }
                                            }
                                            else
                                            {
                                                @("-")
                                            }
                                        </div>
                                        <div class="employee-name">
                                            <a href="/AssetAllocation/Details/@item.EmployeeId" class="employee-profile-link">
                                                @item.EmployeeName
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td style="font-weight: 500;">
                                    @(string.IsNullOrWhiteSpace(item.Department) ? "-" : item.Department)
                                </td>
                                <td style="color: var(--text-secondary);">
                                    @(item.JoiningDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>
                                <td>
                                    @{
                                        string statusClass = (item.AllocationStatus ?? "").ToLower() switch
                                        {
                                            "allocated" => "status-allocated",
                                            "partial" or "partial allocation" => "status-partial",
                                            _ => "status-pending"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@item.AllocationStatus</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No active framework allocations detected in data streams.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterAllocationsTable() {
        const input = document.getElementById('allocationSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('allocationTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>