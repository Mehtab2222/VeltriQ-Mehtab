@{
    ViewData["Title"] = "Leave Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="leave-page">

    <!-- HEADER -->

    <div class="page-header">

        <div>
            <h1>Leave Types</h1>
            <p>Manage organization leave categories and configurations.</p>
        </div>

        <button class="add-btn" onclick="openLeaveModal()">

            <i class="bi bi-plus-lg"></i>
            Add New Leave

        </button>

    </div>

    <!-- CARD -->

    <div class="leave-card">

        <!-- CARD TOP -->

        <div class="card-top">

            <div>
                <h3>Leave Type Directory</h3>
                <p>Total Leave Types : 8</p>
            </div>

            <div class="table-actions-top">

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           placeholder="Search leave type..." />

                </div>

            </div>

        </div>

        <!-- TABLE -->

        <div class="table-wrapper">

            <table class="leave-table">

                <thead>

                    <tr>

                        <th>Leave ID</th>
                        <th>Leave Name</th>
                        <th>Created By</th>
                        <th>Created On</th>
                        <th>Updated By</th>
                        <th>Updated On</th>
                        <th>Status</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>LV001</td>
                        <td>Annual Leave</td>
                        <td>Admin</td>
                        <td>12 Jan 2025</td>
                        <td>HR Manager</td>
                        <td>05 Feb 2025</td>

                        <td>
                            <span class="status active-status">
                                Active
                            </span>
                        </td>

                        <td>

                            <div class="action-buttons">

                                <button class="action-btn view-btn">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <button class="action-btn edit-btn">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="action-btn delete-btn">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </div>

                        </td>

                    </tr>

                    <tr>

                        <td>LV002</td>
                        <td>Sick Leave</td>
                        <td>Admin</td>
                        <td>14 Jan 2025</td>
                        <td>HR Manager</td>
                        <td>01 Mar 2025</td>

                        <td>
                            <span class="status active-status">
                                Active
                            </span>
                        </td>

                        <td>

                            <div class="action-buttons">

                                <button class="action-btn view-btn">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <button class="action-btn edit-btn">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="action-btn delete-btn">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </div>

                        </td>

                    </tr>

                    <tr>

                        <td>LV003</td>
                        <td>Maternity Leave</td>
                        <td>System</td>
                        <td>22 Jan 2025</td>
                        <td>Admin</td>
                        <td>11 Apr 2025</td>

                        <td>
                            <span class="status inactive-status">
                                Inactive
                            </span>
                        </td>

                        <td>

                            <div class="action-buttons">

                                <button class="action-btn view-btn">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <button class="action-btn edit-btn">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="action-btn delete-btn">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </div>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>
<!-- ADD / EDIT LEAVE MODAL -->

<div class="custom-modal" id="leaveModal">

    <div class="custom-modal-box">

        <!-- HEADER -->

        <div class="modal-header-custom">

            <div>
                <h3 id="modalTitle">Add Leave Type</h3>
                <p>Create and manage leave configurations.</p>
            </div>

            <button class="close-modal-btn"
                    onclick="closeLeaveModal()">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>

        <!-- BODY -->

        <div class="modal-body-custom">

            <div class="modal-grid">

                <!-- LEAVE NAME -->

                <div class="form-group">

                    <label>Leave Name</label>

                    <input type="text"
                           class="custom-input"
                           placeholder="Enter leave name" />

                </div>

                <!-- LEAVE CODE -->

                <div class="form-group">

                    <label>Leave Code</label>

                    <input type="text"
                           class="custom-input"
                           placeholder="Ex : AL" />

                </div>

                <!-- NUMBER OF DAYS -->

                <div class="form-group">

                    <label>No Of Days</label>

                    <input type="number"
                           class="custom-input"
                           placeholder="Enter number of days" />

                </div>

                <!-- STATUS -->

                <div class="form-group">

                    <label>Status</label>

                    <select class="custom-input">

                        <option>Active</option>
                        <option>Inactive</option>

                    </select>

                </div>

                <!-- GENDER -->

                <div class="form-group">

                    <label>Gender Applicability</label>

                    <select class="custom-input">

                        <option>All</option>
                        <option>Male</option>
                        <option>Female</option>

                    </select>

                </div>

                <!-- CARRY FORWARD -->

                <div class="form-group">

                    <label>Carry Forward</label>

                    <select class="custom-input">

                        <option>Yes</option>
                        <option>No</option>

                    </select>

                </div>

                <!-- ENCASHMENT -->

                <div class="form-group">

                    <label>Encashment Allowed</label>

                    <select class="custom-input">

                        <option>Yes</option>
                        <option>No</option>

                    </select>

                </div>

                <!-- HALF DAY -->

                <div class="form-group">

                    <label>Half Day Allowed</label>

                    <select class="custom-input">

                        <option>Yes</option>
                        <option>No</option>

                    </select>

                </div>

            </div>

        </div>

        <!-- FOOTER -->

        <div class="modal-footer-custom">

            <button class="cancel-btn"
                    onclick="closeLeaveModal()">

                Cancel

            </button>

            <button class="save-btn">

                <i class="bi bi-check2-circle"></i>
                Save Leave Type

            </button>

        </div>

    </div>

</div>
<style>

    .leave-page {
        width: 100%;
    }

    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

        .page-header h1 {
            font-size: 42px;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .page-header p {
            color: var(--text-secondary);
            font-size: 15px;
        }

    /* BUTTON */

    .add-btn {
        height: 48px;
        padding: 0 22px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(124,58,237,.25);
    }

    /* CARD */

    .leave-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 24px;
        overflow: hidden;
    }

    .card-top {
        padding: 22px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-top h3 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 5px;
        }

        .card-top p {
            color: var(--text-secondary);
            font-size: 13px;
        }

    /* SEARCH */

    .search-box {
        width: 280px;
        position: relative;
    }

        .search-box input {
            width: 100%;
            height: 44px;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 16px 0 42px;
            outline: none;
            font-size: 14px;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
        }

    /* TABLE */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .leave-table {
        width: 100%;
        border-collapse: collapse;
    }

        .leave-table thead tr {
            background: rgba(255,255,255,.02);
        }

        .leave-table th {
            padding: 18px 20px;
            text-align: left;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .leave-table td {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(255,255,255,.04);
            color: var(--text-primary);
            font-size: 14px;
            white-space: nowrap;
        }

        .leave-table tbody tr {
            transition: .2s ease;
        }

            .leave-table tbody tr:hover {
                background: rgba(255,255,255,.02);
            }

    /* STATUS */

    .status {
        padding: 7px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .active-status {
        background: rgba(34,197,94,.14);
        color: #22c55e;
    }

    .inactive-status {
        background: rgba(239,68,68,.14);
        color: #ef4444;
    }

    /* ACTIONS */

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: .2s ease;
        font-size: 14px;
    }

    .view-btn {
        background: rgba(59,130,246,.12);
        color: #3b82f6;
    }

    .edit-btn {
        background: rgba(124,58,237,.12);
        color: #7c3aed;
    }

    .delete-btn {
        background: rgba(239,68,68,.12);
        color: #ef4444;
    }

    .action-btn:hover {
        transform: translateY(-2px);
    }
    /* MODAL */

    .custom-modal {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.65);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
        backdrop-filter: blur(4px);
    }

        .custom-modal.active {
            display: flex;
        }

    .custom-modal-box {
        width: 100%;
        max-width: 760px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 24px;
        overflow: hidden;
        animation: modalShow .2s ease;
    }

    @@keyframes modalShow {
        from

    {
        opacity: 0;
        transform: translateY(10px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .modal-header-custom {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .modal-header-custom h3 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .modal-header-custom p {
            font-size: 13px;
            color: var(--text-secondary);
        }

    .close-modal-btn {
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 12px;
        background: rgba(255,255,255,.06);
        color: var(--text-primary);
        cursor: pointer;
    }

    .modal-body-custom {
        padding: 22px 24px;
    }

    .modal-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-secondary);
        }

    .custom-input {
        width: 100%;
        height: 46px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 14px;
        font-size: 14px;
        outline: none;
    }

        .custom-input:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124,58,237,.15);
        }

    .modal-footer-custom {
        padding: 18px 24px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .cancel-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        cursor: pointer;
        font-weight: 600;
    }

    .save-btn {
        height: 44px;
        padding: 0 18px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    @@media(max-width:768px) {

        .modal-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
<script>

    function openLeaveModal() {

        document
            .getElementById('leaveModal')
            .classList.add('active');
    }

    function closeLeaveModal() {

        document
            .getElementById('leaveModal')
            .classList.remove('active');
    }

</script>