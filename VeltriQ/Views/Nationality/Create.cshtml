@model VeltriQ.Models.HR.Nationality

@{
    ViewData["Title"] = "Create Nationality";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .nationality-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        padding-bottom: 30px;
    }

    /* TOPBAR */
    .nationality-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
    }

    .nationality-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

        .nationality-breadcrumb a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
        }

        .nationality-breadcrumb i {
            color: var(--text-muted);
            font-size: 10px;
        }

        .nationality-breadcrumb span {
            color: var(--text-secondary);
            font-weight: 500;
        }

    .nationality-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cancel-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .cancel-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    .save-btn {
        height: 32px;
        padding: 0 16px;
        border: none;
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .save-btn:hover {
            opacity: 0.9;
        }

    /* SINGLE COMPACT CARD MODULE (3 Columns per row) */
    .nationality-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
    }

    .nationality-card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .col-span-2 {
        grid-column: span 2;
    }

    .col-span-3 {
        grid-column: span 3;
    }

    /* FIELD */
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .form-field label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

    /* INPUT */
    .form-input {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .form-input:focus {
            border-color: var(--purple);
        }

        .form-input::placeholder {
            color: var(--text-muted);
        }

    /* RESPONSIVE */
    @@media(max-width: 1024px) {
        .nationality-card-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .col-span-2, .col-span-3 {
            grid-column: span 2;
        }
    }

    @@media(max-width: 640px) {
        .nationality-card-grid {
            grid-template-columns: 1fr;
        }

        .col-span-2, .col-span-3 {
            grid-column: span 1;
        }

        .nationality-topbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .nationality-top-actions {
            width: 100%;
        }

        .cancel-btn,
        .save-btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="nationality-create-page">

    <div class="nationality-topbar">
        <div class="nationality-breadcrumb">
            <a href="/Nationality/Index">Nationalities</a>
            <i class="bi bi-chevron-right"></i>
            <span>Create</span>
        </div>

        <div class="nationality-top-actions">
            <a href="/Nationality/Index" class="cancel-btn">
                <i class="bi bi-x"></i> Cancel
            </a>

            <button type="submit" form="nationalityForm" class="save-btn">
                <i class="bi bi-globe"></i> Save Nationality
            </button>
        </div>
    </div>

    <form id="nationalityForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="nationality-master-card">
            <div class="nationality-card-grid">

                <div class="form-field">
                    <label>Nationality Name *</label>
                    <input asp-for="NationalityName" class="form-input" placeholder="Enter nationality name" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Nationality Code *</label>
                    <input asp-for="NationalityCode" class="form-input" placeholder="IND" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Country Code</label>
                    <input asp-for="CountryCode" class="form-input" placeholder="+91 / IN" autocomplete="off" />
                </div>

            </div>
        </div>
    </form>
</div>