@model VeltriQ.Models.HR.EmployeeExit

@{
    ViewData["Title"] = "Create Employee Exit";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar {
        width: 4px !important;
        height: 4px !important;
    }

    *::-webkit-scrollbar-track {
        background: transparent !important;
    }

    *::-webkit-scrollbar-thumb {
        background: var(--border) !important;
        border-radius: 10px !important;
    }

        *::-webkit-scrollbar-thumb:hover {
            background: var(--purple) !important;
        }

    * {
        scrollbar-width: thin !important;
        scrollbar-color: var(--border) transparent !important;
    }

    .exit-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        padding-bottom: 30px;
    }

    /* TOPBAR */
    .exit-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
    }

    .exit-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

        .exit-breadcrumb a {
            color: var(--purple);
            text-decoration: none;
            font-weight: 600;
        }

        .exit-breadcrumb i {
            color: var(--text-muted);
            font-size: 10px;
        }

        .exit-breadcrumb span {
            color: var(--text-secondary);
            font-weight: 500;
        }

    .exit-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cancel-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .cancel-btn:hover {
            background: var(--purple);
            color: #fff;
            border-color: var(--purple);
        }

    .save-btn {
        height: 32px;
        padding: 0 16px;
        border: none;
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .save-btn:hover {
            opacity: 0.9;
        }

    /* SINGLE COMPACT CARD MODULE (3 Columns per row) */
    .exit-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
    }

    .exit-card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .col-span-2 {
        grid-column: span 2;
    }

    .col-span-3 {
        grid-column: span 3;
    }

    /* FIELD */
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .form-field label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

    /* INPUT */
    .form-input, .form-select {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease;
    }

        .form-input:focus, .form-select:focus {
            border-color: var(--purple);
        }

        .form-input::placeholder {
            color: var(--text-muted);
        }

    textarea.form-input {
        height: auto;
        min-height: 70px;
        padding-top: 8px;
        resize: vertical;
    }

    /* RESPONSIVE */
    @@media(max-width: 1024px) {
        .exit-card-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .col-span-2, .col-span-3 {
            grid-column: span 2;
        }
    }

    @@media(max-width: 640px) {
        .exit-card-grid {
            grid-template-columns: 1fr;
        }

        .col-span-2, .col-span-3 {
            grid-column: span 1;
        }

        .exit-topbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .exit-top-actions {
            width: 100%;
        }

        .cancel-btn,
        .save-btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="exit-create-page">

    <!-- TOPBAR -->
    <div class="exit-topbar">
        <div class="exit-breadcrumb">
            <a href="/EmployeeExit/Index">Employee Exits</a>
            <i class="bi bi-chevron-right"></i>
            <span>Create</span>
        </div>

        <div class="exit-top-actions">
            <a href="/EmployeeExit/Index" class="cancel-btn">
                <i class="bi bi-x"></i> Cancel
            </a>
            <button type="submit" form="exitForm" class="save-btn">
                <i class="bi bi-check2-circle"></i> Submit Exit
            </button>
        </div>
    </div>

    <!-- FORM -->
    <form id="exitForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <!-- SINGLE COMPACT CARD (3 Fields per row) -->
        <div class="exit-master-card">
            <div class="exit-card-grid">

                <!-- EMPLOYEE -->
                <div class="form-field">
                    <label>Employee *</label>
                    <select asp-for="EmployeeId" asp-items="ViewBag.EmployeeList" class="form-select" required>
                        <option value="">-- Select Employee --</option>
                    </select>
                </div>

                <!-- EXIT TYPE -->
                <div class="form-field">
                    <label>Exit Type *</label>
                    <select asp-for="ExitType" class="form-select" required>
                        <option value="">Select Exit Type</option>
                        <option value="Resignation">Resignation</option>
                        <option value="Termination">Termination</option>
                        <option value="Absconding">Absconding</option>
                        <option value="Retirement">Retirement</option>
                        <option value="Contract End">Contract End</option>
                    </select>
                </div>

                <!-- RESIGNATION DATE -->
                <div class="form-field">
                    <label>Resignation Date *</label>
                    <input asp-for="ResignationDate" type="date" class="form-input" required />
                </div>

                <!-- LAST WORKING DATE -->
                <div class="form-field">
                    <label>Last Working Date *</label>
                    <input asp-for="LastWorkingDate" type="date" class="form-input" required />
                </div>

                <!-- EXIT REASON -->
                <div class="form-field col-span-2">
                    <label>Exit Reason</label>
                    <textarea asp-for="ExitReason" rows="3" class="form-input" placeholder="Describe the reason for separation..."></textarea>
                </div>

                <!-- HR REMARKS -->
                <div class="form-field col-span-3">
                    <label>HR Remarks</label>
                    <textarea asp-for="HRRemarks" rows="3" class="form-input" placeholder="Enter any internal HR notes..."></textarea>
                </div>

            </div>
        </div>
    </form>
</div>