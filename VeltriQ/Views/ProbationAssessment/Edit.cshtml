@model VeltriQ.ViewModels.HR.ProbationAssessmentViewModel

@{
    ViewData["Title"] = "Edit Probation Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 80px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .form-card-top {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

        .form-card-top h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .form-scroll-body {
        overflow-y: auto;
        padding: 24px;
        flex: 1;
        scrollbar-width: none;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .form-scroll-body::-webkit-scrollbar {
            display: none;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group.wide {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
        }

    .custom-input, .custom-select, .custom-textarea {
        width: 100%;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
    }

    .custom-input, .custom-select {
        height: 36px;
    }

    .custom-textarea {
        resize: vertical;
        min-height: 80px;
        padding: 8px 12px;
    }

        .custom-input:focus, .custom-select:focus, .custom-textarea:focus {
            border-color: var(--purple);
        }

    .custom-input[readonly] {
        background: var(--hover-bg);
        opacity: 0.8;
        cursor: not-allowed;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .status-inprogress {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
    }

    .status-completed {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .form-footer {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

    .btn-cancel {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-save {
        height: 34px;
        padding: 0 18px;
        border-radius: 6px;
        border: none;
        background: var(--purple);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="form-page">
    <form id="editAssessmentForm" method="post" class="form-card" onsubmit="submitEditForm(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Master.AssessmentId" />
        <input type="hidden" asp-for="Master.EmployeeNo" />
        <input type="hidden" asp-for="Master.CompanyId" />

        <div class="form-card-top">
            <h3>Edit Probation Assessment — @Model.Master.EmployeeNo</h3>
            <span style="font-size: 11px; color: var(--text-secondary);">Manage evaluation checkpoints, timeline updates, and final confirmation.</span>
        </div>

        <div class="form-scroll-body">
            <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 12px; margin-bottom: 10px;"></div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Employee No</label>
                    <input type="text" value="@Model.Master.EmployeeNo" class="custom-input" readonly />
                </div>

                <div class="form-group">
                    <label>Overall Status</label>
                    <div style="padding-top: 6px;">
                        @{
                            var badgeClass = Model.Master.OverallStatus == "Completed" ? "status-completed" : (Model.Master.OverallStatus == "InProgress" ? "status-inprogress" : "status-pending");
                        }
                        <span class="badge-status @badgeClass">@Model.Master.OverallStatus</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Probation Start Date</label>
                    <input type="text" value="@(Model.Master.ProbationStartDate.HasValue? Model.Master.ProbationStartDate.Value.ToString("dd MMM yyyy") : "—")" class="custom-input" readonly />
                </div>

                <div class="form-group">
                    <label>Probation End Date</label>
                    <input type="date" name="Master.ProbationEndDate" value="@(Model.Master.ProbationEndDate.HasValue? Model.Master.ProbationEndDate.Value.ToString("yyyy-MM-dd") : "")" class="custom-input" />
                </div>

                <div class="form-group wide">
                    <label>Overall HR Remarks / Decision Summary</label>
                    <textarea name="Master.HRRemarks" class="custom-textarea">@Model.Master.HRRemarks</textarea>
                </div>
            </div>

            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); border-top: 1px solid var(--border); padding-top: 16px;">
                Evaluation Checkpoints
            </div>

            <div style="overflow-x: auto;">
                <table class="probation-table" style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Checkpoint Label</th>
                            <th>Scheduled Date</th>
                            <th style="text-align: center;">Score</th>
                            <th style="text-align: center;">Grade</th>
                            <th style="text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Checkpoints != null && Model.Checkpoints.Any())
                        {
                            @foreach (var cp in Model.Checkpoints)
                            {
                                var cpStatusClass = cp.Status == "Completed" ? "status-completed" : (cp.Status == "InProgress" ? "status-inprogress" : "status-pending");
                                <tr>
                                    <td style="font-weight: 700;">CP @cp.CheckpointNo</td>
                                    <td style="font-weight: 600;">@cp.CheckpointLabel</td>
                                    <td>@(cp.ScheduledDate.HasValue? cp.ScheduledDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                    <td style="text-align: center;">@(cp.OverallScore.HasValue? cp.OverallScore.Value.ToString("F0") + " / 100" : "—")</td>
                                    <td style="text-align: center; font-weight: 700;">@(cp.OverallGrade ?? "—")</td>
                                    <td style="text-align: center;">
                                        <span class="badge-status @cpStatusClass">@cp.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 20px;">
                                    No checkpoint records initialized.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save"><i class="bi bi-check2-circle"></i> Update Assessment</button>
        </div>
    </form>
</div>

<script>
    async function submitEditForm(e) {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);

        try {
            const res = await fetch(form.action || window.location.href, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (res.ok) {
                Swal.fire({ icon: 'success', title: 'Updated!', text: 'Probation assessment updated successfully.', timer: 1200, showConfirmButton: false });
                setTimeout(() => window.location.href = '/ProbationAssessment/Index', 1200);
            } else {
                Swal.fire({ icon: 'error', title: 'Validation Error', text: 'Please verify input parameters.', confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Edit submission error:', err);
            Swal.fire({ icon: 'error', title: 'Submission Failed', text: 'An unexpected network error occurred.', confirmButtonColor: '#7c3aed' });
        }
    }
</script>