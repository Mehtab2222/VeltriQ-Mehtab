@model IEnumerable<VeltriQ.ViewModels.JobProfileListItemViewModel>

@{
    ViewData["Title"] = "Job Profiles";
}

<style>
    .job-profile-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .job-profile-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    .job-profile-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .job-profile-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .job-profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .job-profile-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .job-profile-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .job-profile-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .job-profile-search-wrapper {
        position: relative;
        width: 320px;
    }

        .job-profile-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .job-profile-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .job-profile-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .job-profile-table {
        width: 100%;
        border-collapse: collapse;
    }

        .job-profile-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .job-profile-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .job-profile-table tbody tr {
            transition: background-color .1s ease;
        }

            .job-profile-table tbody tr:hover {
                background: var(--hover-bg);
            }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(148, 163, 184, .12);
        color: #94a3b8;
    }

    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="job-profile-page">

    <div class="job-profile-header">
        <a href="/Skill/Index" class="job-profile-add-btn" style="background: linear-gradient(135deg, #1e293b, #334155);">
            <i class="bi bi-tools"></i> Add Skills
        </a>
        <a href="/JobProfile/Create" class="job-profile-add-btn">
            <i class="bi bi-plus-lg"></i> Add Job Profile
        </a>
    </div>

    <div class="job-profile-card">

        <div class="job-profile-card-top">
            <div class="job-profile-card-title">
                <h3>Job Profile Directory</h3>
                <p>Total Records: <span id="profilesCounter">@Model.Count()</span></p>
            </div>

            <div class="job-profile-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="searchBox" placeholder="Search job profiles..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="job-profile-table" id="jobProfileTableMatrix">
                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Job Code</th>
                        <th>Skill Category</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="title" style="font-weight: 600;">
                                    @item.JobTitle
                                </td>
                                <td data-search="code">
                                    <span style="color: var(--text-secondary); font-size: 11.5px; font-weight: 500;">
                                        JP-@item.JobProfileId
                                    </span>
                                </td>
                                <td data-search="category">
                                    @item.CategoryName
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/JobProfile/Edit/@item.JobProfileId" class="action-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="action-btn delete-btn" title="Delete Entry" onclick="return confirm('Are you sure?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="5" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchBox");
        const matrixGrid = document.getElementById("jobProfileTableMatrix");
        const counterTracker = document.getElementById("profilesCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="5" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const titleText = row.querySelector('[data-search="title"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const categoryText = row.querySelector('[data-search="category"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${titleText} ${codeText} ${categoryText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>