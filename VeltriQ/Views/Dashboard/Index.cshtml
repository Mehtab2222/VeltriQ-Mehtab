    <!-- FLOATING THEME TOGGLE -->
    <div class="float-settings">
        <div class="appear-panel" id="appearPanel">
            <h6>Appearance</h6>
            <div class="theme-opt" id="optLight" onclick="setTheme('light')"><i class="bi bi-sun-fill"></i> Light Mode</div>
            <div class="theme-opt active" id="optDark" onclick="setTheme('dark')"><i class="bi bi-moon-fill"></i> Dark Mode</div>
            <div class="theme-opt" id="optSystem" onclick="setTheme('system')"><i class="bi bi-display"></i> System</div>
        </div>
        <button class="float-btn" onclick="togglePanel()"><i class="bi bi-moon-fill" id="floatIcon"></i></button>
    </div>

    <script>
        // DATE
        const mo=['January','February','March','April','May','June','July','August','September','October','November','December'];
        const nd=new Date();
        document.getElementById('todayDate').textContent=mo[nd.getMonth()]+' '+nd.getDate()+', '+nd.getFullYear();

        // THEME
        let curT=localStorage.getItem('vqT')||'dark';
        applyT(curT);
        function applyT(t){
          let r=t==='system'?(window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;
          document.documentElement.setAttribute('data-theme',r);
          document.getElementById('floatIcon').className=r==='dark'?'bi bi-moon-fill':'bi bi-sun-fill';
          document.querySelectorAll('.theme-opt').forEach(e=>e.classList.remove('active'));
          const m={light:'optLight',dark:'optDark',system:'optSystem'};
          document.getElementById(m[t])?.classList.add('active');
          rCharts();
        }
        function setTheme(t){curT=t;localStorage.setItem('vqT',t);applyT(t);}
        function togglePanel(){document.getElementById('appearPanel').classList.toggle('open');}
        document.addEventListener('click',e=>{if(!e.target.closest('.float-settings'))document.getElementById('appearPanel').classList.remove('open');});

        // CHARTS
        let eC,lC,dC,aC;
        function gc(){const dk=document.documentElement.getAttribute('data-theme')==='dark';return{g:dk?'rgba(255,255,255,0.05)':'rgba(0,0,0,0.06)',t:dk?'#4b5563':'#94a3b8'};}
        function buildC(){
          const c=gc();
          eC=new Chart(document.getElementById('empChart'),{type:'line',data:{labels:['May 1','May 5','May 10','May 15','May 20','May 25','May 30'],datasets:[{label:'Employees',data:[250,380,560,700,900,1100,1248],borderColor:'#7c3aed',backgroundColor:'rgba(124,58,237,.1)',tension:0.45,fill:true,pointRadius:4,pointBackgroundColor:'#7c3aed',pointBorderColor:'#fff',pointBorderWidth:2}]},options:{responsive:true,plugins:{legend:{display:false},tooltip:{callbacks:{label:x=>' '+x.parsed.y.toLocaleString()+' Employees'}}},scales:{x:{grid:{color:c.g},ticks:{color:c.t,font:{size:11}}},y:{grid:{color:c.g},ticks:{color:c.t,font:{size:11}}}}}});
          lC=new Chart(document.getElementById('leaveChart'),{type:'doughnut',data:{labels:['Annual','Sick','Casual','Other'],datasets:[{data:[512,210,180,346],backgroundColor:['#7c3aed','#3b82f6','#22c55e','#f97316'],borderWidth:0,hoverOffset:5}]},options:{cutout:'68%',responsive:false,plugins:{legend:{display:false}}}});
          dC=new Chart(document.getElementById('deptChart'),{type:'doughnut',data:{labels:['Engineering','HR','Sales','Finance','Others'],datasets:[{data:[462,196,312,146,132],backgroundColor:['#7c3aed','#3b82f6','#22c55e','#f97316','#94a3b8'],borderWidth:0,hoverOffset:5}]},options:{cutout:'68%',responsive:false,plugins:{legend:{display:false}}}});
          aC=new Chart(document.getElementById('attendChart'),{type:'bar',data:{labels:['Mon','Tue','Wed','Thu','Fri','Sat'],datasets:[{label:'Present',data:[1100,1180,1050,1200,1140,420],backgroundColor:'#7c3aed',borderRadius:7,borderSkipped:false},{label:'Absent',data:[148,68,198,48,108,28],backgroundColor:'rgba(239,68,68,.6)',borderRadius:7,borderSkipped:false}]},options:{responsive:true,plugins:{legend:{position:'top',labels:{color:c.t,font:{size:11},usePointStyle:true,pointStyle:'circle'}}},scales:{x:{grid:{display:false},ticks:{color:c.t}},y:{grid:{color:c.g},ticks:{color:c.t}}}}});
        }
        function rCharts(){
          if(!eC)return;
          const c=gc();
          [eC,aC].forEach(ch=>{
            ch.options.scales.x.grid.color=c.g;ch.options.scales.x.ticks.color=c.t;
            ch.options.scales.y.grid.color=c.g;ch.options.scales.y.ticks.color=c.t;
            if(ch.options.plugins?.legend?.labels)ch.options.plugins.legend.labels.color=c.t;
            ch.update();
          });
        }
        window.addEventListener('load',buildC);
    </script>
</body>
