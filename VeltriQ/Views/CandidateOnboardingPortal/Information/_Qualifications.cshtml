@model VeltriQ.ViewModels.CandidateOnboardingPortal.CandidateOnboardingQualificationsViewModel

<style>
    /* ── HIGH-DENSITY THEMED CARD CONSOLES ── */
    .vq-form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px; /* Fully squared sharp border guidelines */
        margin-bottom: 16px;
        position: relative;
    }

    .vq-form-card-header {
        background: var(--hover-bg);
        border-bottom: 1px solid var(--border);
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .vq-form-card-header h5 {
            margin: 0;
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .vq-form-card-header h5 i {
                font-size: 13px;
                color: var(--purple);
            }

    .vq-form-card-body {
        padding: 0; /* High-density grid overlay alignment */
    }

    /* ── PREMIUM SYSTEM DATA TABLES ── */
    .vq-dense-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
        font-size: 12.5px;
    }

        .vq-dense-table th {
            background: var(--hover-bg);
            color: var(--text-secondary);
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        .vq-dense-table td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
        }

        .vq-dense-table tr:last-child td {
            border-bottom: none;
        }

    /* ── COMPACT REFINED FORM CONTROL INPUTS ── */
    .vq-field-wrap {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .vq-field-wrap label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
        }

    .vq-input-ctrl {
        width: 100%;
        height: 34px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
        font-family: inherit;
        transition: border-color 0.15s ease;
    }

        .vq-input-ctrl:focus {
            border-color: var(--purple);
        }

    /* ── TOGGLEABLE INLINE FORM BOX ── */
    .vq-inline-drawer {
        background: var(--card-bg);
        border-bottom: 1px solid var(--border);
        padding: 16px;
        display: none; /* Controlled via internal JS runtime toggle */
    }

    .vq-drawer-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--purple);
        text-transform: uppercase;
        margin-bottom: 12px;
        letter-spacing: 0.5px;
    }

    /* ── SYSTEM HIGH DENSITY BUTTONS ── */
    .form-action-btn {
        height: 30px;
        padding: 0 14px;
        border-radius: 4px;
        border: none;
        font-size: 11px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
        cursor: pointer;
    }

    .btn-submit-theme {
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
    }

        .btn-submit-theme:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-secondary-theme {
        background: var(--hover-bg);
        border: 1px solid var(--border);
        color: var(--text-primary);
    }

        .btn-secondary-theme:hover {
            background: var(--border);
        }

    .btn-row-action {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 2px 6px;
        font-size: 14px;
        transition: color 0.1s ease;
    }

    .btn-row-edit {
        color: var(--text-secondary);
    }

        .btn-row-edit:hover {
            color: var(--purple);
        }

    .btn-row-delete {
        color: #ef4444;
        opacity: 0.7;
    }

        .btn-row-delete:hover {
            opacity: 1;
        }
</style>

<div class="vq-form-card">
    <div class="vq-form-card-header">
        <h5><i class="bi bi-mortarboard"></i> Educational Qualifications</h5>
        <button type="button" class="form-action-btn btn-submit-theme" id="btnToggleQualificationForm">
            <i class="bi bi-plus-lg"></i> Add Qualification
        </button>
    </div>

    <div class="vq-inline-drawer" id="qualificationFormDrawer">
        <div class="vq-drawer-title" id="qualDrawerTitle">Add New Qualification</div>
        <form id="qualificationForm" asp-action="SaveQualification" asp-controller="CandidateOnboardingPortal" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input asp-for="EmployeeOnboardingId" type="hidden" />

            <input type="hidden" name="Qualifications[0].EmployeeOnboardingQualificationId" id="txtQualificationId" value="0" />

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="vq-field-wrap">
                        <label>Qualification / Degree</label>
                        <input name="Qualifications[0].QualificationName" id="txtQualName" required class="vq-input-ctrl" placeholder="e.g. B.Tech CSE, Class 12" />
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="vq-field-wrap">
                        <label>Institute / School / University</label>
                        <input name="Qualifications[0].Institute" id="txtInstitute" required class="vq-input-ctrl" placeholder="Enter institution name" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="vq-field-wrap">
                        <label>Passing Year</label>
                        <input name="Qualifications[0].PassingYear" id="txtPassingYear" type="number" min="1950" max="2035" required class="vq-input-ctrl" placeholder="YYYY" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="vq-field-wrap">
                        <label>Percentage / CGPA</label>
                        <input name="Qualifications[0].Percentage" id="txtPercentage" type="number" step="0.01" min="0" max="100" required class="vq-input-ctrl" placeholder="00.00" />
                    </div>
                </div>
            </div>

            <div class="text-end mt-3 d-flex justify-content-end gap-2">
                <button type="button" class="form-action-btn btn-secondary-theme" id="btnCancelQualification">Cancel</button>
                <button type="submit" class="form-action-btn btn-submit-theme" id="btnSaveQualification">
                    <i class="bi bi-check-lg"></i> Save Qualification
                </button>
            </div>
        </form>
    </div>

    <div class="vq-form-card-body">
        <table class="vq-dense-table">
            <thead>
                <tr>
                    <th style="width: 25%;">Qualification</th>
                    <th style="width: 40%;">Institute</th>
                    <th style="width: 13%;">Year</th>
                    <th style="width: 12%;">Percentage</th>
                    <th style="width: 10%; text-align: center;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Qualifications != null && Model.Qualifications.Any())
                {
                    foreach (var item in Model.Qualifications)
                    {
                        <tr id="row_qual_@item.EmployeeOnboardingQualificationId"
                            data-id="@item.EmployeeOnboardingQualificationId"
                            data-name="@item.QualificationName"
                            data-institute="@item.Institute"
                            data-year="@item.PassingYear"
                            data-percent="@(item.Percentage?.ToString("F2"))">
                            <td><strong>@item.QualificationName</strong></td>
                            <td>@item.Institute</td>
                            <td>@(item.PassingYear?.ToString() ?? "—")</td>
                            <td>@(item.Percentage != null ? $"{item.Percentage:F2}%" : "—")</td>
                            <td style="text-align: center;">
                                <div class="d-flex justify-content-center gap-1">
                                    <button type="button" class="btn-row-action btn-row-edit action-edit-qual" title="Edit Qualification">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button" class="btn-row-action btn-row-delete action-delete-qual" title="Delete Qualification">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="bi bi-folder-x d-block mb-1" style="font-size: 18px; color: var(--text-muted);"></i>
                            No qualifications added.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        const toggleBtn = document.getElementById('btnToggleQualificationForm');
        const cancelBtn = document.getElementById('btnCancelQualification');
        const drawer = document.getElementById('qualificationFormDrawer');
        const qualForm = document.getElementById('qualificationForm');
        const titleEl = document.getElementById('qualDrawerTitle');
        const submitBtn = document.getElementById('btnSaveQualification');

        // Field value binding selectors
        const txtId = document.getElementById('txtQualificationId');
        const txtName = document.getElementById('txtQualName');
        const txtInst = document.getElementById('txtInstitute');
        const txtYear = document.getElementById('txtPassingYear');
        const txtPerc = document.getElementById('txtPercentage');

        function openDrawer(mode = "add") {
            if (mode === "add") {
                titleEl.textContent = "Add New Qualification";
                txtId.value = "0"; // Improvement 2: Clear hidden input mapping context
                submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> Save Qualification'; // Reset text state
                if(qualForm) qualForm.reset();
            } else {
                titleEl.textContent = "Modify Qualification Record";
                // Improvement 1: Dynamic structural update text context assignation
                submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> Update Qualification';
            }
            drawer.style.display = 'block';
        }

        if (toggleBtn && drawer) {
            toggleBtn.addEventListener('click', () => openDrawer("add"));
        }

        if (cancelBtn && drawer) {
            cancelBtn.addEventListener('click', () => {
                drawer.style.display = 'none';
                txtId.value = "0"; // Improvement 2: Clean tracking ID completely on execution drop
                submitBtn.innerHTML = '<i class="bi bi-check-lg"></i> Save Qualification'; // Restore text context
                if(qualForm) qualForm.reset();
            });
        }

        // Parse row metrics data maps right into input controllers
        document.querySelectorAll('.action-edit-qual').forEach(btn => {
            btn.addEventListener('click', function() {
                const tr = this.closest('tr');
                txtId.value = tr.dataset.id;
                txtName.value = tr.dataset.name;
                txtInst.value = tr.dataset.institute;
                txtYear.value = tr.dataset.year;
                txtPerc.value = tr.dataset.percent;

                openDrawer("edit");
                drawer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });

        // Dynamic multi-tier fallback checking layer processing AJAX requests safely
        document.querySelectorAll('.action-delete-qual').forEach(btn => {
            btn.addEventListener('click', function() {
                const tr = this.closest('tr');
                const id = tr.dataset.id;
                const name = tr.dataset.name;

                if (confirm(`Are you sure you want to permanently delete your qualification record for: ${name}?`)) {
                    fetch(`/CandidateOnboardingPortal/DeleteQualification?id=${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if(data.success) {
                            // Improvement 3: Handle structural message fallback definitions cleanly
                            alert(data.message || "Qualification deleted successfully.");
                            if (typeof refreshCandidateWorkspace === "function") refreshCandidateWorkspace();
                            else window.location.reload();
                        } else {
                            alert(data.message || "Unable to complete action validation parameters.");
                        }
                    }).catch(err => console.error(err));
                }
            });
        });

        if (qualForm) {
            qualForm.addEventListener('submit', function (e) {
                e.preventDefault();

                // Preserve programmatic spinner processing text configurations elegantly
                const activeText = txtId.value === "0" ? "Saving..." : "Updating...";
                submitBtn.disabled = true;
                submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" style="width: 11px; height: 11px; border-width: 1.5px;"></span> ${activeText}`;

                const formData = new FormData(qualForm);

                fetch($(this).attr('action'), {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        if (typeof refreshCandidateWorkspace === "function") refreshCandidateWorkspace();
                        else window.location.reload();
                    } else {
                        alert(data.message || 'Validation operational exception encountered.');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = txtId.value === "0" ?
                            '<i class="bi bi-check-lg"></i> Save Qualification' :
                            '<i class="bi bi-check-lg"></i> Update Qualification';
                    }
                })
                .catch(err => {
                    console.error(err);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = txtId.value === "0" ?
                        '<i class="bi bi-check-lg"></i> Save Qualification' :
                        '<i class="bi bi-check-lg"></i> Update Qualification';
                });
            });
        }
    })();
</script>