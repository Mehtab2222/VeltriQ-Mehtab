@model VeltriQ.ViewModels.OnboardingTemplateViewModel

@{
    ViewData["Title"] = "Create Onboarding Template";

    // Server-side filtering to remove the generic "Employee Onboarding" duplicate row if it exists
    var cleanSuggestions = Model.TemplateSuggestions?
        .Where(s => !string.Equals(s, "Employee Onboarding", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<string>();
}

<style>
    .template-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── ALERT SYSTEM ── */
    .alert-container {
        margin-bottom: 12px;
    }

    .custom-alert {
        padding: 8px 12px;
        font-size: 12px;
        border-radius: 4px;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .custom-alert-success {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .custom-alert-danger {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .validation-summary-box {
        font-size: 12px;
        color: #ef4444;
        margin-bottom: 12px;
        font-weight: 500;
    }

    /* ── HEADER ACTION STRUCTURING ── */
    .form-action-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT SYSTEM BUTTONS ── */
    .form-action-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
        cursor: pointer;
    }

    .btn-submit-theme {
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
    }

        .btn-submit-theme:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-cancel-theme {
        background: var(--hover-bg);
        color: var(--text-primary);
        border: 1px solid var(--border);
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }

    .form-footer-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
    }

    /* ── INLINE INJECTED FORM CARD STYLES ── */
    .custom-form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
    }

    .custom-form-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
    }

        .custom-form-header h5 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

    .custom-form-body {
        padding: 16px;
        background: var(--card-bg);
    }

    .form-grid-row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -8px;
        margin-left: -8px;
    }

    .form-grid-col-3 {
        flex: 0 0 25%;
        max-width: 25%;
        padding: 0 8px;
    }

    .form-grid-col-4 {
        flex: 0 0 33.3333%;
        max-width: 33.3333%;
        padding: 0 8px;
    }

    .form-grid-col-6 {
        flex: 0 0 50%;
        max-width: 50%;
        padding: 0 8px;
    }

    .form-field-group {
        margin-bottom: 12px;
        position: relative; /* Imperative for custom dropdown attachment alignment */
    }

    .custom-form-label {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .custom-form-control {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12.5px;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--purple);
        }

    select.custom-form-control {
        padding-right: 24px;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%239ca3af' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 12px 12px;
    }

    /* ── 🌟 NEW BRAND-ALIGNED DROPDOWN PANEL 🌟 ── */
    .suggest-input-wrapper {
        position: relative;
        width: 100%;
    }

    .suggest-dropdown-panel {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        width: 100%;
        max-height: 200px; /* Short, elegant height limit instead of a massive menu */
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        z-index: 1000;
        overflow-y: auto;
        display: none; /* Controlled by JS text listeners */
        /* Hidden scrollbars */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .suggest-dropdown-panel::-webkit-scrollbar {
            display: none;
        }

    .suggest-item {
        padding: 8px 12px;
        font-size: 12.5px;
        color: var(--text-primary);
        cursor: pointer;
        transition: background-color 0.1s ease;
        border-bottom: 1px solid rgba(255, 255, 255, 0.02);
    }

        .suggest-item:last-child {
            border-bottom: none;
        }

        .suggest-item:hover {
            background: var(--hover-bg);
            color: var(--sidebar-text-hover);
        }

        .suggest-item.no-results {
            color: var(--text-muted);
            font-style: italic;
            cursor: default;
            background: transparent !important;
        }

    /* ── CHECKBOX SYSTEM ── */
    .custom-check-group {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding-top: 6px;
    }

    .custom-check-input {
        width: 14px;
        height: 14px;
        accent-color: var(--purple);
        cursor: pointer;
    }

    .custom-check-label {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-primary);
        cursor: pointer;
        user-select: none;
    }

    .custom-text-muted {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 4px;
        display: block;
        line-height: 1.3;
    }

    .validation-err-text {
        font-size: 11px;
        color: #ef4444;
        font-weight: 500;
        margin-top: 2px;
        display: block;
    }

    @@media (max-width: 768px) {
        .form-grid-col-3, .form-grid-col-4, .form-grid-col-6

    {
        flex: 0 0 100%;
        max-width: 100%;
    }

    }
</style>

<div class="template-create-page">

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="alert-container">
            @if (TempData["Success"] != null)
            {
                <div class="custom-alert custom-alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="custom-alert custom-alert-danger">@TempData["Error"]</div>
            }
        </div>
    }

    <div class="form-action-header">
        <a asp-action="Index" class="form-action-btn btn-cancel-theme">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <form asp-action="Create" method="post" id="createTemplateForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="validation-summary-box"></div>

        <div class="custom-form-card">
            <div class="custom-form-header">
                <h5>General Information</h5>
            </div>

            <div class="custom-form-body">
                <div class="form-grid-row">

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="TemplateName" class="custom-form-label"></label>
                        <div class="suggest-input-wrapper">
                            <input asp-for="TemplateName"
                                   id="templateNameInput"
                                   class="custom-form-control"
                                   placeholder="Select or type a template name..."
                                   autocomplete="off" />

                            <div class="suggest-dropdown-panel" id="suggestionsPanel">
                                @foreach (var suggestion in cleanSuggestions)
                                {
                                    <div class="suggest-item" onclick="selectSuggestion('@suggestion')">@suggestion</div>
                                }
                            </div>
                        </div>

                        <span asp-validation-for="TemplateName" class="validation-err-text"></span>
                        <small class="custom-text-muted">
                            You can type a custom name or filter down our refined structural presets.
                        </small>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="EmploymentTypeMasterId" class="custom-form-label"></label>
                        <select asp-for="EmploymentTypeMasterId" asp-items="Model.EmploymentTypes" class="custom-form-control">
                            <option value="">-- Select Employment Type --</option>
                        </select>
                        <span asp-validation-for="EmploymentTypeMasterId" class="validation-err-text"></span>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="DepartmentId" class="custom-form-label"></label>
                        <select asp-for="DepartmentId" asp-items="Model.Departments" class="custom-form-control">
                            <option value="">-- Select Department --</option>
                        </select>
                    </div>

                    <div class="form-grid-col-6 form-field-group">
                        <label asp-for="DesignationId" class="custom-form-label"></label>
                        <select asp-for="DesignationId" asp-items="Model.Designations" class="custom-form-control">
                            <option value="">-- Select Designation --</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid-row">
                    <div class="form-grid-col-4 form-field-group">
                        <label asp-for="TemplateVersion" class="custom-form-label"></label>
                        <input asp-for="TemplateVersion" class="custom-form-control" />
                    </div>
                </div>

                <div class="form-grid-row" style="margin-top: 8px;">
                    <div class="form-grid-col-3 form-field-group">
                        <div class="custom-check-group">
                            <input asp-for="IsDefault" class="custom-check-input" />
                            <label asp-for="IsDefault" class="custom-check-label"></label>
                        </div>
                    </div>

                    <div class="form-grid-col-3 form-field-group">
                        <div class="custom-check-group">
                            <input asp-for="IsActive" class="custom-check-input" />
                            <label asp-for="IsActive" class="custom-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-footer-actions">
            <button type="submit" class="form-action-btn btn-submit-theme">
                <i class="bi bi-check-circle"></i>
                Save Template
            </button>

            <a asp-action="Index" class="form-action-btn btn-cancel-theme">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const nameInput = document.getElementById('templateNameInput');
        const panel = document.getElementById('suggestionsPanel');
        const items = panel.getElementsByClassName('suggest-item');

        // Display panel on focus
        nameInput.addEventListener('focus', () => {
            filterSuggestions();
            panel.style.display = 'block';
        });

        // Track live user input filters
        nameInput.addEventListener('input', filterSuggestions);

        // Hide list panel context when user clicks outside target elements
        document.addEventListener('click', (e) => {
            if (!nameInput.contains(e.target) && !panel.contains(e.target)) {
                panel.style.display = 'none';
            }
        });

        function filterSuggestions() {
            const val = nameInput.value.toLowerCase();
            let visibleCount = 0;

            // Remove any old "No results" messages before tracking loops
            const emptyMsg = panel.querySelector('.no-results');
            if (emptyMsg) emptyMsg.remove();

            for (let i = 0; i < items.length; i++) {
                const text = items[i].textContent.toLowerCase();
                if (text.includes(val)) {
                    items[i].style.display = 'block';
                    visibleCount++;
                } else {
                    items[i].style.display = 'none';
                }
            }

            // Fallback UI layout when filter terms match nothing inside the collections
            if (visibleCount === 0) {
                const div = document.createElement('div');
                div.className = 'suggest-item no-results';
                div.textContent = 'No matching suggestions...';
                panel.appendChild(div);
            }
        }

        function selectSuggestion(value) {
            nameInput.value = value;
            panel.style.display = 'none';

            // Forces jQuery validation triggers to evaluate input fields upon parameter selection
            if(window.jQuery) {
                $("#createTemplateForm").validate().element("#templateNameInput");
            }
        }
    </script>
}