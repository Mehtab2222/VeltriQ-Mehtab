@model VeltriQ.ViewModels.HR.ProbationAssessmentViewModel

@{
    ViewData["Title"] = "Create Probation Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var employeeName = Model.Master.EmployeeName ?? "Employee";
    var employeeParts = employeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(employeeParts.Take(2).Select(x => x.FirstOrDefault()));

    var today = DateTime.Today;
    var checkpoint1 = Model.Checkpoints.ElementAtOrDefault(0);
    var checkpoint2 = Model.Checkpoints.ElementAtOrDefault(1);
    var checkpoint3 = Model.Checkpoints.ElementAtOrDefault(2);

    var completed1 = checkpoint1 != null && string.Equals(checkpoint1.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var completed2 = checkpoint2 != null && string.Equals(checkpoint2.Status, "Completed", StringComparison.OrdinalIgnoreCase);

    bool IsCheckpointAvailable(VeltriQ.Models.HR.ProbationAssessment.ProbationAssessmentDetailsModel? checkpoint, int number)
    {
        if (checkpoint == null) return false;
        if (string.Equals(checkpoint.Status, "Completed", StringComparison.OrdinalIgnoreCase)) return true;
        var dateReached = !checkpoint.ScheduledDate.HasValue || checkpoint.ScheduledDate.Value.Date <= today;
        if (!dateReached) return false;
        if (number == 1) return true;
        if (number == 2) return completed1;
        if (number == 3) return completed2;
        return false;
    }

    bool IsCheckpointLocked(VeltriQ.Models.HR.ProbationAssessment.ProbationAssessmentDetailsModel? checkpoint, int number)
    {
        if (checkpoint == null) return true;
        return !IsCheckpointAvailable(checkpoint, number);
    }

    var cp1Available = IsCheckpointAvailable(checkpoint1, 1);
    var cp2Available = IsCheckpointAvailable(checkpoint2, 2);
    var cp3Available = IsCheckpointAvailable(checkpoint3, 3);

    var activeCheckpoint = Model.ActiveCheckpoint ?? (cp1Available ? checkpoint1 : cp2Available ? checkpoint2 : cp3Available ? checkpoint3 : checkpoint1);
    var activeIndex = activeCheckpoint == null ? 0 : Model.Checkpoints.IndexOf(activeCheckpoint);
    var activeRatings = Model.ActiveRatings ?? new List<VeltriQ.Models.HR.ProbationAssessment.ProbationAssessmentRatingsModel>();

    string RatingFor(int criteriaId)
    {
        return activeRatings.FirstOrDefault(x => x.CriteriaId == criteriaId)?.Rating ?? "";
    }
}

<style>
    .probation-page {
        padding: 0px 20px 30px;
        color: var(--text-primary);
        max-width: 1450px;
        margin: 0 auto;
    }

    /* COMPACT HEADER BAR */
    .probation-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .probation-title h1 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .probation-title p {
        margin: 2px 0 0;
        color: var(--text-secondary);
        font-size: 11.5px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px solid var(--border);
        border-radius: 4px;
        color: var(--text-primary);
        text-decoration: none;
        background: var(--card-bg);
        font-size: 12px;
        font-weight: 600;
        transition: 0.15s;
    }

        .back-btn:hover {
            border-color: var(--purple);
            color: var(--purple);
        }

    /* SINGLE UNIFIED CONTAINER */
    .main-workspace {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    /* EMPLOYEE MINI STRIP */
    .employee-strip {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--hover-bg);
        gap: 15px;
        flex-wrap: wrap;
    }

    .employee-mini-main {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .employee-avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--purple);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
    }

    .employee-name-sm {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .employee-code-sm {
        font-size: 11px;
        color: var(--text-secondary);
        font-family: monospace;
    }

    .strip-meta {
        display: flex;
        gap: 24px;
        font-size: 12px;
    }

    .strip-meta-item label {
        display: block;
        font-size: 9.5px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .strip-meta-item span {
        font-weight: 600;
        color: var(--text-primary);
    }

    /* UNIFORM TABS ROW - ALL CARDS SHARE IDENTICAL NORMAL COLOR */
    .checkpoint-tabs-clean {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
    }

    .cp-tab-btn {
        padding: 10px 16px;
        border: none;
        border-right: 1px solid var(--border);
        background: var(--card-bg);
        opacity: 1 !important;
        text-align: left;
        cursor: pointer;
        transition: 0.15s;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .cp-tab-btn:last-child {
            border-right: none;
        }

        .cp-tab-btn:hover {
            background: var(--hover-bg);
        }

        .cp-tab-btn.active {
            background: var(--card-bg);
            border-bottom: 2px solid var(--purple);
        }

    .cp-tab-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
    }

    .cp-tab-title {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text-primary);
    }

    /* WORKSPACE CONTENT BODY */
    .workspace-body {
        padding: 20px;
    }

    .checkpoint-heading-clean {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }

        .checkpoint-heading-clean h3 {
            margin: 0;
            font-size: 14.5px;
            font-weight: 750;
            color: var(--text-primary);
        }

    .date-badge-clean {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    /* CRITERIA TABLE-LIKE ROWS */
    .criteria-category-clean {
        margin-bottom: 18px;
    }

    .category-title-clean {
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--purple);
        margin-bottom: 8px;
        padding-bottom: 4px;
        border-bottom: 1px dashed var(--border);
    }

    .criteria-line {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 20px;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

        .criteria-line:last-child {
            border-bottom: none;
        }

    .c-name {
        font-size: 12.5px;
        font-weight: 650;
        color: var(--text-primary);
    }

    .c-desc {
        font-size: 11px;
        color: var(--text-secondary);
        margin-top: 1px;
    }

    /* ROUND RATING BUTTONS - SIMPLE WHITE OUTLINE WITH NO SHADOW */
    .rating-set {
        display: flex;
        gap: 6px;
    }

    .r-opt input {
        display: none;
    }

    .r-opt label {
        width: 32px;
        height: 32px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        background: var(--input-bg);
        color: var(--text-primary);
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 50%;
        transition: 0.1s;
    }

        .r-opt label:hover {
            border-color: #fff;
            background: var(--hover-bg);
        }

    .r-opt input:checked + label {
        background: var(--purple);
        border-color: var(--purple);
        color: #fff;
        box-shadow: none;
    }

    .r-opt input:disabled + label {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* COMPACT COMMENTS GRID */
    .comments-grid-clean {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 20px;
    }

    .f-group label {
        display: block;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .f-group textarea {
        width: 100%;
        height: 75px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 8px;
        font-size: 12px;
        font-family: inherit;
        resize: vertical;
        outline: none;
        border-radius: 2px;
    }

        .f-group textarea:focus {
            border-color: var(--purple);
        }

    /* FOOTER */
    .workspace-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
    }

    .btn-submit-clean {
        height: 32px;
        padding: 0 16px;
        border: none;
        background: var(--purple);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-submit-clean:hover {
            opacity: 0.9;
        }

    .locked-box {
        padding: 30px;
        text-align: center;
        color: var(--text-secondary);
        font-size: 12.5px;
    }

    .validation-err {
        margin-bottom: 12px;
        padding: 8px 12px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid #ef4444;
        color: #ef4444;
        font-size: 11.5px;
    }
</style>

<div class="probation-page">
    <div class="probation-header">
        <div class="probation-title">
            <h1>Create Probation Assessment</h1>
            <p>Evaluate and record employee performance metrics across designated milestones.</p>
        </div>
        <a asp-action="Index" class="back-btn"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-err"><div asp-validation-summary="All"></div></div>
    }

    <div class="main-workspace">
        <div class="employee-strip">
            <div class="employee-mini-main">
                <div class="employee-avatar-sm">@initials</div>
                <div>
                    <div class="employee-name-sm">@Model.Master.EmployeeName</div>
                    <div class="employee-code-sm">@Model.Master.EmployeeNo</div>
                </div>
            </div>
            <div class="strip-meta">
                <div class="strip-meta-item">
                    <label>Department</label>
                    <span>@(string.IsNullOrEmpty(Model.Master.Department) ? "—" : Model.Master.Department)</span>
                </div>
                <div class="strip-meta-item">
                    <label>Designation</label>
                    <span>@(string.IsNullOrEmpty(Model.Master.Designation) ? "—" : Model.Master.Designation)</span>
                </div>
                <div class="strip-meta-item">
                    <label>Probation Window</label>
                    <span>@(Model.Master.ProbationStartDate?.ToString("dd MMM yyyy") ?? "—") → @(Model.Master.ProbationEndDate?.ToString("dd MMM yyyy") ?? "—")</span>
                </div>
            </div>
        </div>

        <div class="checkpoint-tabs-clean">
            @if (checkpoint1 != null)
            {
                var isLocked1 = IsCheckpointLocked(checkpoint1, 1);
                <button type="button" class="cp-tab-btn @(activeIndex == 0 ? "active" : "")" onclick="@(isLocked1 ? "alert('This checkpoint is currently locked.');" : "location.href='?assessmentId=" + Model.Master.AssessmentId + "&checkpoint=" + checkpoint1.CheckpointNo + "';")">
                    <div class="cp-tab-top">
                        <span>CP 01</span>
                        <span>@(completed1 ? "Completed" : cp1Available ? "Available" : "Locked")</span>
                    </div>
                    <div class="cp-tab-title">@checkpoint1.CheckpointLabel</div>
                </button>
            }
            @if (checkpoint2 != null)
            {
                var isLocked2 = IsCheckpointLocked(checkpoint2, 2);
                <button type="button" class="cp-tab-btn @(activeIndex == 1 ? "active" : "")" onclick="@(isLocked2 ? "alert('This checkpoint is locked until prior milestones complete.');" : "")">
                    <div class="cp-tab-top">
                        <span>CP 02</span>
                        <span>@(completed2 ? "Completed" : cp2Available ? "Available" : "Locked")</span>
                    </div>
                    <div class="cp-tab-title">@checkpoint2.CheckpointLabel</div>
                </button>
            }
            @if (checkpoint3 != null)
            {
                var isLocked3 = IsCheckpointLocked(checkpoint3, 3);
                var cp3Completed = string.Equals(checkpoint3.Status, "Completed", StringComparison.OrdinalIgnoreCase);
                <button type="button" class="cp-tab-btn @(activeIndex == 2 ? "active" : "")" onclick="@(isLocked3 ? "alert('This checkpoint is locked until prior milestones complete.');" : "")">
                    <div class="cp-tab-top">
                        <span>CP 03</span>
                        <span>@(cp3Completed ? "Completed" : cp3Available ? "Available" : "Locked")</span>
                    </div>
                    <div class="cp-tab-title">@checkpoint3.CheckpointLabel</div>
                </button>
            }
        </div>

        <div class="workspace-body">
            @if (activeCheckpoint == null)
            {
                <div class="locked-box"><i class="bi bi-lock" style="font-size: 20px; display: block; margin-bottom: 6px;"></i>No active evaluation milestones accessible.</div>
            }
            else
            {
                var activeNumber = activeCheckpoint.CheckpointNo;
                var activeAvailable = IsCheckpointAvailable(activeCheckpoint, activeNumber);
                var activeCompleted = string.Equals(activeCheckpoint.Status, "Completed", StringComparison.OrdinalIgnoreCase);

                <div class="checkpoint-heading-clean">
                    <h3>@activeCheckpoint.CheckpointLabel</h3>
                    <div class="date-badge-clean"><i class="bi bi-calendar-event"></i> Target Date: @(activeCheckpoint.ScheduledDate?.ToString("dd MMM yyyy") ?? "—")</div>
                </div>

                @if (!activeAvailable && !activeCompleted)
                {
                    <div class="locked-box"><i class="bi bi-lock-fill" style="font-size: 20px; display: block; margin-bottom: 6px;"></i>This checkpoint is locked until prior milestones complete.</div>
                }
                else
                {
                    <form asp-action="SubmitCheckpoint" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AssessmentId" value="@Model.Master.AssessmentId" />
                        <input type="hidden" name="DetailId" value="@activeCheckpoint.DetailId" />
                        <input type="hidden" name="CheckpointNo" value="@activeCheckpoint.CheckpointNo" />

                        @foreach (var category in Model.AllCriteria.GroupBy(x => x.Category).OrderBy(x => x.Min(y => y.DisplayOrder)))
                        {
                            <div class="criteria-category-clean">
                                <div class="category-title-clean">@category.Key</div>
                                @foreach (var criterion in category.OrderBy(x => x.DisplayOrder))
                                {
                                    var currentRating = RatingFor(criterion.CriteriaId);
                                    <div class="criteria-line">
                                        <div>
                                            <div class="c-name">@criterion.CriteriaName</div>
                                            @if (!string.IsNullOrWhiteSpace(criterion.CriteriaDescription))
                                            {
                                                <div class="c-desc">@criterion.CriteriaDescription</div>
                                            }
                                        </div>
                                        <div class="rating-set">
                                            @foreach (var rating in new[] { "A+", "A", "B+", "B", "C" })
                                            {
                                                var inputId = $"rating_{activeCheckpoint.DetailId}_{criterion.CriteriaId}_{rating.Replace("+", "plus")}";
                                                <div class="r-opt">
                                                    <input type="radio" id="@inputId" name="Ratings[@criterion.CriteriaId]" value="@rating" @(currentRating == rating ? "checked" : "") @(activeCompleted ? "disabled" : "") />
                                                    <label for="@inputId">@rating</label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="comments-grid-clean">
                            <div class="f-group">
                                <label for="Strengths">Strengths</label>
                                <textarea id="Strengths" name="Strengths" placeholder="Strengths..." @(activeCompleted ? "readonly" : "")>@activeCheckpoint.Strengths</textarea>
                            </div>
                            <div class="f-group">
                                <label for="DevelopmentAreas">Development Areas</label>
                                <textarea id="DevelopmentAreas" name="DevelopmentAreas" placeholder="Improvement areas..." @(activeCompleted ? "readonly" : "")>@activeCheckpoint.DevelopmentAreas</textarea>
                            </div>
                            <div class="f-group">
                                <label for="Progress">Progress Notes</label>
                                <textarea id="Progress" name="Progress" placeholder="Progress remarks..." @(activeCompleted ? "readonly" : "")>@activeCheckpoint.Progress</textarea>
                            </div>
                        </div>

                        <div class="workspace-footer">
                            <a asp-action="Index" class="back-btn" style="padding: 6px 14px;">Cancel</a>
                            @if (!activeCompleted)
                            {
                                <button type="submit" class="btn-submit-clean"><i class="bi bi-check2"></i> Submit Checkpoint @activeCheckpoint.CheckpointNo</button>
                            }
                            else
                            {
                                <button type="button" class="btn-submit-clean" disabled style="opacity: 0.6;">Completed</button>
                            }
                        </div>
                    </form>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form[action*='SubmitCheckpoint']");
            if (form) {
                form.addEventListener("submit", function (event) {
                    const ratingGroups = new Set();
                    form.querySelectorAll("input[type='radio'][name^='Ratings']").forEach(function (input) {
                        ratingGroups.add(input.name);
                    });

                    let selectedCount = 0;
                    ratingGroups.forEach(function (name) {
                        const selected = form.querySelector("input[name='" + name + "']:checked");
                        if (selected) selectedCount++;
                    });

                    if (selectedCount < ratingGroups.size) {
                        event.preventDefault();
                        alert("Please select a rating for every evaluation criterion before submitting.");
                    }
                });
            }
        });
    </script>
}