@model VeltriQ.ViewModels.EmployeeAssets.EmployeeAssetsDetailsViewModel

@{
    ViewData["Title"] = "Employee Allocation Details";
}

<style>
    .custody-details-frame {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── PROFILE HERO WORKSPACE BANNER ── */
    .custody-hero-banner {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
    }

    .hero-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .hero-identity-deck {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hero-avatar-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .hero-title-block {
        display: flex;
        flex-direction: column;
    }

        .hero-title-block h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

    .hero-meta-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
        font-weight: 600;
    }

    /* ── SUMMARIZED DATA STRIPS ── */
    .hero-metadata-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .hero-metadata-strip span strong {
            color: var(--text-primary);
        }

    /* ── HIGH DENSITY CONTENT WORKSPACE CARD ── */
    .workspace-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    .workspace-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--hover-bg);
    }

        .workspace-card-header h3 {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    /* ── DATA GRID TIMELINE MATRIX ── */
    .table-wrapper {
        overflow-x: auto;
    }

    .matrix-grid-table {
        width: 100%;
        border-collapse: collapse;
    }

        .matrix-grid-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
        }

        .matrix-grid-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .matrix-grid-table tbody tr:last-child td {
            border-bottom: none;
        }

        .matrix-grid-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── CONDENSED DESCRIPTORS AND MICRO BADGES ── */
    .asset-info {
        display: flex;
        flex-direction: column;
    }

    .asset-master-name {
        font-weight: 600;
        line-height: 1.2;
    }

    .inventory-item-code {
        font-size: 10.5px;
        color: var(--text-muted);
        font-weight: 700;
        margin-top: 1px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-allocated {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .badge-returned {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .btn-cancel-theme {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }
</style>

<div class="custody-details-frame">

    <div class="hero-top-row">
        <div>
            <a asp-action="Index" class="btn-cancel-theme">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>
    </div>

    <div class="custody-hero-banner">
        <div class="hero-top-row">
            <div class="hero-identity-deck">
                <div class="hero-avatar-circle">
                    @if (!string.IsNullOrWhiteSpace(Model.EmployeeName) && Model.EmployeeName.Contains(" "))
                    {
                        var components = Model.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        @($"{components[0][0]}{components[1][0]}".ToUpper())
                    }
                    else
                    {
                        @("EM")
                    }
                </div>
                <div class="hero-title-block">
                    <h2>@Model.EmployeeName</h2>
                    <div class="hero-meta-subtitle">
                        Department Fleet: <strong style="color: var(--text-primary);">@Model.Department</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="hero-metadata-strip">
            <span>Employee Code: <strong>@Model.EmployeeCode</strong></span>
            <span>Currently Holding: <strong style="color: #22c55e;">@Model.ActiveAssets Units</strong></span>
            <span>Successfully Returned: <strong style="color: var(--purple);">@Model.ReturnedAssets Units</strong></span>
            <span>Total Issued (Lifetime): <strong>@Model.TotalAssetsIssued</strong></span>
        </div>
    </div>

    <div class="workspace-card">
        <div class="workspace-card-header">
            <h3>Asset Allocation & Handover Ledger History</h3>
        </div>

        <div class="table-wrapper">
            <table class="matrix-grid-table">
                <thead>
                    <tr>
                        <th>Staged Asset Model</th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th>Serial / Tag Key</th>
                        <th>Issued On</th>
                        <th>Returned On</th>
                        <th>Current Status</th>
                        <th>Handover Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Assets != null && Model.Assets.Any())
                    {
                        foreach (var asset in Model.Assets)
                        {
                            <tr>
                                <td>
                                    <div class="asset-info">
                                        <span class="asset-master-name">@asset.AssetName</span>
                                        <span class="inventory-item-code">Stock Code: @asset.InventoryCode</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="status-badge badge-category">@asset.AssetCategory</span>
                                </td>

                                <td style="color: var(--text-secondary); font-weight: 500;">
                                    @asset.BrandName / @asset.ModelName
                                    ]
                                </td>

                                <td style="font-family: monospace; font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(asset.SerialNumber) ? "N/A" : asset.SerialNumber)
                                </td>

                                <td style="color: var(--text-secondary);">
                                    @(asset.IssueDate?.ToString("dd MMM yyyy") ?? "-")
                                </td>
                                <td style="color: var(--text-secondary); font-weight: 500;">
                                    @(asset.ReturnDate?.ToString("dd MMM yyyy") ?? "Still Holding")
                                </td>

                                <td>
                                    @if (asset.ReturnDate == null)
                                    {
                                        <span class="status-badge badge-allocated">In Custody</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge badge-returned">Returned</span>
                                    }
                                </td>

                                <td style="color: var(--text-secondary); font-style: italic; font-size: 12px; line-height: 1.3; max-width: 220px; white-space: normal;">
                                    @(string.IsNullOrWhiteSpace(asset.Remarks) ? "-" : asset.Remarks)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No dynamic historical asset allocation streams mapped to this profile.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>