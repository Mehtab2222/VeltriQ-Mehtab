@model IEnumerable<VeltriQ.Models.AssetInventory>

@{
    ViewData["Title"] = "Asset Inventory";
}

<style>
    .inventory-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Pushed Up & Titleless Style) ── */
    .inventory-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    /* ── COMPACT ACTION BUTTON ── */
    .inventory-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .inventory-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT PANEL CARD WITH SQUARED EDGES ── */
    .inventory-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .inventory-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .inventory-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .inventory-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── COMPACT SYSTEM SEARCH ── */
    .inventory-search {
        width: 280px;
        position: relative;
    }

        .inventory-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .inventory-search input:focus {
                border-color: var(--purple);
            }

        .inventory-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── HIGH DENSITY SCROLLABLE CONTAINER ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
    }

        .inventory-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .inventory-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .inventory-table tbody tr {
            transition: background-color .1s ease;
        }

            .inventory-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── ASSET INFORMATION ROW DESCRIPTORS ── */
    .asset-info {
        display: flex;
        flex-direction: column;
    }

    .asset-master-name {
        font-weight: 600;
        margin-bottom: 1px;
        line-height: 1.2;
    }

    .asset-inventory-link {
        color: var(--text-primary);
        text-decoration: none;
    }

        .asset-inventory-link:hover {
            color: var(--purple);
        }

    .inventory-item-code {
        font-size: 10.5px;
        color: var(--text-muted);
        line-height: 1;
        font-weight: 700;
    }

    /* ── MATCHING VELTRIQ METRO BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    /* Dynamic Status States Matching Requirements */
    .status-available {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .status-allocated {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-default-state {
        background: rgba(234, 179, 8, 0.12);
        color: #eab308;
    }

    /* ── HIGH DENSITY ACTIONS PANEL ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="inventory-page">

    <div class="inventory-header">
        <a href="/AssetInventory/Create" class="inventory-add-btn">
            <i class="bi bi-plus-lg"></i>
            Add Inventory
        </a>
    </div>

    <div class="inventory-card">

        <div class="inventory-card-top">
            <div class="inventory-card-title">
                <h3>Asset Inventory </h3>
                <p>Total Traceable Records: @Model.Count()</p>
            </div>

            <div class="inventory-search">
                <i class="bi bi-search"></i>
                <input type="text" id="inventorySearchInput" placeholder="Search stock registries..." onkeyup="filterInventoryTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="inventory-table" id="inventoryTable">
                <thead>
                    <tr>
                        <th>Inventory Code</th>
                        <th>Asset </th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th>Serial No</th>
                        <th>Status</th>
                        <th style="text-align: center; width: 90px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-weight: 700; color: var(--text-primary);">
                                    @(string.IsNullOrWhiteSpace(item.InventoryCode) ? "-" : item.InventoryCode)
                                </td>

                                <td>
                                    <div class="asset-info">
                                        <div class="asset-master-name">
                                            <a href="/AssetInventory/Details/@item.AssetInventoryId" class="asset-inventory-link">
                                                @(item.AssetMaster != null ? item.AssetMaster.AssetName : "Unmapped Asset")
                                            </a>
                                        </div>
                                        <div class="inventory-item-code">@(item.AssetMaster != null ? item.AssetMaster.AssetCode : "-")</div>
                                    </div>
                                </td>

                                <td>
                                    <span class="status-badge status-category">
                                        @(item.AssetMaster != null ? item.AssetMaster.AssetCategory : "General")
                                    </span>
                                </td>

                                <td style="font-weight: 500; color: var(--text-secondary);">
                                    @(item.AssetMaster != null ? $"{item.AssetMaster.BrandName} / {item.AssetMaster.ModelName}" : "-")
                                </td>

                                <td style="font-family: monospace; font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(item.SerialNumber) ? "N/A" : item.SerialNumber)
                                </td>

                                <td>
                                    @{
                                        string statusLower = (item.InventoryStatus ?? "").ToLower();
                                        string statusClass = statusLower switch
                                        {
                                            "available" or "instock" or "in stock" => "status-available",
                                            "allocated" or "assigned" or "issued" => "status-allocated",
                                            _ => "status-default-state"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@(item.InventoryStatus ?? "Pending")</span>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a href="/AssetInventory/Details/@item.AssetInventoryId" class="action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                                        <a href="/AssetInventory/Edit/@item.AssetInventoryId" class="action-btn" title="Edit Properties"><i class="bi bi-pencil"></i></a>
                                        <a href="/AssetInventory/Delete/@item.AssetInventoryId" class="action-btn delete-btn" title="Delete Log" onclick="return confirm('Are you sure you want to deactivate this inventory item?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No tracking entries registered inside asset stock inventory databases.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterInventoryTable() {
        const input = document.getElementById('inventorySearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('inventoryTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>