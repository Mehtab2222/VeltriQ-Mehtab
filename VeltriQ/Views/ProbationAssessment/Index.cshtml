@model IEnumerable<VeltriQ.Controllers.ProbationIndexViewModel>

@{
    ViewData["Title"] = "Probation Assessments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .probation-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .probation-header-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 10px;
    }

    .probation-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }
    .probation-add-btn:hover { transform: translateY(-1px); color: #fff; }

    .probation-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .probation-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .probation-card-title h3 { font-size: 15px; font-weight: 700; color: var(--text-primary); margin: 0; }
    .probation-card-title p { font-size: 11px; color: var(--text-secondary); margin: 2px 0 0 0; }

    .search-box {
        position: relative;
        width: 260px;
    }
    .search-box input {
        width: 100%;
        height: 32px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px 0 32px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s;
    }
    .search-box input:focus { border-color: var(--purple); }
    .search-box i {
        position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
        color: var(--text-muted); font-size: 13px;
    }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .table-wrapper::-webkit-scrollbar { display: none; }

    .probation-table { width: 100%; border-collapse: collapse; }
    .probation-table th {
        text-align: left;
        padding: 10px 16px;
        font-size: 10px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .probation-table td {
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        color: var(--text-primary);
        font-size: 12.5px;
        vertical-align: middle;
    }
    .probation-table tbody tr:hover { background: var(--hover-bg); }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }
    .status-pending { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .status-inprogress { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .status-completed { background: rgba(34, 197, 94, 0.15); color: #22c55e; }

    .action-btn {
        width: 28px; height: 28px;
        border-radius: 4px; border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; cursor: pointer; text-decoration: none;
        transition: background-color 0.2s;
    }
    .action-btn:hover { background: var(--purple); color: #fff; }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@Html.AntiForgeryToken()

<div class="probation-page">
    <div class="probation-header-bar">
        <a asp-action="Create" class="probation-add-btn">
            <i class="bi bi-plus-lg"></i> Create Probation Assessment
        </a>
    </div>

    <div class="probation-card">
        <div class="probation-card-top">
            <div class="probation-card-title">
                <h3>Probation Assessments Workspace</h3>
                <p>Manage active employee performance lifecycles, checkpoints, and evaluation milestones.</p>
            </div>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="tableSearchKeyword" placeholder="Search assessments..." onkeyup="filterProbationTable()" autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="probation-table" id="probationTable">
                <thead>
                    <tr>
                        <th>Employee No</th>
                        <th>Employee Name</th>
                        <th>Current Checkpoint</th>
                        <th>Due Date</th>
                        <th style="text-align: center;">Days Remaining</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            var statusClass = x.OverallStatus == "Completed" ? "status-completed" : (x.OverallStatus == "InProgress" ? "status-inprogress" : "status-pending");
                            <tr class="probation-row">
                                <td style="font-weight: 700; font-family: monospace;">@x.EmployeeNo</td>
                                <td style="font-weight: 600;" class="searchable-text">@x.EmployeeName</td>
                                <td>@(x.CurrentCheckpointLabel ?? "—")</td>
                                <td>@(x.CurrentCheckpointDate.HasValue? x.CurrentCheckpointDate.Value.ToString("dd MMM yyyy") : "—")</td>
                                <td style="text-align: center; font-weight: 600;">
                                    @if (x.DaysRemaining.HasValue)
                                    {
                                        <span style="color: @(x.DaysRemaining < 0 ? "#ef4444" : "inherit")">@x.DaysRemaining days</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge-status @statusClass">@x.OverallStatus</span>
                                </td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                        <a asp-action="Edit" asp-route-id="@x.AssessmentId" class="action-btn" title="View / Edit Assessment">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button class="action-btn" onclick="deleteAssessment(@x.AssessmentId)" title="Delete Assessment" style="color: #ef4444;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No probation assessments found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterProbationTable() {
        const input = document.getElementById('tableSearchKeyword');
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#probationTable tbody tr.probation-row');

        rows.forEach(row => {
            const textContent = row.textContent.toLowerCase();
            if (textContent.includes(filter)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    async function deleteAssessment(id) {
        const confirmResult = await Swal.fire({
            title: 'Delete Assessment?',
            text: 'Are you sure you want to delete this probation assessment record?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#7c3aed',
            confirmButtonText: 'Yes, delete it!'
        });

        if (!confirmResult.isConfirmed) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(`/ProbationAssessment/DeleteAssessment?assessmentId=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                Swal.fire({ icon: 'success', title: 'Deleted!', text: result.message, timer: 1200, showConfirmButton: false });
                setTimeout(() => location.reload(), 1200);
            } else {
                Swal.fire({ icon: 'error', title: 'Action Denied', text: result.message, confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Delete error:', err);
        }
    }
</script>