@model VeltriQ.ViewModels.Attendance.WeeklyOffPolicyViewModel

@{
    ViewData["Title"] = "Create Weekly Off Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 80px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .form-card-top {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

        .form-card-top h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .form-scroll-body {
        overflow-y: auto;
        padding: 24px;
        flex: 1;
        scrollbar-width: none;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .form-scroll-body::-webkit-scrollbar {
            display: none;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 18px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .form-group.wide {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
        }

    .custom-input, .custom-select {
        width: 100%;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 12.5px;
        outline: none;
        height: 36px;
    }

        .custom-input:focus, .custom-select:focus {
            border-color: var(--purple);
        }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }

        .checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--purple);
            cursor: pointer;
        }

        .checkbox-group label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-primary);
            text-transform: none;
            cursor: pointer;
        }

    /* Rules Table Styles */
    .rules-section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: var(--text-secondary);
        border-top: 1px solid var(--border);
        padding-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rules-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 4px;
    }

        .rules-table th {
            text-align: left;
            padding: 8px 12px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            background: var(--hover-bg);
            border-bottom: 1px solid var(--border);
        }

        .rules-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

    .add-rule-row-btn {
        height: 28px;
        padding: 0 12px;
        border-radius: 4px;
        border: none;
        background: var(--purple);
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .remove-rule-row-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .form-footer {
        padding: 14px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

    .btn-cancel {
        height: 34px;
        padding: 0 16px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-save {
        height: 34px;
        padding: 0 18px;
        border-radius: 6px;
        border: none;
        background: var(--purple);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="form-page">
    <form asp-action="Create" method="post" class="form-card" onsubmit="prepareFormSubmission(event)">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WeeklyOffPolicy.PolicyCode" />

        <div class="form-card-top">
            <h3>Create Weekly Off Policy</h3>
            <span style="font-size: 11px; color: var(--text-secondary);">Define company-wide weekly off rules and parameters.</span>
        </div>

        <div class="form-scroll-body">
            <div asp-validation-summary="ModelOnly" style="color: #ef4444; font-size: 12px; margin-bottom: 10px;"></div>

            <div class="form-grid">
                <div class="form-group wide">
                    <label asp-for="WeeklyOffPolicy.CompanyId">Company *</label>
                    <select asp-for="WeeklyOffPolicy.CompanyId" asp-items="Model.Companies" class="custom-select" required>
                        <option value="">Select Company</option>
                    </select>
                </div>

                <div class="form-group wide">
                    <label asp-for="WeeklyOffPolicy.PolicyName">Policy Name *</label>
                    <input asp-for="WeeklyOffPolicy.PolicyName" class="custom-input" placeholder="e.g. Saturday & Sunday Off" autocomplete="off" required />
                </div>

                <div class="form-group wide" style="display: flex; flex-direction: row; gap: 24px; margin-top: 4px;">
                    <div class="checkbox-group">
                        <input asp-for="WeeklyOffPolicy.IsDefaultPolicy" />
                        <label asp-for="WeeklyOffPolicy.IsDefaultPolicy">Set as Default Policy</label>
                    </div>
                    <div class="checkbox-group">
                        <input asp-for="WeeklyOffPolicy.IsActive" checked />
                        <label asp-for="WeeklyOffPolicy.IsActive">Is Active</label>
                    </div>
                </div>
            </div>

            <div class="rules-section-title">
                <span>Weekly Off Rules</span>
                <button type="button" class="add-rule-row-btn" onclick="addRuleRow()"><i class="bi bi-plus-lg"></i> Add Rule</button>
            </div>

            <div style="overflow-x: auto;">
                <table class="rules-table">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Day of Week</th>
                            <th style="width: 45%;">Week Number</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="rulesTableBody">
                    </tbody>
                </table>
            </div>
        </div>

        <div class="form-footer">
            <a asp-action="Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-save"><i class="bi bi-check2-circle"></i> Save Policy</button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        addRuleRow(0, 0); // Add default Sunday, Every Week row on load
    });

    function addRuleRow(selectedDay = 0, selectedWeek = 0) {
        const tbody = document.getElementById('rulesTableBody');
        const rowIndex = tbody.children.length;
        const row = document.createElement('tr');

        row.innerHTML = `
            <td>
                <input type="hidden" name="WeeklyOffDetails[${rowIndex}].WeeklyOffPolicyDetailId" value="0" />
                <select name="WeeklyOffDetails[${rowIndex}].DayOfWeek" class="custom-select rule-day" required>
                    <option value="0" ${selectedDay === 0 ? 'selected' : ''}>Sunday</option>
                    <option value="1" ${selectedDay === 1 ? 'selected' : ''}>Monday</option>
                    <option value="2" ${selectedDay === 2 ? 'selected' : ''}>Tuesday</option>
                    <option value="3" ${selectedDay === 3 ? 'selected' : ''}>Wednesday</option>
                    <option value="4" ${selectedDay === 4 ? 'selected' : ''}>Thursday</option>
                    <option value="5" ${selectedDay === 5 ? 'selected' : ''}>Friday</option>
                    <option value="6" ${selectedDay === 6 ? 'selected' : ''}>Saturday</option>
                </select>
            </td>
            <td>
                <select name="WeeklyOffDetails[${rowIndex}].WeekNumber" class="custom-select rule-week" required>
                    <option value="0" ${selectedWeek === 0 ? 'selected' : ''}>Every Week</option>
                    <option value="1" ${selectedWeek === 1 ? 'selected' : ''}>First</option>
                    <option value="2" ${selectedWeek === 2 ? 'selected' : ''}>Second</option>
                    <option value="3" ${selectedWeek === 3 ? 'selected' : ''}>Third</option>
                    <option value="4" ${selectedWeek === 4 ? 'selected' : ''}>Fourth</option>
                    <option value="5" ${selectedWeek === 5 ? 'selected' : ''}>Fifth</option>
                </select>
            </td>
            <td>
                <button type="button" class="remove-rule-row-btn" onclick="removeRuleRow(this)"><i class="bi bi-trash"></i></button>
            </td>
        `;
        tbody.appendChild(row);
        reindexRows();
    }

    function removeRuleRow(btn) {
        const tbody = document.getElementById('rulesTableBody');
        if (tbody.children.length <= 1) {
            Swal.fire({ icon: 'warning', title: 'At least one rule required', text: 'You must keep at least one weekly off rule.', confirmButtonColor: '#7c3aed' });
            return;
        }
        btn.closest('tr').remove();
        reindexRows();
    }

    function reindexRows() {
        const rows = document.querySelectorAll('#rulesTableBody tr');
        rows.forEach((row, index) => {
            const hiddenId = row.querySelector('input[type="hidden"]');
            const daySelect = row.querySelector('.rule-day');
            const weekSelect = row.querySelector('.rule-week');

            if (hiddenId) hiddenId.name = `WeeklyOffDetails[${index}].WeeklyOffPolicyDetailId`;
            if (daySelect) daySelect.name = `WeeklyOffDetails[${index}].DayOfWeek`;
            if (weekSelect) weekSelect.name = `WeeklyOffDetails[${index}].WeekNumber`;
        });
    }

    function prepareFormSubmission(e) {
        reindexRows();
    }
</script>