@model dynamic

@{
    ViewData["Title"] = "VeltriQ Dashboard";
}

<style>
    /* DASHBOARD SPECIFIC STYLES - Variables handled by Layout */
    .topbar {
        background: var(--topbar-bg);
        border-radius: 13px;
        padding: 10px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--card-shadow);
        margin-bottom: 16px;
        border: 1px solid var(--border);
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 18px;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
    }

        .menu-btn:hover {
            background: var(--hover-bg);
        }

    .search-box {
        width: 330px;
        position: relative;
    }

        .search-box input {
            width: 100%;
            border: 1.5px solid var(--border);
            background: var(--input-bg);
            border-radius: 10px;
            padding: 8px 14px 8px 36px;
            font-size: 13px;
            color: var(--text-primary);
            outline: none;
            transition: border .2s;
        }

            .search-box input:focus {
                border-color: #7c3aed;
            }

        .search-box i {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 12px;
            color: var(--text-muted);
            font-size: 13px;
        }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .tb-icon {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-secondary);
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        position: relative;
        transition: background .15s;
    }

        .tb-icon:hover {
            background: var(--hover-bg);
            color: var(--purple);
        }

    .notif-dot {
        position: absolute;
        top: 4px;
        right: 4px;
        background: #7c3aed;
        color: #fff;
        font-size: 8px;
        font-weight: 800;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--topbar-bg);
    }

    .tb-sep {
        width: 1px;
        height: 24px;
        background: var(--border);
        margin: 0 4px;
    }

    .profile-pill {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 4px 9px;
        border-radius: 9px;
        cursor: pointer;
        transition: background .15s;
    }

        .profile-pill:hover {
            background: var(--hover-bg);
        }

        .profile-pill img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #7c3aed;
        }

    .p-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .p-role {
        font-size: 10.5px;
        color: var(--text-muted);
    }

    /* ── GREETING ── */
    .greeting-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
    }

    .greeting-section h2 {
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .greeting-section p {
        font-size: 12.5px;
        color: var(--text-secondary);
    }

    .date-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-secondary);
        cursor: pointer;
        white-space: nowrap;
    }

        .date-chip i {
            color: var(--purple);
            font-size: 12px;
        }

    /* ── STATS ── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: 11px;
        margin-bottom: 14px;
    }

    .stat-card {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 15px 15px 13px;
        border: 1px solid var(--border);
        box-shadow: var(--card-shadow);
        transition: transform .2s,box-shadow .2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(15,23,42,.1);
        }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 10px;
    }

    .ic-pu {
        background: var(--pu-l);
        color: var(--purple);
    }

    .ic-bl {
        background: var(--bl-l);
        color: var(--blue);
    }

    .ic-gr {
        background: var(--gr-l);
        color: var(--green);
    }

    .ic-or {
        background: var(--or-l);
        color: var(--orange);
    }

    .ic-rd {
        background: var(--rd-l);
        color: var(--red);
    }

    .stat-label {
        font-size: 11px;
        color: var(--text-muted);
        font-weight: 500;
        margin-bottom: 3px;
    }

    .stat-value {
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .stat-delta {
        font-size: 11px;
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .d-up {
        color: #16a34a;
    }

    .d-dn {
        color: #dc2626;
    }

    /* ── CARDS & GRIDS ── */
    .card-box {
        background: var(--card-bg);
        border-radius: 15px;
        padding: 16px 18px;
        border: 1px solid var(--border);
        box-shadow: var(--card-shadow);
    }

    .ch-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 13px;
    }

    .card-title {
        font-size: 13.5px;
        font-weight: 700;
    }

    .view-all {
        font-size: 11.5px;
        color: var(--purple);
        text-decoration: none;
        font-weight: 600;
    }

    .sel-mini {
        background: var(--input-bg);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 12px;
        color: var(--text-secondary);
        cursor: pointer;
        outline: none;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 12px;
        margin-bottom: 12px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 350px;
        gap: 12px;
        margin-bottom: 12px;
    }

    .grid-last {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 12px;
        margin-bottom: 12px;
    }

    /* ── APPROVALS ── */
    .appr-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

        .appr-item:last-child {
            border-bottom: none;
        }

    .emp-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .emp-ava {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
    }

    .emp-name {
        font-size: 12px;
        font-weight: 700;
    }

    .emp-type {
        font-size: 11px;
        color: var(--text-muted);
    }

    .act-grp {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .act-time {
        font-size: 10.5px;
        color: var(--text-muted);
        margin-right: 2px;
    }

    .appr-btn, .rejt-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        transition: all .15s;
    }

    .appr-btn {
        background: var(--gr-l);
        color: var(--green);
    }

    .rejt-btn {
        background: var(--rd-l);
        color: var(--red);
    }

    /* ── DONUT ── */
    .donut-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .donut-ctr {
        position: relative;
        flex-shrink: 0;
    }

    .donut-label {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        text-align: center;
        pointer-events: none;
    }

        .donut-label .dl {
            font-size: 10px;
            color: var(--text-muted);
        }

        .donut-label .dv {
            font-size: 16px;
            font-weight: 800;
        }

    .leg-list {
        list-style: none;
        flex: 1;
    }

        .leg-list li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 11.5px;
            color: var(--text-secondary);
        }

    .leg-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 6px;
    }

    .leg-left {
        display: flex;
        align-items: center;
    }

    .leg-val {
        font-weight: 700;
        color: var(--text-primary);
    }

    /* ── ANNOUNCEMENTS ── */
    .ann-item {
        display: flex;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

        .ann-item:last-child {
            border-bottom: none;
        }

    .ann-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .ann-title {
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 1px;
    }

    .ann-desc {
        font-size: 11px;
        color: var(--text-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 210px;
    }

    .ann-time {
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    /* ── BIRTHDAYS ── */
    .bday-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

        .bday-item:last-child {
            border-bottom: none;
        }

    .bday-left {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .bday-ava {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
    }

    .bday-name {
        font-size: 12px;
        font-weight: 700;
    }

    .bday-role {
        font-size: 11px;
        color: var(--text-muted);
    }

    .bday-badge {
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 20px;
    }

    .b-today {
        background: var(--pu-l);
        color: var(--purple);
    }

    .b-anniv {
        background: var(--bl-l);
        color: var(--blue);
    }

    .b-soon {
        background: var(--gr-l);
        color: var(--green);
    }

    /* ── FLOATING THEME ── */
    .float-settings {
        position: fixed;
        bottom: 22px;
        right: 22px;
        z-index: 999;
    }

    .float-btn {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        border: none;
        border-radius: 13px;
        color: #fff;
        font-size: 19px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 20px rgba(109,40,217,.4);
        transition: transform .2s,box-shadow .2s;
    }

        .float-btn:hover {
            transform: scale(1.08);
            box-shadow: 0 10px 28px rgba(109,40,217,.5);
        }

    .appear-panel {
        position: absolute;
        bottom: 56px;
        right: 0;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 13px;
        padding: 10px;
        width: 185px;
        box-shadow: 0 10px 36px rgba(0,0,0,.18);
        display: none;
    }

        .appear-panel.open {
            display: block;
        }

    .theme-opt {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 10px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-secondary);
        transition: background .15s;
        border: 2px solid transparent;
    }

        .theme-opt:hover {
            background: var(--hover-bg);
        }

        .theme-opt.active {
            border-color: var(--purple);
            color: var(--purple);
            background: var(--pu-l);
        }
</style>

