@model VeltriQ.Models.HR.EmployeeInduction

@{
    ViewData["Title"] = "View Employee Induction";
    int currentStatusCode = ViewBag.Status ?? 1;
    string statusText = currentStatusCode == 1 ? "Assigned" : currentStatusCode == 2 ? "In Progress" : currentStatusCode == 3 ? "Completed" : "Cancelled";
    string statusColor = currentStatusCode == 1 ? "#3b82f6" : currentStatusCode == 2 ? "#eab308" : currentStatusCode == 3 ? "#22c55e" : "#ef4444";
}

<style>
    .view-frame {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .view-top-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 4px;
    }

    .btn-back-theme {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .btn-back-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }

    /* ── DASHBOARD CARD ── */
    .dashboard-hero-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
    }

    .hero-title h2 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .hero-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 2px 0 8px 0;
        font-weight: 600;
    }

    .metadata-dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        padding-top: 10px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .metadata-dashboard-grid span strong {
            color: var(--text-primary);
        }

    /* ── CURRICULUM WORKSPACE PANELS ── */
    .curriculum-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    .curriculum-card-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--hover-bg);
    }

        .curriculum-card-header h3 {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .table-wrapper {
        overflow-x: auto;
    }

    .matrix-grid-table {
        width: 100%;
        border-collapse: collapse;
    }

        .matrix-grid-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
        }

        .matrix-grid-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .matrix-grid-table tbody tr:last-child td {
            border-bottom: none;
        }
</style>

<div class="view-frame">
    <div class="view-top-row">
        <a asp-action="Index" class="btn-back-theme"><i class="bi bi-arrow-left"></i> Back to Register</a>
    </div>

    <div class="dashboard-hero-card">
        <div class="hero-title">
            <h2>@ViewBag.EmployeeName</h2>
            <div class="hero-subtitle">Program Blueprint Track: <span style="color:var(--purple);">@ViewBag.ProgramName</span></div>
        </div>

        <div class="metadata-dashboard-grid">
            <span>Start Date: <strong>@(ViewBag.StartDate != null ? ((DateTime)ViewBag.StartDate).ToString("dd MMM yyyy") : "-")</strong></span>
            <span>Expected Completion: <strong>@(Model.ExpectedCompletionDate?.ToString("dd MMM yyyy") ?? "-")</strong></span>
            <span>Actual Completion: <strong>@(Model.ActualCompletionDate?.ToString("dd MMM yyyy") ?? "In Progress")</strong></span>
            <span>Current Status: <strong style="color: @statusColor;">@statusText</strong></span>
        </div>
    </div>

    <div class="curriculum-card">
        <div class="curriculum-card-header">
            <h3>Assigned Curriculum Module Learning Sessions</h3>
        </div>

        <div class="table-wrapper">
            <table class="matrix-grid-table">
                <thead>
                    <tr>
                        <th style="width: 70px; text-align: center;">Order</th>
                        <th>Session Module Title Heading</th>
                        <th>Duration Metric</th>
                        <th>Constraint Rule</th>
                        <th>Attendance Log</th>
                        <th>Completion Metric</th>
                    </tr>
                </thead>
                <tbody id="sessionRosterGridBody">
                    <tr>
                        <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                            Streaming runtime logs tracking...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetchInductionSessionsTrack();
    });

    async function fetchInductionSessionsTrack() {
        const tbody = document.getElementById("sessionRosterGridBody");
        const inductionId = @Model.EmployeeInductionId;

        try {
            const res = await fetch(`/EmployeeInduction/GetSessions?employeeInductionId=${inductionId}`, { method: 'GET' });
            const result = await res.json();
            const dataset = result.data || [];

            if (dataset.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; font-style:italic; color:var(--text-muted); padding:16px;">No mapped template modules connected to this instance.</td></tr>`;
                return;
            }

            tbody.innerHTML = dataset.map(item => {
                let attendColor = "var(--text-secondary)";
                if (item.attendanceStatus === "Present") attendColor = "#22c55e";
                else if (item.attendanceStatus === "Absent") attendColor = "#ef4444";
                else if (item.attendanceStatus === "Rescheduled") attendColor = "#eab308";

                return `
                <tr>
                    <td style="text-align: center; font-weight: 700; color: var(--text-secondary);">${item.sessionOrder}</td>
                    <td style="font-weight: 600;">${item.sessionTitle}</td>
                    <td style="font-weight: 500; color:var(--text-secondary);">${item.durationInMinutes} Mins</td>
                    <td style="font-weight: 600; color: ${item.isMandatory ? '#ef4444' : 'var(--text-secondary)'};">
                        ${item.isMandatory ? 'Mandatory' : 'Optional'}
                    </td>
                    <td style="font-weight: 700; color: ${attendColor};">${item.attendanceStatus}</td>
                    <td style="font-weight: 600; color: ${item.isCompleted ? '#22c55e' : 'var(--text-muted)'};">
                        ${item.isCompleted ? '✓ Completed' : 'Pending Action'}
                    </td>
                </tr>`;
            }).join('');

        } catch {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:red; padding:16px;">Failed to stream session tracking blocks.</td></tr>`;
        }
    }
</script>