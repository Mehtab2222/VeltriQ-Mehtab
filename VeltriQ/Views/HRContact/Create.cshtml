@model VeltriQ.Models.HR.HRContact

@{
    ViewData["Title"] = "Create HR Contact";
}

<style>

    .hrcontact-create-page {
        padding: 4px 0 32px;
    }

    /* TOPBAR */

    .hrcontact-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        gap: 20px;
    }

    .hrcontact-breadcrumb {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
    }

        .hrcontact-breadcrumb a {
            color: #8b5cf6;
            text-decoration: none;
            font-weight: 600;
        }

        .hrcontact-breadcrumb span {
            color: #94a3b8;
        }

    .hrcontact-top-actions {
        display: flex;
        gap: 10px;
    }

    .cancel-btn {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        color: #94a3b8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
    }

    .save-btn {
        height: 40px;
        padding: 0 20px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg,#6d28d9,#7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 22px rgba(124,58,237,.24);
    }

    /* CARD */

    .hrcontact-card {
        max-width: 1000px;
        background: rgba(30,35,44,.92);
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.06);
        overflow: hidden;
    }

    .hrcontact-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

    .hrcontact-card-icon {
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: rgba(124,58,237,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a78bfa;
    }

    .hrcontact-card-title {
        font-size: 14px;
        font-weight: 700;
        color: #fff;
    }

    /* BODY */

    .hrcontact-card-body {
        padding: 22px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .full-width {
        grid-column: span 2;
    }

    /* FIELD */

    .form-field {
        display: flex;
        flex-direction: column;
    }

        .form-field label {
            margin-bottom: 7px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .7px;
        }

    /* INPUT */

    .form-input,
    .form-select {
        width: 100%;
        height: 42px;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,.07);
        background: rgba(15,20,30,.7);
        color: #fff;
        padding: 0 14px;
        font-size: 13px;
        outline: none;
    }

        .form-input:focus,
        .form-select:focus {
            border-color: #7c3aed;
            background: rgba(124,58,237,.06);
            box-shadow: 0 0 0 3px rgba(124,58,237,.12);
        }

</style>

<div class="hrcontact-create-page">

    <!-- TOPBAR -->

    <div class="hrcontact-topbar">

        <div class="hrcontact-breadcrumb">

            <a href="/HRContact/Index">
                HR Contacts
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Create</span>

        </div>

        <div class="hrcontact-top-actions">

            <a href="/HRContact/Index"
               class="cancel-btn">

                <i class="bi bi-x"></i>

                Cancel

            </a>

            <button type="submit"
                    form="hrcontactForm"
                    class="save-btn">

                <i class="bi bi-person-lines-fill"></i>

                Save Contact

            </button>

        </div>

    </div>

    <!-- FORM -->

    <form id="hrcontactForm"
          asp-action="Create"
          method="post">

        <div class="hrcontact-card">

            <div class="hrcontact-card-header">

                <div class="hrcontact-card-icon">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div class="hrcontact-card-title">
                    HR Contact Information
                </div>

            </div>

            <div class="hrcontact-card-body">

                <!-- NAME -->

                <div class="form-field full-width">

                    <label>
                        Contact Name
                    </label>

                    <input asp-for="ContactName"
                           class="form-input"
                           placeholder="Enter contact name" />

                </div>

                <!-- CODE -->

                <div class="form-field">

                    <label>
                        Contact Code
                    </label>

                    <input asp-for="ContactCode"
                           class="form-input"
                           placeholder="HR-001" />

                </div>

                <!-- TYPE -->

                <div class="form-field">

                    <label>
                        Contact Type
                    </label>

                    <select asp-for="ContactType"
                            class="form-select">

                        <option value="">
                            Select Type
                        </option>

                        <option>HRBP</option>
                        <option>Payroll</option>
                        <option>Recruitment</option>
                        <option>IT Support</option>
                        <option>Admin</option>

                    </select>

                </div>

                <!-- EMAIL -->

                <div class="form-field">

                    <label>
                        Email Address
                    </label>

                    <input asp-for="EmailAddress"
                           class="form-input"
                           placeholder="support@company.com" />

                </div>

                <!-- PHONE -->

                <div class="form-field">

                    <label>
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-input"
                           placeholder="+91 9876543210" />

                </div>

                <!-- DEPARTMENT -->

                <div class="form-field full-width">

                    <label>
                        Department Name
                    </label>

                    <input asp-for="DepartmentName"
                           class="form-input"
                           placeholder="Human Resources" />

                </div>

                <!-- DESCRIPTION -->

                <div class="form-field full-width">

                    <label>
                        Description
                    </label>

                    <input asp-for="Description"
                           class="form-input"
                           placeholder="Enter contact description" />

                </div>

            </div>

        </div>

    </form>

</div>