@model IEnumerable<VeltriQ.Models.HR.EmployeeExit>

@{
    ViewData["Title"] = "Employee Exit";
}

<style>
    .exit-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .exit-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .exit-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .exit-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .exit-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .exit-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .exit-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .exit-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .exit-search-wrapper {
        position: relative;
        width: 320px;
    }

        .exit-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .exit-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .exit-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .exit-table {
        width: 100%;
        border-collapse: collapse;
    }

        .exit-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .exit-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .exit-table tbody tr {
            transition: background-color .1s ease;
        }

            .exit-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── IDENTITY SYSTEM LABELS ── */
    .emp-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .emp-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 10px;
        flex-shrink: 0;
    }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-pending {
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
    }

    /* ── INLINE CORE RUNTIME ACTIONS (RIGHT ALIGNED) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn-complete {
        padding: 0 10px;
        height: 26px;
        border-radius: 4px;
        background: rgba(239, 68, 68, .12);
        color: #f87171;
        font-size: 11px;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
        border: 1px solid rgba(239, 68, 68, 0.15);
        display: inline-flex;
        align-items: center;
    }

        .action-btn-complete:hover {
            background: #ef4444;
            color: #fff;
            border-color: #ef4444;
        }
</style>

<div class="exit-page">

    <div class="exit-header">
        <a href="/EmployeeExit/Create" class="exit-add-btn">
            <i class="bi bi-plus-lg"></i> New Exit Request
        </a>
    </div>

    <div class="exit-card">

        <div class="exit-card-top">
            <div class="exit-card-title">
                <h3>Exit Records</h3>
                <p>Total Offboarding: <span id="exitCounter">@Model.Count()</span></p>
            </div>

            <!-- Enhanced Right-aligned Search Bar -->
            <div class="exit-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="exitSearchInput" placeholder="Search offboardings..." autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="exit-table" id="exitTableMatrix">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Exit ID</th>
                        <th>Resignation Date</th>
                        <th>Last Working Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name">
                                    <div class="emp-info">
                                        <div class="emp-avatar">
                                            @(item.Employee?.FirstName?.Substring(0, 1).ToUpper())@(item.Employee?.LastName?.Substring(0, 1).ToUpper())
                                        </div>
                                        <div style="font-weight: 600;">
                                            @item.Employee?.FirstName @item.Employee?.LastName
                                        </div>
                                    </div>
                                </td>
                                <td data-search="id">
                                    <span style="color: var(--text-secondary); font-size: 11.5px; font-weight: 500;">
                                        @item.EmployeeExitId
                                    </span>
                                </td>
                                <td>
                                    @item.ResignationDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    @item.LastWorkingDate.ToString("dd MMM yyyy")
                                </td>
                                <td data-search="status">
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="status-badge status-active">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-pending">Pending</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        @if (item.Status == "Pending")
                                        {
                                            <a asp-action="Complete" asp-route-id="@item.EmployeeExitId" class="action-btn-complete">
                                                Complete Exit
                                            </a>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: 11.5px; font-style: italic; padding-right: 8px;">Processed</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyMatrixFallback">
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("exitSearchInput");
        const matrixGrid = document.getElementById("exitTableMatrix");
        const counterTracker = document.getElementById("exitCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");

        let inlineFallbackRow = document.getElementById("emptyMatrixFallback");
        if (!inlineFallbackRow) {
            inlineFallbackRow = document.createElement("tr");
            inlineFallbackRow.id = "emptyMatrixFallback";
            inlineFallbackRow.innerHTML = `<td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">No matching records found.</td>`;
            inlineFallbackRow.style.display = "none";
            matrixGrid.querySelector("tbody").appendChild(inlineFallbackRow);
        }

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const idText = row.querySelector('[data-search="id"]')?.textContent.toLowerCase() || "";
                const statusText = row.querySelector('[data-search="status"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameText} ${idText} ${statusText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (matchedCount === 0 && dataRows.length > 0) {
                inlineFallbackRow.style.display = "";
            } else {
                inlineFallbackRow.style.display = "none";
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>