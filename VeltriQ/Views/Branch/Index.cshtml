
@model IEnumerable<VeltriQ.Models.HR.Branch>

@{
    ViewData["Title"] = "Branches";
}

<style>
    .branch-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .branch-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .branch-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .branch-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .branch-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .branch-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .branch-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .branch-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .branch-search-wrapper {
        position: relative;
        width: 320px;
    }

        .branch-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .branch-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .branch-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .branch-table {
        width: 100%;
        border-collapse: collapse;
    }

        .branch-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .branch-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .branch-table tbody tr {
            transition: background-color .1s ease;
        }

            .branch-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, .12);
        color: #ef4444;
    }

    /* ── INLINE ACTIONS (RIGHT ALIGNED) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }

    .empty-state {
        padding: 40px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 36px;
            color: var(--text-muted);
            margin-bottom: 10px;
            display: block;
        }

        .empty-state h4 {
            color: var(--text-primary);
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .empty-state p {
            color: var(--text-secondary);
            font-size: 12px;
            margin-bottom: 14px;
        }
</style>

<div class="branch-page">

    <div class="branch-header">
        <a href="/Branch/Create" class="branch-add-btn">
            <i class="bi bi-plus-lg"></i> Add Branch
        </a>
    </div>

    <div class="branch-card">

        <div class="branch-card-top">
            <div class="branch-card-title">
                <h3>Branch Directory</h3>
                <p>Total Records: <span id="branchCounter">@Model.Count()</span></p>
            </div>

            <div class="branch-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="branchSearchInput" placeholder="Search branches..." autocomplete="off" />
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="table-wrapper">
                <table class="branch-table" id="branchTableMatrix">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Branch Code</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>City</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-search="name" style="font-weight: 600;">
                                    @item.BranchName
                                </td>
                                <td data-search="code">
                                    <span style="color: var(--text-secondary); font-size: 11.5px; font-weight: 500;">
                                        @item.BranchCode
                                    </span>
                                </td>
                                <td data-search="company">
                                    @(item.Company?.CompanyName ?? "-")
                                </td>
                                <td data-search="email">
                                    @(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)
                                </td>
                                <td data-search="phone">
                                    @(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "-" : item.PhoneNumber)
                                </td>
                                <td data-search="city">
                                    @(string.IsNullOrWhiteSpace(item.City) ? "-" : item.City)
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a href="/Branch/Details/@item.BranchId" class="action-btn" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Branch/Edit/@item.BranchId" class="action-btn" title="Edit Properties">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/Branch/Delete/@item.BranchId" class="action-btn delete-btn" title="Delete Entry" onclick="return confirm('Are you sure?')">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="emptyMatrixFallback" style="display: none;">
                            <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No matching records found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-building"></i>
                <h4>No Branches Found</h4>
                <p>Start by creating your first organization branch workspace registry node.</p>
                <a href="/Branch/Create" class="branch-add-btn" style="box-shadow: none;">
                    <i class="bi bi-plus-lg"></i> Create Branch
                </a>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("branchSearchInput");
        const matrixGrid = document.getElementById("branchTableMatrix");
        const counterTracker = document.getElementById("branchCounter");

        if (!searchInput || !matrixGrid) return;

        const dataRows = matrixGrid.querySelectorAll("tbody tr:not(#emptyMatrixFallback)");
        const inlineFallbackRow = document.getElementById("emptyMatrixFallback");

        searchInput.addEventListener("input", function () {
            const criteria = this.value.trim().toLowerCase();
            let matchedCount = 0;

            dataRows.forEach(row => {
                const nameText = row.querySelector('[data-search="name"]')?.textContent.toLowerCase() || "";
                const codeText = row.querySelector('[data-search="code"]')?.textContent.toLowerCase() || "";
                const companyText = row.querySelector('[data-search="company"]')?.textContent.toLowerCase() || "";
                const emailText = row.querySelector('[data-search="email"]')?.textContent.toLowerCase() || "";
                const phoneText = row.querySelector('[data-search="phone"]')?.textContent.toLowerCase() || "";
                const cityText = row.querySelector('[data-search="city"]')?.textContent.toLowerCase() || "";

                const compoundSourceText = `${nameText} ${codeText} ${companyText} ${emailText} ${phoneText} ${cityText}`;

                if (compoundSourceText.includes(criteria)) {
                    row.style.display = "";
                    matchedCount++;
                } else {
                    row.style.display = "none";
                }
            });

            if (inlineFallbackRow) {
                if (matchedCount === 0 && dataRows.length > 0) {
                    inlineFallbackRow.style.display = "";
                } else {
                    inlineFallbackRow.style.display = "none";
                }
            }

            if (counterTracker) {
                counterTracker.textContent = matchedCount;
            }
        });
    });
</script>

