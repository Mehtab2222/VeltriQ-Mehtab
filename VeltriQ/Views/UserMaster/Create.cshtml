@model VeltriQ.ViewModels.Administration.UserMasterCreateViewModel

@{
    ViewData["Title"] = "Create User";

    var employeeName = Model.EmployeeName ?? "";
    var employeeCode = Model.EmployeeCode ?? "";

    var employeeParts = employeeName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    var initials = employeeParts.Length switch
    {
        0 => "?",
        1 => employeeParts[0].Substring(0, 1).ToUpper(),
        _ => (
            employeeParts[0].Substring(0, 1) +
            employeeParts[^1].Substring(0, 1)
        ).ToUpper()
    };
}

<style>

    /* =========================================================
           PAGE
        ========================================================= */

    .user-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
    }


    /* =========================================================
           MAIN CARD
        ========================================================= */

    .user-create-card {
        width: 100%;
        height: calc(100vh - var(--topbar-h) - 100px);
        min-height: 500px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }


    /* =========================================================
           FORM
        ========================================================= */

    .user-create-form {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .user-create-head {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

        .user-create-head h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .user-create-head p {
            margin: 3px 0 0;
            font-size: 11px;
            color: var(--text-secondary);
        }


    /* =========================================================
           BODY
        ========================================================= */

    .user-create-body {
        padding: 20px;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .user-create-body::-webkit-scrollbar {
            display: none;
        }


    /* =========================================================
           SECTION
        ========================================================= */

    .user-create-section {
        border-bottom: 1px solid var(--border);
        padding-bottom: 18px;
        margin-bottom: 18px;
    }

        .user-create-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }


    /* =========================================================
           SECTION TITLE
        ========================================================= */

    .user-create-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
    }

        .user-create-section-title i {
            color: var(--purple);
            font-size: 14px;
        }

        .user-create-section-title span {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-primary);
        }


    /* =========================================================
           GRID
        ========================================================= */

    .user-create-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }


    /* =========================================================
           FORM GROUP
        ========================================================= */

    .user-create-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .user-create-group.wide {
            grid-column: 1 / -1;
        }

        .user-create-group label {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .35px;
        }

            .user-create-group label .required {
                color: #ef4444;
            }


    /* =========================================================
           INPUT / SELECT
        ========================================================= */

    .user-create-input,
    .user-create-select {
        width: 100%;
        height: 38px;
        padding: 0 11px;
        border: 1px solid var(--border);
        border-radius: 5px;
        background: var(--input-bg);
        color: var(--text-primary);
        font-size: 12px;
        outline: none;
    }

        .user-create-input:focus,
        .user-create-select:focus {
            border-color: var(--purple);
        }

        .user-create-input[readonly] {
            opacity: .75;
            cursor: not-allowed;
        }


    /* =========================================================
           VALIDATION
        ========================================================= */

    .user-create-validation {
        color: #ef4444;
        font-size: 10px;
    }


    /* =========================================================
           EMPLOYEE PREVIEW
        ========================================================= */

    .employee-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
    }

    .employee-preview-avatar {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient( 135deg, #7c3aed, #9333ea );
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .employee-preview-name {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .employee-preview-code {
        margin-top: 2px;
        font-size: 10px;
        color: var(--text-muted);
    }


    /* =========================================================
           PASSWORD
        ========================================================= */

    .user-create-password-wrap {
        position: relative;
    }

        .user-create-password-wrap input {
            padding-right: 40px;
        }

    .user-create-password-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: var(--text-muted);
        cursor: pointer;
    }


    /* =========================================================
           FOOTER
        ========================================================= */

    .user-create-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 18px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
        background: var(--card-bg);
    }


    /* =========================================================
           CANCEL BUTTON
        ========================================================= */

    .user-create-cancel {
        height: 34px;
        padding: 0 14px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-secondary);
        border-radius: 5px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }


    /* =========================================================
           SAVE BUTTON
        ========================================================= */

    .user-create-save {
        height: 34px;
        padding: 0 16px;
        border: none;
        background: var(--purple);
        color: #fff;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .user-create-save:hover {
            background: #6d28d9;
        }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 800px) {

        .user-create-grid {
            grid-template-columns: 1fr;
        }

        .user-create-group.wide {
            grid-column: auto;
        }

        .user-create-card {
            height: calc(100vh - var(--topbar-h) - 60px);
        }
    }

</style>


<div class="user-create-page">

    <div class="user-create-card">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="user-create-head">

            <h3>
                Create User
            </h3>

            <p>
                Create a login account and assign access to an employee.
            </p>

        </div>


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-action="Create"
              method="post"
              id="createUserForm"
              class="user-create-form">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 BODY
            ================================================== -->

            <div class="user-create-body">

                <div asp-validation-summary="ModelOnly"
                     class="user-create-validation"
                     style="margin-bottom:14px;">
                </div>


                <!-- =============================================
                     EMPLOYEE INFORMATION
                ============================================== -->

                <div class="user-create-section">

                    <div class="user-create-section-title">

                        <i class="bi bi-person"></i>

                        <span>
                            Employee Information
                        </span>

                    </div>


                    <!-- IMPORTANT:
                         Employee dropdown removed.
                         EmployeeId comes from the Index page.
                    -->

                    <input type="hidden"
                           asp-for="EmployeeId" />


                    <div class="user-create-grid">


                        <!-- =====================================
                             EMPLOYEE
                        ====================================== -->

                        <div class="user-create-group wide">

                            <label>
                                Employee
                            </label>


                            <div class="employee-preview">

                                <div class="employee-preview-avatar">
                                    @initials
                                </div>


                                <div>

                                    <div class="employee-preview-name">
                                        @employeeName
                                    </div>

                                    <div class="employee-preview-code">
                                        @employeeCode
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =====================================
                             OFFICIAL EMAIL
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Official Email
                            </label>

                            <input asp-for="OfficialEmail"
                                   class="user-create-input"
                                   readonly />

                        </div>


                        <!-- =====================================
                             USERNAME
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Username
                                <span class="required">*</span>
                            </label>

                            <input asp-for="UserName"
                                   class="user-create-input"
                                   autocomplete="off" />

                            <span asp-validation-for="UserName"
                                  class="user-create-validation">
                            </span>

                        </div>


                    </div>

                </div>


                <!-- =============================================
                     ACCESS & ROLE
                ============================================== -->

                <div class="user-create-section">

                    <div class="user-create-section-title">

                        <i class="bi bi-shield-lock"></i>

                        <span>
                            Access & Role
                        </span>

                    </div>


                    <div class="user-create-grid">


                        <!-- =====================================
                             ROLE
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Role
                                <span class="required">*</span>
                            </label>

                            <select asp-for="Role"
                                    asp-items="Model.Roles"
                                    class="user-create-select">

                                <option value="">
                                    Select Role
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="user-create-validation">
                            </span>

                        </div>


                        <!-- =====================================
                             COMPANY
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Company Access
                                <span class="required">*</span>
                            </label>

                            <select asp-for="CompanyId"
                                    asp-items="Model.Companies"
                                    id="companyId"
                                    class="user-create-select">

                                <option value="">
                                    Select Company
                                </option>

                            </select>

                            <span asp-validation-for="CompanyId"
                                  class="user-create-validation">
                            </span>

                        </div>


                        <!-- =====================================
                             BRANCH
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Branch
                            </label>

                            <select asp-for="BranchId"
                                    asp-items="Model.Branches"
                                    id="branchId"
                                    class="user-create-select">

                                <option value="">
                                    Select Branch
                                </option>

                            </select>

                        </div>


                    </div>

                </div>


                <!-- =============================================
                     LOGIN CREDENTIALS
                ============================================== -->

                <div class="user-create-section">

                    <div class="user-create-section-title">

                        <i class="bi bi-key"></i>

                        <span>
                            Login Credentials
                        </span>

                    </div>


                    <div class="user-create-grid">


                        <!-- =====================================
                             PASSWORD
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Password
                                <span class="required">*</span>
                            </label>

                            <div class="user-create-password-wrap">

                                <input asp-for="Password"
                                       id="password"
                                       type="password"
                                       class="user-create-input"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="user-create-password-toggle"
                                        onclick="togglePassword('password', this)">

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="user-create-validation">
                            </span>

                        </div>


                        <!-- =====================================
                             CONFIRM PASSWORD
                        ====================================== -->

                        <div class="user-create-group">

                            <label>
                                Confirm Password
                                <span class="required">*</span>
                            </label>

                            <div class="user-create-password-wrap">

                                <input asp-for="ConfirmPassword"
                                       id="confirmPassword"
                                       type="password"
                                       class="user-create-input"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="user-create-password-toggle"
                                        onclick="togglePassword('confirmPassword', this)">

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="user-create-validation">
                            </span>

                        </div>


                    </div>

                </div>


            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="user-create-footer">

                <a asp-action="Index"
                   class="user-create-cancel">

                    Cancel

                </a>


                <button type="submit"
                        class="user-create-save">

                    <i class="bi bi-check2-circle"></i>

                    Create User

                </button>

            </div>


        </form>

    </div>

</div>


<script>

    /* =========================================================
       COMPANY → BRANCH
    ========================================================== */

    document
        .getElementById("companyId")
        ?.addEventListener("change", async function () {

            const companyId = this.value;

            const branch =
                document.getElementById("branchId");


            branch.innerHTML =
                '<option value="">Select Branch</option>';


            if (!companyId) {
                return;
            }


            try {

                const response =
                    await fetch(
                        '@Url.Action("GetBranchesForCompany", "UserMaster")?companyId='
                        + companyId
                    );


                const data =
                    await response.json();


                if (!data.success) {
                    return;
                }


                data.branches.forEach(function (item) {

                    const option =
                        document.createElement("option");


                    option.value =
                        item.id;


                    option.textContent =
                        item.name;


                    branch.appendChild(option);

                });

            }
            catch (error) {

                console.error(
                    "Branch loading error:",
                    error
                );

            }

        });


    /* =========================================================
       PASSWORD VISIBILITY
    ========================================================== */

    function togglePassword(
        inputId,
        button
    ) {

        const input =
            document.getElementById(inputId);

        const icon =
            button.querySelector("i");


        if (input.type === "password") {

            input.type = "text";

            icon.className =
                "bi bi-eye-slash";

        }
        else {

            input.type = "password";

            icon.className =
                "bi bi-eye";

        }

    }

</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}