@model VeltriQ.ViewModels.HR.ProbationAssessmentViewModel

@{
    ViewData["Title"] = "My Probation Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool noAssessment = Model?.Master == null || Model.Master.AssessmentId == 0;
    var master = Model?.Master ?? new VeltriQ.Models.HR.ProbationAssessment.ProbationAssessmentMasterModel();
}

<style>
    .assessment-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .assessment-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .assessment-card-top {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hover-bg);
        flex-shrink: 0;
    }

        .assessment-card-top h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

    .assessment-body {
        overflow-y: auto;
        padding: 24px;
        flex: 1;
        scrollbar-width: none;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .assessment-body::-webkit-scrollbar {
            display: none;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px 18px;
        margin-bottom: 10px;
    }

    .info-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .info-group label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-secondary);
        }

        .info-group span {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .status-inprogress {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
    }

    .status-completed {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .sig-box {
        border: 1.5px dashed var(--border);
        border-radius: 6px;
        padding: 12px;
        text-align: center;
        background: var(--input-bg);
        font-size: 12.5px;
        color: var(--text-secondary);
        cursor: pointer;
        transition: all 0.2s;
    }

        .sig-box.signed {
            border-style: solid;
            border-color: #22c55e;
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
            font-weight: 600;
            cursor: default;
        }

        .sig-box:hover:not(.signed) {
            border-color: var(--purple);
            color: var(--purple);
        }

    .empty-state {
        padding: 50px;
        text-align: center;
        color: var(--text-muted);
        font-style: italic;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@Html.AntiForgeryToken()

<div class="assessment-page">
    <div class="assessment-card">
        <div class="assessment-card-top">
            <h3>My Probation Assessment Portfolio</h3>
            <span style="font-size: 11px; color: var(--text-secondary);">Review feedback, milestone evaluation scores, and provide electronic sign-off.</span>
        </div>

        <div class="assessment-body">
            @if (noAssessment)
            {
                <div class="empty-state">
                    <i class="bi bi-journal-x" style="font-size: 36px; display: block; margin-bottom: 8px;"></i>
                    No probation assessment records found or assigned for your profile yet.
                </div>
            }
            else
            {
                <input type="hidden" id="assessmentId" value="@master.AssessmentId" />

                <div class="info-grid" style="background: var(--hover-bg); padding: 16px; border: 1px solid var(--border);">
                    <div class="info-group">
                        <label>Employee No</label>
                        <span style="font-family: monospace;">@master.EmployeeNo</span>
                    </div>
                    <div class="info-group">
                        <label>Probation Window</label>
                        <span>@(master.ProbationStartDate.HasValue? master.ProbationStartDate.Value.ToString("dd MMM yyyy") : "—") to @(master.ProbationEndDate.HasValue? master.ProbationEndDate.Value.ToString("dd MMM yyyy") : "—")</span>
                    </div>
                    <div class="info-group">
                        <label>Overall Status</label>
                        <div>
                            @{
                                var badgeClass = master.OverallStatus == "Completed" ? "status-completed" : (master.OverallStatus == "InProgress" ? "status-inprogress" : "status-pending");
                            }
                            <span class="badge-status @badgeClass">@master.OverallStatus</span>
                        </div>
                    </div>
                    <div class="info-group">
                        <label>Final Decision</label>
                        <span style="font-weight: 700; color: var(--purple);">@(master.FinalDecision ?? "Pending Evaluation")</span>
                    </div>
                </div>

                @if (Model.Checkpoints != null && Model.Checkpoints.Any())
                {
                    <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--text-secondary); margin-top: 5px;">
                        Evaluation Checkpoint Milestones
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 14px;">
                        @foreach (var cp in Model.Checkpoints)
                        {
                            <div style="border: 1px solid var(--border); border-radius: 6px; padding: 16px; background: var(--card-bg);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
                                    <div>
                                        <span style="font-weight: 700; font-size: 13.5px;">Checkpoint @cp.CheckpointNo: @cp.CheckpointLabel</span>
                                        <span style="font-size: 11px; color: var(--text-secondary); margin-left: 8px;">Due: @(cp.ScheduledDate.HasValue? cp.ScheduledDate.Value.ToString("dd MMM yyyy") : "—")</span>
                                    </div>
                                    <div>
                                        <span class="badge-status @(cp.Status == "Completed" ? "status-completed" : "status-inprogress")">@cp.Status</span>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 12px;">
                                    <div>
                                        <label style="font-size: 10.5px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase;">Strengths Observed</label>
                                        <p style="font-size: 12.5px; margin-top: 3px; color: var(--text-primary);">@(cp.Strengths ?? "—")</p>
                                    </div>
                                    <div>
                                        <label style="font-size: 10.5px; font-weight: 700; color: var(--text-secondary); text-transform: uppercase;">Areas of Development</label>
                                        <p style="font-size: 12.5px; margin-top: 3px; color: var(--text-primary);">@(cp.DevelopmentAreas ?? "—")</p>
                                    </div>
                                </div>

                                <div style="border-top: 1px dashed var(--border); padding-top: 12px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; align-items: center;">
                                    <div style="font-size: 12px;">
                                        <strong>Manager Sign-off:</strong>
                                        <span style="color: @(cp.SigManager ? "#22c55e" : "#f59e0b");">@(cp.SigManager ? "Signed" : "Pending")</span>
                                    </div>
                                    <div style="font-size: 12px;">
                                        <strong>HR Review:</strong>
                                        <span style="color: @(cp.SigHR ? "#22c55e" : "#f59e0b");">@(cp.SigHR ? "Reviewed" : "Pending")</span>
                                    </div>
                                    <div>
                                        @if (cp.SigEmployee)
                                        {
                                            <div class="sig-box signed">
                                                <i class="bi bi-check-circle-fill"></i> Acknowledged & Signed
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sig-box" onclick="acknowledgeCheckpoint(@cp.DetailId)">
                                                <i class="bi bi-pencil"></i> Click here to Acknowledge
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    async function acknowledgeCheckpoint(detailId) {
        const confirmResult = await Swal.fire({
            title: 'Acknowledge Assessment?',
            text: 'Do you confirm that you have reviewed this evaluation checkpoint?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#ef4444',
            confirmButtonText: 'Yes, acknowledge!'
        });

        if (!confirmResult.isConfirmed) return;

        const assessmentId = document.getElementById('assessmentId').value;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch('/ProbationAssessment/SaveEmployeeSignature', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `detailId=${detailId}&assessmentId=${assessmentId}&employeeComments=Acknowledged by employee.`
            });

            const result = await res.json();
            if (result.success) {
                Swal.fire({ icon: 'success', title: 'Acknowledged!', text: result.message, timer: 1200, showConfirmButton: false });
                setTimeout(() => location.reload(), 1200);
            } else {
                Swal.fire({ icon: 'error', title: 'Action Denied', text: result.message, confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Acknowledgement error:', err);
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not complete electronic acknowledgement.', confirmButtonColor: '#7c3aed' });
        }
    }
</script>