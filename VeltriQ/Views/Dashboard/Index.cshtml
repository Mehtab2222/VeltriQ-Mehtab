@{
    ViewData["Title"] = "HRMS Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dash-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 20px;
    }

    /* MODULE NAV PILL TABS BAR */
    .dash-module-tabs {
        display: flex;
        gap: 6px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 4px;
        border-radius: 6px;
        overflow-x: auto;
        scrollbar-width: none;
        flex-shrink: 0;
    }

        .dash-module-tabs::-webkit-scrollbar {
            display: none;
        }

    .dash-tab-btn {
        height: 34px;
        padding: 0 16px;
        border-radius: 5px;
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-size: 11.5px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

        .dash-tab-btn:hover {
            background: var(--hover-bg);
            color: var(--text-primary);
        }

        .dash-tab-btn.active {
            background: var(--purple);
            color: #fff;
        }

    .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 16px;
        height: 16px;
        padding: 0 4px;
        border-radius: 8px;
        background: rgba(255,255,255,0.18);
        font-size: 9.5px;
        font-weight: 800;
    }

    .dash-tab-btn:not(.active) .tab-count {
        background: var(--hover-bg);
        color: var(--text-secondary);
    }

    /* METRICS STATS CARDS */
    .dash-metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 12px;
    }

        .dash-metrics-grid.dense {
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s;
    }

        .stat-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: var(--accent, var(--purple));
        }

        .stat-card:hover {
            border-color: var(--purple);
            transform: translateY(-1px);
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
    }

    .stat-icon {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        background: var(--hover-bg);
        color: var(--accent, var(--purple));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .stat-value {
        font-family: 'Manrope', sans-serif;
        font-size: 25px;
        font-weight: 800;
        color: var(--text-primary);
        line-height: 1.1;
    }

    .stat-footer {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--text-muted);
    }

    .stat-trend-up {
        color: #22c55e;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 2px;
    }

    .stat-bar-track {
        margin-top: 4px;
        height: 4px;
        border-radius: 2px;
        background: var(--hover-bg);
        overflow: hidden;
    }

    .stat-bar-fill {
        height: 100%;
        border-radius: 2px;
        background: var(--accent, var(--purple));
    }

    /* SPLIT GRIDS */
    .dash-split-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 14px;
    }

        .dash-split-grid.even {
            grid-template-columns: 1fr 1fr;
        }

        .dash-split-grid.thirds {
            grid-template-columns: 1.3fr 1fr 1fr;
        }

    @@media (max-width: 1100px) {
        .dash-split-grid,
        .dash-split-grid.even,
        .dash-split-grid.thirds {
            grid-template-columns: 1fr;
        }
    }

    .dash-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .dash-card-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--card-bg);
    }

        .dash-card-header h4 {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }

        .dash-card-header span {
            font-size: 11px;
            color: var(--text-muted);
        }

        .dash-card-header a.link-out {
            font-size: 11px;
            color: var(--purple);
            text-decoration: none;
            font-weight: 700;
        }

    .dash-card-body {
        padding: 18px 16px;
    }

    /* ===== PURE CSS HORIZONTAL BAR CHART ===== */
    .hbar-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .hbar-row {
        display: grid;
        grid-template-columns: 150px 1fr 32px;
        align-items: center;
        gap: 10px;
    }

    .hbar-label {
        font-size: 11.5px;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .hbar-track {
        height: 10px;
        border-radius: 5px;
        background: var(--hover-bg);
        overflow: hidden;
    }

    .hbar-fill {
        height: 100%;
        border-radius: 5px;
        width: var(--pct, 0%);
        background: var(--bar-color, var(--purple));
    }

    .hbar-value {
        font-family: 'Manrope', sans-serif;
        font-size: 12px;
        font-weight: 800;
        color: var(--text-primary);
        text-align: right;
    }

    /* ===== PURE CSS VERTICAL BAR CHART ===== */
    .vbar-chart {
        display: flex;
        align-items: flex-end;
        gap: 16px;
        height: 160px;
        padding: 0 4px;
        border-bottom: 1px solid var(--border);
    }

    .vbar-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 1;
        height: 100%;
        justify-content: flex-end;
    }

    .vbar-value {
        font-family: 'Manrope', sans-serif;
        font-size: 10.5px;
        font-weight: 800;
        color: var(--text-primary);
    }

    .vbar-fill {
        width: 26px;
        border-radius: 4px 4px 0 0;
        background: var(--purple);
        height: var(--h, 10%);
    }

    .vbar-labels {
        display: flex;
        gap: 16px;
        padding-top: 8px;
    }

    .vbar-label {
        flex: 1;
        font-size: 10px;
        color: var(--text-secondary);
        text-align: center;
    }

    /* ===== PURE CSS DONUT CHART ===== */
    .donut-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6px 0 2px;
    }

    .donut {
        width: 128px;
        height: 128px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        .donut::before {
            content: "";
            position: absolute;
            width: 74px;
            height: 74px;
            border-radius: 50%;
            background: var(--card-bg);
        }

    .donut-center {
        position: relative;
        z-index: 1;
        text-align: center;
    }

        .donut-center .n {
            font-family: 'Manrope', sans-serif;
            font-size: 18px;
            font-weight: 800;
            color: var(--text-primary);
            display: block;
        }

        .donut-center .l {
            font-size: 9px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .4px;
        }

    .chart-legend {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 10px 16px 16px;
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11.5px;
        color: var(--text-secondary);
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        flex-shrink: 0;
    }

    .legend-row b {
        color: var(--text-primary);
        margin-left: auto;
        font-family: 'Manrope', sans-serif;
    }

    /* TABLES & BADGES */
    .dash-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dash-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            border-bottom: 1px solid var(--border);
            background: var(--hover-bg);
        }

        .dash-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12px;
            vertical-align: middle;
        }

        .dash-table tbody tr:last-child td {
            border-bottom: none;
        }

        .dash-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .emp-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
    }

    .emp-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--hover-bg);
        color: var(--purple);
        font-size: 9.5px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cell-sub {
        display: block;
        font-size: 10px;
        color: var(--text-muted);
        margin-top: 1px;
    }

    .mini-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 18px;
        padding: 0 7px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .mini-badge::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

    .badge-success {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .badge-warning {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .badge-info {
        background: rgba(124, 58, 237, 0.15);
        color: var(--purple);
    }

    /* QUICK ACTIONS MATRIX */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        padding: 14px;
    }

    .quick-action-btn {
        background: var(--input-bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 12px;
        text-align: left;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 4px;
        color: var(--text-primary);
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .quick-action-btn:hover {
            border-color: var(--purple);
            background: var(--hover-bg);
            transform: translateY(-1px);
        }

        .quick-action-btn i {
            font-size: 16px;
            color: var(--purple);
        }

        .quick-action-btn span {
            font-size: 12px;
            font-weight: 700;
        }

        .quick-action-btn p {
            font-size: 10.5px;
            color: var(--text-secondary);
            margin: 0;
        }

    /* TODAY'S FLOOR - who's out avatar strip */
    .pulse-strip {
        display: flex;
        gap: 0;
        padding: 14px 16px;
        overflow-x: auto;
    }

    .pulse-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        min-width: 66px;
        border-right: 1px solid var(--border);
        padding: 0 12px;
    }

        .pulse-item:last-child {
            border-right: none;
        }

    .pulse-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        color: var(--purple);
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pulse-name {
        font-size: 9.5px;
        color: var(--text-secondary);
        white-space: nowrap;
    }

    .dash-note {
        padding: 14px 16px;
        font-size: 12px;
        color: var(--text-secondary);
        border-top: 1px solid var(--border);
        line-height: 1.6;
    }

        .dash-note b {
            color: var(--text-primary);
        }

    /* TAB CONTENT PANELS */
    .dash-tab-pane {
        display: none;
        flex-direction: column;
        gap: 14px;
    }

        .dash-tab-pane.active {
            display: flex;
        }
</style>

<div class="dash-page">

    <div class="dash-module-tabs">
        <button class="dash-tab-btn active" onclick="switchDashboardTab(event, 'generalDashboard')">
            <i class="bi bi-grid"></i> General Overview
        </button>
        <button class="dash-tab-btn" onclick="switchDashboardTab(event, 'leaveDashboard')">
            <i class="bi bi-calendar2-check"></i> Leave & Time Off <span class="tab-count">4</span>
        </button>
        <button class="dash-tab-btn" onclick="switchDashboardTab(event, 'recruitmentDashboard')">
            <i class="bi bi-briefcase"></i> Recruitment & Talent <span class="tab-count">12</span>
        </button>
        <button class="dash-tab-btn" onclick="switchDashboardTab(event, 'trainingDashboard')">
            <i class="bi bi-mortarboard"></i> Training & Development <span class="tab-count">3</span>
        </button>
        <button class="dash-tab-btn" onclick="switchDashboardTab(event, 'financeDashboard')">
            <i class="bi bi-wallet2"></i> Payroll & Finance <span class="tab-count">14</span>
        </button>
    </div>

    <!-- ================= GENERAL OVERVIEW ================= -->
    <div id="generalDashboard" class="dash-tab-pane active">
        <div class="dash-metrics-grid">
            <div class="stat-card" style="--accent:var(--purple);">
                <div class="stat-header"><span class="stat-title">Total Employees</span><div class="stat-icon"><i class="bi bi-people"></i></div></div>
                <div class="stat-value">248</div>
                <div class="stat-footer"><span class="stat-trend-up"><i class="bi bi-arrow-up-short"></i> +4.2%</span> from last month</div>
            </div>
            <div class="stat-card" style="--accent:#22c55e;">
                <div class="stat-header"><span class="stat-title">Active Openings</span><div class="stat-icon"><i class="bi bi-briefcase"></i></div></div>
                <div class="stat-value">18</div>
                <div class="stat-footer"><span class="stat-trend-up"><i class="bi bi-arrow-up-short"></i> +2 new</span> this week</div>
            </div>
            <div class="stat-card" style="--accent:#f59e0b;">
                <div class="stat-header"><span class="stat-title">Pending Approvals</span><div class="stat-icon"><i class="bi bi-clock-history"></i></div></div>
                <div class="stat-value">7</div>
                <div class="stat-footer"><span style="color:#f59e0b; font-weight:700;"><i class="bi bi-exclamation-circle"></i> Action required</span></div>
            </div>
            <div class="stat-card" style="--accent:var(--purple);">
                <div class="stat-header"><span class="stat-title">Attendance Rate</span><div class="stat-icon"><i class="bi bi-person-check"></i></div></div>
                <div class="stat-value">96.8%</div>
                <div class="stat-bar-track"><div class="stat-bar-fill" style="width:96.8%;"></div></div>
                <div class="stat-footer"><span class="stat-trend-up"><i class="bi bi-arrow-up-short"></i> +0.5%</span> stable today</div>
            </div>
        </div>

        <div class="dash-split-grid">
            <div class="dash-card">
                <div class="dash-card-header"><h4>Today's Floor</h4><span>Who's out, at a glance</span></div>
                <div class="pulse-strip">
                    <div class="pulse-item"><div class="pulse-avatar">EJ</div><div class="pulse-name">Elizabeth</div></div>
                    <div class="pulse-item"><div class="pulse-avatar">TW</div><div class="pulse-name">Thomas</div></div>
                    <div class="pulse-item"><div class="pulse-avatar">SJ</div><div class="pulse-name">Sarah</div></div>
                    <div class="pulse-item"><div class="pulse-avatar">RK</div><div class="pulse-name">Ravi</div></div>
                    <div class="pulse-item"><div class="pulse-avatar">MN</div><div class="pulse-name">Meera</div></div>
                </div>
                <div class="dash-note">
                    <b>5 employees on leave today.</b> Select <b>Leave & Time Off</b> above to filter specific department streams and review the approval queue.
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-card-header"><h4>Quick Operations</h4><span>Shortcuts</span></div>
                <div class="quick-actions-grid">
                    <a href="/Leave/Requests" class="quick-action-btn">
                        <i class="bi bi-calendar-check"></i><span>Leave Requests</span><p>Review & approve time off</p>
                    </a>
                    <a href="/Onboarding/Index" class="quick-action-btn">
                        <i class="bi bi-person-plus"></i><span>Onboarding</span><p>Manage new hires</p>
                    </a>
                    <a href="/MyInterviews/Index" class="quick-action-btn">
                        <i class="bi bi-star"></i><span>Interviews</span><p>Feedback & ratings</p>
                    </a>
                    <a href="/Leave/Index" class="quick-action-btn">
                        <i class="bi bi-gear"></i><span>Leave Rules</span><p>Configure quotas</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= LEAVE & TIME OFF ================= -->
    <div id="leaveDashboard" class="dash-tab-pane">
        <div class="dash-metrics-grid">
            <div class="stat-card" style="--accent:#f59e0b;">
                <div class="stat-header"><span class="stat-title">Pending Leave Requests</span><div class="stat-icon"><i class="bi bi-hourglass-split"></i></div></div>
                <div class="stat-value">4</div>
                <div class="stat-footer"><span style="color:#f59e0b; font-weight:700;">Needs review</span></div>
            </div>
            <div class="stat-card" style="--accent:#22c55e;">
                <div class="stat-header"><span class="stat-title">Approved This Month</span><div class="stat-icon"><i class="bi bi-check-circle"></i></div></div>
                <div class="stat-value">32</div>
                <div class="stat-footer"><span class="stat-trend-up"><i class="bi bi-arrow-up-short"></i> +12%</span> vs last month</div>
            </div>
            <div class="stat-card" style="--accent:var(--purple);">
                <div class="stat-header"><span class="stat-title">On Leave Today</span><div class="stat-icon"><i class="bi bi-airplane"></i></div></div>
                <div class="stat-value">5</div>
                <div class="stat-footer"><span style="color:var(--text-muted)">Active absence</span></div>
            </div>
            <div class="stat-card" style="--accent:#22c55e;">
                <div class="stat-header"><span class="stat-title">Active Leave Types</span><div class="stat-icon"><i class="bi bi-list-check"></i></div></div>
                <div class="stat-value">4</div>
                <div class="stat-footer"><span style="color:#22c55e; font-weight:700;">Configured</span></div>
            </div>
        </div>

        <div class="dash-split-grid">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h4>Recent Leave Applications</h4>
                    <a href="/Leave/Requests" class="link-out">View All &rarr;</a>
                </div>
                <div style="overflow-x: auto;">
                    <table class="dash-table">
                        <thead>
                            <tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><div class="emp-cell"><span class="emp-avatar">EJ</span>Elizabeth Jackson</div></td>
                                <td>Annual Leave</td>
                                <td>29 Jul — 31 Jul</td>
                                <td style="font-weight: 700;">3.0</td>
                                <td><span class="mini-badge badge-warning">Pending</span></td>
                            </tr>
                            <tr>
                                <td><div class="emp-cell"><span class="emp-avatar">TW</span>Thomas Wright</div></td>
                                <td>Casual Leave</td>
                                <td>29 Jul — 30 Jul</td>
                                <td style="font-weight: 700;">2.0</td>
                                <td><span class="mini-badge badge-warning">Pending</span></td>
                            </tr>
                            <tr>
                                <td><div class="emp-cell"><span class="emp-avatar">SJ</span>Sarah Jenkins</div></td>
                                <td>Sick Leave</td>
                                <td>15 Jul — 16 Jul</td>
                                <td style="font-weight: 700;">2.0</td>
                                <td><span class="mini-badge badge-success">Approved</span></td>
                            </tr>
                            <tr>
                                <td><div class="emp-cell"><span class="emp-avatar">RK</span>Ravi Kumar</div></td>
                                <td>Casual Leave</td>
                                <td>01 Aug — 01 Aug</td>
                                <td style="font-weight: 700;">1.0</td>
                                <td><span class="mini-badge badge-success">Approved</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dash-card">
                <div class="dash-card-header"><h4>Quick Operations</h4><span>Shortcuts</span></div>
                <div class="quick-actions-grid">
                    <a href="/Leave/Requests" class="quick-action-btn">
                        <i class="bi bi-calendar-check"></i><span>Leave Requests</span><p>Review & approve time off</p>
                    </a>
                    <a href="/Onboarding/Index" class="quick-action-btn">
                        <i class="bi bi-person-plus"></i><span>Onboarding</span><p>Manage new hires</p>
                    </a>
                    <a href="/MyInterviews/Index" class="quick-action-btn">
                        <i class="bi bi-star"></i><span>Interviews</span><p>Feedback & ratings</p>
                    </a>
                    <a href="/Leave/Index" class="quick-action-btn">
                        <i class="bi bi-gear"></i><span>Leave Rules</span><p>Configure quotas</p>
                    </a>
                </div>
            </div>
        </div>

        <div class="dash-split-grid even">
            <div class="dash-card">
