@model IEnumerable<VeltriQ.Models.HR.Attendance.WeeklyOffPolicy>

@{
    ViewData["Title"] = "Weekly Off Policies";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .weekly-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .weekly-header-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
    }

    .weekly-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
    }

        .weekly-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    .weekly-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .weekly-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .weekly-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .weekly-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box input {
            width: 100%;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 12px 0 32px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .search-box input:focus {
                border-color: var(--purple);
            }

        .search-box i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .weekly-table {
        width: 100%;
        border-collapse: collapse;
    }

        .weekly-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .weekly-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .weekly-table tbody tr:hover {
            background: var(--hover-bg);
        }

    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .status-inactive {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.2s;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@Html.AntiForgeryToken()

<div class="weekly-page">
    <div class="weekly-header-bar">
        <a asp-action="Create" class="weekly-add-btn">
            <i class="bi bi-plus-lg"></i> Create Weekly Off Policy
        </a>
    </div>

    <div class="weekly-card">
        <div class="weekly-card-top">
            <div class="weekly-card-title">
                <h3>Weekly Off Policy Master</h3>
                <p>Manage standard weekend patterns, company-specific day offs, and recurring schedules.</p>
            </div>
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="tableSearchKeyword" placeholder="Search policies..." onkeyup="filterPolicies()" autocomplete="off" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="weekly-table" id="policyTable">
                <thead>
                    <tr>
                        <th>Policy Code</th>
                        <th>Policy Name</th>
                        <th>Company</th>
                        <th style="text-align: center;">Default Status</th>
                        <th style="text-align: center;">Status</th>
                        <th style="text-align: right; padding-right: 24px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            var statusClass = x.IsActive ? "status-active" : "status-inactive";
                            var statusText = x.IsActive ? "Active" : "Inactive";
                            <tr class="policy-row" id="policy-row-@x.WeeklyOffPolicyId">
                                <td style="font-weight: 700; font-family: monospace;">@x.PolicyCode</td>
                                <td style="font-weight: 600;" class="searchable-text">@x.PolicyName</td>
                                <td class="searchable-text">@(x.Company?.CompanyName ?? "—")</td>
                                <td style="text-align: center;">
                                    @if (x.IsDefaultPolicy)
                                    {
                                        <span class="badge-status" style="background: rgba(124, 58, 237, 0.15); color: var(--purple);">Default</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td style="text-align: center;">
                                    <span class="badge-status @statusClass" id="badge-@x.WeeklyOffPolicyId">@statusText</span>
                                </td>
                                <td style="text-align: right; padding-right: 24px;">
                                    <div style="display: flex; gap: 4px; justify-content: flex-end;">
                                        <a asp-action="Edit" asp-route-id="@x.WeeklyOffPolicyId" class="action-btn" title="Edit Policy">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <button class="action-btn" onclick="togglePolicyStatus(@x.WeeklyOffPolicyId)" title="Toggle Status" style="color: #f59e0b;">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No weekly off policies configured yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterPolicies() {
        const input = document.getElementById('tableSearchKeyword');
        const filter = input.value.toLowerCase();
        const rows = document.querySelectorAll('#policyTable tbody tr.policy-row');

        rows.forEach(row => {
            const textContent = row.textContent.toLowerCase();
            if (textContent.includes(filter)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    async function togglePolicyStatus(id) {
        const confirmResult = await Swal.fire({
            title: 'Toggle Policy Status?',
            text: 'Are you sure you want to toggle the status of this weekly off policy?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#ef4444',
            confirmButtonText: 'Yes, toggle it!'
        });

        if (!confirmResult.isConfirmed) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(`/WeeklyOffPolicy/ToggleStatus/${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Action Denied', text: result.message, confirmButtonColor: '#7c3aed' });
            }
        } catch (err) {
            console.error('Toggle status error:', err);
        }
    }
</script>