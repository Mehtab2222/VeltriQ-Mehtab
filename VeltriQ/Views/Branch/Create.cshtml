@model VeltriQ.Models.HR.Branch

@{
    ViewData["Title"] = "Create Branch";
}

<style>
    /* ── ULTRA-THIN GLOBAL SCROLLBAR FORCE OVERRIDES ── */
    *::-webkit-scrollbar { width: 4px !important; height: 4px !important; }
    *::-webkit-scrollbar-track { background: transparent !important; }
    *::-webkit-scrollbar-thumb { background: var(--border) !important; border-radius: 10px !important; }
    *::-webkit-scrollbar-thumb:hover { background: var(--purple) !important; }
    * { scrollbar-width: thin !important; scrollbar-color: var(--border) transparent !important; }

    .branch-create-page {
        width: 100%;
        display: flex;
        flex-direction: column;
        padding-top: 16px;
        padding-bottom: 30px;
    }

    /* ── TOPBAR NAVIGATION ACTION ── */
    .branch-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        gap: 16px;
    }

    .branch-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

    .branch-breadcrumb a {
        color: var(--purple);
        text-decoration: none;
        font-weight: 600;
    }

    .branch-breadcrumb i {
        color: var(--text-muted);
        font-size: 10px;
    }

    .branch-breadcrumb span {
        color: var(--text-secondary);
        font-weight: 500;
    }

    .branch-top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── COMPACT SYSTEM BUTTON CONTROLS ── */
    .cancel-btn {
        height: 32px;
        padding: 0 14px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .cancel-btn:hover {
        background: var(--purple);
        color: #fff;
        border-color: var(--purple);
    }

    .save-btn {
        height: 32px;
        padding: 0 16px;
        border: none;
        border-radius: 4px;
        background: var(--purple);
        color: #fff;
        font-size: 11.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .save-btn:hover {
        opacity: 0.9;
    }

    /* ── COMPACT SINGLE CARD MODULE (3 Columns per row) ── */
    .branch-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 20px;
    }

    .branch-card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .col-span-2 {
        grid-column: span 2;
    }

    .col-span-3 {
        grid-column: span 3;
    }

    /* FIELD */
    .form-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .form-field label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    /* INPUT */
    .form-input,
    .form-select {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .form-input:focus,
    .form-select:focus {
        border-color: var(--purple);
    }

    .form-input::placeholder {
        color: var(--text-muted);
    }

    /* RESPONSIVE */
    @@media(max-width: 1024px) {
        .branch-card-grid {
            grid-template-columns: repeat(2, 1fr);
        }
        .col-span-2, .col-span-3 {
            grid-column: span 2;
        }
    }

    @@media(max-width: 640px) {
        .branch-card-grid {
            grid-template-columns: 1fr;
        }
        .col-span-2, .col-span-3 {
            grid-column: span 1;
        }
        .branch-topbar {
            flex-direction: column;
            align-items: flex-start;
        }
        .branch-top-actions {
            width: 100%;
        }
        .cancel-btn,
        .save-btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<div class="branch-create-page">

    <div class="branch-topbar">
        <div class="branch-breadcrumb">
            <a href="/Branch/Index">Branches</a>
            <i class="bi bi-chevron-right"></i>
            <span>Create</span>
        </div>

        <div class="branch-top-actions">
            <a href="/Branch/Index" class="cancel-btn">
                <i class="bi bi-x"></i> Cancel
            </a>

            <button type="submit" form="branchForm" class="save-btn">
                <i class="bi bi-building-add"></i> Save Branch
            </button>
        </div>
    </div>

    <form id="branchForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="branch-master-card">
            <div class="branch-card-grid">

                <div class="form-field">
                    <label>Company *</label>
                    <select asp-for="CompanyId" asp-items="ViewBag.CompanyList" class="form-select">
                        <option value="">Select Company</option>
                    </select>
                </div>

                <div class="form-field">
                    <label>Branch Name *</label>
                    <input asp-for="BranchName" class="form-input" placeholder="Enter branch name" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Branch Code *</label>
                    <input asp-for="BranchCode" class="form-input" placeholder="BR-001" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Email Address</label>
                    <input asp-for="Email" class="form-input" placeholder="branch@company.com" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-input" placeholder="+91 9876543210" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Address Line 1</label>
                    <input asp-for="AddressLine1" class="form-input" placeholder="Street, building name" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Address Line 2</label>
                    <input asp-for="AddressLine2" class="form-input" placeholder="Floor, unit, landmark" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>City</label>
                    <input asp-for="City" class="form-input" placeholder="Enter city" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>State</label>
                    <input asp-for="StateName" class="form-input" placeholder="Enter state" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Country</label>
                    <input asp-for="CountryName" class="form-input" placeholder="Enter country" autocomplete="off" />
                </div>

                <div class="form-field">
                    <label>Postal Code</label>
                    <input asp-for="PostalCode" class="form-input" placeholder="411001" autocomplete="off" />
                </div>

            </div>
        </div>
    </form>
</div>