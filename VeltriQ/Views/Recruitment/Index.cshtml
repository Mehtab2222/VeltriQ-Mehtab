@model IEnumerable<VeltriQ.Models.Recruitment.ManpowerRequest>

@{
    ViewData["Title"] = "Recruitment Requests";
}

<style>
    .recruitment-page {
        width: 100%;
    }

    /* HEADER */
    .recruitment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        gap: 20px;
    }

    .recruitment-header-left h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 4px;
        letter-spacing: -.4px;
    }

    .recruitment-header-left p {
        font-size: 14px;
        color: #94a3b8;
        margin: 0;
    }

    /* BUTTONS */
    .header-actions {
        display: flex;
        gap: 12px;
    }

    .btn-export {
        height: 44px;
        padding: 0 20px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 13px;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-export:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }

    .recruitment-add-btn {
        height: 44px;
        padding: 0 20px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: .2s ease;
        box-shadow: 0 8px 22px rgba(124, 58, 237, .22);
    }

        .recruitment-add-btn:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    /* CARD COMPONENTS */
    .recruitment-card {
        background: rgba(30, 35, 44, .94);
        border: 1px solid rgba(255, 255, 255, .06);
        border-radius: 20px;
        margin-bottom: 24px;
        overflow: hidden;
    }

    .recruitment-card-top {
        padding: 20px 22px;
        border-bottom: 1px solid rgba(255, 255, 255, .05);
    }

    /* INPUTS & SELECTS */
    .modern-input {
        width: 100%;
        height: 44px;
        border-radius: 12px;
        border: 1px solid #2a3441 !important;
        background: #0d1117 !important;
        padding: 0 14px;
        color: #fff !important;
        font-size: 13px;
        outline: none;
    }

        .modern-input:focus {
            border-color: #7c3aed !important;
        }

    .btn-search {
        height: 44px;
        border-radius: 12px;
        background: #7c3aed;
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 13px;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #6d28d9;
        }

    /* TABLE */
    .table-wrapper {
        overflow-x: auto;
    }

    .recruitment-table {
        width: 100%;
        border-collapse: collapse;
    }

        .recruitment-table th {
            text-align: left;
            padding: 16px 20px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            background: transparent;
            border-bottom: 1px solid rgba(255, 255, 255, .05);
        }

        .recruitment-table td {
            padding: 16px 20px;
            border-top: 1px solid rgba(255, 255, 255, .04);
            color: #fff;
            font-size: 13px;
            vertical-align: middle;
        }

        .recruitment-table tbody tr:hover {
            background: rgba(255, 255, 255, .02);
        }

    /* STATUS & BADGE TOKENS */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        padding: 0 12px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

    /* Type Customizations */
    .badge-new {
        background: rgba(59, 130, 246, .14);
        color: #60a5fa;
    }

    .badge-warning {
        background: rgba(245, 158, 11, .14);
        color: #fbbf24;
    }

    .badge-danger {
        background: rgba(239, 68, 68, .14);
        color: #f87171;
    }

    /* Priority Customizations */
    .badge-low {
        background: rgba(148, 163, 184, .12);
        color: #94a3b8;
    }

    .badge-medium {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
    }

    .badge-high {
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
    }

    .badge-urgent {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
    }

    /* Workflow Customizations */
    .badge-draft {
        background: rgba(148, 163, 184, .14);
        color: #cbd5e1;
    }

    .badge-pending {
        background: rgba(245, 158, 11, .14);
        color: #fbbf24;
    }

    .badge-approved {
        background: rgba(34, 197, 94, .14);
        color: #4ade80;
    }

    /* ACTION BUTTON ELEMENTS */
    .action-dropdown-btn {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 6px 16px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s;
    }

        .action-dropdown-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
        }
</style>

<div class="recruitment-page">

    <div class="recruitment-header">
        <div class="recruitment-header-left">
            <h2>Recruitment Requests</h2>
            <p>Manage manpower recruitment requests and personnel pipelines.</p>
        </div>

        <div class="header-actions">
            <button class="btn-export">
                <i class="bi bi-download me-1"></i> Export
            </button>
            <a href="@Url.Action("Create")" class="recruitment-add-btn">
                <i class="bi bi-plus-lg"></i> Create Request
            </a>
        </div>
    </div>

    <div class="recruitment-card">
        <div class="recruitment-card-top">
            <div class="row g-3">
                <div class="col-md-3">
                    <input type="text" class="modern-input" placeholder="Search request code..." />
                </div>

                <div class="col-md-3">
                    <select class="form-select modern-input">
                        <option value="">All Departments</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select class="form-select modern-input">
                        <option value="">All Statuses</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button class="btn-search w-100">
                        <i class="bi bi-search me-1"></i> Search Records
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="recruitment-card">
        <div class="table-wrapper">
            <table class="recruitment-table">
                <thead>
                    <tr>
                        <th>Request Code</th>
                        <th>Request Date</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Type</th>
                        <th>Positions</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 700; color: #fff;">
                                    @item.RequestCode
                                </div>
                            </td>

                            <td>
                                @item.RequestDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <span style="color: #cbd5e1;">@item.DepartmentId</span>
                            </td>

                            <td>
                                <span style="color: #cbd5e1;">@item.DesignationId</span>
                            </td>

                            <td>
                                @if (item.RecruitmentTypeId == 1)
                                {
                                    <span class="status-badge badge-new">New Block</span>
                                }
                                else if (item.RecruitmentTypeId == 2)
                                {
                                    <span class="status-badge badge-warning">Resignation</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-danger">Termination</span>
                                }
                            </td>

                            <td>
                                <div style="font-weight: 600; padding-left: 8px;">@item.NumberOfPositions</div>
                            </td>

                            <td>
                                @if (item.PriorityId == 1)
                                {
                                    <span class="status-badge badge-low">Low</span>
                                }
                                else if (item.PriorityId == 2)
                                {
                                    <span class="status-badge badge-medium">Medium</span>
                                }
                                else if (item.PriorityId == 3)
                                {
                                    <span class="status-badge badge-high">High</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-urgent">Urgent</span>
                                }
                            </td>

                            <td>
                                @if (item.StatusId == 1)
                                {
                                    <span class="status-badge badge-draft">Draft</span>
                                }
                                else if (item.StatusId == 2)
                                {
                                    <span class="status-badge badge-pending">Pending</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-approved">Approved</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="dropdown d-inline-block">
                                    <button class="action-dropdown-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                        Manage
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" style="background-color: #1e232c; border-color: rgba(255,255,255,0.05);">
                                        <li><a class="dropdown-item" href="#">View Details</a></li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Recruitment"
                                               asp-action="Edit"
                                               asp-route-id="@item.ManpowerRequestId">
                                                Edit Record
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.05);"></li>
                                        <li><a class="dropdown-item text-danger" href="#">Delete Request</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>