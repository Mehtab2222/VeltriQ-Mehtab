@model IEnumerable<VeltriQ.Models.HR.AssetMaster>

@{
    ViewData["Title"] = "Asset Master";
}

<style>
    .asset-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .asset-header {
        display: flex;
        justify-content: flex-end; /* Aligns button to right cleanly without big text */
        align-items: center;
        margin-bottom: 12px; /* Reduced to push card up */
    }

    /* ── COMPACT ADD BUTTON ── */
    .asset-add-btn {
        height: 34px; /* Scaled down height */
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px; /* Slightly smaller typography */
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
    }

        .asset-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .asset-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        /* Strict max-height constraint calculated based on remaining viewport space */
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .asset-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px; /* Compressed padding */
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .asset-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .asset-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── SEARCH BAR ── */
    .asset-search {
        width: 280px;
        position: relative;
    }

        .asset-search input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .asset-search input:focus {
                border-color: var(--purple);
            }

        .asset-search i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        /* Invisible scrollbars for modern browsers */
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }

        .table-wrapper::-webkit-scrollbar {
            display: none; /* Chrome, Safari, Opera */
        }

    .asset-table {
        width: 100%;
        border-collapse: collapse;
    }

        .asset-table th {
            text-align: left;
            padding: 10px 16px; /* Compact padding */
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .asset-table td {
            padding: 8px 16px; /* Significantly reduced row height */
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .asset-table tbody tr {
            transition: background-color .1s ease;
        }

            .asset-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── COMPACT IDENTITY PLATFORMS ── */
    .asset-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .asset-avatar {
        width: 32px; /* Smaller avatars */
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 11px;
        flex-shrink: 0;
    }

    .asset-name {
        font-weight: 600;
        margin-bottom: 1px;
        line-height: 1.2;
    }

    .asset-profile-link {
        color: var(--text-primary);
        text-decoration: none;
    }

        .asset-profile-link:hover {
            color: var(--purple);
        }

    .asset-code {
        font-size: 10.5px;
        color: var(--text-muted);
        line-height: 1;
    }

    /* ── BADGES & CONTROLS ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .status-serial {
        background: rgba(59, 130, 246, 0.12);
        color: #3b82f6;
    }

    .status-returnable {
        background: rgba(34, 197, 94, .12);
        color: #22c55e;
    }

    .status-nonreturnable {
        background: rgba(239, 68, 68, .12);
        color: #ef4444;
    }

    .table-actions {
        display: flex;
        gap: 4px;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.delete-btn {
            color: #ef4444;
        }

            .action-btn.delete-btn:hover {
                background: #ef4444;
                color: #fff;
            }
</style>

<div class="asset-page">

    <div class="asset-header">
        <a href="/AssetMaster/Create" class="asset-add-btn">
            <i class="bi bi-plus-lg"></i>
            Add Asset
        </a>
    </div>

    <div class="asset-card">

        <div class="asset-card-top">
            <div class="asset-card-title">
                <h3>Asset Directory</h3>
                <p>Total Records: @Model.Count()</p>
            </div>

            <div class="asset-search">
                <i class="bi bi-search"></i>
                <input type="text" id="assetSearchInput" placeholder="Search assets..." onkeyup="filterAssetsTable()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="asset-table" id="assetTable">
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Category</th>
                        <th>Brand / Model</th>
                        <th>Serial Required</th>
                        <th>Returnable</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var primaryId = item.GetType().GetProperty("AssetMasterId")?.GetValue(item)
                        ?? item.GetType().GetProperty("Id")?.GetValue(item)
                        ?? "0";

                        <tr>
                            <td>
                                <div class="asset-info">
                                    <div class="asset-avatar">
                                        @(item.AssetName?.Substring(0, Math.Min(2, item.AssetName.Length)).ToUpper())
                                    </div>
                                    <div>
                                        <div class="asset-name">
                                            <a href="/AssetMaster/Details/@primaryId" class="asset-profile-link">
                                                @item.AssetName
                                            </a>
                                        </div>
                                        <div class="asset-code">@item.AssetCode</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="status-badge status-category">@item.AssetCategory</span>
                            </td>
                            <td>@item.BrandName / @item.ModelName</td>
                            <td>
                                @if (item.SerialNumberRequired)
                                {
                                    <span class="status-badge status-serial">Required</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted); font-size: 12px;">No</span>
                                }
                            </td>
                            <td>
                                @if (item.IsReturnable)
                                {
                                    <span class="status-badge status-returnable">Returnable</span>
                                }
                                else
                                {
                                    <span class="status-badge status-nonreturnable">Non Returnable</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    <a href="/AssetMaster/Details/@primaryId" class="action-btn" title="View Details"><i class="bi bi-eye"></i></a>
                                    <a href="/AssetMaster/Edit/@primaryId" class="action-btn" title="Edit Entry"><i class="bi bi-pencil"></i></a>
                                    <a href="/AssetMaster/Delete/@primaryId" class="action-btn delete-btn" title="Delete" onclick="return confirm('Are you sure?')"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterAssetsTable() {
        const input = document.getElementById('assetSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('assetTable');
        const tr = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

        for (let i = 0; i < tr.length; i++) {
            // Evaluates Identity Strings, Categories, Brands, and Models for match validation
            const textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toLowerCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>
