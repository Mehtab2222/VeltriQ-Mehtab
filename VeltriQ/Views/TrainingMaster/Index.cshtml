@model VeltriQ.ViewModels.Training.TrainingMasterViewModel

@{
    ViewData["Title"] = "Training Master";
}

<style>
    .training-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ── HEADER (Optimized & Pushed Up) ── */
    .training-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
        gap: 12px;
    }

    /* ── COMPACT ADD BUTTON ── */
    .training-add-btn {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .2s ease;
        cursor: pointer;
    }

        .training-add-btn:hover {
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── MAX HEIGHT CARD WITH HIDDEN SCROLLBAR ── */
    .training-master-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .training-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .training-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .training-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    /* ── WIDER SEARCH BAR WITH EMBEDDED ICON ── */
    .training-search-wrapper {
        position: relative;
        width: 320px;
    }

        .training-search-wrapper input {
            width: 100%;
            height: 34px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            padding: 0 12px 0 36px;
            color: var(--text-primary);
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .training-search-wrapper input:focus {
                border-color: var(--purple);
            }

        .training-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    /* ── SCROLLABLE CONTAINER WITH HIDDEN SCROLLBAR ── */
    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .training-table {
        width: 100%;
        border-collapse: collapse;
    }

        .training-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .training-table td {
            padding: 6px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .training-table tbody tr {
            transition: background-color .1s ease;
        }

            .training-table tbody tr:hover {
                background: var(--hover-bg);
            }

    /* ── HIGH-DENSITY COMPACT BADGES ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .badge-returnable {
        background: rgba(34, 197, 94, 0.12);
        color: #22c55e;
    }

    .badge-nonreturnable {
        background: rgba(239, 68, 68, 0.12);
        color: #ef4444;
    }

    .col-code {
        font-family: monospace;
        font-weight: 700;
        color: var(--purple);
    }

    /* ── INLINE ACTIONS (EDIT & TOGGLE WORKFLOWS) ── */
    .table-actions {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
        cursor: pointer;
    }

        .action-btn:hover {
            background: var(--purple);
            color: #fff;
        }

        .action-btn.toggle-deactivate-btn {
            color: #22c55e;
        }

            .action-btn.toggle-deactivate-btn:hover {
                background: #ef4444;
                color: #fff;
            }

        .action-btn.toggle-activate-btn {
            color: #ef4444;
        }

            .action-btn.toggle-activate-btn:hover {
                background: #22c55e;
                color: #fff;
            }

    /* ── ✅ CENTERED POPUP MODAL ELEMENT CONFIGURATIONS ── */
    .modal-backdrop-layer {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
    }

    .modal-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        width: 460px;
        max-width: 92vw;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-card-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--hover-bg);
    }

        .modal-card-header h4 {
            margin: 0;
            font-size: 13.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .modal-body-form-fields {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group-block label {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

    .form-deck-input {
        width: 100%;
        height: 36px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 12px;
        font-size: 13px;
        outline: none;
    }

        .form-deck-input:focus {
            border-color: var(--purple);
        }

        .form-deck-input:disabled {
            background: var(--hover-bg);
            opacity: 0.7;
            cursor: not-allowed;
        }

    .form-split-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .checkbox-item-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
        cursor: pointer;
        user-select: none;
    }

        .checkbox-item-row input {
            width: 16px;
            height: 16px;
            accent-color: var(--purple);
            cursor: pointer;
        }

        .checkbox-item-row span {
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-primary);
        }

    .modal-card-footer {
        padding: 12px 16px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-modal-cancel {
        height: 34px;
        padding: 0 14px;
        background: var(--hover-bg);
        border: 1px solid var(--border);
        color: var(--text-primary);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-action-trigger {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

@Html.AntiForgeryToken()

<div class="training-page">

    <div class="training-header">
        <button type="button" class="training-add-btn" onclick="openCreateWorkspaceModal()">
            <i class="bi bi-plus-lg"></i> Add Course
        </button>
    </div>

    <div class="training-master-card">

        <div class="training-card-top">
            <div class="training-card-title">
                <h3>Training Master</h3>
                <p>Total Records: <span id="trainingCounter">0</span></p>
            </div>

            <div class="training-search-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" id="trainingSearchInput" placeholder="Search training courses..." autocomplete="off" oninput="executeClientSideSearchFilter()" />
            </div>
        </div>

        <div class="table-wrapper">
            <table class="training-table" id="trainingGridMatrix">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Training Course Name</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th>Mandatory</th>
                        <th>Assessment</th>
                        <th>Certificate</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="trainingMasterGridBody">
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                            Streaming training database registers...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal-backdrop-layer" id="trainingWorkspaceModalLayer">
    <div class="modal-card">
        <div class="modal-card-header">
            <h4 id="modalHeadingTitle">Add Course</h4>
            <button type="button" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size: 16px;" onclick="closeWorkspaceModal()">✕</button>
        </div>
        <form id="trainingWorkspaceForm" onsubmit="submitTrainingForm(event)">
            <input type="hidden" id="txtTrainingMasterId" name="TrainingMasterId" value="0" />

            <div class="modal-body-form-fields">
                <div class="form-group-block" id="blockTrainingCodeDisplay" style="display: none;">
                    <label>Training Reference Code</label>
                    <input type="text" id="txtTrainingCode" class="form-deck-input" disabled style="opacity: 0.75; font-weight: 700; color: var(--purple);" />
                </div>

                <div class="form-group-block">
                    <label>Training Program Title *</label>
                    <input type="text" id="txtTrainingName" name="TrainingName" class="form-deck-input" placeholder="e.g. Advanced Cybersecurity Frameworks" maxlength="200" required />
                </div>

                <div class="form-group-block">
                    <label>Classification Category Master *</label>
                    <select id="ddlTrainingCategoryId" name="TrainingCategoryId" class="form-deck-input" asp-items="Model.TrainingCategories" required>
                        <option value="">-- Select Category Context --</option>
                    </select>
                </div>

                <div class="form-split-row">
                    <div class="form-group-block">
                        <label>Duration Value *</label>
                        <input type="number" id="txtDuration" name="Duration" class="form-deck-input" min="1" placeholder="e.g. 5" required />
                    </div>
                    <div class="form-group-block">
                        <label>Timeline Type *</label>
                        <select id="ddlDurationType" name="DurationType" class="form-deck-input" asp-items="Model.DurationTypes" required>
                            <option value="">-- Select Scope --</option>
                        </select>
                    </div>
                </div>

                <div class="form-group-block" style="gap: 12px; margin-top: 6px;">
                    <label>Roster Governance Flags</label>

                    <label class="checkbox-item-row" for="chkIsMandatory">
                        <input type="checkbox" id="chkIsMandatory" name="IsMandatory" value="true" />
                        <span>This training is Compulsory / Mandatory</span>
                    </label>

                    <label class="checkbox-item-row" for="chkIsAssessmentRequired">
                        <input type="checkbox" id="chkIsAssessmentRequired" name="IsAssessmentRequired" value="true" />
                        <span>Requires passing Evaluation Assessment</span>
                    </label>

                    <label class="checkbox-item-row" for="chkIsCertificateRequired">
                        <input type="checkbox" id="chkIsCertificateRequired" name="IsCertificateRequired" value="true" />
                        <span>Generates Achievement Qualification Certificate</span>
                    </label>
                </div>
            </div>

            <div class="modal-card-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeWorkspaceModal()">Cancel</button>
                <button type="submit" class="btn-action-trigger" id="btnSubmitForm">Save Training</button>
            </div>
        </form>
    </div>
</div>

<script>
    let localTrainingCache = [];

    document.addEventListener("DOMContentLoaded", function () {
        loadTrainingGridMatrix();
    });

    function openCreateWorkspaceModal() {
        document.getElementById("trainingWorkspaceForm").reset();
        document.getElementById("txtTrainingMasterId").value = "0";
        document.getElementById("blockTrainingCodeDisplay").style.display = "none";

        toggleFormInputStates(false);

        document.getElementById("modalHeadingTitle").innerText = "Add Course";
        document.getElementById("btnSubmitForm").innerText = "Save Training";
        document.getElementById("btnSubmitForm").style.display = "inline-flex";

        document.getElementById("trainingWorkspaceModalLayer").style.display = "flex";
    }

    function closeWorkspaceModal() {
        document.getElementById("trainingWorkspaceModalLayer").style.display = "none";
    }

    function toggleFormInputStates(isDisable) {
        document.getElementById("txtTrainingName").disabled = isDisable;
        document.getElementById("ddlTrainingCategoryId").disabled = isDisable;
        document.getElementById("txtDuration").disabled = isDisable;
        document.getElementById("ddlDurationType").disabled = isDisable;
        document.getElementById("chkIsMandatory").disabled = isDisable;
        document.getElementById("chkIsAssessmentRequired").disabled = isDisable;
        document.getElementById("chkIsCertificateRequired").disabled = isDisable;
    }

    async function loadTrainingGridMatrix() {
        try {
            const res = await fetch('/TrainingMaster/GetTrainingList', { method: 'GET' });
            const result = await res.json();

            localTrainingCache = result.data || [];
            renderTrainingRows(localTrainingCache);
        } catch {
            document.getElementById("trainingMasterGridBody").innerHTML = `<tr><td colspan="8" style="text-align: center; color: red; padding: 24px;">Failed to refresh course data registers.</td></tr>`;
        }
    }

    function renderTrainingRows(dataset) {
        const tbody = document.getElementById("trainingMasterGridBody");
        document.getElementById("trainingCounter").innerText = dataset.length;

        if (dataset.length === 0) {
            tbody.innerHTML = `<tr id="emptyMatrixFallback"><td colspan="8" style="text-align: center; color: var(--text-secondary); font-style: italic; padding: 24px;">No records found.</td></tr>`;
            return;
        }

        tbody.innerHTML = dataset.map(x => `
            <tr>
                <td class="col-code"><code>${x.trainingCode}</code></td>
                <td style="font-weight: 600;">${x.trainingName}</td>
                <td><span class="status-badge badge-category">${x.categoryName}</span></td>
                <td style="font-weight: 600;">${x.duration} ${x.durationText}</td>
                <td>
                    <span class="status-badge ${x.isMandatory ? "badge-returnable" : "badge-nonreturnable"}">
                        ${x.isMandatory ? "Yes" : "No"}
                    </span>
                </td>
                <td>
                    <span class="status-badge ${x.isAssessmentRequired ? "badge-returnable" : "badge-nonreturnable"}">
                        ${x.isAssessmentRequired ? "Yes" : "No"}
                    </span>
                </td>
                <td>
                    <span class="status-badge ${x.isCertificateRequired ? "badge-returnable" : "badge-nonreturnable"}">
                        ${x.isCertificateRequired ? "Yes" : "No"}
                    </span>
                </td>
                <td>
                    <div class="table-actions">
                        <button type="button" class="action-btn" title="View Details" onclick="fireViewDetails(${x.trainingMasterId})"><i class="bi bi-eye"></i></button>
                        <button type="button" class="action-btn" title="Edit Parameters" onclick="fireEditWorkflow(${x.trainingMasterId})"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="action-btn toggle-status ${x.isActive ? "toggle-deactivate-btn" : "toggle-activate-btn"}"
                                title="${x.isActive ? "Deactivate Course" : "Activate Course"}"
                                onclick="executeToggleStatus(${x.trainingMasterId}, ${x.isActive})">
                            <i class="bi ${x.isActive ? "bi-toggle-on" : "bi-toggle-off"}" style="font-size:14px;"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `).join('');
    }

    async function fireViewDetails(id) {
        document.getElementById("trainingWorkspaceForm").reset();
        try {
            const res = await fetch(`/TrainingMaster/GetTrainingMaster/${id}`);
            const result = await res.json();

            if (result.success && result.data) {
                populateFormFields(result.data);
                toggleFormInputStates(true);

                document.getElementById("blockTrainingCodeDisplay").style.display = "flex";
                document.getElementById("modalHeadingTitle").innerText = "View Course Details";
                document.getElementById("btnSubmitForm").style.display = "none";

                document.getElementById("trainingWorkspaceModalLayer").style.display = "flex";
            }
        } catch { alert("Failed to establish detail channel fields."); }
    }

    async function fireEditWorkflow(id) {
        document.getElementById("trainingWorkspaceForm").reset();
        try {
            const res = await fetch(`/TrainingMaster/GetTrainingMaster/${id}`);
            const result = await res.json();

            if (result.success && result.data) {
                populateFormFields(result.data);
                toggleFormInputStates(false);

                document.getElementById("blockTrainingCodeDisplay").style.display = "flex";
                document.getElementById("modalHeadingTitle").innerText = "Modify Course Parameters";
                document.getElementById("btnSubmitForm").innerText = "Save Changes";
                document.getElementById("btnSubmitForm").style.display = "inline-flex";

                document.getElementById("trainingWorkspaceModalLayer").style.display = "flex";
            }
        } catch { alert("Failed to establish update channel fields."); }
    }

    function populateFormFields(d) {
        document.getElementById("txtTrainingMasterId").value = d.trainingMasterId;
        document.getElementById("txtTrainingCode").value = d.trainingCode;
        document.getElementById("txtTrainingName").value = d.trainingName;
        document.getElementById("ddlTrainingCategoryId").value = d.trainingCategoryId;
        document.getElementById("txtDuration").value = d.duration;
        document.getElementById("ddlDurationType").value = d.durationType;
        document.getElementById("chkIsMandatory").checked = d.isMandatory;
        document.getElementById("chkIsAssessmentRequired").checked = d.isAssessmentRequired;
        document.getElementById("chkIsCertificateRequired").checked = d.isCertificateRequired;
    }

    async function submitTrainingForm(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById("txtTrainingMasterId").value);
        const url = id === 0 ? "/TrainingMaster/Create" : "/TrainingMaster/Update";

        const formData = new URLSearchParams();
        formData.append("TrainingMasterId", id);
        formData.append("TrainingName", document.getElementById("txtTrainingName").value);
        formData.append("TrainingCategoryId", document.getElementById("ddlTrainingCategoryId").value);
        formData.append("Duration", document.getElementById("txtDuration").value);
        formData.append("DurationType", document.getElementById("ddlDurationType").value);
        formData.append("IsMandatory", document.getElementById("chkIsMandatory").checked);
        formData.append("IsAssessmentRequired", document.getElementById("chkIsAssessmentRequired").checked);
        formData.append("IsCertificateRequired", document.getElementById("chkIsCertificateRequired").checked);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded", "RequestVerificationToken": token },
                body: formData.toString()
            });
            const result = await res.json();

            if (result.success) {
                closeWorkspaceModal();
                if (window.showVqSuccess) window.showVqSuccess(result.message);

                setTimeout(() => { loadTrainingGridMatrix(); }, 500);
            } else {
                if (window.showVqError) window.showVqError(result.message);
                else alert(result.message);
            }
        } catch { alert("Transmission synchronization fault."); }
    }

    function executeToggleStatus(id, currentStatus) {
        const titleText = currentStatus ? "Deactivate" : "Activate";
        const msg = `Are you sure you want to ${titleText.toLowerCase()} this training course track?`;

        showVqConfirm(
            titleText + " Training",
            msg,
            async function() {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                try {
                    const res = await fetch(`/TrainingMaster/ToggleStatus/${id}`, {
                        method: "POST", headers: { "RequestVerificationToken": token }
                    });
                    const result = await res.json();

                    if (result.success) {
                        if (window.showVqAlert) {
                            showVqAlert("Success", "Training status updated successfully.", true);
                        }
                        loadTrainingGridMatrix();
                    }
                } catch { alert("Status toggling failed."); }
            }
        );
    }

    function executeClientSideSearchFilter() {
        const query = document.getElementById("trainingSearchInput").value.trim().toLowerCase();

        const matched = localTrainingCache.filter(x =>
            x.trainingName.toLowerCase().includes(query) ||
            x.trainingCode.toLowerCase().includes(query) ||
            x.categoryName.toLowerCase().includes(query)
        );

        renderTrainingRows(matched);
    }
</script>