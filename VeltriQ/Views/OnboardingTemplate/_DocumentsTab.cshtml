@model VeltriQ.ViewModels.OnboardingTemplateSectionDesignerViewModel

<form asp-action="SaveDocuments" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="OnboardingTemplateId" />
    <input type="hidden" asp-for="TemplateName" />
    <input type="hidden" asp-for="TemplateCode" />

    <div class="designer-panel">

        <div style="padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--card-bg);">
            <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: var(--text-primary);">Configure Documents</h4>
            <p style="margin: 2px 0 0 0; font-size: 11px; color: var(--text-secondary);">Select the required onboarding documents.</p>
        </div>

        <div class="table-wrapper">
            <table class="designer-table">
                <thead>
                    <tr>
                        <th style="width: 90px;">Include</th>
                        <th style="width: 120px;">Mandatory</th>
                        <th>Document</th>
                        <th style="width: 120px;">Display Order</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Documents != null && Model.Documents.Count > 0)
                    {
                        @for (int i = 0; i < Model.Documents.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input asp-for="Documents[i].IsSelected" class="custom-check-input document-checkbox" />

                                    <input asp-for="Documents[i].OnboardingDocumentMasterId" type="hidden" />
                                    <input asp-for="Documents[i].DocumentName" type="hidden" />
                                    <input asp-for="Documents[i].OnboardingTemplateDocumentId" type="hidden" />
                                </td>

                                <td>
                                    <input asp-for="Documents[i].IsMandatory" class="custom-check-input mandatory-doc-checkbox" />
                                </td>

                                <td style="font-weight: 600;">
                                    @Model.Documents[i].DocumentName
                                </td>

                                <td>
                                    <input asp-for="Documents[i].DisplayOrder" class="custom-form-control order-input order-doc-input" type="number" min="1" />
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 32px 16px;">
                                No onboarding master documents mapped to this configuration context.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="panel-footer-actions">
        <button type="submit" class="form-action-btn btn-submit-theme">
            <i class="bi bi-floppy"></i> Save Documents
        </button>
        <a asp-action="Index" class="form-action-btn btn-cancel-theme">
            Cancel
        </a>
    </div>
</form>

<script>
    function toggleDocumentRow(includeCheckbox) {
        const row = includeCheckbox.closest('tr');
        if (!row) return;

        const mandatory = row.querySelector('.mandatory-doc-checkbox');
        const order = row.querySelector('.order-doc-input');

        if (mandatory) mandatory.disabled = !includeCheckbox.checked;
        if (order) order.readOnly = !includeCheckbox.checked;
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".document-checkbox").forEach(function (cb) {
            toggleDocumentRow(cb);
            cb.addEventListener("change", function () {
                toggleDocumentRow(this);
            });
        });
    });
</script>