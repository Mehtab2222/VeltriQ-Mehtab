@model IEnumerable<VeltriQ.ViewModels.HR.ProbationAssessmentIndexViewModel>

@{
    ViewData["Title"] = "Probation Assessments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .probation-page {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .probation-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        max-height: calc(100vh - var(--topbar-h) - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .probation-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--border);
        gap: 20px;
    }

    .probation-card-title h3 {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .probation-card-title p {
        font-size: 11px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
    }

    .search-box {
        position: relative;
        width: 260px;
    }

        .search-box input {
            width: 100%;
            height: 32px;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: var(--input-bg);
            color: var(--text-primary);
            padding: 0 12px 0 32px;
            font-size: 12px;
            outline: none;
            transition: border-color 0.2s;
        }

            .search-box input:focus {
                border-color: var(--purple);
            }

        .search-box i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
        }

    .table-wrapper {
        overflow-y: auto;
        overflow-x: auto;
        flex: 1;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .table-wrapper::-webkit-scrollbar {
            display: none;
        }

    .probation-table {
        width: 100%;
        border-collapse: collapse;
    }

        .probation-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--card-bg);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .probation-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .probation-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* Employee */
    .employee-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .employee-avatar {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 50%;
        background: #7c3aed;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .employee-name {
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .employee-code {
        font-size: 10.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    /* Status */
    .badge-status {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
    }

    .status-pending {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
    }

    .status-inprogress {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
    }

    .status-completed {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    /* Actions */
    .action-area {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
    }

    .assess-btn {
        height: 28px;
        padding: 0 12px;
        border-radius: 4px;
        border: none;
        background: linear-gradient(135deg, #6d28d9, #7c3aed);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

        .assess-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .edit-btn {
        width: 28px;
        height: 28px;
        border-radius: 4px;
        border: none;
        background: var(--hover-bg);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        text-decoration: none;
        transition: .2s ease;
    }

        .edit-btn:hover {
            background: var(--purple);
            color: #fff;
        }

    .no-assessment {
        color: var(--text-muted);
        font-size: 11px;
    }
</style>

<div class="probation-page">

    <div class="probation-card">

        <!-- =====================================================
             CARD HEADER
        ====================================================== -->

        <div class="probation-card-top">

            <div class="probation-card-title">
                <h3>Probation Assessments</h3>
                <p>
                    Manage probation employees and their evaluation checkpoints.
                </p>
            </div>

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       id="tableSearchKeyword"
                       placeholder="Search employees..."
                       onkeyup="filterProbationTable()"
                       autocomplete="off" />
            </div>

        </div>


        <!-- =====================================================
             TABLE
        ====================================================== -->

        <div class="table-wrapper">

            <table class="probation-table"
                   id="probationTable">

                <thead>
                    <tr>

                        <th>EMPLOYEE</th>

                        <th>DEPARTMENT</th>

                        <th>DESIGNATION</th>

                        <th>PROBATION END</th>

                        <th>CHECKPOINT</th>

                        <th style="text-align:center;">
                            STATUS
                        </th>

                        <th style="text-align:right; padding-right:24px;">
                            ACTION
                        </th>

                    </tr>
                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var x in Model)
                        {
                            var statusClass =
                            x.OverallStatus == "Completed"
                            ? "status-completed"
                            : x.OverallStatus == "InProgress"
                            ? "status-inprogress"
                            : "status-pending";


                            <tr class="probation-row">

                                <!-- EMPLOYEE -->

                                <td>

                                    <div class="employee-info">

                                        @{
                                            var nameParts =
                                            (x.EmployeeName ?? "")
                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                            var initials =
                                            nameParts.Length >= 2
                                            ? $"{nameParts[0][0]}{nameParts[^1][0]}"
                                            : nameParts.Length == 1
                                            ? nameParts[0][0].ToString()
                                            : "?";
                                        }

                                <div class="employee-avatar">
                                    @initials
                                </div>

                                <div>

                                    <div class="employee-name searchable-text">
                                        @x.EmployeeName
                                    </div>

                                    <div class="employee-code">
                                        @x.EmployeeNo
                                    </div>

                                </div>

                            </div>

                        </td>


                        <!-- DEPARTMENT -->

                        <td>
                            @(x.Department ?? "—")
                        </td>


                        <!-- DESIGNATION -->

                        <td>
                            @(x.Designation ?? "—")
                        </td>


                        <!-- PROBATION END -->

                        <td>
                            @(x.ProbationEndDate.HasValue
                                                        ? x.ProbationEndDate.Value.ToString("dd MMM yyyy")
                                                        : "—")
                        </td>


                                <!-- CURRENT CHECKPOINT -->

                                <td>
                                    @(x.CurrentCheckpointLabel ?? "Not Started")
                                </td>


                                <!-- STATUS -->

                                <td style="text-align:center;">

                            @if (x.HasAssessment)
                                    {
                                        <span class="badge-status @statusClass">
                                            @x.OverallStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status status-pending">
                                            Not Started
                                        </span>
                                    }

                                </td>


                                <!-- ACTION -->

                                <td style="text-align:right; padding-right:24px;">

                                    <div class="action-area">

                                        @if (!x.HasAssessment)
                                        {
                                            <a asp-action="Create"
                                               asp-route-employeeId="@x.EmployeeId"
                                               class="assess-btn">

                                                <i class="bi bi-clipboard-check"></i>
                                                Assess

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@x.AssessmentId"
                                               class="assess-btn">

                                                <i class="bi bi-pencil-square"></i>
                                                Edit

                                            </a>
                                        }
                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                style="
                                        text-align:center;
                                        color:var(--text-muted);
                                        font-style:italic;
                                        padding:24px;
                                    ">

                                No probation employees found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    function filterProbationTable() {

        const input =
            document.getElementById('tableSearchKeyword');

        const filter =
            input.value.toLowerCase();

        const rows =
            document.querySelectorAll(
                '#probationTable tbody tr.probation-row'
            );

        rows.forEach(row => {

            const textContent =
                row.textContent.toLowerCase();

            row.style.display =
                textContent.includes(filter)
                    ? ''
                    : 'none';

        });
    }

</script>