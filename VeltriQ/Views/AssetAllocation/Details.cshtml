@model VeltriQ.ViewModels.AssetAllocation.AssetAllocationDetailsViewModel

@{
    ViewData["Title"] = "Allocation Profile Details";
}

<style>
    .details-page-frame {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* ── PROFILE HERO WORKSPACE BANNER ── */
    .profile-hero-banner {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 14px 16px;
        position: relative;
    }

    .hero-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .hero-identity-deck {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hero-avatar-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        flex-shrink: 0;
    }

    .hero-title-block {
        display: flex;
        flex-direction: column;
    }

        .hero-title-block h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
        }

    .hero-meta-subtitle {
        font-size: 12px;
        color: var(--text-secondary);
        margin: 2px 0 0 0;
        font-weight: 600;
    }

    /* ── METADATA INFO STRIP ── */
    .hero-metadata-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        padding-top: 8px;
        border-top: 1px dashed var(--border);
        font-size: 11.5px;
        color: var(--text-secondary);
    }

        .hero-metadata-strip span strong {
            color: var(--text-primary);
        }

    /* ── HIGH DENSITY CONTROL WORKSPACE CARD ── */
    .workspace-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px;
        display: flex;
        flex-direction: column;
    }

    .workspace-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
    }

        .workspace-card-header h3 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

    /* ── GRID LAYOUT MATRIX ── */
    .table-wrapper {
        overflow-x: auto;
    }

    .matrix-grid-table {
        width: 100%;
        border-collapse: collapse;
    }

        .matrix-grid-table th {
            text-align: left;
            padding: 10px 16px;
            font-size: 10px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: .5px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
            background: var(--hover-bg);
        }

        .matrix-grid-table td {
            padding: 8px 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text-primary);
            font-size: 12.5px;
            vertical-align: middle;
        }

        .matrix-grid-table tbody tr:last-child td {
            border-bottom: none;
        }

        .matrix-grid-table tbody tr:hover {
            background: var(--hover-bg);
        }

    /* ── COMPACT SYSTEM ACTIONS LABELS ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 20px;
        padding: 0 8px;
        border-radius: 4px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-category {
        background: rgba(124, 58, 237, 0.12);
        color: var(--purple);
    }

    .btn-cancel-theme {
        height: 34px;
        padding: 0 14px;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: var(--hover-bg);
        color: var(--text-primary);
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: .15s ease-in-out;
    }

        .btn-cancel-theme:hover {
            background: rgba(124, 58, 237, 0.15);
            color: var(--purple);
        }
</style>

<div class="details-page-frame">

    <div class="details-header hero-top-row">
        <div>
            <a asp-action="Index" class="btn-cancel-theme">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
        </div>
    </div>

    <div class="profile-hero-banner">
        <div class="hero-top-row">
            <div class="hero-identity-deck">
                <div class="hero-avatar-circle">
                    @if (!string.IsNullOrWhiteSpace(Model.EmployeeName) && Model.EmployeeName.Contains(" "))
                    {
                        var parts = Model.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        @($"{parts[0][0]}{parts[1][0]}".ToUpper())
                    }
                    else
                    {
                        @("EM")
                    }
                </div>
                <div class="hero-title-block">
                    <h2>@Model.EmployeeName</h2>
                    <div class="hero-meta-subtitle">
                        @Model.Designation <span style="color: var(--border); margin: 0 4px;">•</span> @Model.Department
                    </div>
                </div>
            </div>
        </div>

        <div class="hero-metadata-strip">
            <span>Employee Code: <strong>@Model.EmployeeCode</strong></span>
            <span>Operating Branch: <strong>@Model.Branch</strong></span>
            <span>Joining Date: <strong style="color: var(--purple);">@(Model.JoiningDate?.ToString("dd MMM yyyy") ?? "-")</strong></span>
            <span>Total Tracked Assets: <strong>@Model.AllocatedAssets.Count</strong></span>
        </div>
    </div>

    <div class="workspace-card">
        <div class="workspace-card-header">
            <h3>Asset Allocation History</h3>
        </div>

        <div class="table-wrapper">
            <table class="matrix-grid-table">
                <thead>
                    <tr>
                        <th>Asset Code</th>
                        <th>Asset Name</th>
                        <th>Category Group</th>
                        <th>Brand / Model Blueprint</th>
                        <th>Allocated By</th>
                        <th>Allocated On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllocatedAssets != null && Model.AllocatedAssets.Any())
                    {
                        foreach (var asset in Model.AllocatedAssets)
                        {
                            <tr>
                                <td style="font-weight: 700; color: var(--text-primary);">
                                    @asset.AssetCode
                                </td>
                                <td style="font-weight: 600;">
                                    @asset.AssetName
                                </td>
                                <td>
                                    <span class="status-badge badge-category">@asset.AssetCategory</span>
                                </td>
                                <td style="color: var(--text-secondary); font-weight: 500;">
                                    @asset.BrandName / @asset.ModelName
                                </td>
                                <td style="font-weight: 600;">
                                    <i class="bi bi-person-circle" style="color: var(--purple); font-size: 11px; margin-right: 4px;"></i> @asset.AllocatedBy
                                </td>
                                <td style="color: var(--text-secondary);">
                                    @(asset.AllocatedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); font-style: italic; padding: 24px;">
                                No active hardware or parameter layout assets currently mapped to this staff account.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>