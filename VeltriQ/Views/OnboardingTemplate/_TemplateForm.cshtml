@model VeltriQ.ViewModels.OnboardingTemplateViewModel

<style>
    /* ── FORM CARD WRAPPER ── */
    .custom-form-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 0px; /* Aligned with your squared layout system */
        display: flex;
        flex-direction: column;
        margin-bottom: 16px;
    }

    .custom-form-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border);
        background: var(--card-bg);
    }

        .custom-form-header h5 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

    .custom-form-body {
        padding: 16px;
        background: var(--card-bg);
    }

    /* ── FORM FIELDS & LAYOUT UNITS ── */
    .form-grid-row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -8px;
        margin-left: -8px;
    }

    .form-grid-col-3 {
        flex: 0 0 25%;
        max-width: 25%;
        padding: 0 8px;
    }

    .form-grid-col-4 {
        flex: 0 0 33.3333%;
        max-width: 33.3333%;
        padding: 0 8px;
    }

    .form-grid-col-6 {
        flex: 0 0 50%;
        max-width: 50%;
        padding: 0 8px;
    }

    .form-field-group {
        margin-bottom: 12px;
    }

    .custom-form-label {
        display: inline-block;
        margin-bottom: 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    /* ── CUSTOM INPUTS & SELECT FIELDS ── */
    .custom-form-control {
        width: 100%;
        height: 34px;
        border-radius: 4px;
        border: 1px solid var(--border);
        background: var(--input-bg);
        color: var(--text-primary);
        padding: 0 10px;
        font-size: 12.5px;
        outline: none;
        transition: border-color 0.15s ease-in-out;
    }

        .custom-form-control:focus {
            border-color: var(--purple);
        }

        .custom-form-control[readonly] {
            opacity: 0.65;
            cursor: not-allowed;
        }

    /* ── SELECTION DRAWER REPLACES BOOTSTRAP SELECT ── */
    select.custom-form-control {
        padding-right: 24px;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%239ca3af' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 12px 12px;
    }

    /* ── TOGGLE & CHECKBOX MECHANICS ── */
    .custom-check-group {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding-top: 6px;
    }

    .custom-check-input {
        width: 14px;
        height: 14px;
        accent-color: var(--purple);
        cursor: pointer;
    }

    .custom-check-label {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-primary);
        cursor: pointer;
        user-select: none;
    }

    /* ── VALIDATION ANCHORS ── */
    .validation-err-text {
        font-size: 11px;
        color: #ef4444;
        font-weight: 500;
        margin-top: 2px;
        display: block;
    }

    /* Mobile handling overlay override */
    @@media (max-width: 768px) {
        .form-grid-col-3, .form-grid-col-4, .form-grid-col-6

    {
        flex: 0 0 100%;
        max-width: 100%;
    }

    }
</style>

<div class="custom-form-card">

    <div class="custom-form-header">
        <h5>General Information</h5>
    </div>

    <div class="custom-form-body">

        @if (Model.OnboardingTemplateId > 0)
        {
            <div class="form-grid-row">
                <div class="form-grid-col-4 form-field-group">
                    <label asp-for="TemplateCode" class="custom-form-label"></label>
                    <input asp-for="TemplateCode" class="custom-form-control" readonly />
                </div>
            </div>
        }

        <div class="form-grid-row">
            <div class="form-grid-col-6 form-field-group">
                <label asp-for="TemplateName" class="custom-form-label"></label>
                <input asp-for="TemplateName" class="custom-form-control" autocomplete="off" />
                <span asp-validation-for="TemplateName" class="validation-err-text"></span>
            </div>

            <div class="form-grid-col-6 form-field-group">
                <label asp-for="EmploymentTypeMasterId" class="custom-form-label"></label>
                <select asp-for="EmploymentTypeMasterId" asp-items="Model.EmploymentTypes" class="custom-form-control">
                    <option value="">-- Select Employment Type --</option>
                </select>
                <span asp-validation-for="EmploymentTypeMasterId" class="validation-err-text"></span>
            </div>
        </div>

        <div class="form-grid-row">
            <div class="form-grid-col-6 form-field-group">
                <label asp-for="DepartmentId" class="custom-form-label"></label>
                <select asp-for="DepartmentId" asp-items="Model.Departments" class="custom-form-control">
                    <option value="">-- Select Department --</option>
                </select>
            </div>

            <div class="form-grid-col-6 form-field-group">
                <label asp-for="DesignationId" class="custom-form-label"></label>
                <select asp-for="DesignationId" asp-items="Model.Designations" class="custom-form-control">
                    <option value="">-- Select Designation --</option>
                </select>
            </div>
        </div>

        <div class="form-grid-row">
            <div class="form-grid-col-4 form-field-group">
                <label asp-for="TemplateVersion" class="custom-form-label"></label>
                <input asp-for="TemplateVersion" class="custom-form-control" />
            </div>
        </div>

        <div class="form-grid-row" style="margin-top: 8px;">
            <div class="form-grid-col-3 form-field-group">
                <div class="custom-check-group">
                    <input asp-for="IsDefault" class="custom-check-input" />
                    <label asp-for="IsDefault" class="custom-check-label"></label>
                </div>
            </div>

            <div class="form-grid-col-3 form-field-group">
                <div class="custom-check-group">
                    <input asp-for="IsActive" class="custom-check-input" />
                    <label asp-for="IsActive" class="custom-check-label"></label>
                </div>
            </div>
        </div>

    </div>
</div>